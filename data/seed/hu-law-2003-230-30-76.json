{
  "id": "hu-law-2003-230-30-76",
  "type": "statute",
  "title": "230/2003. (XII. 19.) KE határozat rektori megbízásokról",
  "status": "in_force",
  "in_force_date": "2003-12-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-230-30-76",
  "description": "rektori megbízásokról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben – megbízom a rektori teendők ellátásával,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Budapesti Közgazdaságtudományi és Államigazgatási Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Mészáros Tamás egyetemi tanárt,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2004. január hó 1-jétől 2007. december 30-éig terjedő időtartamra és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Szent István Egyetemen"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Molnár József egyetemi tanárt,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2004. január 1-jétől 2007. június 30-áig terjedő időtartamra."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "A Budapesti Közgazdaságtudományi és Államigazgatási Egyetemen dr. Chikán Attila egyetemi tanárnak és a Szent István Egyetemen dr. Szendrő Péter egyetemi tanárnak rektori megbízása lejártával eredményes munkájáért elismerésemet és köszönetemet fejezem ki."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "KEH ügyszám: V-2/4822/2003."
    }
  ]
}
