{
  "id": "hu-law-2006-51-30-63",
  "type": "statute",
  "title": "51/2006. (VIII. 28.) ME határozat központi tiszt cím megszűnésének megállapításáról",
  "status": "in_force",
  "in_force_date": "2006-08-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-51-30-63",
  "description": "központi tiszt cím megszűnésének megállapításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A fegyveres szervek hivatásos állományú tagjainak szolgálati viszonyáról szóló 1996. évi XLIII. törvény 245/J. § (4) bekezdése alapján – a köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 31/D. § (1) bekezdés a) pontjára tekintettel – megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Varga Valéria központi tiszt címe"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2006. szeptember 15-ei hatállyal,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. jur. Ódor Péter központi tiszt címe"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2006. október 29-ei hatállyal,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Bodrogi István központi tiszt címe"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2006. november 30-ai hatállyal,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Hatala József központi tiszt címe"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "2006. december 31-ei hatállyal"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "– a hivatásos szolgálati jogviszonyának megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "megszűnik."
    }
  ]
}
