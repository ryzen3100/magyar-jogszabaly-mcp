      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1994. évi 62. számában megjelent helyesbítés 3. francia bekezdése helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,— a rendelet 10. sz. lábjegyzetében feltüntetett rendeletszám helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "20/1984. (XII. 21.) KM r. 6. §-ának (1) bekezdése''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(Nyomdahiba)"
    }
  ]
}
