{
  "id": "hu-law-2007-153-20-0n",
  "type": "statute",
  "title": "153/2007. (XII. 27.) KvVM rendelet a Mártélyi Tájvédelmi Körzet védettségének fenntartásáról",
  "status": "in_force",
  "in_force_date": "2008-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-153-20-0N",
  "description": "a Mártélyi Tájvédelmi Körzet védettségének fenntartásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § Az Országos Természetvédelmi Hivatal 390/1971. számú határozatával védetté nyilvánított Mártélyi Tájvédelmi Körzet védettségét fenntartom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § A Mártélyi Tájvédelmi Körzet kiterjedése 1916,1 ha, ingatlan-nyilvántartási helyrajzi számait a melléklet tartalmazza."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A védettség indoka és célja a Mártélyi-holtág, a Körtvélyesi-holtág és a Barci-rét természeti és tájképi értékeinek megőrzése, a hullámtér területén élő gazdag madárvilág zavartalan életfeltételeinek biztosítása."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § A terület természetvédelmi kezeléséért felelős szerv a Kiskunsági Nemzeti Park Igazgatóság."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5. §",
      "content": "5. § Ez a rendelet 2008. január 1-jén lép hatályba. A Mártélyi Tájvédelmi Körzet ingatlan-nyilvántartási helyrajzi számai Hódmezővásárhely 01052, 01053/1, 01053/2, 01054, 01055/1, 01055/10, 01055/3, 01055/4, 01055/6, 01055/7, 01055/8, 01055/9, 01056/1, 01056/3, 01056/4, 01057, 01058/1, 01058/2, 01059/1, 01059/2, 01059/3, 01060, 01061/1, 01061/2, 01061/4, 01061/5, 01062, 01063/1, 01063/2, 01063/3, 01063/4, 01064, 01065/1, 01065/2, 01066, 01067/2, 01067/3, 01067/4, 01067/5, 01067/6, 01067/7, 01067/8, 01067/9, 01068, 01069, 01070/1, 01070/2, 01070/3, 01070/4, 01070/5, 01071, 02055, 02056, 02057, 02058, 02059, 02060, 02061, 02063, 02064, 02066, 02067, 02068, 02069, 02070, 02071, 02072, 02073, 02074, 02075, 02077, 02078, 02079, 02080, 02081, 02082, 02083, 02084, 02086, 02088, 02089, 02090, 02091, 02092, 02093, 02094, 02095, 02096, 02097, 02098, 02100, 02101, 02103, 02142, 02143, 02144/1, 02144/2, 02146, 02148/1, 02148/3, 02149, 02150, 02151, 02152, 02153, 02154, 02155, 02156, 02157/1, 02158/1, 02159/1, 02164, 02167, 02168, 02169, 02170, 02171, 02172, 02173, 02175/1, 02176/1, 02179/3, Mártély üdülőterület Mártély 0360, 0361, 0362, 0363, 0364, 0365, 0366, 0367, 0368, 0369, 0370, 0371, 0372, 0373, 0374, 0375, 0376, 0377, 0378, 0380, 0381 Mindszent 0152/2 Az aláhúzással jelölt helyrajzi számú ingatlanok területei az európai közösségi jelentőségű természetvédelmi rendeltetésű területekkel érintett földrészletekről szóló 45/2006. (XII. 8.) KvVM rendelet alapján Natura 2000 területnek minősülnek."
    }
  ]
}
