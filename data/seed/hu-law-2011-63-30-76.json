{
  "id": "hu-law-2011-63-30-76",
  "type": "statute",
  "title": "63/2011. (III. 16.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2011-03-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-63-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a nemzeti fejlesztési miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Ernyey Ibolyának, a Magyar Horizont Energia Kft. ügyvezető igazgatójának,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Koncz Lászlónak, a Fővárosi Gázművek Zrt. vezérigazgatójának,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Tajti Péter Pálnak, az Égáz-Dégáz Földgázelosztó Zrt. általános vezérigazgatójának a"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "kitüntetést,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "adományozom."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "KEH ügyszám: VIII-1/00906/2011."
    }
  ]
}
