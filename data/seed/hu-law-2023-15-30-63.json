    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2023. február 28-ai hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem, egyidejűleg"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Bidló Juditot és"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Lengyel Lászlót a Belügyminisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 2023. március 1-jei hatállyal –"
    },
    {
      "provision_ref": "s9",
