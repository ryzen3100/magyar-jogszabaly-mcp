{
  "id": "hu-law-2008-122-30-76",
  "type": "statute",
  "title": "122/2008. (V. 14.) KE határozat államtitkárok felmentéséről",
  "status": "in_force",
  "in_force_date": "2008-05-14",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-122-30-76",
  "description": "államtitkárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 49. § (2) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Puch Lászlót, a Gazdasági és Közlekedési Minisztérium államtitkárát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Burány Sándort, a Miniszterelnöki Hivatal államtitkárát"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e tisztségükből 2008. május 14-i hatállyal felmentem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: IV-2/02486/2008."
    }
  ]
}
