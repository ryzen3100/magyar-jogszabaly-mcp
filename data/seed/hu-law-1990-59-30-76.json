{
  "id": "hu-law-1990-59-30-76",
  "type": "statute",
  "title": "59/1990. (V. 8.) KE határozat dr. Antall József kormányalakítási megbízásáról",
  "status": "in_force",
  "in_force_date": "1990-05-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-59-30-76",
  "description": "dr. Antall József kormányalakítási megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 33. § (3) bekezdése alapján az Országgyűlésben képviselettel rendelkező pártok képviselőcsoportjai vezetőinek, továbbá a pártokhoz nem tartozó képviselők megbízottjának a meghallgatása után:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Antall Józsefnek,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Magyar Demokrata Fórum elnökének"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kormányalakításra megbízást adok."
    }
  ]
}
