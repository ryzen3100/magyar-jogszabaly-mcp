{
  "id": "hu-law-2007-63-30-63",
  "type": "statute",
  "title": "63/2007. (IX. 21.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2007-09-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-63-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) pontjában foglalt jogkörömben – az oktatási és kulturális miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Szegedi Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kozma Gábor főiskolai tanárt – a 2007. szeptember 1-jétől 2011. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
