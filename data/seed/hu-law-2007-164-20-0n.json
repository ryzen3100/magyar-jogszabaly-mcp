{
  "id": "hu-law-2007-164-20-0n",
  "type": "statute",
  "title": "164/2007. (XII. 27.) KvVM rendelet a Kőszegi Tájvédelmi Körzet védettségének fenntartásáról",
  "status": "in_force",
  "in_force_date": "2008-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-164-20-0N",
  "description": "a Kőszegi Tájvédelmi Körzet védettségének fenntartásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § Az Országos Környezet- és Természetvédelmi Hivatal 2/1980. (V. 14.) OKTH rendelkezésével védetté nyilvánított Kőszegi Tájvédelmi Körzet védettségét fenntartom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § A Kőszegi Tájvédelmi Körzet kiterjedése 4350,8 ha, ingatlan-nyilvántartási helyrajzi számait az 1. számú melléklet, fokozottan védett területének ingatlan-nyilvántartási helyrajzi számait a 2. számú melléklet tartalmazza."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A védettség indoka és célja a terület tájképi és természeti adottságainak, értékeinek, a szubalpin klíma sajátosságaival jellemezhető élőhelyek természetes növénytársulásainak, védett növényfajainak, illetve a hozzájuk kapcsolódó állatközösségek életfeltételeinek megőrzése."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § A terület természetvédelmi kezeléséért felelős szerv a Fertő-Hanság és Őrségi Nemzeti Park Igazgatóság."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5. §",
      "content": "5. § (1) Ez a rendelet 2008. január 1-jén lép hatályba. (2)"
    },
