{
  "id": "hu-law-2001-59-40-00",
  "type": "statute",
  "title": "2001. MK 59. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2001-05-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/2001-59-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2001. évi 46. számában kihirdetett, a belföldi és a nemzetközi közúti árufuvarozás szakmai feltételeiről és engedélyezési eljárásáról szóló 14/2001. (IV. 20.) KöViM rendelet"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 3. §-a (2) bekezdésének c) pontja helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,c) … a bíróság jogerősen megállapította (felszámolását elrendelte),''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 7. §-a (2) bekezdésének b) pontja helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,b) az engedélyezett tevékenységet tartósan –legalább 6 hónapon át – nem gyakorolja …''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– 8. §-a (2) bekezdésének felvezető szövege helyesen:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": ",,(2) … a gazdálkodó szervezet kérelmére a KKF – a külön jogszabályban3 hivatkozott kereten belül, …''"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 10. §-a (2) bekezdésének a) pontja helyesen:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,a) … ha az engedély kiadása a külön jogszabályban3 hivatkozott keret kimerülése miatt nem teljesíthető,''"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": ",,3 A közúti közlekedési szolgáltatásokról és a közúti járművek üzemben tartásáról szóló 89/1988. (XII. 20.) MT rendelet 4/A. §-ának (1) bekezdése.''"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Egyidejűleg az eredeti 3., 4. lábjegyzetek számozása 4., 5-re változik."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "– 4. §-a (3) bekezdésének első mondata helyesen:"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": ",,(3) Az egyes részvizsgákon elérhető pontszám a maximálisan megszerezhető összes pontszám egyharmada lehet.''"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "– 5. §-a (1) bekezdésének b) pontja helyesen:"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": ",,b) adó-, vám- és járulék-, továbbá a közlekedési hatósággal szemben fennálló fizetési kötelezettségének folyamatosan eleget tesz.''"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "– 11. §-a (2) bekezdésének b) pontja helyesen:"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": ",,b) a szolgáltatást nem az elvárható színvonalon végzi, súlyosan és ismételten megsérti a szakma bérezési és munkafeltételeire, …''"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "(Nyomdahiba)"
    }
  ]
}
