{
  "id": "hu-law-1999-40-30-63",
  "type": "statute",
  "title": "40/1999. (XII. 30.) ME határozat főiskolai főigazgatói megbízásról",
  "status": "amended",
  "in_force_date": "1999-12-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/1999-40-30-63",
  "description": "főiskolai főigazgatói megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatási intézményhálózat átalakításáról szóló 1999. évi LII. törvény 34. §-ának (2) bekezdésében foglaltak értelmében, illetve a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben megbízom"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kiss Endre főiskolai tanárt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Dunaújvárosi Főiskolán (Dunaújváros)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a főiskolai főigazgató feladatok ellátásával"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2000. január 1-jétől 2000. június 30-ig terjedő időtartamra."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
