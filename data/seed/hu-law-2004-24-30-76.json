{
  "id": "hu-law-2004-24-30-76",
  "type": "statute",
  "title": "24/2004. (III. 16.) KE határozat határőr vezérőrnagyi kinevezéséről",
  "status": "in_force",
  "in_force_date": "2004-03-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-24-30-76",
  "description": "határőr vezérőrnagyi kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére Samu István határőr dandártábornokot, a Határőrség rendészeti főigazgatóját, nemzeti ünnepünk alkalmából az 1949. évi XX. törvény 30/A. § (1) bekezdés i) pontja alapján, a vezetői és a szakmai munka terén kifejtett kimagasló tevékenysége elismeréseként 2004. március 15-i hatállyal"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,határőr vezérőrnaggyá''"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "KEH ügyszám: V-5/0867/2004."
    }
  ]
}
