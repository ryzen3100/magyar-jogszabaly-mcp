{
  "id": "hu-law-2007-118-c0-27",
  "type": "statute",
  "title": "A külügyminiszter közleménye a „Pro auxilio civium Hungarorum” emlékplakett adományozásáról",
  "status": "in_force",
  "in_force_date": "2007-09-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-118-C0-27",
  "description": "a „Pro auxilio civium Hungarorum” emlékplakett adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Magyar Köztársaság külügyminisztere 2007 folyamán a 9/2003. (V. 20.) KüM rendelet 5. §-a alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "PRO AUXILIO CIVIUM HUNGARORUM emlékplakettet"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "adományozott"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a magyar állampolgárok érdekeinek védelméért a Magyar Köztársaság kinevezett tiszteletbeli konzuli tisztviselőjeként megszakítás nélkül tíz éve eredményesen tevékenykedő tiszteletbeli főkonzuloknak és konzuloknak."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Az emlékplakettel jutalmazottak:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Fenjves János, caracasi (Venezuela) tiszteletbeli főkonzul,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Gordon Wavamunno, kampalai (Uganda) tiszteletbeli konzul,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Garai Gábor, bostoni (USA) tiszteletbeli konzul,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Molnár György, perth-i (Ausztrália) tiszteletbeli konzul,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "C. S. Gyawali, kathmandui (Nepál) tiszteletbeli konzul,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Marijan Kljucaricek, rijekai (Horvátország) tiszteletbeli konzul."
    }
  ]
}
