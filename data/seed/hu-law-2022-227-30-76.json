  "title": "227/2022. (VIII. 4.) KE határozat dandártábornok rendfokozatba történő kinevezésekről",
  "status": "in_force",
  "in_force_date": "2022-08-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/2022-227-30-76",
  "description": "dandártábornok rendfokozatba történő kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés e) pontja, valamint a nemzetbiztonsági szolgálatokról szóló 1995. évi CXXV. törvény 11. § (2) bekezdés l) pontja alapján – a Miniszterelnöki Kabinetirodát vezető miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Májer Zsolt nemzetbiztonsági ezredest,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Németh Attila nemzetbiztonsági ezredest és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Keller László nemzetbiztonsági alezredest"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2022. augusztus 1-jei hatállyal nemzetbiztonsági dandártábornok rendfokozatba kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: KEH/04514-2/2022."
    }
  ]
}
