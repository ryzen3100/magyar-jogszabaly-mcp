{
  "id": "hu-law-2005-156-c0-27",
  "type": "statute",
  "title": "A külügyminiszter közleménye a „Pro auxilio civium Hungarorum” emlékplakett adományozásáról",
  "status": "in_force",
  "in_force_date": "2005-12-06",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-156-C0-27",
  "description": "a „Pro auxilio civium Hungarorum” emlékplakett adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Magyar Köztársaság külügyminisztere 2005 folyamán a 9/2003. (V. 20.) KüM rendelet 5. §-a alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "PRO AUXILIO CIVIUM HUNGARORUM"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "emlékplakettet"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "adományozott"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a magyar állampolgárok védelméért a Magyar Köztársaság kinevezett tiszteletbeli konzuli tisztviselőjeként megszakítás nélkül tíz éve eredményesen tevékenykedő tiszteletbeli főkonzuloknak és konzuloknak."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Az emlékplakettel jutalmazottak:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Gilly G. János zugi (Svájc) tiszteletbeli konzul,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Hajóssy István limai (Peru) tiszteletbeli konzul,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Erdal Keresteci izmiri (Törökország) tiszteletbeli konzul,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Jürg Marquard zugi (Svájc) tiszteletbeli főkonzul,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
