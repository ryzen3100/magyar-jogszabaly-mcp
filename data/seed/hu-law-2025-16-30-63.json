  "title": "16/2025. (II. 25.) ME határozat főispán kinevezéséről",
  "status": "in_force",
  "in_force_date": "2025-02-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/2025-16-30-63",
  "description": "főispán kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 207. § (1) bekezdésében foglalt jogkörömben eljárva – a közigazgatási és területfejlesztési miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Lehőcz Regina Máriát a Tolna Vármegyei Kormányhivatalt vezető főispánná"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2025. március 1-jei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    }
  ]
}
