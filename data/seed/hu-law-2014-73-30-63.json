  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 220. § (2) bekezdésében foglalt jogkörömben eljárva, a nemzeti fejlesztési miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Becsey Zsolt Lászlót,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Koszorús László Gáspárt és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Mészáros Karinát"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2014. július 1-jei hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Nemzeti Fejlesztési Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kinevezem."
    }
  ]
}
