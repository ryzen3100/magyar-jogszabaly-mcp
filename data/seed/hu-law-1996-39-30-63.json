{
  "id": "hu-law-1996-39-30-63",
  "type": "statute",
  "title": "39/1996. (XI. 14.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1996-11-14",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-39-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Kocsárné Herboly Ildikót, a Liszt Ferenc Zeneművészeti Főiskola főiskolai tanárát 1996. november 1-jei hatállyal,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Bodoky Tamásné Krause Annamáriát, a Liszt Ferenc Zeneművészeti Főiskola főiskolai tanárát 1996. december 1-jei hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– nyugállományba vonulásukra tekintettel –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "e tisztségükből"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "felmentem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
