      "section": "10",
      "title": "10",
      "content": "– közalkalmazotti jogviszony áthelyezéssel történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "2001. július hó 31. napjával,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "a Budapesti Műszaki és Gazdaságtudományi Egyetemen"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "dr. Fogassy Elemér egyetemi tanárt"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "– nyugállományba vonulására tekintettel –"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "2001. augusztus hó 31. napjával, és"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "a Szegedi Tudományegyetemen"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "dr. Szederkényi Tibor egyetemi tanárt"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "– közalkalmazotti jogviszony saját kérésre történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "2001. szeptember hó 1. napjával"
    },
    {
      "provision_ref": "s20",
