    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2001. augusztus hó 31. napjával,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Könczey György egyetemi tanárt"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– közalkalmazotti jogviszony közös megegyezéssel történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "2001. augusztus hó 31. napjával és"
    },
