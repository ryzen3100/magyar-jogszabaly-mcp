  "title": "51/2000. (V. 2.) KE határozat miniszter megbízatása megszűnésének megállapításáról",
  "status": "amended",
  "in_force_date": "2000-05-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-51-30-76",
  "description": "miniszter megbízatása megszűnésének megállapításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 16. § (3) bekezdésében foglalt jogkörömben megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kövér László tárca nélküli miniszter megbízatása – a Magyar Köztársaság Alkotmányáról szóló 1949. évi XX. törvény 33/B. § b) pontja szerinti lemondással –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2000. május 2-i hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megszűnik."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Budapest, 2000. május 2."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
