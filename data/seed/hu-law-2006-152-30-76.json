{
  "id": "hu-law-2006-152-30-76",
  "type": "statute",
  "title": "152/2006. (IX. 14.) KE határozat rektori megbízásról",
  "status": "in_force",
  "in_force_date": "2006-09-14",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-152-30-76",
  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási és kulturális miniszter előterjesztésére, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának a) pontjában foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Színház- és Filmművészeti Egyetemen,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Ascher Tamás egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2006. szeptember 1-jétől 2010. szeptember 1-jéig terjedő időtartamra,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-2/3504/2006."
    }
  ]
}
