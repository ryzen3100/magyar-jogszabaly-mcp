  "title": "41/1998. (X. 30.) ME határozat a Nemzetbiztonsági Szakszolgálat főigazgatójának felmentéséről",
  "status": "amended",
  "in_force_date": "1998-10-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/1998-41-30-63",
  "description": "a Nemzetbiztonsági Szakszolgálat főigazgatójának felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzetbiztonsági szolgálatokról szóló 1995. évi CXXV. törvény 12. §-ának (2) bekezdése alapján a polgári nemzetbiztonsági szolgálatokat irányító tárca nélküli miniszternek a honvédelmi miniszterrel és a belügyminiszterrel egyetértésben történt előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 1998. október 31-i hatállyal –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Hevesi Tóth Ferenc vezérőrnagyot,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Nemzetbiztonsági Szakszolgálat főigazgatóját"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
