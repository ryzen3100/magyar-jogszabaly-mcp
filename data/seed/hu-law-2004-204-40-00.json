    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "„"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "[2. számú melléklet a 168/1997. (X. 6.) Korm. rendelethez]"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "A keresetek beszámításához alkalmazandó valorizációs szorzószámok"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "”"
    },
    {
      "provision_ref": "s6",
