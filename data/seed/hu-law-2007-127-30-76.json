{
  "id": "hu-law-2007-127-30-76",
  "type": "statute",
  "title": "127/2007. (VI. 29.) KE határozat városi cím adományozásáról",
  "status": "in_force",
  "in_force_date": "2007-07-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-127-30-76",
  "description": "városi cím adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A helyi önkormányzatokról szóló 1990. évi LXV. törvény 94. § b) pontja alapján, az önkormányzati és területfejlesztési miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Baranya megyében: Kozármisleny"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Békés megyében: Körösladány"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Borsod-Abaúj-Zemplén megyében: Alsózsolca"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Komárom-Esztergom megyében: Ács"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Pest megyében: Biatorbágy, Maglód, Törökbálint"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Szabolcs-Szatmár-Bereg megyében: Mándok"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Vas megyében: Bük"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "nagyközségeknek a városi címet adományozom."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Ez a határozat 2007. július 1-jén lép hatályba."
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "KEH ügyszám: VI-1/2282/2007. 1 A Magyar Közlöny 2007. évi 86. számában megjelent helyesbítésnek megfelelő szöveg."
    }
  ]
