      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján az igazságügyi és rendészeti miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Bujdosó Lajos nyugállományú főtörzsőrmesternek,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Czapp Gábor nyugállományú főtörzsőrmesternek,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Gombás Zoltán nyugállományú őrnagynak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Róka István nyugállományú alezredesnek a"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(katonai tagozat)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "kitüntetést adományozom."
    },
    {
