{
  "id": "hu-law-2014-115-30-63",
  "type": "statute",
  "title": "115/2014. (IX. 25.) ME határozat főiskolai rektorok megbízásáról",
  "status": "in_force",
  "in_force_date": "2014-09-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/2014-115-30-63",
  "description": "főiskolai rektorok megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az emberi erőforrások miniszterének a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Sárospataki Református Teológiai Akadémián"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Füsti-Molnár Szilveszter főiskolai tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2014. október 1-jétől 2017. június 30-áig terjedő időtartamra – a rektori teendők ellátásával megbízom, valamint"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "az Adventista Teológiai Főiskolán"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Szilvási József főiskolai tanárt"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– a 2014. október 15-étől 2019. október 14-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
