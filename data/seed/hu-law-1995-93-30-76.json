{
  "id": "hu-law-1995-93-30-76",
  "type": "statute",
  "title": "93/1995. (VI. 2.) KE határozat városi cím adományozásáról",
  "status": "in_force",
  "in_force_date": "1995-06-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-93-30-76",
  "description": "városi cím adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére a városi címet adományozom 1995. július 1. napjával:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. a Baranya megyében lévő"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Sásd,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2. a Bács-Kiskun megyében lévő"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Szabadszállás,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "3. a Győr-Moson-Sopron megyében lévő"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Fertőd,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "4. a Tolna megyében lévő"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Bátaszék,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Simontornya,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "5. a Vas megyében lévő"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Csepreg"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "nagyközségnek."
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "Kuncze Gábor s. k., belügyminiszter"
    }
  ]
}
