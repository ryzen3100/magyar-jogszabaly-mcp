  "title": "274/2011. (XI. 10.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2011-11-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-274-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdésének j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 4/A. §-a alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a hazafias helytállással példát mutató, a magyar függetlenséget szolgáló, a társadalmi párbeszéd, a társadalmi béke, a nemzet egységének megvalósítása, a békés rendszerváltoztatás megteremtése érdekében kifejtett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Bácsi Józsefnek,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Dózsa Lászlónak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Jecsmenik Andornak a"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "NAGY IMRE ÉRDEMREND"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "KEH ügyszám: VIII-1/05395/2011."
    }
  ]
}
