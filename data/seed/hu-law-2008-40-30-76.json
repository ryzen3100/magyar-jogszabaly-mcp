{
  "id": "hu-law-2008-40-30-76",
  "type": "statute",
  "title": "40/2008. (II. 5.) KE határozat rektori megbízásról",
  "status": "in_force",
  "in_force_date": "2008-02-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-40-30-76",
  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának a) pontja alapján, az oktatási és kulturális miniszternek – a fenntartóval egyetértésben tett – javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Andrássy Gyula Budapesti Német Nyelvű Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Masát András egyetemi tanárt, Collegium Hungaricum Berlin igazgatóját"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2008. február 1-jétől 2011. január 31-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: IV-3/00207/2008."
    }
  ]
}
