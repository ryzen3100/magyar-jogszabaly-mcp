{
  "id": "hu-law-2008-48-30-63",
  "type": "statute",
  "title": "48/2008. (VII. 3.) ME határozat főiskolai rektorok megbízásáról",
  "status": "in_force",
  "in_force_date": "2008-07-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-48-30-63",
  "description": "főiskolai rektorok megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) és b) pontjában foglalt jogkörömben, az oktatási és kulturális miniszternek a fenntartóval egyetértésben tett előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Általános Vállalkozási Főiskolán,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Sárközy Tamás egyetemi tanárt – a 2008. július 1-jétől 2010. június 30-áig terjedő időtartamra –,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Baptista Teológiai Főiskolán,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Almási Tibor egyetemi tanárt – további – a 2008. július 1-jétől 2012. június 30-áig terjedő időtartamra,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "az Eötvös József Főiskolán,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Majdán János főiskolai tanárt – további – a 2008. július 1-jétől 2012. június 30-áig terjedő időre,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a Sapientia Szerzetesi Hittudományi Főiskolán,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Orosz András Lóránt egyetemi tanárt – a 2008. július 1-jétől 2012. augusztus 31-éig terjedő időtartamra –,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "a Sárospataki Református Teológiai Akadémián,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "dr. Kádár Ferenc főiskolai tanárt – további – a 2008. július 1-jétől 2011. június 30-áig terjedő időtartamra"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "a rektori teendők ellátásával megbízom;"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "dr. Tóth-Soma Lászlót – 2008. július 1-jei hatállyal –"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "főiskolai tanárrá kinevezem, és"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "a Bhaktivedanta Hittudományi Főiskolán – a 2008. július 1-jétől 2012. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
