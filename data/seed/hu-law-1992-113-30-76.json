  "title": "113/1992. (VI. 24.) KE határozat egyetemi tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1992-06-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/1992-113-30-76",
  "description": "egyetemi tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A népjóléti miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Nagy Endre egyetemi tanárt — Debreceni Orvostudományi Egyetem —,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Popper Péter egyetemi tanárt — Semmelweis Orvostudományi Egyetem —"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "nyugállományba vonulására tekintettel 1992. december 31. napjával,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Kenéz József egyetemi tanárt — Semmelweis Orvostudományi Egyetem —"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Karácsonyi Sándor egyetemi tanárt és"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Vadon Gábor egyetemi tanárt — Szegedi Orvostudományi Egyetem —"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "érdemei elismerése mellett, más munkakörbe történő kinevezése miatt 1992. június 1. napjával e tisztsége alól felmentem."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Dr. Surján László s. k., népjóléti miniszter"
    }
  ]
}
