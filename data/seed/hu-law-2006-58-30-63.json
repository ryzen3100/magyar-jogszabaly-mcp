  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 31/D. § (1) bekezdés a) és b) pontja alapján megállapítom, hogy"
    },
