  "title": "70/2002. (V. 28.) KE határozat rektori megbízásokról",
  "status": "in_force",
  "in_force_date": "2002-05-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2002-70-30-76",
  "description": "rektori megbízásokról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "megbízom a rektori teendők ellátásával"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2002. július hó 1. napjával"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Magyar Képzőművészeti Egyetemen"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Farkas Ádám egyetemi tanárt"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "2002. július hó 1. napjától 2005. július hó 31. napjáig terjedő időtartamra;"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a Nyugat-Magyarországi Egyetemen"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Iváncsics János egyetemi tanárt"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "2002. július hó 1. napjától 2003. december hó 31. napjáig terjedő időtartamra;"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "a Semmelweis Egyetemen"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "dr. Sótonyi Péter egyetemi tanár, rektort"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "– további – 2002. július hó 1. napjától 2003. június hó 30. napjáig terjedő időtartamra;"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "2002. augusztus hó 1. napjával"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "a Debreceni Egyetemen"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "dr. Nagy János egyetemi tanárt"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "2002. augusztus hó 1. napjától 2003. július hó 31. napjáig terjedő időtartamra és"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "a Magyar Iparművészeti Egyetemen"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "Droppa Judit egyetemi tanár, rektort"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "– további – 2002. augusztus hó 1. napjától 2006. július hó 31. napjáig terjedő időtartamra."
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "A Debreceni Egyetemen dr. Győry Kálmán, a Magyar Képzőművészeti Egyetemen Szabados Árpád és a Nyugat-Magyarországi Egyetemen dr. Koloszár József egyetemi tanár, rektornak, rektori megbízása lejártával eredményes munkájáért elismerésemet és köszönetemet fejezem ki."
    },
    {
      "provision_ref": "s21",
      "section": "21",
