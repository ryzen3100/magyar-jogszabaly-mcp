  "title": "1318/2025. (VIII. 21.) Korm. határozat a Népművészet Mestere díj 2025. évi adományozásáról",
  "status": "in_force",
  "in_force_date": "2025-08-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/2025-1318-30-22",
  "description": "a Népművészet Mestere díj 2025. évi adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Magyarország Kormánya 2025-ben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– Csapó Angéla kaposvári népi szövőnek,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– Egri István palóc fafaragónak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– Jókai Mária verebélyi (Felsőaha, Nyitra-vidék) néprajzkutató pedagógusnak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– Ládás József egyházaskozári népmesemondónak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– Máthé Dezső mezőpaniti hagyományőrző néptáncosnak,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– Nagyné Török Erzsébet tiszafüredi fazekasnak,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– Sebők Valéria szabadkai népi hímzőnek,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– Senyo Jolán magyarbődi népi énekesnek,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "– Szuperné Bohus Judit balatonfüredi népi hímzőnek,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "– Varga Zsuzsanna Emília gyimesi néptáncpedagógusnak"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "a Népművészet Mestere díjat adományozza."
    }
  ]
}
