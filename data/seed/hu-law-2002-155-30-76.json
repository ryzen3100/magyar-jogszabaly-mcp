  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére Dakos József hőr. ezredest, a Pécsi Határőr Igazgatóság igazgatóját, Nemzeti Ünnepünk alkalmából a határőrizeti munka végzésében és irányításában kifejtett eredményes tevékenysége elismeréseként 2002. október 23-i hatállyal"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "határőr dandártábornokká"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s4",
