{
  "id": "hu-law-2011-82-30-63",
  "type": "statute",
  "title": "82/2011. (IX. 30.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2011-09-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-82-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormánytisztviselők jogállásáról szóló 2010. évi LVIII. törvény 51. §-a alapján, a közigazgatási és igazságügyi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Lánczi Tamást, a Közigazgatási és Igazságügyi Minisztérium helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2011. szeptember 30-ai hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
