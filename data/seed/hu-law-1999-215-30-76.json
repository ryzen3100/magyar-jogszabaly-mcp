      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 21. §-a alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Rockenbauer Zoltánt, a Miniszterelnöki Hivatal politikai államtitkárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– más fontos megbízatása miatt –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "1999. december 31-i hatállyal"
    },
    {
