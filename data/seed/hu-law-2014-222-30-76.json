      "content": "Tállai Andrást 2014. június 15-ei hatállyal, valamint"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Glattfelder Bélát 2014. július 2-ai hatállyal"
    },
    {
      "provision_ref": "s8",
      "section": "8",
