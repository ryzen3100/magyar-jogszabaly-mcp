{
  "id": "hu-law-2008-117-30-76",
  "type": "statute",
  "title": "117/2008. (IV. 30.) KE határozat miniszterek kinevezéséről",
  "status": "in_force",
  "in_force_date": "2008-04-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-117-30-76",
  "description": "miniszterek kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 33. § (4) bekezdése alapján a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Székely Tamást egészségügyi miniszterré,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Szabó Pált gazdasági és közlekedési miniszterré,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Szabó Imrét környezetvédelmi és vízügyi miniszterré,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Szűcs Erikát szociális és munkaügyi miniszterré,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Molnár Károlyt tárca nélküli miniszterré,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2008. május 5-ei hatállyal kinevezem."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "KEH ügyszám: IV-2/02362/2008."
    }
  ]
}
