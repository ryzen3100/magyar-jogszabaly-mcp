{
  "id": "hu-law-2012-55-30-63",
  "type": "statute",
  "title": "55/2012. (V. 3.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2012-05-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-55-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 221. § (2) bekezdésének c) pontja, valamint a 223. § (1) bekezdése alapján, a külügyminiszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Hóvári Jánost, a Külügyminisztérium helyettes államtitkárát e tisztségéből – más fontos megbízatására tekintettel –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2012. július 15-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
