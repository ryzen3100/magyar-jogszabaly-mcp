  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "A Magyar Közlöny 1990. évi 32. számában megjelent a volt Munkásőrség egyes ingatlanainak hasznosításáról szóló 1067/1990. (IV. 9.) MT határozat 1. számú mellékletének harmadik és huszonharmadik tétele helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "A Magyar Közlöny 1990. évi 37. számában kihirdetett, a Nemzeti Gyermek és Ifjúsági Alapítványról szóló 81/1990. (IV. 27.) MT rendelet mellékletének II. és III. részében a helyes szöveg a következő:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "II."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "III."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Kézirathiba)"
    }
  ]
}
