{
  "id": "hu-law-2003-114-30-63",
  "type": "statute",
  "title": "114/2003. (XII. 11.) ME határozat kormányzati főtisztviselő áthelyezéséről",
  "status": "in_force",
  "in_force_date": "2003-12-11",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-114-30-63",
  "description": "kormányzati főtisztviselő áthelyezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 31/C. §-ának (4) bekezdésében foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Csáky Bernadett Barbara kormányzati főtisztviselőt a Gyermek-, Ifjúsági és Sportminisztérium Miniszteri Titkárság állományába, főosztályvezetői teendők ellátására"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2003. december 1-jei hatállyal – határozatlan időre – áthelyezem."
    }
  ]
}
