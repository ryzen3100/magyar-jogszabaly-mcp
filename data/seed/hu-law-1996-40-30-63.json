{
  "id": "hu-law-1996-40-30-63",
  "type": "statute",
  "title": "40/1996. (XI. 19.) ME határozat főiskolai tanárok kinevezéséről",
  "status": "amended",
  "in_force_date": "1996-11-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-40-30-63",
  "description": "főiskolai tanárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1)–(2) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Patkó Istvánt, a Könnyűipari Műszaki Főiskolán,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Jüptner Vilmosné Kékesi Máriát, a Magyar Táncművészeti Főiskolán,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Kászonyi Gábort,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Reischl Gábort,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Soós Zsoltot és"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Wagnerné dr. Strazicky Beátát, az Ybl Miklós Műszaki Főiskolán"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 1996. november 1-jei hatállyal – és"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Karácsony Jánost, a Jászberényi Tanítóképző Főiskolán"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "– meghívással 1996. november 1-jétől 1997. augusztus 31-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "főiskolai tanárrá"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
