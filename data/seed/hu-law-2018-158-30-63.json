{
  "id": "hu-law-2018-158-30-63",
  "type": "statute",
  "title": "158/2018. (XII. 27.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2018-12-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/2018-158-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az emberi erőforrások miniszterének a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Karsai Gábor Zsoltot az A Tan Kapuja Buddhista Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2019. február 15-étől 2023. február 14-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
