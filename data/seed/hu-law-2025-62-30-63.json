{
  "id": "hu-law-2025-62-30-63",
  "type": "statute",
  "title": "62/2025. (VII. 31.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2025-07-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2025-62-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – a kultúráért és innovációért felelős miniszternek a fenntartó kezdeményezésére tett javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Dolhai Lajost az Egri Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2025. augusztus 2-ától 2027. március 10-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
