{
  "id": "hu-law-2007-148-20-0n",
  "type": "statute",
  "title": "148/2007. (XII. 27.) KvVM rendelet a Hollókői Tájvédelmi Körzet védettségének fenntartásáról",
  "status": "in_force",
  "in_force_date": "2008-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-148-20-0N",
  "description": "a Hollókői Tájvédelmi Körzet védettségének fenntartásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § Az Országos Természetvédelmi Hivatal elnökének 2/1977. OTvH számú határozatával védetté nyilvánított Hollókői Tájvédelmi Körzet védettségét fenntartom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § A Hollókői Tájvédelmi Körzet kiterjedése 149,6 ha, ingatlan-nyilvántartási helyrajzi számait a 1. melléklet tartalmazza."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A védettség indoka és célja Hollókő község és környékének sajátos természeti, tájképi és kultúrtörténeti értékeinek megőrzése."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § A terület természetvédelmi kezeléséért felelős szerv a Bükki Nemzeti Park Igazgatóság."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5. §",
      "content": "5. § Ez a rendelet 2008. január 1-jén lép hatályba."
    },
    {
      "provision_ref": "s1mellklet",
