  "description": "rektori megbízásokról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszternek – a fenntartóval egyetértésben tett – előterjesztésére a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Debreceni Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Nagy János egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2004. július hó 1. napjától – 2007. június hó 30. napjáig terjedő időtartamra,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Budapesti Műszaki és Gazdaságtudományi Egyetemen"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Molnár Károly egyetemi tanárt"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2004. augusztus hó 1. napjától – 2008. július hó 31. napjáig terjedő időtartamra,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "az Evangélikus Hittudományi Egyetemen"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Szabó Lajos egyetemi tanár, rektort"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "– további – 2004. augusztus hó 1. napjától – 2006. július hó 31. napjáig terjedő időtartamra és"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "a Károli Gáspár Református Egyetemen"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "dr. Szűcs Ferenc egyetemi tanárt"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "2004. augusztus hó 1. napjától – 2008. július hó 31. napjáig terjedő időtartamra"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "A Debreceni Egyetemen dr. Imre László egyetemi tanárnak és a Budapesti Műszaki és Gazdaságtudományi Egyetemen dr. Detrekői Ákos egyetemi tanárnak, rektori megbízása lejártával eredményes munkájáért elismerésemet és köszönetemet fejezem ki."
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "KEH ügyszám: V-2/2395/2004."
    }
  ]
}
