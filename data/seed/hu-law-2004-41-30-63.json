    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Csorba Sándort, a Nyíregyházi Főiskola főiskolai tanárát 2004. november 30-i hatállyal,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Sámsondi Kiss Györgyöt, a Szent István Egyetem főiskolai tanárát 2004. szeptember 26-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 70. életévük betöltésére tekintettel –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "e tisztségükből"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "felmentem."
    }
  ]
