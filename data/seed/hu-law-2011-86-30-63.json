  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormánytisztviselők jogállásáról szóló 2010. évi LVIII. törvény 47. § (1) bekezdése alapján, a nemzeti fejlesztési miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Földi Enikőt és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Pálffy Ilona Évát"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Nemzeti Fejlesztési Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2011. szeptember 15-ei hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
