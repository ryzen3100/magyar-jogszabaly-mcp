{
  "id": "hu-law-2011-90-30-63",
  "type": "statute",
  "title": "90/2011. (X. 28.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2011-10-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-90-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormánytisztviselők jogállásáról szóló 2010. évi LVIII. törvény 51. §-a alapján, a nemzeti erőforrás miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Nyitrai Imrét, a Nemzeti Erőforrás Minisztérium helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2011. október 31-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
