      "section": "3",
      "title": "3",
      "content": "dr. Fekete György egyetemi tanárt és dr. Tompa Béla egyetemi tanárt 1991. június 30., valamint"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Kertészeti és Élelmiszeripari Egyetemről (Budapest)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
