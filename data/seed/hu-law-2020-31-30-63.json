      "content": "az Igazságügyi Minisztérium helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2020. április 30-ai hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
