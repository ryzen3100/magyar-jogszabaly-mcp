  "title": "31/2020. (IV. 29.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2020-04-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2020-31-30-63",
