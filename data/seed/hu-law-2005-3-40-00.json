  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2004. évi 199. számában megjelent 608077A törzskönyv száma helyesen: 658966B"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "A Magyar Közlöny 2004. évi 200. számában kihirdetett 5/2004. (XII. 25.) MeHVM rendelet bevezető része helyesen:"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "„..., valamint egyéb pénzbeli és természetbeni ellátásáról szóló,...”"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "(Nyomdatechnikai hiba)"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "A Magyar Közlöny 2004. évi 204/I/2. kötetében (16 545. oldal) megjelent APEH közlemény 1. sorszáma helyesen:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Sorszám Kedvezményezett Technikai szám)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "„1. a társadalmi bűnmegelőzés 1294”"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Nyomdahiba)"
    }
  ]
}
