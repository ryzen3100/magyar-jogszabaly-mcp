    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1998. évi 96. számában kihirdetett, a Magyar Köztársaság Kormánya és a Kazah Köztársaság Kormánya között Budapesten, 1996. október 7-én aláírt nemzetközi közúti személyszállításról és árufuvarozásról szóló Egyezmény kihirdetéséről rendelkező 173/1998. (X. 28.) Korm. rendelet"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 2. § 3. Cikk (2) bekezdésének 10. sorában helyesen menetrendet szó,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2. § 6. Cikk (6) bekezdésének 3. sorában helyesen az engedélyűrlapokat szó,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2. § utolsó mondatát követően helyesen a következő szövegrész szerepel:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Kovács Kálmán s. k.,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a Magyar Köztársaság Kormánya nevében"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "J. I. Lavrinyenko s. k.,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "a Kazah Köztársaság Kormánya nevében"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "JEGYZŐKÖNYV"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "a Magyar Köztársaság Kormánya és a Kazah Köztársaság Kormánya közötti nemzetközi közúti személyszállításról és árufuvarozásról szóló Egyezmény alkalmazásának szabályairól"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "A Magyar Köztársaság Kormánya és a Kazah Köztársaság Kormánya közötti nemzetközi közúti személyszállításról és árufuvarozásról Budapesten, 1996. év október hó 7. napján aláírt Egyezmény alkalmazására az alábbi megállapodás született:"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "1. Az említett Egyezmény értelmében az illetékes hatóság"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "a Magyar Köztársaság részéről:"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "a Magyar Köztársaság Közlekedési, Hírközlési és Vízügyi Minisztériuma"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "1077 Budapest, Dob u. 75–81."
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "Tel.: (36-1) 322-0220"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "Fax: (36-1) 322-3480"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "a Kazah Köztársaság részéről"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "a) a 3., 4., 5., 6., 10., 14., 15. Cikkek tekintetében:"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "a Kazah Köztársaság Közlekedési, Hírközlési és Vízügyi Minisztériuma"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "480083 Almati"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "Szejfullina sugárút 458."
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": "Tel.: 7 3272 60 40 40"
    },
    {
      "provision_ref": "s25",
      "section": "25",
