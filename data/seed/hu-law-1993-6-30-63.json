{
  "id": "hu-law-1993-6-30-63",
  "type": "statute",
  "title": "6/1993. (XII. 10.) ME határozat főiskolai tanár felmentéséről",
  "status": "amended",
  "in_force_date": "1993-12-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/1993-6-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (3) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kiscelli Lászlót, a Széchenyi István Főiskola főiskolai tanárát nyugállományba vonulása miatt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— 1994. június 30-i hatállyal — e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "A miniszterelnök helyett:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Dr. Boross Péter s. k., belügyminiszter"
    }
  ]
}
