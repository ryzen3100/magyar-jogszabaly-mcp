  "description": "határőr dandártábornok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére dr. Orodán Sándor határőr ezredest, a Belügyminisztérium Sajtó- és Kommunikációs Főigazgatóság főigazgatóját a „Határőrség Napja” alkalmából, a szakterülete vezetésében és irányításában végzett kimagasló tevékenysége elismeréseként 2005. június 27-i hatállyal"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "határőr dandártábornokká"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "KEH ügyszám: V-5/2123/2005."
    }
  ]
