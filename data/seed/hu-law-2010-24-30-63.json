{
  "id": "hu-law-2010-24-30-63",
  "type": "statute",
  "title": "24/2010. (III. 18.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2010-03-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-24-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) és b) pontjában foglalt jogkörömben – az oktatási és kulturális miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Angelus Ivánt a Budapest Kortárstánc Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2010. március 1-jétől 2015. február 28-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
