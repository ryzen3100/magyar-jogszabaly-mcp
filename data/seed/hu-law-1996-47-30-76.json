      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Leövey András egyetemi tanárt és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Székely György egyetemi tanárt"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 1996. december 26. napjával – e tisztsége alól"
