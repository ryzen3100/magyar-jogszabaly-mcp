  "status": "in_force",
  "in_force_date": "2022-12-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2022-115-30-63",
  "description": "főiskolai tanárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 27. § (3) bekezdésében foglalt jogkörömben eljárva – a kultúráért és innovációért felelős miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Illési Zsoltot és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Wintsche Gergely Balázst"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2023. január 1-jei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "főiskolai tanárrá kinevezem."
    }
  ]
}
