    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "özv. Szigethy Istvánné (Anda Erzsébet) csipkekészítő, varró népi iparművésznek,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Schmidt Sándor fafaragónak,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Sütő Levente Lehel festő-bútorasztalos, fafaragónak"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "a Népművészet Mestere díjat adományozza. 1 A határozatot az 1046/2015. (II. 11.) Korm. határozat 1. pontja visszavonta 2015. február 12. napjával. Alkalmazására lásd e visszavonó határozat 3. pontját."
    }
  ]
