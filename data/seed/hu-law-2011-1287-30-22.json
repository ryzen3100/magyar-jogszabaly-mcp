      "section": "2",
      "title": "2",
      "content": "özv. András Jánosné (András Elizabeta) népdalénekes, mesemondónak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Anyalai Sándor népzenész, prímásnak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Bodor Béla Péter és Bodor Erzsébet néptáncos párosnak (megosztva),"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Gadányi Pál dudás-dudakészítőnek,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Kovács József zenész, tanítónak,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Maneszes Józsefné (Tóth Mária) népdalénekesnek,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Párniczky Józsefné (Nunczás Ilona) hímző, népi iparművésznek,"
