  "title": "78/2026. (VIII. 13.) ME határozat helyettes államtitkárok felmentéséről",
  "status": "in_force",
  "in_force_date": "2026-08-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2026-78-30-63",
  "description": "helyettes államtitkárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján – a belügyminiszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Herczeg Mónikát és Kovácsné dr. Szekér Enikőt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Belügyminisztérium helyettes államtitkárait e tisztségükből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2026. augusztus 15-ei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
