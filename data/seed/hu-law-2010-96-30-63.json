    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2010. október 15-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
