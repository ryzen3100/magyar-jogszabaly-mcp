{
  "id": "hu-law-1993-8-30-76",
  "type": "statute",
  "title": "8/1993. (II. 15.) KE határozat miniszterek felmentéséről",
  "status": "amended",
  "in_force_date": "1993-02-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/1993-8-30-76",
  "description": "miniszterek felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 33. §-ának (4) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "érdemei elismerése mellett, saját kérésére:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kupa Mihály pénzügyminisztert"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e tisztségéből — 1993. február 11-i hatállyal —,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Horváth Balázs tárca nélküli minisztert,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Keresztes K. Sándor környezetvédelmi és területfejlesztési minisztert;"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "érdemei elismerése mellett:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Andrásfalvy Bertalan művelődési és közoktatási minisztert,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Gergátz Elemér földművelésügyi minisztert,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Siklós Csaba közlekedési, hírközlési és vízügyi minisztert"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "e tisztségükből — 1993. február 22-i hatállyal — felmentem."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Dr. Antall József s. k., miniszterelnök"
    }
  ]
}
