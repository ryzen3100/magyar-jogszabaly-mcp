{
  "id": "hu-law-2007-142-20-0n",
  "type": "statute",
  "title": "142/2007. (XII. 27.) KvVM rendelet a Szatmár-beregi Tájvédelmi Körzet védettségének fenntartásáról",
  "status": "in_force",
  "in_force_date": "2008-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-142-20-0N",
  "description": "a Szatmár-beregi Tájvédelmi Körzet védettségének fenntartásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § Az Országos Környezet- és Természetvédelmi Hivatal elnökének 4/1982. (XI. 20.) OKTH rendelkezésével védetté nyilvánított Szatmár-beregi Tájvédelmi Körzet védettségét fenntartom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § A Szatmár-beregi Tájvédelmi Körzet kiterjedése 21891,7 ha, ingatlan-nyilvántartási helyrajzi számait az 1. számú melléklet, fokozottan védett területének ingatlan-nyilvántartási helyrajzi számait a 2. számú melléklet tartalmazza."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A védettség indoka és célja a területen található természetes növénytársulások (az egykori nagy kiterjedésű, mocsár- és lápfoltokkal átszőtt erdőtakaró maradványai, a tőzegmohás- és égerlápok) megőrzése, az ezekhez kapcsolódó életközösségek, a Szatmári- és a Beregi-síkra jellemző tájképi adottságok, a táj jellegét meghatározó formakincs, vízfolyások, állóvizek, gyepek, fáslegelők és fasorok rendszerének, a tájszerkezetnek a megóvása."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § A terület természetvédelmi kezeléséért felelős szerv a Hortobágyi Nemzeti Park Igazgatóság."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5. §",
      "content": "5. § Ez a rendelet 2008. január 1-jén lép hatályba."
    },
