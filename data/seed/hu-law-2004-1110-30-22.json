{
  "id": "hu-law-2004-1110-30-22",
  "type": "statute",
  "title": "1110/2004. (X. 27.) Korm. határozat a Nemzeti Erdőprogramról, 2006–2015.",
  "status": "in_force",
  "in_force_date": "2004-10-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-1110-30-22",
  "description": "a Nemzeti Erdőprogramról, 2006–2015.",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "1. A Kormány elfogadja a Nemzeti Erdőprogram 2006–2015. évi megvalósításának tervét, amelyet az alábbi célprogramok szerint kell végrehajtani:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. Állami erdőgazdálkodás fejlesztése"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2. Magán-erdőgazdálkodás fejlesztése"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "3. Vidék- és területfejlesztés, erdőtelepítés, erdőszerkezet-átalakítás"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "4. Természetvédelem az erdőkben"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "5. Modern erdővédelem"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "6. A fenntartható vadgazdálkodás"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "7. Racionális fahasznosítás"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "8. Az erdészeti igazgatás"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "9. Kutatás, oktatás és termelésfejlesztés"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "10. Az ember és az erdő viszonyának javítása érdekében hatékony kommunikáció az erdőről."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "2. A Kormány felhívja"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "a) a földművelésügyi és vidékfejlesztési minisztert, hogy évente – az érintett miniszterekkel egyetértve – dolgozza ki a Nemzeti Erdőprogram megvalósításának éves tervét és annak költségeit az érintett tárcák éves költségvetési előirányzatában tervezzék be;"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Felelős: földművelésügyi és vidékfejlesztési miniszter, érintett miniszterek"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "Határidő: első alkalommal a 2006. évi költségvetés tervezésekor"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "b) a pénzügyminisztert, hogy a költségvetési törvény tervezeteinek előkészítése során vegye figyelembe az a) pontban foglaltakat."
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "Felelős: pénzügyminiszter"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "Határidő: első alkalommal a 2006. évi költségvetés tervezésekor"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "3. A Nemzeti Erdőprogram 2006–2015. évi megvalósításának terve a Földművelésügyi és Vidékfejlesztési Értesítőben, valamint a Földművelésügyi és Vidékfejlesztési Minisztérium honlapján kerül közzétételre."
    }
  ]
}
