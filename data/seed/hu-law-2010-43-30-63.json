  "title": "43/2010. (VI. 10.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2010-06-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-43-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 58/R. § (1) bekezdése alapján, az illetékes miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Virág Rudolfot"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Közigazgatási és Igazságügyi Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2010. június 10-ei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    }
  ]
}
