{
  "id": "hu-law-2006-214-30-76",
  "type": "statute",
  "title": "214/2006. (XI. 3.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2006-11-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-214-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére, a szolgálat terén végzett kiemelkedő színvonalú szakmai munkájáért"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Fenyvesi Lajos ezredesnek, az MK Nemzetbiztonsági Szakszolgálat igazgatójának a"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND TISZTIKERESZTJE"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(katonai tagozata);"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Tündik Sándor ezredesnek, az MK Nemzetbiztonsági Szakszolgálat TÜK felügyelőjének a"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND LOVAGKERESZTJE"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(katonai tagozata)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "KEH ügyszám: VII-2/4607-1/2006."
    }
  ]
}
