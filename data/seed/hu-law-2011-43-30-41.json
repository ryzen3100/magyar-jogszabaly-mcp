  "description": "az Alkotmánybíróság öt tagjának megválasztásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Országgyűlés az Alkotmány 32/A. § (5) bekezdésében és a Magyar Köztársaság Alkotmányáról szóló 1949. évi XX. törvénynek az Alaptörvénnyel összefüggő egyes átmeneti rendelkezések megalkotása érdekében szükséges módosításáról szóló 2011. évi LXI. törvény 5. §-ában foglaltak alapján:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Dienes-Oehm Egont,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Balsai Istvánt,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Pokol Bélát,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Szalay Pétert és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Szívós Máriát"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2011. szeptember 1-jei hatállyal az Alkotmánybíróság tagjává"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "megválasztja. 1 A határozatot az Országgyűlés a 2011. június 27-i ülésnapján fogadta el."
    }
  ]
}
