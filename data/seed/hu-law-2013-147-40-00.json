    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "A Magyar Közlöny 2013. szeptember 5-én megjelent 145. számának 66536. oldalán a 331/2013. (IX. 5.) Korm. rendelet 1. mellékletében a minimális pályázati ajánlati ár kiszámításának képlete helyesen a következő:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "„"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MPÁ = ((ST*s1)+(((AE/(1+DR)0)+(AE*(1+PV)/(1+DR))+ (AE*(1+PV)2/((1+DR)2))+ (AE*(1+PV)3/((1+DR)3))+ (AE*(1+PV)4/((1+DR)4))+ (AE*(1+PV)5/((1+DR)5)))*s2))*PÜ"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "”"
    }
  ]
