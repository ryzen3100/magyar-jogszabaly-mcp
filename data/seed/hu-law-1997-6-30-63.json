{
  "id": "hu-law-1997-6-30-63",
  "type": "statute",
  "title": "6/1997. (II. 13.) ME határozat főiskolai tanárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "1997-02-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-6-30-63",
  "description": "főiskolai tanárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1)–(2) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kászonyi Lászlót, a Berzsenyi Dániel Tanárképző Főiskolán,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 1997. február 1-jei hatállyal –,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Krasznayné dr. Mankó Máriát, a Berzsenyi Dániel Tanárképző Főiskolán"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 1997. február 1-jei hatállyal, meghívással, hat hónapi időtartamra –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "főiskolai tanárrá"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
