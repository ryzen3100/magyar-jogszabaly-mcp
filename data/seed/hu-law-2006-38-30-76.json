{
  "id": "hu-law-2006-38-30-76",
  "type": "statute",
  "title": "38/2006. (III. 23.) KE határozat egyetemi tanár felmentéséről",
  "status": "in_force",
  "in_force_date": "2006-03-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-38-30-76",
  "description": "egyetemi tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére, az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, tekintettel a felsőoktatásról szóló 1993. évi LXXX. törvény 17. § (6)–(7) bekezdéseire,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Eötvös Loránd Tudományegyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Domokos Péter egyetemi tanárt 2006. január hó 15. napjával"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-2/0625/2006."
    }
  ]
}
