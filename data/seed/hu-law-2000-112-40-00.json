  "title": "2000. MK 112. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2000-11-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-112-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2000. évi 106. számában kihirdetett, a MÁV Rt. működési feltételeinek biztosításához szükséges állami kötelezettségvállalásról szóló 1086/2000. (X. 30.) Korm. határozat"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 1/b. pontjában a határidő helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,Határidő: 2000. december 31.''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 3. pontjának negyedik sorában a hivatkozott pont száma helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,… 2. b) pontban…''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(Kézirathiba)"
    }
  ]
}
