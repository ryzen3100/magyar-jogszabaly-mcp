{
  "id": "hu-law-2012-215-30-76",
  "type": "statute",
  "title": "215/2012. (VIII. 22.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2012-08-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-215-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés f) pontja, továbbá a Magyarország címerének és zászlajának használatáról, valamint állami kitüntetéseiről szóló 2011. évi CCII. törvény 18. § (1) bekezdése alapján – a miniszterelnök előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "több mint két évtizedes lelkiismeretes oktató-nevelői munkája, eredményes vezetői tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Kis Mihály, az Újbudai Grosics Gyula Sport Általános Iskola igazgatója részére a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "polgári tagozata"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "KEH ügyszám: VIII-1/04610/2012."
    }
  ]
}
