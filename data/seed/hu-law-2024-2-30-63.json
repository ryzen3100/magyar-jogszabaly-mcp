{
  "id": "hu-law-2024-2-30-63",
  "type": "statute",
  "title": "2/2024. (I. 18.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2024-01-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/2024-2-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján – az építési és közlekedési miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Kikina Artúrt, az Építési és Közlekedési Minisztérium helyettes államtitkárát e tisztségéből – más fontos megbízatására tekintettel –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2024. január 18-ai hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
