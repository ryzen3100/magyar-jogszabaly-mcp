{
  "id": "hu-law-1997-16-30-63",
  "type": "statute",
  "title": "16/1997. (VI. 5.) ME határozat főiskolai főigazgató megbízásáról",
  "status": "amended",
  "in_force_date": "1997-06-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-16-30-63",
  "description": "főiskolai főigazgató megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 73. §-ának b) pontja alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Molnár István főiskolai tanárt a Kereskedelmi és Gazdasági Főiskolán a főigazgatói teendők ellátásával"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1997. június 1-jei hatállyal – négyévi időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "ismételten megbízom."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
