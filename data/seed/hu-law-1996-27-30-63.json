{
  "id": "hu-law-1996-27-30-63",
  "type": "statute",
  "title": "27/1996. (VII. 12.) ME határozat a Magyar Ösztöndíj Bizottság elnökének és tagjainak megbízásáról",
  "status": "amended",
  "in_force_date": "1996-07-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-27-30-63",
  "description": "a Magyar Ösztöndíj Bizottság elnökének és tagjainak megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Magyar Ösztöndíj Bizottságról szóló 151/1991. (XII. 4.) Korm. rendelet 3. §-ának (1) bekezdése alapján a művelődési és közoktatási miniszter javaslatára – 1996. július 1-jei hatállyal, kétéves időtartamra – megbízom"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "T. Sós Vera akadémikust, egyetemi tanárt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Magyar Ösztöndíj Bizottság elnöki teendőinek ellátásával,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Bácskai Verát a történettudományok doktorát, egyetemi tanárt,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Bak Imre festőművészt, egyetemi tanárt,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Bor Zsolt kutatóprofesszort, akadémikust,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Csákó Mihály szociológust, kandidátust,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Hámori József akadémikust, egyetemi tanárt,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Jordán Tamás színművészt, színházigazgatót,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Radnóti Sándor esztétát, kritikust, egyetemi tanárt,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Székely Csabát, a mezőgazdasági tudományok doktorát, egyetemi tanárt,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Vörös Józsefet, a közgazdaságtudományok doktorát, egyetemi tanárt"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "a Magyar Ösztöndíj Bizottság tagsági teendőinek ellátásával."
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Budapest, 1996. június 28."
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
