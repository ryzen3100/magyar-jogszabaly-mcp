{
  "id": "hu-law-2011-53-30-63",
  "type": "statute",
  "title": "53/2011. (VII. 7.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2011-07-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-53-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) pontjában foglalt jogkörömben – a nemzeti erőforrás miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Enghy Sándor egyetemi tanárt a Sárospataki Református Teológiai Akadémián"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2011. július 1-jétől 2014. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
