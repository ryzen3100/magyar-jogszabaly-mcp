{
  "id": "hu-law-1994-42-30-63",
  "type": "statute",
  "title": "42/1994. (XI. 15.) ME határozat főiskolai tanár felmentéséről",
  "status": "amended",
  "in_force_date": "1994-11-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-42-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (3) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Gara Miklóst, a Könnyűipari Műszaki Főiskola főiskolai tanárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1995. június 30-i hatállyal — nyugállományba vonulására tekintettel — e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
