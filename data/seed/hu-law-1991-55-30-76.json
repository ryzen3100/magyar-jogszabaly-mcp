  "title": "A Köztársaság Elnökének 55/1991. (III. 12.) KE határozata kitüntetéses doktorrá avatásról",
  "status": "amended",
  "in_force_date": "1991-03-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/1991-55-30-76",
  "description": "kitüntetéses doktorrá avatásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A művelődési és közoktatási miniszter előterjesztésére hozzájárulok ahhoz, hogy Murányi Szilvia gyógyszerészt a Semmelweis Orvostudományi Egyetemen Sub auspiciis praesidis Rei Publicae kitüntetéses doktorrá avassák."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Göncz Árpád s. k.,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Köztársaság elnöke"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Dr. Andrásfalvy Bertalan s. k.,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "művelődési és közoktatási miniszter"
    }
  ]
}
