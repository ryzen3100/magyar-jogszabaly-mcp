{
  "id": "hu-law-2023-1375-30-22",
  "type": "statute",
  "title": "1375/2023. (VIII. 22.) Korm. határozat a Népművészet Mestere díj 2023. évi adományozásáról",
  "status": "in_force",
  "in_force_date": "2023-08-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2023-1375-30-22",
  "description": "a Népművészet Mestere díj 2023. évi adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Magyarország Kormánya 2023-ban"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Árvai Sándor lénárddaróci énekes-táncosnak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Csóti Andrásné öregcsertői hagyományőrző énekes-táncosnak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Fehér Tibor mezőkövesdi fazekasnak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horváth Tibor tolnai kékfestőnek,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Kiss Bertalanné rimóci viseletkészítőnek,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Kocák Andrásné Mihók Jolán magyarbődi népdalénekesnek,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Murguly Lajos nagyecsedi hagyományőrző táncosnak,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Pados Zoltán bejcgyertyánosi kosárfonónak,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Papp Samu visai hagyományőrző táncosnak,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Péter Lajos lajosmizsei szíjgyártó és nyeregkészítőnek"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "a Népművészet Mestere díjat adományozza."
    }
  ]
}
