{
  "id": "hu-law-1995-6-30-63",
  "type": "statute",
  "title": "6/1995. (II. 24.) ME határozat főiskolai tanár kinevezéséről",
  "status": "amended",
  "in_force_date": "1995-02-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-6-30-63",
  "description": "főiskolai tanár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1)—(2) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Földi Pétert, az egri Eszterházy Károly Tanárképző Főiskolára"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "főiskolai tanárrá — 1995. március 1-jei hatállyal — kinevezem."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
