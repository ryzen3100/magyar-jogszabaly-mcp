  "title": "106/2011. (V. 26.) KE határozat egyetemi tanári kinevezésről",
  "status": "in_force",
  "in_force_date": "2011-05-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-106-30-76",
  "description": "egyetemi tanári kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. CXXXIX. törvény 100. §-ának b) pontja alapján, a nemzeti erőforrás miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Bencsik Andreát, a Széchenyi István Egyetem egyetemi docensét és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Stephan Kirste-t, az Andrássy Gyula Budapesti Német Nyelvű Egyetem egyetemi docensét"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2011. május 20. napjával kinevezem egyetemi tanárrá."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: IV-3/02112/2011."
    }
  ]
