  "status": "in_force",
  "in_force_date": "2015-06-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/2015-47-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
