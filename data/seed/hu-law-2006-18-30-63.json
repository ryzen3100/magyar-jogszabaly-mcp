{
  "id": "hu-law-2006-18-30-63",
  "type": "statute",
  "title": "18/2006. (II. 28.) ME határozat főiskolai tanár felmentéséről",
  "status": "in_force",
  "in_force_date": "2006-02-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-18-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 73. § a) pontja alapján, az oktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Mesterházi Zsuzsannát, az Eötvös Loránd Tudományegyetem főiskolai tanárát 2006. január 17-ei hatállyal"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e tisztségéből felmentem."
    }
  ]
}
