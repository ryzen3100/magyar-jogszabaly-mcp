{
  "id": "hu-law-2008-64-30-63",
  "type": "statute",
  "title": "64/2008. (IX. 11.) ME határozat főiskolai tanár kinevezéséről és főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2008-09-11",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-64-30-63",
  "description": "főiskolai tanár kinevezéséről és főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) és b) pontjában foglalt jogkörömben – az oktatási és kulturális miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Borbély Attilát – 2008. október 1-jei hatállyal –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "főiskolai tanárrá kinevezem, és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Wekerle Sándor Üzleti Főiskolán"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– a 2008. október 1-jétől 2009. szeptember 30-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
