{
  "id": "hu-law-2024-125-30-63",
  "type": "statute",
  "title": "125/2024. (XII. 23.) ME határozat helyettes államtitkárok megbízatása megszűnésének megállapításáról",
  "status": "in_force",
  "in_force_date": "2024-12-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/2024-125-30-63",
  "description": "helyettes államtitkárok megbízatása megszűnésének megállapításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 236. § (1) bekezdésében foglalt jogkörömben eljárva – a pénzügyminiszter előterjesztésére – megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Ambrus Ilonának,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Jármai Péter Zoltánnak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Marczinkó Zoltán Istvánnak, valamint"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Szőcs Gábornak"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Pénzügyminisztérium helyettes államtitkárainak e megbízatása a kormányzati igazgatásról szóló 2018. évi CXXV. törvény 239. § (1) bekezdése alapján történt lemondásukra tekintettel"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– 2024. december 31-ei hatállyal –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "megszűnik."
    }
  ]
}
