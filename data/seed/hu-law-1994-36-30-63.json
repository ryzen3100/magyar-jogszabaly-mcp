  "title": "36/1994. (IX. 29.) ME határozat az Állami Bankfelügyelet elnökhelyettesének kinevezéséről",
  "status": "amended",
  "in_force_date": "1994-09-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-36-30-63",
  "description": "az Állami Bankfelügyelet elnökhelyettesének kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
