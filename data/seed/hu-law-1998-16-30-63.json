    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1998. június 1-jei hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megerősítem."
    },
    {
      "provision_ref": "s5",
