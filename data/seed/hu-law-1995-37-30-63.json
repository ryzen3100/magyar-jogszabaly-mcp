{
  "id": "hu-law-1995-37-30-63",
  "type": "statute",
  "title": "37/1995. (XI. 9.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1995-11-09",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-37-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Szűts Tivadart, a Kereskedelmi, Vendéglátóipari és Idegenforgalmi Főiskola főiskolai tanárát 1995. szeptember 1-jei hatállyal"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— közalkalmazotti jogviszonyáról való lemondására tekintettel —"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
