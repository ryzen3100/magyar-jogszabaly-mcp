{
  "id": "hu-law-2012-231-30-76",
  "type": "statute",
  "title": "231/2012. (IX. 20.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2012-09-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-231-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés f) pontja, továbbá a Magyarország címerének és zászlajának használatáról, valamint állami kitüntetéseiről szóló 2011. évi CCII. törvény 18. § (1) bekezdése alapján – a miniszterelnök előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a XIV. Paralimpiai Játékokon szerepelt sportolók felkészítésében végzett munkájáért"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Petrov Anatolij úszóedző részére a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR ÉRDEMREND KÖZÉPKERESZTJE polgári tagozata;"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Aranyosi Péter asztalitenisz-edző,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Gömöri Zsolt, a Magyar Paralimpiai Bizottság elnöke, sportigazgató és"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Kovács Iván, a kerekesszékesvívó-válogatott szövetségi kapitánya részére a"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "MAGYAR ÉRDEMREND TISZTIKERESZTJE polgári tagozata;"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Feczer Viktor vívóedző és"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Magyarovits Zoltán úszóedző részére a"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "MAGYAR ÉRDEMREND LOVAGKERESZTJE polgári tagozata;"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Antal Andor atlétikaedző,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Kovács Brigitta, a Magyar Paralimpiai Bizottság gazdasági vezetője, csapatvezető-helyettes,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "László Dezső vívóedző,"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "dr. Sós Csaba, a paralimpiai úszóválogatott szövetségi kapitánya részére és"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "Szeleiné Tóth Ildikó, a magyar paralimpiai csapat vezetője részére a"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "MAGYAR ARANY ÉRDEMKERESZT polgári tagozata"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "KEH ügyszám: VIII-1/05383/2012."
    }
  ]
}
