  "title": "92/2024. (VIII. 29.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2024-08-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2024-92-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján – az agrárminiszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kőrösmezei Csaba Györgyöt, az Agrárminisztérium helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2024. augusztus 31-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
