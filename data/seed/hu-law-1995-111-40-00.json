      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1995. évi 103. számában megjelent, főiskolai tanárok kinevezéséről szóló 45/1995. (XI. 30.) ME határozat helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,…dr. Berek Lajost, a Bolyai János Katonai Műszaki Főiskolára,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Pintér Istvánt, a Szolnoki Repülőtiszti Főiskolára…''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(Kézirathiba)"
    }
  ]
}
