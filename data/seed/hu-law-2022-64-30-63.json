  "title": "64/2022. (VIII. 5.) ME határozat helyettes államtitkárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2022-08-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2022-64-30-63",
  "description": "helyettes államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 234. § (1) bekezdése alapján – az építési és beruházási miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Bartal Tamás Lajost,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Határ Renátát,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Horváth Jánost,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Perényi Lóránt Lászlót és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Vukoszávlyev Zoránt"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "az Építési és Beruházási Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 2022. augusztus 5-ei hatállyal –"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kinevezem. 1 A 120/2022. (XII. 23.) ME határozat alapján dr. Bartal Tamás Lajos, Határ Renáta, Perényi Lóránt László és dr. Vukoszávlyev Zorán tekintetében akként módosul, hogy az „Építési és Beruházási Minisztérium” megnevezés helyett az „Építési és Közlekedési Minisztérium” megnevezést kell érteni."
    }
  ]
}
