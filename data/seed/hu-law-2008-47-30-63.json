{
  "id": "hu-law-2008-47-30-63",
  "type": "statute",
  "title": "47/2008. (VI. 20.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2008-06-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-47-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) pontjában foglalt jogkörömben – az oktatási és kulturális miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Veszprémi Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Varga István főiskolai tanárt – a 2008. június 18-tól 2013. június 17-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
