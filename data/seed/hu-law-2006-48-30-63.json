{
  "id": "hu-law-2006-48-30-63",
  "type": "statute",
  "title": "48/2006. (VIII. 1.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2006-08-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-48-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) pontjában foglalt jogkörömben – az oktatási és kulturális miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Magyar Táncművészeti Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "ifj. Nagy Zoltán főiskolai tanárt – 2006. augusztus 1-jétől 2009. július 31-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
