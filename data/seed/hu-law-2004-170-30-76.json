{
  "id": "hu-law-2004-170-30-76",
  "type": "statute",
  "title": "170/2004. (XII. 16.) KE határozat egyetemi tanári kinevezésekről",
  "status": "in_force",
  "in_force_date": "2004-12-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-170-30-76",
  "description": "egyetemi tanári kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "2005. január 1. napjával"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Bakonyi Istvánt, a Széchenyi István Egyetem egyetemi docensét,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Illés Bálint Csabát, a Szent István Egyetem egyetemi docensét,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Makai Sándort, a Nyugat-Magyarországi Egyetem egyetemi docensét,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Miszlivetz Ferencet, a Berzsenyi Dániel Főiskola főiskolai tanárát,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Tasnádi Pétert, az Eötvös Loránd Tudományegyetem egyetemi docensét és"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Tompa Annát, a Fodor József Országos Közegészségügyi Központ igazgató főorvosát"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kinevezem egyetemi tanárrá."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "KEH ügyszám: V-2/4795/2004."
    }
  ]
}
