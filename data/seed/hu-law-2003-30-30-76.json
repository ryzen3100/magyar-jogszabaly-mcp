{
  "id": "hu-law-2003-30-30-76",
  "type": "statute",
  "title": "30/2003. (III. 4.) KE határozat miniszter felmentéséről",
  "status": "in_force",
  "in_force_date": "2003-03-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-30-30-76",
  "description": "miniszter felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Magyar Köztársaság Alkotmányáról szóló 1949. évi XX. törvény 33. §-ának (4) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Kiss Péter foglalkoztatáspolitikai és munkaügyi minisztert"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– más fontos megbízatása miatt –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2003. március 2-i hatállyal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "felmentem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "KEH ügyszám: V-1/0799-0/2003."
    }
  ]
}
