    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2024. június 16-ai hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "az Agrárminisztérium helyettes államtitkárává"
    },
    {
