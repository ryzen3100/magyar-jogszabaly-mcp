  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló – többször módosított – 1993. évi LXXX. törvény 73. § a) pontja alapján, az oktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Farkas Györgyöt, a Széchenyi István Egyetem Főiskolai tanárát – 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2003. november 6-i hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e tisztségéből felmentem."
    }
  ]
}
