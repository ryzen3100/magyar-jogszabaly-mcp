{
  "id": "hu-law-2005-89-30-76",
  "type": "statute",
  "title": "89/2005. (VI. 29.) KE határozat Somoskőújfalu községgé nyilvánításáról",
  "status": "amended",
  "in_force_date": "2006-10-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-89-30-76",
  "description": "Somoskőújfalu községgé nyilvánításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Salgótarján megyei jogú város Somoskőújfalu elnevezésű településrészét a korábbi egyesítés megszüntetésével Somoskőújfalu néven községgé nyilvánítom. Somoskőújfalu községgé nyilvánítása nem érinti Salgótarján város városi címét."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Ez a határozat a kihirdetését követő önkormányzati általános választás napján lép hatályba."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Budapest, 2005. június 27."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Mádl Ferenc s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Dr. Lamperth Mónika s. k., belügyminiszter"
    },
    {
      "provision_ref": "s7",
      "section": "7",
