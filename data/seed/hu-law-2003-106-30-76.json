  "title": "106/2003. (VI. 26.) KE határozat határőr dandártábornok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2003-06-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-106-30-76",
  "description": "határőr dandártábornok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére Rolyák József hőr. ezredest, a Miskolci Határőr Igazgatóság igazgatóját, a Határőrség Napja alkalmából, a szakmai és vezetői munka terén kifejtett eredményes tevékenysége elismeréseként 2003. június 27-i hatállyal"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,határőr dandártábornokká''"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "KEH ügyszám: V-5/2274/2003."
    }
  ]
}
