  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a külügyminiszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Paulette Normand, a Magyar Köztársaság Európai Unió mellett működő Állandó Képviselete titkárnője részére a"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(polgári tagozat)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kitüntetést"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "adományozom."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "KEH ügyszám: VIII-1/06522/2011."
    }
  ]
