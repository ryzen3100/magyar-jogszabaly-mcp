  "title": "A Köztársaság Elnökének 21/1991. (I. 21.) KE határozata Kovács István főkonzuli kinevezéséről",
  "status": "amended",
  "in_force_date": "1991-01-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/1991-21-30-76",
  "description": "Kovács István főkonzuli kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A külügyminiszter előterjesztésére Kovács Istvánt kinevezem főkonzullá és megbízom a San Marino Köztársaság területére kiterjedő hatáskörrel a főkonzuli teendők ellátásával."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Göncz Árpád s. k.,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Köztársaság elnöke"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Dr. Jeszenszky Géza s. k.,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "külügyminiszter"
    }
  ]
}
