    },
    {
      "provision_ref": "s35",
      "section": "35",
      "title": "35",
      "content": "6. Meg kell vizsgálni az életvitelt segítő eszközök regionális szinten történő kölcsönzési rendszere kialakításának lehetőségeit."
    },
    {
      "provision_ref": "s36",
      "section": "36",
      "title": "36",
      "content": "Felelős: nemzeti erőforrás miniszter"
    },
    {
      "provision_ref": "s37",
      "section": "37",
      "title": "37",
      "content": "Határidő: 2013. december 31."
    },
    {
      "provision_ref": "s38",
      "section": "38",
