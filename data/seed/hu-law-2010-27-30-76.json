{
  "id": "hu-law-2010-27-30-76",
  "type": "statute",
  "title": "27/2010. (III. 15.) KE határozat kitüntetés adományozásáról",
  "status": "amended",
  "in_force_date": "2010-03-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-27-30-76",
  "description": "Kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a honvédelmi miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Gachályi Andrásnak, a Magyar Honvédség dr. Radó György Honvéd Egészségügyi Központ Tudományos Intézet Toxikológiai Kutató Osztálya vezetőjének,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Kovács Gábornak, a Honvédelmi Minisztérium Honvéd Kulturális Szolgáltató Kht. katonai rendezvényszervező igazgató-helyettesének a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "(polgári tagozat)"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Kiss Imre ezredesnek, a Magyar Köztársaság Katonai Biztonsági Hivatal Belbiztonsági Főosztálya vezetőjének,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Kókay András mérnök ezredesnek, a Honvédelmi Minisztérium Állami Egészségügyi Központ Főigazgatóság gazdasági igazgatójának,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Vida László Árpád mérnök ezredesnek, a Honvédelmi Minisztérium Fejlesztési és Logisztikai Ügynökség Anyag-technikai és Közlekedési Igazgatóság igazgatójának a"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "(katonai tagozat)"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Gyenes Tamásnak, a Magyar Honvédség 43. Nagysándor József Híradó és Vezetéstámogató Ezrede Logisztikai Zászlóalj, Ellátó és szállító század, ellátó szakasz, élelmezés ellátó raj 2. étkezde vezetőjének a"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "MAGYAR KÖZTÁRSASÁGI BRONZ ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "(polgári tagozat)"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "kitüntetést"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "adományozom."
    },
    {
      "provision_ref": "s18",
