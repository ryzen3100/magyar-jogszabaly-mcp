    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Jenőfi Márkot,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Juhász Mariannt és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Litauszki Tibort"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a 2023. május 1. napjától 2026. április 30. napjáig terjedő időtartamra bíróvá kinevezem."
    },
    {
