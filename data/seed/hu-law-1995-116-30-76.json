{
  "id": "hu-law-1995-116-30-76",
  "type": "statute",
  "title": "116/1995. (VII. 13.) KE határozat egyetemi tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1995-07-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-116-30-76",
  "description": "egyetemi tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 17. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Liszt Ferenc Zeneművészeti Főiskoláról — nyugállományba vonulására tekintettel —"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Balassa Sándor egyetemi tanárt és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Rados Ferenc egyetemi tanárt 1995. december 30. napjával,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Varasdy Emília egyetemi tanárt 1996. február 28. napjával;"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Janus Pannonius Tudományegyetemről — hetvenedik életéve betöltésére tekintettel — dr. Benedek Ferenc egyetemi tanárt 1996. február 1. napjával"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Dr. Fodor Gábor s. k., művelődési és közoktatási miniszter"
    }
  ]
}
