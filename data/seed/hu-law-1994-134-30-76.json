{
  "id": "hu-law-1994-134-30-76",
  "type": "statute",
  "title": "134/1994. (VIII. 19.) KE határozat vezérőrnagyi kinevezésekről",
  "status": "amended",
  "in_force_date": "1994-08-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-134-30-76",
  "description": "vezérőrnagyi kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A honvédelmi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "állami ünnepünk, augusztus 20-a alkalmából"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Farkas Tivadar mk. ezredest, a Bólyai János Katonai Műszaki Főiskola parancsnokát,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Gillicz János ezredest, a Magyar Honvédség személyügyi főnökét,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Nagy Béla ezredest, a Szárazföldi Csapatok törzsfőnökét,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Nagy János ezredest, a Magyar Honvédség gépesített lövész- és harckocsizó szemlélőjét,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Pick Róbert ezredest, címzetes államtitkárt, a Köztársasági Elnök Katonai Irodája irodavezetőjét, főhadsegédet,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Stefán Géza ezredest, a Katonai Biztonsági Hivatal vezetőjét,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Rába Imre ezredest, a Szárazföldi Csapatok anyagi-technikai főnökét (parancsnok anyagi-technikai helyettes)"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "vezérőrnaggyá"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Keleti György s. k., honvédelmi miniszter"
    }
  ]
}
