  "title": "15/1998. (VI. 10.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1998-06-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/1998-15-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1)–(3) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "nyugállományba vonulásukra tekintettel"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Pálhegyi Ferencet, a Bárczi Gusztáv Gyógypedagógiai Tanárképző Főiskola főiskolai tanárát"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "1998. szeptember 1-jei hatállyal,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Hartai Jánost, a Miskolci Egyetem Dunaújvárosi Főiskolai Kar főiskolai tanárát"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "1998. december 22-i hatállyal,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Papp Pétert, a Kossuth Lajos Tudományegyetem Műszaki Főiskolai Kar főiskolai tanárát"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "1999. január 1-jei hatállyal,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "közalkalmazotti jogviszonyának megszűnésére tekintettel"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "dr. Varga Lajost, a Gödöllői Agrártudományi Egyetem Mezőgazdasági Főiskolai Kar főiskolai tanárát"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "1998. december 30-i hatállyal"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "főiskolai tanári tisztségéből felmentem."
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
