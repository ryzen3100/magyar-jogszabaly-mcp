  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a külügyminiszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a magyar–lengyel kapcsolatok ápolása és fejlesztése érdekében végzett tevékenységük elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Maciej Syrek szobrászművésznek,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Malgorzata Mazurnak, a Varsói Ingatlankezelő igazgatójának,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Marek Moderau szobrászművésznek,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Zofia Cakala-nak, a Varsói Ingatlankezelő műszaki igazgatójának a"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "KEH ügyszám: VIII-1/01262/2009."
    }
  ]
