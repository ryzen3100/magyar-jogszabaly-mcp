{
  "id": "hu-law-2003-70-30-76",
  "type": "statute",
  "title": "70/2003. (IV. 25.) KE határozat címzetes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2003-04-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-70-30-76",
  "description": "címzetes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 31/A. § (2) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Gulyás Kálmánt, a Nemzeti Kulturális Örökség Minisztérium címzetes államtitkárává"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2003. április 22-i hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: V-1/1525/2003. 1 A 153/2004. (XI. 2.) KE határozattal megállapított szöveg."
    }
  ]
}
