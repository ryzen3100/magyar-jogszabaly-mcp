{
  "id": "hu-law-2011-126-30-76",
  "type": "statute",
  "title": "126/2011. (VII. 5.) KE határozat egyetemi tanár rektori megbízásáról",
  "status": "in_force",
  "in_force_date": "2011-07-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-126-30-76",
  "description": "egyetemi tanár rektori megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának a) pontja alapján, a nemzeti erőforrás miniszter javaslatára a Pannon Egyetemen"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Friedler Ferenc egyetemi tanárt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2011. július 1-jétől 2015. június 30-áig terjedő időtartamra"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: IV-3/02807/2011."
    }
  ]
}
