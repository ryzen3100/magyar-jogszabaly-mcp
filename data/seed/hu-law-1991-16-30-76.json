{
  "id": "hu-law-1991-16-30-76",
  "type": "statute",
  "title": "A Köztársaság Elnökének 16/1991. (I. 21.) KE határozata dr. Németh József nagykövet felmentéséről",
  "status": "amended",
  "in_force_date": "1991-01-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/1991-16-30-76",
  "description": "dr. Németh József nagykövet felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A külügyminiszter előterjesztésére dr. Németh József rendkívüli és meghatalmazott nagykövetet — érdemei elismerése mellett — felmentem a Magyar Köztársaság luandai nagykövetségének vezetésére, valamint a Magyar Köztársaságnak a Kongói Népi Köztársaságban, a Sao Tome és Principe Demokratikus Köztársaságban való képviseletére kapott megbízása alól."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Részére a visszhívólevelet aláírással és pecséttel ellátva kiadom."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Budapest, 1990. július 11."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Göncz Árpád s. k.,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Köztársaság ideiglenes elnöke"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Dr. Jeszenszky Géza s. k.,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "külügyminiszter"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Budapest, 1990. július 16."
    }
  ]
}
