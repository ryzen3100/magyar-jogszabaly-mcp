  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Országgyűlés"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Alkotmány 32/B §-ának (4) bekezdése, az állampolgári jogok országgyűlési biztosáról szóló 1993. évi LIX. törvény 2. §-ának (1) és (2) bekezdése, valamint a nemzeti és etnikai kisebbségek jogairól szóló 1993. évi LXXVII. törvény 20. §-ának (2) bekezdése alapján"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Lenkovics Barnabást"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "az állampolgári jogok országgyűlési biztosának,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Takács Albertet"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "az állampolgári jogok országgyűlési biztosa általános helyettesének,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Kaltenbach Jenőt"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a nemzeti és etnikai kisebbségi jogok országgyűlési biztosának"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– 2001. július elsejétől, hat évre – megválasztja. 1 A határozatot az Országgyűlés a 2001. június 19-i ülésnapján fogadta el."
    }
  ]
}
