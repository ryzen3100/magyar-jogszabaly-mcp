{
  "id": "hu-law-2010-301-30-76",
  "type": "statute",
  "title": "301/2010. (XII. 11.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2010-12-11",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-301-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Köztársaság Elnökének Érdemérme és a Köztársaság Elnökének Díszoklevele Éremmel kitüntetések alapításáról szóló 223/2010. (IX. 2.) KE határozat 3. pontjában foglaltak alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "kiemelkedő szakmai munkája, eddigi katonai pályafutása, valamint az emberi erőforrás gazdálkodás terén kifejtett eredményes szakmai tevékenysége elismeréséül"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Bálint Sándor ezredesnek,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kiemelkedő szakmai munkája, eddigi katonai pályafutása elismeréséül"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Somkutas József ezredesnek,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Magyar Honvédség feladatainak megvalósítása érdekében huzamos időn át végzett kimagasló tevékenysége elismeréséül"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Binder Károlyné törzszászlósnak a"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "KÖZTÁRSASÁG ELNÖKÉNEK DÍSZOKLEVELE ÉREMMEL"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "KEH ügyszám: VIII-5/05461/2010."
    }
  ]
}
