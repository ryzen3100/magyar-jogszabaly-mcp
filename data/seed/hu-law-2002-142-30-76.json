{
  "id": "hu-law-2002-142-30-76",
  "type": "statute",
  "title": "142/2002. (IX. 13.) KE határozat egyetemi tanári tisztség alóli felmentésekről",
  "status": "in_force",
  "in_force_date": "2002-09-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2002-142-30-76",
  "description": "egyetemi tanári tisztség alóli felmentésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Budapesti Közgazdaságtudományi és Államigazgatási Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Gazsó Ferenc egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2002. augusztus hó 31. napjával,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Kovács Sándor egyetemi tanárt és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Szász Iván egyetemi tanárt"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2002. december hó 31. napjával"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 70. életéve betöltésére tekintettel –, és"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Szentes Tamás egyetemi tanárt"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "2002. augusztus hó 31. napjával"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "– közalkalmazotti jogviszony közös megegyezéssel történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "e tisztsége alól felmentem."
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "KEH ügyszám: V-2/3299/2002."
    }
  ]
}
