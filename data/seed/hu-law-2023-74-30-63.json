{
  "id": "hu-law-2023-74-30-63",
  "type": "statute",
  "title": "74/2023. (VIII. 30.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2023-08-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2023-74-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – a felsőoktatásért felelős miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Dolhai Lajos főiskolai tanárt az Egri Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2023. szeptember 1-jétől 2025. augusztus 1-jéig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
