  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján az önkormányzati miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Huszár Erika rövidpályás gyorskorcsolyázónak a"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT (polgári tagozat);"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Bánhidi Ákosnak, a Sportország SC edzőjének,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Belovai Józsefnek, a Szent István Egyetem Alkalmazott Bölcsészeti Kar Gyakorló Általános Iskola és Gimnázium igazgatóhelyettesének,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Darázs Rózsa rövidpályás gyorskorcsolyázónak,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Heidum Bernadett rövidpályás gyorskorcsolyázónak,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Keszler Andrea rövidpályás gyorskorcsolyázónak,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Telegdi Attila Lászlónak, a Szent István Egyetem Alkalmazott Bölcsészeti Kar testnevelő tanárának a"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "MAGYAR KÖZTÁRSASÁGI BRONZ ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s12",
      "section": "12",
