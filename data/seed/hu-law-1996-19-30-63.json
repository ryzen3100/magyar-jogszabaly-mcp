{
  "id": "hu-law-1996-19-30-63",
  "type": "statute",
  "title": "19/1996. (VI. 19.) ME határozat főiskolai tanár felmentéséről",
  "status": "amended",
  "in_force_date": "1996-06-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-19-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Gyöngyössi Józsefet, a Kertészeti és Élelmiszeripari Egyetem Szegedi Élelmiszeripari Főiskolai Kar főiskolai tanárát 1996. december 31-i hatállyal"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– nyugállományba vonulására tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
