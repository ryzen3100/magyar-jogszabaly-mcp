  "title": "117/1998. (IX. 23.) KE határozat a Gazdasági Versenyhivatal elnökének kinevezéséről",
  "status": "amended",
  "in_force_date": "1998-09-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/1998-117-30-76",
  "description": "a Gazdasági Versenyhivatal elnökének kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A tisztességtelen piaci magatartás és versenykorlátozás tilalmáról szóló 1996. évi LVII. törvény 35. §-ának (2) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Nagy Zoltánt a Gazdasági Versenyhivatal elnökévé"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1998. szeptember 17-i hatállyal – hatévi időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
