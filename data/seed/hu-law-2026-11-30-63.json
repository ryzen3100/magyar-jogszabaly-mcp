{
  "id": "hu-law-2026-11-30-63",
  "type": "statute",
  "title": "11/2026. (II. 12.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2026-02-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/2026-11-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – a kultúráért és innovációért felelős miniszternek a fenntartó kezdeményezésére tett javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Sebestyén Józsefet a Veszprémi Érseki Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2026. április 1-jétől 2031. március 31-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
