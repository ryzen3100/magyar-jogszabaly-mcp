{
  "id": "hu-law-1995-134-30-76",
  "type": "statute",
  "title": "134/1995. (VIII. 24.) KE határozat dandártábornoki kinevezésekről",
  "status": "amended",
  "in_force_date": "1995-08-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-134-30-76",
  "description": "dandártábornoki kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A honvédelmi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "állami ünnepünk, augusztus 20-a alkalmából"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Kiss Tibor ezredest, az MH Katonai Felderítő Hivatal hivatalvezető első helyettesét,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Mráz István ezredest, a HVK hadműveleti főcsoportfőnök első helyettesét,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Tóth Ferenc mérnök ezredest, a HM haditechnikai fejlesztési és beszerzési főosztályvezetőjét"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dandártábornokká kinevezem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Keleti György s. k., honvédelmi miniszter"
    }
  ]
}
