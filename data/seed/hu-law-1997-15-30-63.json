{
  "id": "hu-law-1997-15-30-63",
  "type": "statute",
  "title": "15/1997. (VI. 5.) ME határozat főiskolai tanár felmentéséről",
  "status": "amended",
  "in_force_date": "1997-06-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-15-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1)–(3) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Csernicsek Istvánt, a Miskolci Egyetem Dunaújvárosi Főiskolai Kar főiskolai tanárát e tisztségéből – közalkalmazotti jogviszonya közös megegyezéssel történő megszűnésére tekintettel –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1997. május 15-i hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
