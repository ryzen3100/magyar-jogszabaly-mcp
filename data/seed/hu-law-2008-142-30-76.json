  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának a) pontja alapján, az oktatási és kulturális miniszternek – a fenntartóval egyetértésben tett – javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Budapesti Műszaki Egyetemen,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Péceli Gábor egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2008. augusztus 1-jétől 2012. július 31-éig terjedő időtartamra,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Károli Gáspár Református Egyetemen,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Szűcs Ferenc egyetemi tanárt – további –"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2008. augusztus 1-jétől 2011. július 31-éig terjedő időtartamra,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a Liszt Ferenc Zeneművészeti Egyetemen,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Batta András egyetemi tanárt – további –"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "2008. november 1-jétől 2013. október 31-éig terjedő időtartamra, és"
    },
    {
      "provision_ref": "s11",
      "section": "11",
