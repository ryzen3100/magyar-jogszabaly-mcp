      "section": "13",
      "title": "13",
      "content": "2008. augusztus 1-jétől 2013. július 31-éig terjedő időtartamra"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "megbízom a rektori feladatok ellátásával."
