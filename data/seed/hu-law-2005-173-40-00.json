  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2005. évi 170. számának I. kötetében megjelent, a Magyar Nemzeti Bank hivatalos deviza árfolyamlapján nem szereplő külföldi pénznemek euróra átszámított árfolyamairól szóló MNB közleményben, a 12094. oldalon a 4. és 5. sor helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "„Indonézia rúpia 11460.7000"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Irak új iraki dínár 1738.9800”"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(Nyomdahiba)"
    }
  ]
}
