{
  "id": "hu-law-2025-90-30-63",
  "type": "statute",
  "title": "90/2025. (X. 31.) ME határozat főiskolai rektor felmentéséről és főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2025-10-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2025-90-30-63",
  "description": "főiskolai rektor felmentéséről és főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – a kultúráért és innovációért felelős miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Pécsi Püspöki Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kovács Gusztávot főiskolai rektori megbízatása alól – lemondására tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2025. szeptember 1-jei hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem, egyidejűleg"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Lukács Ottiliát"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– a 2025. október 15-étől 2029. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
