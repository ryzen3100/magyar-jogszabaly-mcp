  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 220. § (2) bekezdésében foglalt jogkörömben eljárva, a belügyminiszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Csampa Zsoltot"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Belügyminisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2014. augusztus 15-ei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
