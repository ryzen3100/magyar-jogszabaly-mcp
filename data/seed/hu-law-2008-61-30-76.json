  "title": "61/2008. (III. 15.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2008-03-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-61-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a gazdasági és közlekedési miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Dr. Träger Herbertnek, a Közlekedésfejlesztés Koordinációs Központ tanácsadójának a"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat);"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Békés Györgynek, a Magyar Energia Hivatal főosztályvezető-helyettesének,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Taba Sándornak, a Magyar Bányászati és Földtani Hivatal humánpolitikai vezetőjének, szakmai főtanácsadónak a"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "KEH ügyszám: VIII-1/01237/2008."
    }
  ]
}
