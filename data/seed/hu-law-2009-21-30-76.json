{
  "id": "hu-law-2009-21-30-76",
  "type": "statute",
  "title": "21/2009. (III. 15.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2009-03-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2009-21-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a földművelésügyi és vidékfejlesztési miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Szeghy Szabolcsnak, a Mezőgazdasági Szakigazgatási Hivatal Központ osztályvezetőjének a"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Erős Andrásnak, a Felsőnánai Agrár Kft. ügyvezetőjének,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Friedrich Ferencnek, az Ajkai Körzeti Földhivatal hivatalvezetőjének,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Szabóné Jeszenszky Jolánnak, a Nyíregyházi Körzeti Földhivatal osztályvezetőjének a"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kitüntetést"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "adományozom."
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "KEH ügyszám: VIII-1/00650/2009."
    }
  ]
}
