{
  "id": "hu-law-1997-61-40-00",
  "type": "statute",
  "title": "1997. MK 61. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1997-07-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-61-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1997. évi 54. számában megjelent, az önkéntes kölcsönös egészségpénztárak egészségügyi intézményeinek működési és üzemeltetési szabályairól szóló 109/1997. (VI. 25.) Korm. rendelet"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 2. § f) pont utolsó sora helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,… a beteg vizsgálati anyagainak feldolgozására irányul;''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 6. § (2) bek. c) pont utolsó sora helyesen:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": ",,… értesítési, tájékoztatási kötelezettség);''"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 12. § (4) bek. d) pont 3. sora helyesen:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,… szükséges, jogszabályok által előírt iratokat.''"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "– 17. § (2) bek. utolsó sora helyesen:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": ",,… kell kimutatnia a nyilvántartásaiban.''"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "– 19. § (1) bek. c) pont utolsó sora helyesen:"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": ",,… vonatkozó terv és ehhez kapcsolódó könyvvizsgálói vélemény …''"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "(Kézirathiba)"
    }
  ]
}
