      "content": "a bajor–magyar gazdasági kapcsolatok elmélyítése érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Otto Wiesheu bajor tartományi gazdasági, infrastrukturális, közlekedési és technológiai államminiszternek a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "középkeresztje"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "polgári tagozata;"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a magyar–salzburgi gazdasági és kulturális kapcsolatok fellendítése érdekében végzett egy évtizedes kiemelkedő tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s8",
      "section": "8",
