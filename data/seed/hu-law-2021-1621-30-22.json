      "section": "1",
      "title": "1",
      "content": "Magyarország Kormánya 2021-ben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. Burján Tibor nyárádszentbenedeki furulyásnak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2. Englert Antal mohácsi busómaszkfaragónak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "3. Hutkai László debreceni bőrművesnek,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "4. Lakatos Károly pálpataki székely mesemondónak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "5. Mayer István Antal kővágóörsi kályhakészítőnek,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "6. Szabó Szilárd tordasi táncművésznek, koreográfus-táncoktatónak,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "7. Szóráth János tiszaalpári citerás-klarinétosnak,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "8. Tatai Ernő teveli tamburakészítőnek,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "9. Tötszegi András mérai hagyományőrző táncosnak,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "10. Ulman István gömöri fafaragónak a Népművészet Mestere díjat adományozza."
    }
  ]
}
