{
  "id": "hu-law-2007-31-30-63",
  "type": "statute",
  "title": "31/2007. (V. 15.) ME határozat szakállamtitkár megbízatásának megszűnéséről",
  "status": "in_force",
  "in_force_date": "2007-05-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-31-30-63",
  "description": "szakállamtitkár megbízatásának megszűnéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 58. §-ának b) pontja alapján megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Jenei Zoltánnak, az Igazságügyi és Rendészeti Minisztérium szakállamtitkárának e megbízatása"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2007. május 10-i hatállyal – lemondásával – megszűnik."
    }
  ]
}
