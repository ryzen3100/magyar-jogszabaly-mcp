  "title": "12/2003. (XI. 13.) MeHVM határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2003-11-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-12-30-84",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 33. §-ának (1) bekezdése alapján, a Miniszterelnöki Hivatal közigazgatási államtitkára javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Lévai Gábort"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Miniszterelnöki Hivatal helyettes államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2003. október 8-i hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    }
  ]
}
