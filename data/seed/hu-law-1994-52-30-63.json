{
  "id": "hu-law-1994-52-30-63",
  "type": "statute",
  "title": "52/1994. (XII. 28.) ME határozat főiskolai tanári felmentésésekről",
  "status": "amended",
  "in_force_date": "1994-12-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-52-30-63",
  "description": "főiskolai tanári felmentésésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (3) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Gyovai Ernőt, a Gödöllői Agrártudományi Egyetem főiskolai tanárát 1995. december 19-i hatállyal,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Lányi Miklósnét, a Bárczi Gusztáv Gyógypedagógiai Tanárképző Főiskola főiskolai tanárát 1995. december 28-i hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— nyugállományba vonulásukra tekintettel —"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "e tisztségükből felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
