{
  "id": "hu-law-2024-61-30-63",
  "type": "statute",
  "title": "61/2024. (VI. 18.) ME határozat főiskolai rektor felmentéséről és főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2024-06-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/2024-61-30-63",
  "description": "főiskolai rektor felmentéséről és főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – a kultúráért és innovációért felelős miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Pápai Református Teológiai Akadémián"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Dr. Németh Tamást főiskolai rektori megbízatása alól – lemondására tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2024. június 30-ai hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem, egyúttal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Balla Ibolyát"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– a 2024. július 1-jétől 2029. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
