{
  "id": "hu-law-1990-308-30-76",
  "type": "statute",
  "title": "308/1990. (XII. 22.) KE határozat miniszter felmentéséről, valamint miniszterek kinevezéséről",
  "status": "in_force",
  "in_force_date": "1990-12-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-308-30-76",
  "description": "miniszter felmentéséről, valamint miniszterek kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 33. §-ának (4) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Rabár Ferenc pénzügyminisztert e tisztségéből – kérésére – 1990. december 20-ai hatállyal, érdemei elismerése mellett felmentem,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "egyidejűleg"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Botos Katalint tárca nélküli miniszterré,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Kupa Mihályt pénzügyminiszterré,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Pungor Ernőt tárca nélküli miniszterré"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kinevezem."
    }
  ]
}
