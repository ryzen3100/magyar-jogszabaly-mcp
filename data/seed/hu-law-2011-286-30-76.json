  "title": "286/2011. (XI. 10.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2011-11-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-286-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Liszt Ferenc Emlékév alkalmából a nagy magyar zeneszerző életművének több évtizeden át tartó kutatásáért, nemzetközi bemutatásáért és népszerűsítéséért"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Alan Henry George Walker, a MacMaster University professor emeritusa, tanszékvezetője részére a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND lovagkeresztje"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "polgári tagozata"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "KEH ügyszám: VIII-1/05671/2011."
    }
  ]
}
