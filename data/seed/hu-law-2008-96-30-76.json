{
  "id": "hu-law-2008-96-30-76",
  "type": "statute",
  "title": "96/2008. (IV. 17.) KE határozat egyetemi tanári kinevezésekről",
  "status": "in_force",
  "in_force_date": "2008-04-17",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-96-30-76",
  "description": "egyetemi tanári kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának b) pontja alapján, az oktatási és kulturális miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Matkó Jánost, az Eötvös Loránd Tudományegyetem tudományos tanácsadóját és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Fülöp Gyulát, a Miskolci Egyetem egyetemi docensét"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2008. április 1. napjával kinevezem egyetemi tanárrá."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: IV-3/01845/2008."
    }
  ]
}
