  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Európa Tanács Parlamenti Közgyűlésének elnökeként, valamint képviselőként a hazánkat és térségünket érintő problémák felvetése és megoldása, valamint a kelet-közép-európai régió EU integrációs törekvéseinek felkarolása érdekében végzett munkája elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Lord David Russell-Johnston-nak, az Európa Tanács Parlamenti Közgyűlése képviselőjének a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "középkeresztje a csillaggal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "polgári tagozata"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "KEH ügyszám: VII-2/1327/2006."
    }
  ]
}
