{
  "id": "hu-law-2010-34-30-76",
  "type": "statute",
  "title": "34/2010. (III. 15.) KE határozat kitüntetés adományozásáról",
  "status": "amended",
  "in_force_date": "2010-03-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-34-30-76",
  "description": "Kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a nemzeti fejlesztési és gazdasági miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Dittel Gábornak, a Magánvállalkozók Nemzetközi Fuvarozó Ipartestülete (NiT Hungary) ügyvezető főtitkárának,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Jó Lászlónak, a Kereskedelmi és Vendéglátó Vállalkozók Somogy megyei Érdekképviselete elnökének a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "(polgári tagozat)"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Budapest, 2010. március 1."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "KEH ügyszám: VIII-1/00634/2010."
    }
  ]
}
