    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1993. évi 171. számában helytelenül jelent meg a Magyar Köztársaság Kormányának közleménye a helyi önkormányzatok 1993. évi új, induló tornatermi céltámogatásáról. A 10 745. oldalon a 116. és a 124. sorszámhoz tartozó települések adatai helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Önkormányzat Beruházás 1993. évi 1994. évi Átl."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "összköltség igérvény ütem %"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "________________________________________________________"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "116 Tokodaltáró 28576 11130 300 39,999"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "124 Vértesszőlős 33116 8755 4492 40,002"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "A Magyar Közlöny 1993. évi 178. száma I. kötetében megjelent, főiskolai tanár felmentéséről szóló 5/1993. (XII. 10.) ME határozatának második bekezdése helyesen:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,…dr. Dóka Istvánt, a Gödöllői Agrártudományi Egyetem Nyíregyházi Mezőgazdasági Főiskolai Kara főiskolai tanárát…''"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "(Kézirathiba)"
    }
  ]
}
