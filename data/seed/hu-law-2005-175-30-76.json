  "title": "175/2005. (XI. 18.) KE határozat bíró felmentéséről",
  "status": "in_force",
  "in_force_date": "2005-11-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-175-30-76",
  "description": "bíró felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 48. §-ának (2) bekezdése, valamint a bíróságok szervezetéről és igazgatásáról szóló 1997. évi LXVI. törvény 4. §-ának (1) bekezdése alapján, az Országos Igazságszolgáltatási Tanács előterjesztésére,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "bírói tisztségének ellátására tartósan – egészségügyi okból – alkalmatlanná válása miatt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Spádáné dr. Pelsőczi Kovács Mariannát"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2005. november 17-i hatállyal bírói tisztségéből felmentem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: IV-1/5355-0/2005."
    }
  ]
}
