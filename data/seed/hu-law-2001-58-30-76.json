    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2001. június 27-i hatállyal,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "határőr dandártábornokká"
    },
    {
      "provision_ref": "s6",
