{
  "id": "hu-law-2003-121-30-76",
  "type": "statute",
  "title": "121/2003. (VII. 16.) KE határozat egyetemi tanári kinevezés alóli felmentésről",
  "status": "in_force",
  "in_force_date": "2003-07-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-121-30-76",
  "description": "egyetemi tanári kinevezés alóli felmentésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Kaposvári Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Buday-Sántha Attila meghívott, határozott időre kinevezett egyetemi tanárt – saját kérésére, közalkalmazotti jogviszony lemondással történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2003. június 30. napjával"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezése alól felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-2/2665/2003."
    }
  ]
}
