    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Hevesi Tóth Ferenc dandártábornokot"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1996. április 1-jei hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Nemzetbiztonsági Szakszolgálat főigazgatójává"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s6",
