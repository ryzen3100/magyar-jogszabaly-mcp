  "title": "95/1994. (VII. 8.) KE határozat kitüntetéses doktorrá avatásról",
  "status": "amended",
  "in_force_date": "1994-07-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-95-30-76",
  "description": "kitüntetéses doktorrá avatásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A művelődési és közoktatási miniszter előterjesztésére hozzájárulok ahhoz, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Závodszky Péter okleveles fizikust, és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Boros Zoltán okleveles matematikust"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Kossuth Lajos Tudományegyetemen,,Promotio sub auspiciis praesidentis Rei Publicae'' kitüntetéses doktorrá avassák."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Dr. Mádl Ferenc s. k., művelődési és közoktatási miniszter"
    }
  ]
}
