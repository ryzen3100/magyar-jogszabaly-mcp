  "title": "98/2023. (XII. 6.) ME határozat főiskolai tanárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2023-12-06",
  "url": "https://njt.jog.gov.hu/jogszabaly/2023-98-30-63",
  "description": "főiskolai tanárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 27. § (3) bekezdésében foglalt jogkörömben eljárva – a kultúráért és innovációért felelős miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Tolnai Ágnest és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Váradi Ferencet"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2023. december 15-ei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "főiskolai tanárrá kinevezem."
    }
  ]
}
