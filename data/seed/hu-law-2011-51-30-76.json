  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Köztársaság Elnökének Érdemérme és a Köztársaság Elnökének Díszoklevele Éremmel kitüntetések alapításáról szóló 223/2010. (IX. 2.) KE. határozat 3. pontjában foglaltak alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a vörösiszap-katasztrófa utáni kármentés és helyreállítás során végezett önkéntes munkájuk elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Kovács Péternek,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Rádli Róbertnek,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "ifj. Rosta Zoltánnak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "ifj. Somogyi Tamásnak,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Szabó Tamásnak,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "ifj. Szarka Lajosnak a"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "KÖZTÁRSASÁG ELNÖKÉNEK DÍSZOKLEVELE ÉREMMEL"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s11",
      "section": "11",
