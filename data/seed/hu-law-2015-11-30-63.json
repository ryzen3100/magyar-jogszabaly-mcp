{
  "id": "hu-law-2015-11-30-63",
  "type": "statute",
  "title": "11/2015. (I. 30.) ME határozat állami felsőoktatási intézmény kancellárjának megbízásáról",
  "status": "in_force",
  "in_force_date": "2015-01-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2015-11-30-63",
  "description": "állami felsőoktatási intézmény kancellárjának megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (4a) bekezdésében foglalt jogkörömben eljárva – az oktatásért felelős miniszter előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Kecskeméti Főiskolán Hegmanné Nemes Sárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2015. január 23-ától 2017. december 31-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a kancellári teendők ellátásával megbízom."
    }
  ]
}
