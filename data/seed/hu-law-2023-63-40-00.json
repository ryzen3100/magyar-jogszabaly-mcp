{
  "id": "hu-law-2023-63-40-00",
  "type": "statute",
  "title": "2023. MK 63. szám helyesbítés Helyesbítés",
  "status": "in_force",
  "in_force_date": "2023-04-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2023-63-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Magyar Közlöny 2023. április 27-én megjelent 62. számában kihirdetett, az energetikai tárgyú veszélyhelyzeti rendeletek módosításáról szóló 157/2023. (IV. 27.) Korm. rendelet 3. §-a – a jelzett közlönyszám 2446. oldalán – helyesen a következő:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "„3. § Hatályát veszti az R2."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a) 1. § (1) bekezdésében a „2023. április 30. napjáig” szövegrész,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "b) 1. § (2) bekezdése,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "c) 10. §-ában az „(1) bekezdése” szövegrész.”"
    }
  ]
}
