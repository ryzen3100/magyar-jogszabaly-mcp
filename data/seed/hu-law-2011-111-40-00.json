    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "A Magyar Közlöny 2011. évi 110. számában kihirdetett, az elektronikus hírközlő hálózatok azonosítóinak nemzeti felosztási tervéről szóló 3/2011. (IX. 26.) NMHH rendelet 1. mellékletének 3.1.2. pontjában található táblázat első két sora, valamint 3.7.2. pontjának második sora a 28697., illetve a 28699. oldalon – technikai hiba folytán – pontatlanul jelent meg. A rendelkezések helyesen az alábbiak:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a 28697. oldalon:"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "[3.1.2. A rövid kódok felosztása]"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "„"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "”"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a 28699. oldalon:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "[3.7.2. Előtétek]"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "„131 hívószám kijelzés hívásonkénti letiltása (KTE)”"
    }
  ]
}
