{
  "id": "hu-law-2006-1084-30-22",
  "type": "statute",
  "title": "1084/2006. (VIII. 22.) Korm. határozat a Népművészet Mestere díj 2006. évi adományozásáról",
  "status": "repealed",
  "in_force_date": "2006-08-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-1084-30-22",
  "description": "a Népművészet Mestere díj 2006. évi adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Magyar Köztársaság Kormánya augusztus 20-a, Szent István ünnepe alkalmából"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Brath Margit népdalénekesnek, népszokás gyűjtőnek,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Csótár Rezső fazekasnak, Gránátalma díjas népi iparművésznek,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Ésik István mesemondónak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Farkas György tímár és bocskorosnak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Fehér Jánosné Vincze Irén hímző, viseletkészítő népi iparművésznek,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Kasza Miklós csont-, szaru-, fafaragó népi iparművésznek,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Kisláposi András furulyásnak, mesemondónak,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Lőrincz János néptáncosnak,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Luktor Ferencné Holló Éva szövő népi iparművésznek,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Marton Sándorné hímző népi iparművésznek"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "a Népművészet Mestere díjat"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "adományozza. 1 A határozatot az 1380/2011. (XI. 8.) Korm. határozat 3. pontja visszavonta 2011. november 9. napjával. Alkalmazására lásd e határozat 7. pontját."
    }
  ]
}
