{
  "id": "hu-law-2001-56-30-76",
  "type": "statute",
  "title": "56/2001. (VI. 22.) KE határozat politikai államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2001-06-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2001-56-30-76",
  "description": "politikai államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 23. §-a alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Pálinkás Józsefet, az Oktatási Minisztérium politikai államtitkárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "e tisztségéből – más fontos megbízatása miatt –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2001. július 15-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
