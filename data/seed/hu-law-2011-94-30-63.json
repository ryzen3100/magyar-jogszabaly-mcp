{
  "id": "hu-law-2011-94-30-63",
  "type": "statute",
  "title": "94/2011. (XI. 8.) ME határozat miniszterelnöki biztos kinevezéséről",
  "status": "in_force",
  "in_force_date": "2011-11-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-94-30-63",
  "description": "miniszterelnöki biztos kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2010. évi XLIII. törvény 32. § (1) bekezdésében foglalt jogkörömben eljárva"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Halasi Tibort"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2011. november 1-jei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a kormányzati döntések végrehajtásának ellenőrzéséért felelős miniszterelnöki biztossá nevezem ki."
    }
  ]
}
