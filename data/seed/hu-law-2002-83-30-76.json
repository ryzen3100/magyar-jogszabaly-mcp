    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 29. § (1) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Kovács Miklósné dr. Molnár Ilonát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a volt Szociális és Családügyi Minisztérium közigazgatási államtitkárát"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2002. május 27-i hatállyal –;"
    },
    {
