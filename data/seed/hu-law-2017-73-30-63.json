{
  "id": "hu-law-2017-73-30-63",
  "type": "statute",
  "title": "73/2017. (VI. 30.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2017-06-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2017-73-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az emberi erőforrások miniszterének a fenntartó javaslatára tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Pécsi Püspöki Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kovács Gusztáv főiskolai tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2017. július 1-jétől 2021. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
