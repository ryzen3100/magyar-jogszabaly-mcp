    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Varga Miklóst, a Környezetvédelmi és Vízügyi Minisztérium szakállamtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2007. június 1-jei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
