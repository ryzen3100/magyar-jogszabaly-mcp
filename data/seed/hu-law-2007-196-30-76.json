  "title": "196/2007. (X. 10.) KE határozat a Nemzeti Vagyongazdálkodási Tanács elnökének és tagjainak kinevezéséről",
  "status": "in_force",
  "in_force_date": "2007-10-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-196-30-76",
  "description": "a Nemzeti Vagyongazdálkodási Tanács elnökének és tagjainak kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az állami vagyonról szóló 2007. évi CVI. törvény 8. § (1) bekezdésében foglalt jogkörömben, a miniszterelnök javaslatára,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Nagy Jánost a Nemzeti Vagyongazdálkodási Tanács elnökévé,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Baranyi Imrét,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Erdei Tamást,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Markó Andreát,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Roóz Józsefet,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Tátrai Miklóst és"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Varga Gusztávot a Nemzeti Vagyongazdálkodási Tanács tagjává"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– a határozat közzétételének napjától, hat évig terjedő időtartamra – kinevezem."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "KEH ügyszám: V-3/4183/2007."
    }
  ]
