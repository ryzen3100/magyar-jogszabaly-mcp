{
  "id": "hu-law-2023-79-30-63",
  "type": "statute",
  "title": "79/2023. (IX. 14.) ME határozat főispánok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2023-09-14",
  "url": "https://njt.jog.gov.hu/jogszabaly/2023-79-30-63",
  "description": "főispánok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 207. § (1) bekezdésében foglalt jogkörömben eljárva – a Miniszterelnökséget vezető miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Salgó László Pétert a Csongrád-Csanád Vármegyei Kormányhivatalt vezető főispánná és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Tanárki Gábort a Fejér Vármegyei Kormányhivatalt vezető főispánná"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2023. október 1-jei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    }
  ]
}
