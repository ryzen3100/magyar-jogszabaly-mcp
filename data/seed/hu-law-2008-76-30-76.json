  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a szociális és munkaügyi miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Rácz Sándornak, a nyíregyházi NGYIK Szakképző Iskola, Speciális Szakiskola és Kollégium igazgatójának a"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Molnár Katalinnak, az Abaúji Gyermekvédelmi Körzet (Hernádvécse) gazdasági vezetőjének,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Óváriné Orosz Erzsébetnek, a Nyugdíjasok Országos Szövetsége Borsod-Abaúj-Zemplén Megyei szervezőjének,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Pál Ferencnek, a Magyar Közoktatási és Szakképzési Szakszervezet Országos Elnöksége tagjának a"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Neisz Mihálynénak, a Holnapért Közhasznú Alapítvány kurátorának"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "a MAGYAR KÖZTÁRSASÁGI BRONZ ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "kitüntetést adományozom."
    },
    {
