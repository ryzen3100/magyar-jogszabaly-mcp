  "title": "42/2008. (II. 5.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2008-02-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-42-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a külügyminiszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Sanko Aposztolosz Arszenovnak, a Várnai II. Ulászló Múzeum és Emlékpark nyugalmazott igazgatójának,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Szarka Irénnek, a Szófiai Magyar Kulturális Intézet nyugalmazott gazdasági vezetőjének a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VIII-1/00717/2008."
    }
  ]
}
