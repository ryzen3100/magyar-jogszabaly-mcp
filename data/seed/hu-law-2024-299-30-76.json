  "description": "bírák kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (3) bekezdés k) pontja és 26. cikk (2) bekezdése, valamint a bírák jogállásáról és javadalmazásáról szóló 2011. évi CLXII. törvény 3. § (2) bekezdése és 23. § (1) bekezdése alapján – az Országos Bírósági Hivatal elnökének javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Boldizsárné dr. Varjú Eleonórát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Mónusné dr. Kiss Katalint,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Szincsák-Szászi Juditot és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Tajti Juditot"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a 2024. december 15. napjától 2027. december 14. napjáig terjedő időtartamra bíróvá kinevezem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "SP ügyszám: SP/5245-2/2024"
    }
  ]
}
