  "title": "99/2020. (X. 28.) ME határozat főiskolai tanárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2020-10-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2020-99-30-63",
  "description": "főiskolai tanárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 27. § (3) bekezdésében foglalt jogkörömben eljárva – az innovációért és technológiáért felelős miniszter előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Gombos Norbertet és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Wulfné dr. Kinczler Zsuzsannát"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2020. november 1-jei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "főiskolai tanárrá kinevezem."
    }
  ]
}
