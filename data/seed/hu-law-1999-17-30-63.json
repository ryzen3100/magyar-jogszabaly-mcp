{
  "id": "hu-law-1999-17-30-63",
  "type": "statute",
  "title": "17/1999. (V. 28.) ME határozat főiskolai tanár felmentéséről",
  "status": "amended",
  "in_force_date": "1999-05-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/1999-17-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, az oktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– közalkalmazotti jogviszony áthelyezés jogcímén történő megszűnésére tekintettel –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Sándor Lászlót, a Csokonai Vitéz Mihály Tanítóképző Főiskola főiskolai tanárát e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "1999. április 30-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Budapest, 1999. április 28."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
