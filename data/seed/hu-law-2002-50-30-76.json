  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére Bali József hőr. ezredest, a Határőrség Győri Igazgatóság vezetőjét, a Rendőrség Napja alkalmából a szakmai és vezetői munka terén kifejtett eredményes tevékenysége elismeréseként 2002. április 24-i hatállyal"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "határőr dandártábornokká"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "KEH ügyszám: V-5/1475/2002."
    }
  ]
