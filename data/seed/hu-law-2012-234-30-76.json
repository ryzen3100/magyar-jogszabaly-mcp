{
  "id": "hu-law-2012-234-30-76",
  "type": "statute",
  "title": "234/2012. (IX. 20.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2012-09-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-234-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés f) pontja, továbbá a Magyarország címerének és zászlajának használatáról, valamint állami kitüntetéseiről szóló 2011. évi CCII. törvény 18. § (1) bekezdése alapján – a miniszterelnök előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a magyar–japán kapcsolatok ápolása és fejlesztése érdekében végzett kimagasló tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Ito Tetsuo, Japán budapesti nagykövete részére a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR ÉRDEMREND KÖZÉPKERESZTJE polgári tagozata"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VIII-1/05229/2012."
    }
  ]
}
