      "content": "3.6. kemény és félkemény sajt, lágy sajt****, gyúrt sajt''"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "Egyidejűleg a táblázat aljára (6523. oldal) felveendő a következő lábjegyzet:"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": ",,**** Lágy sajt esetében Coliform m: 104, M:105''"
    },
    {
      "provision_ref": "s19",
