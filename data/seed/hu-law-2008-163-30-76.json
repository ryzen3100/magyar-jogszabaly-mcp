  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a nemzeti fejlesztési és gazdasági miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Tóth Lászlónak, az UNIÓ Coop. Zrt. (Miskolc) vezérigazgatójának a"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Forgács Istvánnak, a HGS Rendezvényszervező Kft. ügyvezető igazgatójának,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Szala Endrének, az Önkormányzati és Területfejlesztési Minisztérium Területfejlesztési Főosztály nyugalmazott főosztályvezetőjének,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Ujvári Károlynak, az Építő-, Fa és Építőanyagipari Dolgozók Zala Megyei Szakszervezete elnökének a"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "KEH ügyszám: VIII-1/3591/2008."
    }
  ]
