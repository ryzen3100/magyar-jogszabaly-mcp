  "title": "162/2001. (XII. 12.) KE határozat a Legfelsőbb Bíróság elnökhelyettesének kinevezéséről",
  "status": "in_force",
  "in_force_date": "2001-12-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/2001-162-30-76",
  "description": "a Legfelsőbb Bíróság elnökhelyettesének kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A bíróságok szervezetéről és igazgatásáról szóló 1997. évi LXVI. törvény 70. §-ának (1) bekezdése alapján, a Legfelsőbb Bíróság elnökének javaslatára és az Országos Igazságszolgáltatási Tanács véleményének előzetes beszerzésével"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Lomnici Zoltánt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Legfelsőbb Bíróság elnökhelyettesévé"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2002. február 1-jei hatállyal, hatévi időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    }
  ]
}
