{
  "id": "hu-law-2003-112-30-76",
  "type": "statute",
  "title": "112/2003. (VII. 1.) KE határozat egyetemi tanári kinevezésről",
  "status": "in_force",
  "in_force_date": "2003-07-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-112-30-76",
  "description": "egyetemi tanári kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "2003. július hó 1. napjával,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Balázs Gézát, az Eötvös Loránd Tudományegyetem egyetemi docensét, a Berzsenyi Dániel Főiskola további jogviszonyban alkalmazott tudományos főmunkatársát"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem egyetemi tanárrá."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: V-2/2469/2003."
    }
  ]
}
