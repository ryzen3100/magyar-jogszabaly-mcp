      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1995. évi 111. számában kihirdetett, a Kereskedelmi Vámtarifa 1996. évi alkalmazásáról szóló 67/1995. (XII. 20.) IKM—PM együttes rendelet helyesbítése a következő:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "2. számú mellékletből a 6455. oldalon kimaradt:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "ex 3925 90 műanyag lemezekből készült termék, víz- és habtartály, sárvédő és tömlő választófal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "ex 7606 12 ötvözött alumínium lemez"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "ex 8502 20 generátor aggregát (belső égésű dugattyú-motoros áramfejlesztő)"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "ex 9020 00 90 00 sűrített levegős légzőkészülék"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Kézirathiba)"
    }
  ]
}
