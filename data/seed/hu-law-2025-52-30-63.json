{
  "id": "hu-law-2025-52-30-63",
  "type": "statute",
  "title": "52/2025. (VI. 30.) ME határozat főiskolai rektor felmentéséről",
  "status": "in_force",
  "in_force_date": "2025-06-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2025-52-30-63",
  "description": "főiskolai rektor felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – a kultúráért és innovációért felelős miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Sapientia Szerzetesi Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Fehérváry Örs Jákót főiskolai rektori megbízatása alól – lemondására tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2025. június 30-ai hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
