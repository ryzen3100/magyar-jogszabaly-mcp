{
  "id": "hu-law-2004-1049-30-22",
  "type": "statute",
  "title": "1049/2004. (V. 14.) Korm. határozat a Magyar Katolikus Egyház számára 2004. évben rendezésre javasolt ingatlanokról, és az e célra elkülönített költségvetési keret felosztásáról",
  "status": "repealed",
  "in_force_date": "2004-05-14",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-1049-30-22",
  "description": "a Magyar Katolikus Egyház számára 2004. évben rendezésre javasolt ingatlanokról, és az e célra elkülönített költségvetési keret felosztásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány az 1991. évi XXXII. törvény értelmében alakított egyeztető bizottság által rendezésre javasolt ingatlanok jegyzékét jóváhagyja és elrendeli, hogy a határozat 1. számú mellékletét képező jegyzékben felsorolt ingatlanok tulajdonba adásáról és a kártalanítás kifizetéséről a Miniszterelnöki Hivatal címzetes államtitkára gondoskodjék a 2. számú mellékletben foglalt pénzellátási terv alapján."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Felelős: Miniszterelnöki Hivatalt vezető miniszter, pénzügyminiszter"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Határidő: a határozat közzétételét követő 30 napon belül"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "J E G Y Z É K"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "A Magyar Katolikus Egyház számára 2004. évben rendezésre javasolt ingatlanokról, és az e célra elkülönített költségvetési keret felhasználásáról."
    },
