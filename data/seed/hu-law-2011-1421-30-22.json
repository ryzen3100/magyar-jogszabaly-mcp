  "type": "statute",
  "title": "1421/2011. (XII. 6.) Korm. határozat az egyes 2007–2013. évekre szóló operatív programok módosításáról",
  "status": "repealed",
  "in_force_date": "2011-12-06",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-1421-30-22",
