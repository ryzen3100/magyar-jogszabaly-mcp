  "description": "miniszterek felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Magyar Köztársaság Alkotmányáról szóló 1949. évi XX. törvény 33. §-ának (4) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Chikán Attila gazdasági minisztert és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Hámori Józsefet, a nemzeti kulturális örökség miniszterét"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e tisztségükből,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– érdemeik elismerése mellett –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "1999. december 31-i hatállyal"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "felmentem."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Budapest, 1999. december 17."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
