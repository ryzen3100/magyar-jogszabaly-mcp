  "title": "84/2007. (V. 8.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2007-05-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-84-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Magyarország és a magyarság hírnevének öregbítése, nemzetközi tekintélyének növelése érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Charles Simonyi mérnöknek a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND NAGYKERESZTJE, polgári tagozata"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VII-2/1822/2007."
    }
  ]
}
