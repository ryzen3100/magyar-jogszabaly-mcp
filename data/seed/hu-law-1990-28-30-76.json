{
  "id": "hu-law-1990-28-30-76",
  "type": "statute",
  "title": "28/1990. (III. 21.) KE határozat altábornagyi, valamint vezérőrnagyi kinevezésről",
  "status": "in_force",
  "in_force_date": "1990-03-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-28-30-76",
  "description": "altábornagyi, valamint vezérőrnagyi kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminisztériumi államtitkár előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– dr. Ilcsik Sándor rendőr vezérőrnagyot, belügyminiszter-helyettest altábornaggyá;"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– Nováky Balázs határőrezredest, a BM Határőrség törzsfőnökét határőr vezérőrnaggyá;"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– dr. Láposi Lőrinc rendőr ezredest, a BM Országos Rendőr-főkapitányság bűnügyi csoportfőnökét,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– dr. Tóth Antal rendőr ezredest, Bács-Kiskun megyei rendőr-főkapitányt"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "rendőr vezérőrnaggyá"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kinevezem."
    }
  ]
}
