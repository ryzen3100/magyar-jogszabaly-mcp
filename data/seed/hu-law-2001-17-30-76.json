      "content": "dr. Szapáry Györgyöt a Magyar Nemzeti Bank alelnökévé"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2001. február 21-i hatállyal – hatévi időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
