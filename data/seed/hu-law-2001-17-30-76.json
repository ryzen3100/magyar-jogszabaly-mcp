  "title": "17/2001. (II. 22.) KE határozat a Magyar Nemzeti Bank alelnökének kinevezéséről",
  "status": "in_force",
  "in_force_date": "2001-02-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2001-17-30-76",
  "description": "a Magyar Nemzeti Bank alelnökének kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
