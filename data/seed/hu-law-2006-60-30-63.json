{
  "id": "hu-law-2006-60-30-63",
  "type": "statute",
  "title": "60/2006. (X. 5.) ME határozat kormányzati főtisztviselői kinevezések megszűnésének megállapításáról",
  "status": "in_force",
  "in_force_date": "2006-10-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-60-30-63",
  "description": "kormányzati főtisztviselői kinevezések megszűnésének megállapításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 31/D. § (1) bekezdés a) és c) pontja alapján megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kereszty Éva Margit kormányzati főtisztviselői kinevezése – a közszolgálati jogviszonyának végleges áthelyezéssel történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2006. május 14-i hatállyal,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Simonné dr. Berta Krisztina kormányzati főtisztviselői kinevezése – a főtisztviselői kinevezéséről történt lemondására tekintettel –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2006. június 28-i hatállyal,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Prőhle Gergely kormányzati főtisztviselői kinevezése – a közszolgálati jogviszonyának közös megegyezéssel történt megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2006. június 30-i hatállyal,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Bardócz László kormányzati főtisztviselői kinevezése – a főtisztviselői kinevezéséről történt lemondására tekintettel –"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "2006. augusztus 1-jei hatállyal és"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Móré László kormányzati főtisztviselői kinevezése – a főtisztviselői kinevezéséről történt lemondására tekintettel –"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "2006. augusztus 1-jei hatállyal"
    },
    {
