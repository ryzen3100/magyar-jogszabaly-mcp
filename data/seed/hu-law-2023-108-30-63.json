  "title": "108/2023. (XII. 22.) ME határozat helyettes államtitkárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2023-12-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2023-108-30-63",
  "description": "helyettes államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 234. § (1) bekezdése alapján – a nemzetgazdasági miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Huray Kingát – 2024. január 1-jei hatállyal – és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Suppan Gergelyt – 2024. január 8-ai hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Nemzetgazdasági Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    }
  ]
}
