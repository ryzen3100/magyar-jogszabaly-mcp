  "title": "35/2007. (V. 31.) ME határozat az országos rendőrfőkapitány felmentéséről",
  "status": "in_force",
  "in_force_date": "2007-05-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-35-30-63",
  "description": "az országos rendőrfőkapitány felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
