      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "e tisztségéből – 2007. május 31-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
