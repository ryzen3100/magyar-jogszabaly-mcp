  "title": "100/2010. (X. 21.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2010-10-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-100-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormánytisztviselők jogállásáról szóló 2010. évi LVIII. törvény 47. § (1) bekezdése alapján, a nemzetgazdasági miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Banai Péter Benőt a Nemzetgazdasági Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2010. október 16-ai hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    }
  ]
}
