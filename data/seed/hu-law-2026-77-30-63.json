  "title": "77/2026. (VII. 29.) ME határozat országos kórházfőigazgató-helyettes felmentéséről",
  "status": "in_force",
  "in_force_date": "2026-07-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2026-77-30-63",
  "description": "országos kórházfőigazgató-helyettes felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Országos Kórházi Főigazgatóságról szóló 506/2020. (XI. 17.) Korm. rendelet 2. § (5) bekezdésében foglalt jogkörömben eljárva, az egészségügyi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Raffay Bálint országos kórházfőigazgató-helyettest e tisztségéből, más fontos megbízatására tekintettel"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2026. július 31-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
