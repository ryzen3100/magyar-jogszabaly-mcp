  "title": "10/2013. (I. 29.) ME határozat az országos rendőrfőkapitány felmentéséről",
  "status": "in_force",
  "in_force_date": "2013-01-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2013-10-30-63",
  "description": "az országos rendőrfőkapitány felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Rendőrségről szóló 1994. évi XXXIV. törvény 6. § (3) bekezdése alapján, a belügyminiszter javaslatára"
