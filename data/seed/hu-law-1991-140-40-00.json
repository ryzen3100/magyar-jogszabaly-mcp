    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "— a Dzsibuti Köztársaság betűjele helyesen:,,DI'',"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "— a Litván Köztársaság betűjele helyesen:,,LV''."
