{
  "id": "hu-law-1995-25-30-63",
  "type": "statute",
  "title": "25/1995. (VIII. 11.) ME határozat főiskolai főigazgatói megbízás megerősítéséről",
  "status": "amended",
  "in_force_date": "1995-08-11",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-25-30-63",
  "description": "főiskolai főigazgatói megbízás megerősítéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 73. §-ának b) pontja alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Stephanides Éva főiskolai tanárnak a Kodolányi János Főiskolára vonatkozó főigazgatói megbízását"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— 1995. július 1-jei hatállyal, háromévi időtartamra —"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megerősítem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "A miniszterelnök helyett:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Dr. Bokros Lajos s. k., pénzügyminiszter"
    }
  ]
}
