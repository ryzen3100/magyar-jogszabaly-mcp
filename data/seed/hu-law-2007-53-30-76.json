{
  "id": "hu-law-2007-53-30-76",
  "type": "statute",
  "title": "53/2007. (III. 20.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2007-03-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-53-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a honvédelmi miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Pintér Józsefnek, a Pintér Művek (Kecel) tulajdonosának,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Szabó Ernőnének, a Zrínyi Miklós Nemzetvédelmi Egyetem Személy- és Munkaügyi Igazgatósága igazgatójának"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Tóth Andrásnak, mérnök ezredesnek"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (katonai tagozat);"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Almási Ferenc alezredesnek,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Ladányi István alezredesnek"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "a MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT (katonai tagozat)"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "KEH ügyszám: VII-2/1066/2007."
    }
  ]
}
