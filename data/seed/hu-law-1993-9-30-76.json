{
  "id": "hu-law-1993-9-30-76",
  "type": "statute",
  "title": "9/1993. (II. 23.) KE határozat miniszter felmentéséről, valamint kinevezéséről",
  "status": "amended",
  "in_force_date": "1993-02-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/1993-9-30-76",
  "description": "miniszter felmentéséről, valamint kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 33. §-ának (4) bekezdése alapján,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Mádl Ferenc tárca nélküli minisztert"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e tisztségéből, érdemei elismerése mellett, 1993. február 22-i hatállyal felmentem,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "egyidejűleg"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "művelődési és közoktatási miniszterré kinevezem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Dr. Antall József s. k., miniszterelnök"
    }
  ]
}
