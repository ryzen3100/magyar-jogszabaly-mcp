    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2001. évi 22. számában, az 1374. oldalon a BM közleményben felsorolt gépjármű törzskönyvek között a 230663A törzskönyv száma helyesen: 230633A."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "A Magyar Közlöny 2001. évi 37. számában kihirdetett, egyes ingatlanok műemlékké nyilvánításáról, illetőleg műemléki védettség megszüntetéséről szóló 8/2001. (III. 30.) NKÖM rendelet melléklete kimaradt. A rendelet melléklete a következő:"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": ",,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Helyszínrajz"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Pécsi Geodéziai és Térképészeti Vállalat 5020/1439/513 munkaszámú"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "1982-ben készült felmérése alapján"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "1:2000''"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Nyomdahiba)"
    }
  ]
}
