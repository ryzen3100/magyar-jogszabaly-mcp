      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A művelődési és közoktatási miniszter előterjesztésére az Eötvös Loránd Tudományegyetemen"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Hankiss Elemér egyetemi tanárt – közalkalmazotti jogviszonyának közös megegyezéssel történő megszűnésére tekintettel –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1997. május 1. napjával,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Kulin Katalin egyetemi tanárt,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Kőrös Endre egyetemi tanárt,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Kucsman Árpád egyetemi tanárt és"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Sarkady János egyetemi tanárt – 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "1997. december 30. napjával,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "e tisztsége alól felmentem."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
