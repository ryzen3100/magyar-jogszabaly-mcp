  "title": "43/1995. (XI. 22.) ME határozat főiskolai tanár kinevezéséről",
  "status": "amended",
  "in_force_date": "1995-11-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-43-30-63",
  "description": "főiskolai tanár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1)—(2) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Gáspár Csabát, a Széchenyi István Főiskolára főiskolai tanárrá"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— 1995. december 1-jei hatállyal —"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
