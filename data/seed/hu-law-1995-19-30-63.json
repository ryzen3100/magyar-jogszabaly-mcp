  "title": "19/1995. (VI. 30.) ME határozat főiskolai főigazgatói megbízás megerősítéséről",
  "status": "amended",
  "in_force_date": "1995-06-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-19-30-63",
  "description": "főiskolai főigazgatói megbízás megerősítéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 73. §-ának b) pontja alapján, a művelődési és közoktatási miniszter javaslatára"
    },
