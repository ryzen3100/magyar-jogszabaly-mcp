    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1995. július 1-jei hatállyal — ötévi időtartamra —"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megerősítem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
