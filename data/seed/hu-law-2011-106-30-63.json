  "title": "106/2011. (XII. 13.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2011-12-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-106-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormánytisztviselők jogállásáról szóló 2010. évi LVIII. törvény 47. § (1) bekezdése alapján, a nemzeti fejlesztési miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Pőcze Orsolyát a Nemzeti Fejlesztési Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2011. december 1-jei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    }
  ]
}
