{
  "id": "hu-law-1996-7-30-63",
  "type": "statute",
  "title": "7/1996. (I. 26.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "amended",
  "in_force_date": "1996-01-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-7-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az államtitkárok jogállásának átmeneti szabályozásáról szóló 1990. évi XXXIII. törvény 8. §-ának (1) bekezdése alapján, a Miniszterelnöki Hivatal közigazgatási államtitkára javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Lóránt Zoltánt, a Miniszterelnöki Hivatalba helyettes államtitkárrá"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 1996. február 1-jei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
