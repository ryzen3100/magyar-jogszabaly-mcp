    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1994. évi 73. számában tévesen megjelent kárpótlási jegyek 1994. július 1-jei értéke helyesen a következő:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "158,7%"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1 000 Ft — 1 587 Ft"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "5 000 Ft — 7 935 Ft"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "10 000 Ft — 15 870 Ft"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(Kézirathiba)"
    }
  ]
}
