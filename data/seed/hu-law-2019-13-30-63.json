{
  "id": "hu-law-2019-13-30-63",
  "type": "statute",
  "title": "13/2019. (II. 15.) ME határozat állami felsőoktatási intézmény kancellárjának megbízásáról",
  "status": "in_force",
  "in_force_date": "2019-02-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2019-13-30-63",
  "description": "állami felsőoktatási intézmény kancellárjának megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (4a) bekezdésében foglalt jogkörömben eljárva – az emberi erőforrások minisztere előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Eötvös József Főiskolán dr. Paska Mihályt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2019. február 15-étől 2022. február 14-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a kancellári teendők ellátásával megbízom."
    }
  ]
}
