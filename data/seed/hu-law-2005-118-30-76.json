  "title": "118/2005. (VIII. 22.) KE határozat közigazgatási államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2005-08-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-118-30-76",
  "description": "közigazgatási államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 26. §-a alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Horváthné dr. Fekszi Mártát, a Külügyminisztérium közigazgatási államtitkárává"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2005. augusztus 16-i hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: V-1/3622/2005."
    }
  ]
}
