{
  "id": "hu-law-2008-36-30-76",
  "type": "statute",
  "title": "36/2008. (I. 31.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2008-01-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-36-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a magyar–amerikai kapcsolatok alakítása, az amerikai és határon túli magyarság támogatása érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Thomas Peter Lantos-nak, az Amerikai Egyesült Államok képviselőjének, a Külügyi Bizottság elnökének a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND NAGYKERESZTJE (polgári tagozata)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VIII-1/00590/2008."
    }
  ]
}
