{
  "id": "hu-law-2018-76-30-63",
  "type": "statute",
  "title": "76/2018. (VI. 18.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2018-06-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/2018-76-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az emberi erőforrások miniszterének a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Gábor Dénes Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Varga Zoltán Balázs főiskolai tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2018. július 1-jétől 2021. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
