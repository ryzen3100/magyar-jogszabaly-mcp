{
  "id": "hu-law-2023-29-30-63",
  "type": "statute",
  "title": "29/2023. (III. 31.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2023-03-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2023-29-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 234. § (1) bekezdésében foglalt jogkörömben eljárva, az igazságügyi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Molnár Balázs Pétert"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2023. április 1-jei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "az Igazságügyi Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem. 1 A 65/2023. (VII. 31.) ME határozat alapján dr. Molnár Balázs Péter tekintetében akként módosul, hogy az „Igazságügyi Minisztérium” megnevezés helyett az „Európai Uniós Ügyek Minisztériuma” megnevezést kell érteni."
    }
  ]
}
