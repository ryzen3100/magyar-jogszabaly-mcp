{
  "id": "hu-law-1996-15-30-63",
  "type": "statute",
  "title": "15/1996. (IV. 30.) ME határozat főiskolai tanár felmentéséről",
  "status": "amended",
  "in_force_date": "1996-04-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-15-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Benkő Pétert, a Pénzügyi és Számviteli Főiskola főiskolai tanárát 1996. május 1-jei hatállyal – közalkalmazotti jogviszonyának megszűnésére tekintettel –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
