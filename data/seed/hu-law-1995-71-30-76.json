  "title": "71/1995. (IV. 19.) KE határozat rendőr vezérőrnagy felmentéséről",
  "status": "amended",
  "in_force_date": "1995-04-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-71-30-76",
  "description": "rendőr vezérőrnagy felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére dr. Nagy Károly rendőr vezérőrnagy, a Belügyminisztérium Rendészeti Főosztályának vezetője szolgálati viszonyát — kérelmére — 1995. április 30-i hatállyal megszüntetem, és nyugállományba helyezem."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Kuncze Gábor s. k., belügyminiszter"
    }
  ]
}
