{
  "id": "hu-law-2003-187-30-76",
  "type": "statute",
  "title": "187/2003. (X. 13.) KE határozat egyetemi tanári kinevezés alóli felmentésekről",
  "status": "in_force",
  "in_force_date": "2003-10-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-187-30-76",
  "description": "egyetemi tanári kinevezés alóli felmentésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Debreceni Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Lakatos Dénes egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2004. április hó 30. napjával, – közalkalmazotti jogviszony közös megegyezéssel történő megszüntetésére tekintettel – és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Pécsi Tudományegyetemen"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Erdősi Ferenc egyetemi tanárt"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2004. április hó 20. napjával – 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "kinevezése alól felmentem."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "KEH ügyszám: V-2/3901/2003."
    }
  ]
}
