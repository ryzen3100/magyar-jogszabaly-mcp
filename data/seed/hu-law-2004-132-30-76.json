  "title": "132/2004. (X. 13.) KE határozat címzetes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2004-10-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-132-30-76",
  "description": "címzetes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 31/A. § (2) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Ábrahám Attilát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Nemzeti Sporthivatal címzetes államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2004. október 7-i hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: I-2/3881/2004. 1 A 158/2004. (XI. 23.) KE határozat szerint módosított szöveg."
    }
  ]
}
