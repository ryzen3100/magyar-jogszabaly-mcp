{
  "id": "hu-law-1998-43-30-63",
  "type": "statute",
  "title": "43/1998. (X. 30.) ME határozat a Nemzetbiztonsági Szakszolgálat főigazgatójának kinevezéséről",
  "status": "amended",
  "in_force_date": "1998-10-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/1998-43-30-63",
  "description": "a Nemzetbiztonsági Szakszolgálat főigazgatójának kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzetbiztonsági szolgálatokról szóló 1995. évi CXXV. törvény 12. §-ának (2) bekezdése alapján a polgári nemzetbiztonsági szolgálatokat irányító tárca nélküli miniszternek a belügyminiszterrel és a honvédelmi miniszterrel egyetértésben tett javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1998. november 1-jei hatállyal"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Chladek István ezredest"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Nemzetbiztonsági Szakszolgálat főigazgatójává kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
