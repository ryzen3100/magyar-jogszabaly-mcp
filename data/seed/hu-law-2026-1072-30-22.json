{
  "id": "hu-law-2026-1072-30-22",
  "type": "statute",
  "title": "1072/2026. (III. 5.) Korm. határozat „Életmentő Emlékérem” adományozásáról",
  "status": "in_force",
  "in_force_date": "2026-03-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2026-1072-30-22",
  "description": "„Életmentő Emlékérem” adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány az „Életmentő Emlékérem” adományozásáról szóló 243/2009. (X. 29.) Korm. rendelet alapján, életmentés közben tanúsított hősies magatartása elismeréseként – a közigazgatási és területfejlesztési miniszter mint helyi önkormányzatokért felelős miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Rácz Bence Illés kiskunmajsai lakosnak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Sóbujtó Antal kunszentmiklósi lakosnak és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Gergály Zsolt söjtöri lakosnak"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "„Életmentő Emlékérmet” adományoz."
    }
  ]
}
