  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján – a közigazgatási és területfejlesztési miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Greinstetter Balázst,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Nemcsok Dénes Sándort,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Oláh Gábort és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Tóthné dr. Csonka Enikő Emesét,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Közigazgatási és Területfejlesztési Minisztérium helyettes államtitkárait e tisztségükből a Nemzeti Fejlesztési Központon belül működő főigazgatóságot vezető főigazgatóvá történő kinevezésükre tekintettel"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– 2024. július 31-ei hatállyal –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "felmentem."
    }
  ]
}
