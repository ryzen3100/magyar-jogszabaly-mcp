  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "1. Az Alkotmánybíróság teljes ülése az Alkotmánybíróságról szóló CLI. törvény 49. § (1) és (7) bekezdésében meghatározott jogkörében eljárva – az Alkotmánybíróság Ügyrendjéről szóló 1001/2013. (II. 27.) AB Tü. határozat 5. § (2)–(4) bekezdésében foglaltakra is tekintettel – az Alkotmánybíróság öttagú tanácsainak összetételéről a következő határozatot hozta:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Az 1. öttagú tanács tagjai:"
