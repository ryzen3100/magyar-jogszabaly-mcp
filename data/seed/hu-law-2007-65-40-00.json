{
  "id": "hu-law-2007-65-40-00",
  "type": "statute",
  "title": "2007. MK 65. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2007-05-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-65-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2007. évi 52. számában megjelent, a közforgalmú személyszállítási utazási kedvezményekről szóló 85/2007. (IV. 25.) Korm. rendelet"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 7. §-a (1) bekezdésének b) pontja helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "„b) az egyházi intézmények, a társadalmi szervezetek, továbbá az alapítványok azon dolgozója, aki az a) pontban hivatkozott személlyel azonos munkakört tölt be kórházakban, szociális szolgáltatókban, alsó-, közép- és felsőfokú nevelési, oktatási intézményekben.”,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 7. §-a (2) bekezdésének első mondata helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "„(2) Az (1) bekezdés szerinti jogosultságot a munkahely útján igényelhető, a 2. melléklet szerinti utalvány alapján lehet megszerezni, ha a jogosult legalább egyéves – bármely munkáltatónál eltöltött – munkaviszonnyal rendelkezik.”,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– 9. §-a (1) bekezdésének fb) pontja helyesen:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "„fb) ha a gyermekek 26 éven aluliak és a nappali képzésben részt vevő tanulók, hallgatók érvényes diákigazolványával rendelkeznek, vagy”,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 1. melléklet 8. sora helyesen:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": ",,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "– 1. melléklet 9. sora helyesen:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "„"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": ",,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "– 1. melléklet 19. sora helyesen:"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "„"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": ",,"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "– 2. melléklet címe helyesen:"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "„Utazási utalvány a 85/2007. (IV. 25.) Korm. rendelet 7. § (1) bekezdésében meghatározott utazási kedvezmény igénybevételéhez”,"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "– 2. mellékletben meghatározott utalvány második, harmadik, negyedik és ötödik sora helyesen:"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "„Az utalvány kiállítójának (foglalkoztató) neve, címe: …………………………………"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "Az utalvány kiállításának időpontja: ……………………………………………………"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "Az utalvány érvényességi ideje: ………………………………………………………..."
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "(Az utalványt évente érvényesíteni kell.)”"
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": "(Kézirathiba)"
    }
  ]
}
