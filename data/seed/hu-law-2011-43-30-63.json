  "title": "43/2011. (V. 31.) ME határozat a Magyar Energia Hivatal elnökhelyettese kinevezéséről",
  "status": "in_force",
  "in_force_date": "2011-05-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-43-30-63",
  "description": "a Magyar Energia Hivatal elnökhelyettese kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A villamos energiáról szóló 2007. évi LXXXVI. törvény 166. § (1) bekezdése alapján, az energiapolitikáért felelős miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Grabner Pétert"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Magyar Energia Hivatal elnökhelyettesévé"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2011. június 1-jei hatállyal, hatévi időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
