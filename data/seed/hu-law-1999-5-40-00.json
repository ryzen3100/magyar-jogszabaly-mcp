      "section": "27",
      "title": "27",
      "content": "38. TÁRSADALOM-, SZOCIÁLPOLITIKAI ÉS EGYÉB TÁRSADALOMBIZTOSÍTÁSI JUTTATÁSOK"
    },
    {
      "provision_ref": "s28",
      "section": "28",
      "title": "28",
      "content": "381. Családi támogatások"
    },
    {
      "provision_ref": "s29",
      "section": "29",
