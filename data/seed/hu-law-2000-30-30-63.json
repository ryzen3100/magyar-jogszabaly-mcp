{
  "id": "hu-law-2000-30-30-63",
  "type": "statute",
  "title": "30/2000. (X. 13.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "2000-10-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-30-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 73. §-ának a) pontja alapján, az oktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Illés Kálmánt, a Debreceni Egyetem Debreceni Konzervatóriuma főiskolai tanárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2000. október 31-i hatállyal,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Őze Józsefet, a Dunaújvárosi Főiskola főiskolai tanárát"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2000. november 16-i hatállyal,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Gödény Endréné dr. Komoróczi Emőkét, az Eötvös Loránd Tudományegyetem Tanárképző Főiskolai Kara főiskolai tanárát"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– közalkalmazotti jogviszonya megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "2000. december 31-i hatállyal"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
