    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2001. október 1-jei hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– hatévi időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
