  "description": "egyetemi tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A szociális és egészségügyi miniszter előterjesztésére 1990. június 30-ai hatállyal – nyugállományba vonulására tekintettel –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– a Semmelweis Orvostudományi Egyetemről –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Dr. Vajda János;"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a Pécsi Orvostudományi Egyetemről –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Dr. Pálffy György,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "1990. augusztus 31-ei hatállyal"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– Dr. Szabolcs József egyetemi tanárt e tisztsége alól felmentem."
    }
  ]
}
