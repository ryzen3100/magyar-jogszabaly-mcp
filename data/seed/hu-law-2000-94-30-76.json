  "title": "94/2000. (VII. 14.) KE határozat egyetemi tanári kinevezésről",
  "status": "amended",
  "in_force_date": "2000-07-14",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-94-30-76",
  "description": "egyetemi tanári kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére, a fenntartó javaslatára 2000. augusztus hó 1. napjával kezdődően"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Kodolányi János Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Cséfalvay Zoltánt, Gazdasági Minisztérium helyettes államtitkárát, a Kodolányi János Főiskola további jogviszonyban alkalmazott főiskolai tanárát határozott időre, ötéves időtartamra"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "egyetemi tanárrá kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Budapest, 2000. július 11."
    },
    {
      "provision_ref": "s6",
      "section": "6",
