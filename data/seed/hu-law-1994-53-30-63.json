{
  "id": "hu-law-1994-53-30-63",
  "type": "statute",
  "title": "53/1994. (XII. 28.) ME határozat főiskolai főigazgatói megbízásról",
  "status": "amended",
  "in_force_date": "1994-12-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-53-30-63",
  "description": "főiskolai főigazgatói megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 73. § b) pontja alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Komáromi Gabriella főiskolai tanárt, a Csokonai Vitéz Mihály Tanítóképző Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a főigazgatói teendők ellátásával 1995. január 1-jei hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— két és fél évi időtartamra —"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
