{
  "id": "hu-law-2000-102-40-00",
  "type": "statute",
  "title": "2000. MK 102. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2000-10-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-102-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2000. évi 95. számában kihirdetett, a számvitelről szóló 2000. évi C. törvény"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 129. § (2) bekezdése helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,(2) Az (1) bekezdést, valamint a 130. §-t nem szükséges alkalmazni akkor, ha a konszolidálásba bevont vállalkozások vagyoni, …''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 4. számú melléklet B. pont II. Követelések mérlegsora helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,II. Követelések"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "ebből: pénzkiadásból származó követelések"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "pénzmozgáshoz nem kapcsolódó követelések''"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 4. számú melléklet F. pont II. Rövid lejáratú kötelezettségek mérlegsora helyesen:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,II. Rövid lejáratú kötelezettségek"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "ebből: pénzbevételből származó kötelezettségek"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "pénzmozgáshoz nem kapcsolódó kötelezettségek''"
    }
  ]
}
