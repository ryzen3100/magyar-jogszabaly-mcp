{
  "id": "hu-law-2006-196-30-76",
  "type": "statute",
  "title": "196/2006. (XI. 3.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2006-11-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-196-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a gazdasági és közlekedési miniszter előterjesztésére, eredményes munkája elismeréseként"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Gáspár Mátyásnak, a Magyar Teleház Szövetség tiszteletbeli elnökének,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kiss Mártának, a Gazdasági és Közlekedési Minisztérium Közgazdasági Főosztálya vezető-főtanácsosának,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Schmideg Ivánnak, a Nemzeti Hírközlési Hatóság tanácsadójának,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Szakál Lászlónak, az EDS Magyarország Kft. ügyvezető igazgatójának a"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(polgári tagozata);"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Nyevrikel Emíliának, a közgazdaságtudomány kandidátusának, a Nemzeti Hírközlési Hatóság Tanácsa tagjának a"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "(polgári tagozata)"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "KEH ügyszám: VII-2/4338/2006."
    }
  ]
