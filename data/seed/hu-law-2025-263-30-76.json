  "status": "in_force",
  "in_force_date": "2025-10-14",
  "url": "https://njt.jog.gov.hu/jogszabaly/2025-263-30-76",
  "description": "dandártábornok rendfokozatba történő kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés e) pontja, valamint a honvédelemről és a Magyar Honvédségről szóló 2021. évi CXL. törvény 5. § (1a) bekezdés a) pontja alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– a honvédelmi miniszter előterjesztésére –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Csernyikné Orosz Beáta ezredest és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Vincze Krisztián ezredest"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2025. október 15-ei hatállyal dandártábornok rendfokozatba kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
