  "description": "rendőr dandártábornok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére dr. Házi István r. ezredest, a Jász-Nagykun-Szolnok Megyei Rendőr-főkapitányság vezetőjét, a Rendőrség Napja alkalmából a rendőri munka végzésében és irányításában kifejtett eredményes tevékenysége elismeréseként 2003. április 24-i hatállyal"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "rendőr dandártábornokká"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "KEH ügyszám: V-5/1565/2003."
    }
  ]
}
