{
  "id": "hu-law-2005-13-30-63",
  "type": "statute",
  "title": "13/2005. (I. 26.) ME határozat kormányzati főtisztviselő áthelyezéséről",
  "status": "in_force",
  "in_force_date": "2005-01-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-13-30-63",
  "description": "kormányzati főtisztviselő áthelyezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló – többször módosított – 1992. évi XXIII. törvény 31/C. §-ának (6) bekezdésében foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Rusznákné dr. Demeter Judit kormányzati főtisztviselőt az Egyenlő Bánásmód Hatóság állományába, elnöki teendők ellátására"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2005. január 24-i hatállyal – határozatlan időre – áthelyezem."
    }
  ]
}
