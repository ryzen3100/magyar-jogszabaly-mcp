{
  "id": "hu-law-2014-65-30-63",
  "type": "statute",
  "title": "65/2014. (VII. 2.) ME határozat helyettes államtitkárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2014-07-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/2014-65-30-63",
  "description": "helyettes államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 220. § (2) bekezdésében foglalt jogkörömben eljárva, a földművelésügyi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kiss Elizát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Román Istvánt,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Szakáli István Lórándot,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Szinay Attilát és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Ugron Ákos Gábort"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a Földművelésügyi Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 2014. július 1-jei hatállyal –"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kinevezem. 1 Az 93/2018. (VII. 4.) ME határozat alapján dr. Szinay Attila tekintetében akként módosul, hogy a „Földművelésügyi Minisztérium” megnevezés helyett az „Agrárminisztérium” megnevezést kell érteni."
    }
  ]
}
