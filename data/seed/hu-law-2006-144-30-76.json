  "title": "144/2006. (VIII. 30.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2006-08-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-144-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdésének j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján, a külügyminiszter előterjesztésére a"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(polgári tagozata)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kitüntetést adományozom"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a magyar–holland oktatási és mezőgazdasági kapcsolatok fejlesztése terén, illetve a hollandiai magyarság körében végzett munkája elismeréseként Kósdi Gergely holland kertésznek."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VII-2/3445/2006."
    }
  ]
}
