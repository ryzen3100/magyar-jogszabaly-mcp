{
  "id": "hu-law-2008-146-30-76",
  "type": "statute",
  "title": "146/2008. (VII. 5.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2008-07-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-146-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a magyar és a nemzetközi szövetkezeti mozgalomban hosszú időn át végzett munkássága elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Váradi Lajosnak, az Országos Takarékszövetkezeti Szövetség nemzetközi főtanácsosának a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND LOVAGKERESZTJE (polgári tagozata)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VIII-1/03212/2008."
    }
  ]
}
