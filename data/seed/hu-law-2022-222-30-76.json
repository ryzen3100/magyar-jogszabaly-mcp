{
  "id": "hu-law-2022-222-30-76",
  "type": "statute",
  "title": "222/2022. (VII. 27.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2022-07-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/2022-222-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés f) pontja, illetve a Magyarország címerének és zászlajának használatáról, valamint állami kitüntetéseiről szóló 2011. évi CCII. törvény 18. § (1) bekezdése alapján – a miniszterelnök előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a magyar–kanadai, illetve Ontario és Magyarország közötti kapcsolatok fejlesztése érdekében végzett elkötelezett munkája elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Kinga Surma,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Ontario tartomány parlamenti képviselője, infrastrukturális miniszter részére,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a magyar kultúra és hagyományok népszerűsítése, valamint a magyar–kanadai kapcsolatok fejlesztése érdekében végzett sokoldalú és példaértékű munkája elismeréseként"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Michael A. Tibollo,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Ontario tartomány parlamenti képviselője, miniszter részére"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a MAGYAR ÉRDEMREND"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "tisztikeresztje"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "polgári tagozata"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "KEH ügyszám: KEH/03188-2/2022."
    }
  ]
