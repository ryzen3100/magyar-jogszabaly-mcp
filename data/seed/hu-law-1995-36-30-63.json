{
  "id": "hu-law-1995-36-30-63",
  "type": "statute",
  "title": "36/1995. (XI. 1.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1995-11-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-36-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Giczy Jánost a Benedek Elek Óvóképző Főiskola főiskolai tanárát 1996. április 30-i hatállyal,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Hézső Ferencet, a Juhász Gyula Tanárképző Főiskola főiskolai tanárát 1995. december 24-i hatállyal,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Farkas Ferencet, a Jászberényi Tanítóképző Főiskola főiskolai tanárát 1996. április 30-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "— nyugállományba vonulására tekintettel — e tisztségéből"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "felmentem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
