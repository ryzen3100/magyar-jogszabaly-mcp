{
  "id": "hu-law-2006-200-30-76",
  "type": "statute",
  "title": "200/2006. (XI. 3.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2006-11-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-200-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a külügyminiszter előterjesztésére, eredményes munkája elismeréseként"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Aurelio Longoni-nak, ny. luganoi városi képviselőnek (svájci állampolgár),"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Ferencz Béla Ervinnek, ferences-rendi szerzetesnek (román állampolgár),"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Hefty Lászlónénak, a Buenos Aires-i Magyar Evangélikus Gyülekezet Presbitériuma elnökének (argentín állampolgár),"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Kelemen Kálmán Andrásnak, az RMDSZ Kereszténydemokrata Platformja elnökének (román állampolgár),"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Koczka Györgynek, a bukaresti közszolgálati televízió magyar adása szerkesztőjének (román állampolgár),"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Páll Lajosnak, festőművész, költőnek (román állampolgár),"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Pap Ivánnak, mérnök, egyesületi vezetőnek (svéd állampolgár),"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Tadeusz Rokicki-nak, karmesternek (lengyel állampolgár),"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Tatár (Péterfy) Irénnek, nyugalmazott tanárnak (román állampolgár),"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Tibor Adlernek, a Németországi Szövetségi Köztársaság budapesti nagykövetsége nyugalmazott tanácsosának (német állampolgár),"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Volcinschi Raoul-nak (román állampolgár),"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Weronika Wysocka-nak, a Lengyel–Magyar Baráti Társaság (Leszno) elnökének (lengyel állampolgár) a"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "(polgári tagozata);"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "Anders Engman-nak, fényképésznek (svéd állampolgár),"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "Páldeák Gézának, egyesületi vezetőnek (svéd állampolgár),"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "Táborosi Mártának, a Külügyminisztérium volt munkatársának,"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "Teresa Sadowska-nak, a Lengyel–Magyar Baráti Társaság titkárának (lengyel állampolgár) a"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "(polgári tagozata)"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s23",
      "section": "23",
