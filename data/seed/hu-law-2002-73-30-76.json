  "title": "73/2002. (V. 28.) KE határozat egyetemi tanári kinevezésekről",
  "status": "in_force",
  "in_force_date": "2002-05-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2002-73-30-76",
  "description": "egyetemi tanári kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére, a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "2002. július hó 1. napjával"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Debreceni Egyetemen"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Szabadfalvi Józsefet, a Miskolci Egyetem egyetemi tanárát, a Debreceni Egyetem további jogviszonyban alkalmazott egyetemi docensét és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Miskolci Egyetemen"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Tóth László egyetemi docenst"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "egyetemi tanárrá kinevezem."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "KEH ügyszám: V-2/1989/2002."
    }
  ]
}
