{
  "id": "hu-law-1990-302-30-76",
  "type": "statute",
  "title": "302/1990. (XII. 18.) KE határozat városi címek adományozásáról",
  "status": "in_force",
  "in_force_date": "1991-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-302-30-76",
  "description": "városi címek adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "1. A települési önkormányzatok képviselőtestületeinek a kezdeményezésére, a belügyminiszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a) a Borsod-Abaúj-Zemplén megyében levő Mezőcsát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "b) a Hajdú-Bihar megyében levő Derecske,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "c) a Pest megyében levő Aszód"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "községeknek városi címet adományozok."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "2. Ez a határozat 1991. január 1-jén lép hatályba."
    }
  ]
}
