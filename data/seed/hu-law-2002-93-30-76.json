  "title": "93/2002. (VI. 5.) KE határozat rendőr vezérőrnagy kinevezéséről",
  "status": "in_force",
  "in_force_date": "2002-06-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2002-93-30-76",
  "description": "rendőr vezérőrnagy kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére dr. Salgó László r. dandártábornokot, az Országos Rendőr-főkapitányság vezetőjévé történő kinevezésével egy időben, a szakmai és vezetői munka terén kifejtett eredményes tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 2002. június 3-i hatállyal –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "rendőr vezérőrnaggyá"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: V-5/2089/2002."
    }
  ]
}
