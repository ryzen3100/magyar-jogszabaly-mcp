{
  "id": "hu-law-1990-74-40-00",
  "type": "statute",
  "title": "1990. MK 74. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1990-08-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-74-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1990. évi 60. számában kihirdetett, a földhivatalokról szóló 1/1990. (VI. 26.) FM rendelet 4. §-a tévesen jelent meg."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "A 4. § szövege helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,4. §"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(1) A földhivatal hivatalvezető irányítása alatt működik."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "(2) A munkáltatói jogkört a"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a) megyei földhivatal vezetője felett a miniszter,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "b) körzeti földhivatal vezetője és a megyei földhivatali dolgozók felett a megyei földhivatal vezetője,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "c) a körzeti földhivatal kirendeltségének vezetője és a körzeti földhivatali dolgozók felett – ideértve a körzeti földhivatal kirendeltségének a dolgozóit is – a körzeti földhivatal vezetője"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "gyakorolja.''"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "A Magyar Közlöny 1990. évi 68. számában kihirdetett"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "143/1990. (VII. 17.) KE,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "144/1990. (VII. 17.) KE,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "145/1990. (VII. 17.) KE,"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "határozatok címeiben az egyetemi tanárok helyett rektorok feltüntetése a helyes."
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "(Szerkesztőségi hiba)"
    }
  ]
}
