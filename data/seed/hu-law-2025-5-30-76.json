    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Balláné dr. Illés Ivettet,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kámán Petrát,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Kollárné dr. Varga Beátát,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Németh-Egry Emőkét és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Wayda Gertrúdot"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a 2025. február 1. napjától 2028. január 31. napjáig terjedő időtartamra bíróvá kinevezem."
    },
