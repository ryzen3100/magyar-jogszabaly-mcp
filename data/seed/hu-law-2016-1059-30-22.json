{
  "id": "hu-law-2016-1059-30-22",
  "type": "statute",
  "title": "1059/2016. (II. 25.) Korm. határozat „Életmentő Emlékérem” adományozásáról",
  "status": "in_force",
  "in_force_date": "2016-02-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/2016-1059-30-22",
  "description": "„Életmentő Emlékérem” adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány az „Életmentő Emlékérem” adományozásáról szóló 243/2009. (X. 29.) Korm. rendelet alapján, életmentés közben tanúsított hősies magatartása elismeréseként – a belügyminiszter mint helyi önkormányzatokért felelős miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "BUSCH PÉTER szegedi lakosnak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "KALLÓS ZSOLT makói lakosnak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "KISS KRISZTINA makói lakosnak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "LÉGRÁDI MÁTÉ tiszakóródi lakosnak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "LÉHMANN KRISZTIÁN kiszombori lakosnak,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "néhai DR. PILÁN MIHÁLYNAK,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "RIPPEL FERENC budapesti lakosnak,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "ZALKODI RÓBERT karcsai lakosnak"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "„Életmentő Emlékérmet” adományoz."
    }
  ]
}
