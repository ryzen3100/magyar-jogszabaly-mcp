{
  "id": "hu-law-2021-27-30-63",
  "type": "statute",
  "title": "27/2021. (V. 27.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2021-05-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/2021-27-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján – a honvédelmi miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Ruszin-Szendi Romuluszt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Honvédelmi Minisztérium helyettes államtitkárát – más fontos megbízatására tekintettel – e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2021. május 28-ai hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
