{
  "id": "hu-law-1999-65-40-00",
  "type": "statute",
  "title": "1999. MK 65. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1999-07-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/1999-65-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1999. évi 23. számában megjelent, a földgáz díjának megállapításáról szóló 11/1999. (III. 19.) GM rendelet 3. számú mellékletének a lábjegyzete helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "* Az 1+két 1/2 szobás lakás is idetartozik."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "** Az 1+három 1/2 szobás lakás is idetartozik."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "*** A 2+két 1/2 szobás lakás is idetartozik.''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(Nyomdahiba)"
    }
  ]
}
