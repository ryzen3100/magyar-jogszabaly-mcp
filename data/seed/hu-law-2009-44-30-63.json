{
  "id": "hu-law-2009-44-30-63",
  "type": "statute",
  "title": "44/2009. (VII. 10.) ME határozat a minisztériumok, a Miniszterelnöki Hivatal és a Kormányhivatalok besorolásáról",
  "status": "in_force",
  "in_force_date": "2009-07-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2009-44-30-63",
  "description": "a minisztériumok, a Miniszterelnöki Hivatal és a Kormányhivatalok besorolásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A költségvetési szervek jogállásáról és gazdálkodásáról szóló 2008. évi CV. törvény (a továbbiakban: Kt.) 44. § (4) bekezdése értelmében történt felülvizsgálat eredménye alapján – figyelemmel a Kt. 2. § (2) és 3. § (4) bekezdésében foglaltakra – a Kt. 15–16. §-a szerinti besorolás tekintetében"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– az Egészségügyi Minisztérium,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a Földművelésügyi és Vidékfejlesztési Minisztérium,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a Honvédelmi Minisztérium,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– az Igazságügyi és Rendészeti Minisztérium,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– a Környezetvédelmi és Vízügyi Minisztérium,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– a Közlekedési, Hírközlési és Energiaügyi Minisztérium,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– a Külügyminisztérium,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– a Nemzeti Fejlesztési és Gazdasági Minisztérium,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "– az Oktatási és Kulturális Minisztérium,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "– az Önkormányzati Minisztérium,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "– a Pénzügyminisztérium,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "– a Szociális és Munkaügyi Minisztérium,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "– a Miniszterelnöki Hivatal,"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "– a Központi Statisztikai Hivatal,"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "– a Nemzeti Hírközlési Hatóság,"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "– a Pénzügyi Szervezetek Állami Felügyelete,"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "– a Magyar Energia Hivatal,"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "– az Országos Atomenergia Hivatal,"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "– a Magyar Szabadalmi Hivatal,"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "– az Egészségbiztosítási Felügyelet"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "tevékenységének jellege alapján közhatalmi költségvetési szerv."
    }
  ]
}
