{
  "id": "hu-law-2010-47-30-63",
  "type": "statute",
  "title": "47/2010. (VI. 18.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2010-06-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-47-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 58/R. § (1) bekezdése alapján, a nemzeti erőforrás miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kálnoki-Gyöngyössy Mártont a Nemzeti Erőforrás Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2010. június 16-ai hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    }
  ]
}
