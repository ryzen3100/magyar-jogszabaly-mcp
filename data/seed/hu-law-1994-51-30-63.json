{
  "id": "hu-law-1994-51-30-63",
  "type": "statute",
  "title": "51/1994. (XII. 28.) ME határozat főiskolai tanári felmentésekről",
  "status": "amended",
  "in_force_date": "1994-12-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-51-30-63",
  "description": "főiskolai tanári felmentésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (3) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Berey Andrást 1995. június 30-i hatállyal és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Scharnitzky Viktort 1995. augusztus 31-i hatállyal,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Könnyűipari Műszaki Főiskola főiskolai tanárait"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "— nyugállományba vonulásukra tekintettel —"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "e tisztségükből felmentem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
