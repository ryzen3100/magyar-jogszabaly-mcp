{
  "id": "hu-law-2016-1373-30-22",
  "type": "statute",
  "title": "1373/2016. (VII. 21.) Korm. határozat „Életmentő Emlékérem” adományozásáról",
  "status": "in_force",
  "in_force_date": "2016-07-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/2016-1373-30-22",
  "description": "„Életmentő Emlékérem” adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány az „Életmentő Emlékérem” adományozásáról szóló 243/2009. (X. 29.) Korm. rendelet alapján, életmentés közben tanúsított hősies magatartása elismeréseként – a belügyminiszter mint helyi önkormányzatokért felelős miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Deli Attila mogyoródi lakosnak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Huszta Antal nagyberényi lakosnak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Sáfár Gergely budapesti lakosnak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Tóth Áron keszthelyi lakosnak"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "„Életmentő Emlékérmet” adományoz."
    }
  ]
}
