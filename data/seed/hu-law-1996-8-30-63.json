    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "főiskolai tanárrá – 1996. február 1-jei hatállyal – kinevezem."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Horn Gyula s. k., miniszterelnök"
