{
  "id": "hu-law-1997-122-40-00",
  "type": "statute",
  "title": "1997. MK 122. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1997-12-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-122-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1997. évi 104. számában kihirdetett, a vágósertés minőségi termelésének intervenciós támogatásáról szóló 87/1997. (XI. 26.) FM rendelet 5. §-ának első mondata helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,… 45/1997. (VI. 25.) FM rendelet és az azt módosító 57/1997. (VIII. 26.) FM rendelet hatályát veszti.''"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "A Magyar Közlöny 1997. évi 107. számában kihirdetett, a vágómarha minőségi termelésének intervenciós támogatásáról szóló 97/1997. (XII. 1.) FM rendelet 1. számú mellékletében a táblázat Minőségi osztály oszlopának"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "I. fajtacsoportjában a helyes szöveg:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": ",,… keresztezéseiből származó vágómarhák:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "hímivar extrém és I. osztály''"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "II. fajtacsoportjában a helyes szöveg:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,… keresztezett egyedei:"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "hímivar extrém és I. osztály''"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "(Kézirathiba)"
    }
  ]
}
