{
  "id": "hu-law-2007-130-20-0n",
  "type": "statute",
  "title": "130/2007. (XII. 27.) KvVM rendelet a Hajdúsági Tájvédelmi Körzet védettségének fenntartásáról",
  "status": "in_force",
  "in_force_date": "2008-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-130-20-0N",
  "description": "a Hajdúsági Tájvédelmi Körzet védettségének fenntartásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § Az egyes területek védetté nyilvánításáról szóló 2/1988. (V. 26.) KVM rendelet 1. § (1) bekezdése által védetté nyilvánított Hajdúsági Tájvédelmi Körzet védettségét fenntartom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § A Hajdúsági Tájvédelmi Körzet kiterjedése 7101,1 ha, ingatlan-nyilvántartási helyrajzi számait az 1. számú melléklet, fokozottan védett területének ingatlan-nyilvántartási helyrajzi számait a 2. számú melléklet tartalmazza."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A védettség indoka és célja a jellegzetes hajdúsági táj, valamint az élőhelyek változatosságának, a rájuk jellemző természetes növény- és állatvilág megőrzése."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § A terület természetvédelmi kezeléséért felelős szerv a Hortobágyi Nemzeti Park Igazgatóság."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5. §",
      "content": "5. § (1) Ez a rendelet 2008. január 1-jén lép hatályba. (2)"
    },
