      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "„14–21. §”"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– 7. § (2) bekezdésében a 22. §-ra való hivatkozás helyesen:"
