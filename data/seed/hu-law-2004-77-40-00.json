    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "„22. §-ban”"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 5. §-a helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "„Az 5. §-ból a (7), (8), (9) bekezdés elmarad, a (10) bekezdés számozása helyesen:"
