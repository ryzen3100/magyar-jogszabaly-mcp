      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "– 13. § (3) bekezdésének a) pontja helyesen:"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "„a) az a személy vagy szervezet, akit a tervpályázati eljárás előkészítésében vagy más szakaszába bevontak;”"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "– 14. §-a (4) bekezdésének j) pontja helyesen:"
