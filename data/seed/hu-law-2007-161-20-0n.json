{
  "id": "hu-law-2007-161-20-0n",
  "type": "statute",
  "title": "161/2007. (XII. 27.) KvVM rendelet a Borsodi-Mezőség Tájvédelmi Körzet védettségének fenntartásáról",
  "status": "in_force",
  "in_force_date": "2008-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-161-20-0N",
  "description": "a Borsodi-Mezőség Tájvédelmi Körzet védettségének fenntartásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § A tájvédelmi körzetek létesítéséről szóló 9/1989. (VIII. 24.) KVM rendelet 5. §-a által védetté nyilvánított Borsodi-Mezőség Tájvédelmi Körzet védettségét fenntartom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § A Borsodi-Mezőség Tájvédelmi Körzet kiterjedése 17932,2 ha, ingatlan-nyilvántartási helyrajzi számait a melléklet tartalmazza."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A védettség indoka és célja a terület tájképi és kultúrtörténeti értékeinek megóvása, a még háborítatlan sztyepprétek változatos növény- és állatvilágának megőrzése, a természetes pusztai környezetben élő túzok (Otis tarda) fészkelő- és táplálkozóhelyének biztosítása."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § A terület természetvédelmi kezeléséért felelős szerv a Bükki Nemzeti Park Igazgatóság."
    },
