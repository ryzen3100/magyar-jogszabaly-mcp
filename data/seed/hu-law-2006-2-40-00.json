{
  "id": "hu-law-2006-2-40-00",
  "type": "statute",
  "title": "2006. MK 2. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2006-01-06",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-2-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2005. évi 166. számában kihirdetett 42/2005. (XII. 22.) PM rendelet 6., 7., 8., 9. és 10. számú mellékletében módosított rendeletre való hivatkozás helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "„[...melléklet a 13/1991. (V. 21.) PM rendelethez]”"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "A Magyar Közlöny 2005. évi 171. számának I. kötetében kihirdetett 34/2005. (XII. 28.) NKÖM rendelet 2. számú mellékletének jelölése helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "„2. számú melléklet a 34/2005. (XII. 28.) NKÖM rendelethez”"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(Nyomdahiba)"
    }
  ]
}
