{
  "id": "hu-law-1990-254-30-76",
  "type": "statute",
  "title": "254/1990. (X. 24.) KE határozat rendőr vezérőrnagyi kinevezésekről",
  "status": "in_force",
  "in_force_date": "1990-10-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-254-30-76",
  "description": "rendőr vezérőrnagyi kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. §-ának (1) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– az 1956. évi forradalom és szabadságharc, valamint a Magyar Köztársaság kikiáltásának évfordulója alkalmából –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Herpai Sándor nyugállományú rendőr ezredest,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Kiss István rendőr ezredest,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Varga Lajos rendőr ezredest"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "rendőr vezérőrnaggyá kinevezem."
    }
  ]
}
