{
  "id": "hu-law-2000-1-30-84",
  "type": "statute",
  "title": "1/2000. (IX. 29.) MeHVM határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2000-09-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-1-30-84",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 36. §-a alapján, a Miniszterelnöki Hivatal közigazgatási államtitkára javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Zöldné Roska Mariettát, a Miniszterelnöki Hivatal helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2000. október 1-jei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
