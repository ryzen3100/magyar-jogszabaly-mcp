{
  "id": "hu-law-2016-118-30-63",
  "type": "statute",
  "title": "118/2016. (XI. 18.) ME határozat állami felsőoktatási intézmény kancellárjának megbízásáról",
  "status": "in_force",
  "in_force_date": "2016-11-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/2016-118-30-63",
  "description": "állami felsőoktatási intézmény kancellárjának megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (4a) bekezdésében foglalt jogkörömben eljárva – az oktatásért felelős miniszter előterjesztése alapján –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Óbudai Egyetemen Szigeti Ádámot"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2016. november 1-jétől 2019. október 31-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a kancellári teendők ellátásával megbízom."
    }
  ]
}
