{
  "id": "hu-law-2001-97-30-76",
  "type": "statute",
  "title": "97/2001. (VIII. 27.) KE határozat Daruszentmiklós községgé nyilvánításáról",
  "status": "in_force",
  "in_force_date": "2002-10-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2001-97-30-76",
  "description": "Daruszentmiklós községgé nyilvánításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére Előszállás nagyközség Daruhegy és Kisszentmiklós elnevezésű településrészeit Daruszentmiklós néven községgé nyilvánítom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Ez a határozat a kihirdetését követő önkormányzati általános választás napjával lép hatályba."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Budapest, 2001. augusztus 23."
    }
  ]
}
