      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Kossuth-díjról és a Széchenyi-díjról szóló 1990. évi XII. törvény 5. § (1) bekezdése alapján, a Kormány előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "több évtizedes művészi pályája során drámai, vígjáték- és filmszerepekben nyújtott hiteles, karakteres színészi alakításaiért"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Blaskó Péternek, a Nemzeti Színház Jászai Mari-díjas színművésznek, Érdemes Művésznek,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Kossuth-díjat"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "adományozom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VIII-2/01416/2011."
    }
  ]
