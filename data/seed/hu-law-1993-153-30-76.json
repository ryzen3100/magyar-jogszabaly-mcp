{
  "id": "hu-law-1993-153-30-76",
  "type": "statute",
  "title": "153/1993. (XII. 22.) KE határozat címzetes államtitkárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "1993-12-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/1993-153-30-76",
  "description": "címzetes államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Barsiné Pataky Etelkát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— az 1996. évi Budapesti Világkiállítással kapcsolatos kormányzati feladatok ellátására —;"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Entz Gézát"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "— a határon túli magyarok ügyei kormányzati feladatainak koordinálására —;"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Kodolányi Gyulát"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "— a külföldi kapcsolattartásban a miniszterelnök személyes megbízottja feladatainak ellátására —;"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Marinovich Endrét"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "— a Miniszterelnöki Kabinetiroda vezetői teendőinek ellátására —;"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Morvay Istvánt"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "— a menekültüggyel és a migrációval kapcsolatos kormányzati feladatok irányítására —;"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "dr. Pick Róbert ezredest, a Magyar Köztársaság Elnökének Katonai Irodája vezetőjét, főhadsegédet"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "— a Honvédelmi Minisztériummal, valamint a Magyar Honvédség Parancsnokságával való közvetlen kapcsolattartás ellátására —;"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "dr. Pongrácz Tibort"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "— dr. Szabó Tamás tárca nélküli miniszter irányítása alatt a privatizációval kapcsolatos kormányzati feladatokban való közreműködésre —;"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "dr. Sepsey Tamást"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "— az Országos Kárrendezési és Kárpótlási Hivatal elnöki feladatainak ellátására —;"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "Szunyogh Károlyt"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "— a Köztársasági Elnöki Hivatal vezetői feladatai, valamint a Miniszterelnöki Hivatal közigazgatási államtitkárával való közvetlen kapcsolattartás ellátására —;"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "címzetes államtitkárrá"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "— 1993. december 21-i hatállyal —"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "kinevezem."
    }
  ]
}
