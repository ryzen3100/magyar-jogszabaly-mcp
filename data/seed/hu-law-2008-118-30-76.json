{
  "id": "hu-law-2008-118-30-76",
  "type": "statute",
  "title": "118/2008. (IV. 30.) KE határozat államtitkárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2008-04-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-118-30-76",
  "description": "államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 46. § (2) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Vojnik Máriát az Egészségügyi Minisztérium államtitkárává,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Puch Lászlót a Gazdasági és Közlekedési Minisztérium államtitkárává,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Oláh Lajost a Környezetvédelmi és Vízügyi Minisztérium államtitkárává,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2008. május 1-jei hatállyal kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: IV-2/02339/2008."
    }
  ]
}
