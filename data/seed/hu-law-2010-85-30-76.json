{
  "id": "hu-law-2010-85-30-76",
  "type": "statute",
  "title": "85/2010. (V. 5.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2010-05-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-85-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a külügyminiszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Wieslawa Kozaka-Jaworskanak, a Magyar–Lengyel Baráti Társaság elnökének,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Józef Niezgodanak, a Lódïi Műszaki Egyetem nyugalmazott mérnöktanárának, a Magyar–Lengyel Baráti Társaság tagjának,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Hermann Pühringernek, a Felső-Ausztriai Gazdasági Kamara nemzetközi szekciójának vezetőjének a"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(polgári tagozat);"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Miroslaw Felińczaknak, a Magyar–Lengyel Baráti Társaság tagjának a"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "MAGYAR KÖZTÁRSASÁGI BRONZ ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(polgári tagozat)"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "KEH ügyszám: VIII-1/01441/2010."
    }
  ]
}
