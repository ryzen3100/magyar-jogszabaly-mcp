  "title": "176/2003. (IX. 19.) KE határozat rektori megbízásról",
  "status": "in_force",
  "in_force_date": "2003-09-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-176-30-76",
  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszternek – a fenntartóval egyetértésben tett – előterjesztésére, a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Andrássy Gyula Budapesti Német Nyelvű Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kengyel Miklós egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2003. szeptember hó 15. napjával,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– kétéves időtartamra – megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-2/3537/2003."
    }
  ]
}
