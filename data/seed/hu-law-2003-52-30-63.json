{
  "id": "hu-law-2003-52-30-63",
  "type": "statute",
  "title": "52/2003. (IV. 24.) ME határozat főiskolai tanár felmentéséről",
  "status": "in_force",
  "in_force_date": "2003-04-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-52-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló – többször módosított – 1993. évi LXXX. törvény 73. § a) pontja alapján, az oktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Bagyinszki Jánost, a Budapesti Műszaki Főiskola főiskolai tanárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– közalkalmazotti jogviszonyának közös megegyezéssel történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2003. március 17-i hatállyal e tisztségéből"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
