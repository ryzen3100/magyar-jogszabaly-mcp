  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "új munkahelyek teremtése, a német termelőtőke magyarországi beruházásai, a magyar–német műszaki és gazdasági kapcsolatok fejlesztése érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Wendel Schindele, a Wentech International Consulting Kft. ügyvezető igazgatója részére a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "középkeresztje"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "polgári tagozata,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a magyar zenei kultúra ápolásáért, fejlesztéséért, nemzetközi elismerésének erősítéséért, több évtizedes kiemelkedő művészeti és oktatói tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Gazsi Lajosné Laki Krisztina operaénekesnek, a brémai Hochschule für Künste tiszteletbeli professzorának a"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
