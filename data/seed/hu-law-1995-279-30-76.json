    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1996. augusztus 31. napjával és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Kecskés Sándor egyetemi tanárt"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "1996. szeptember 30. napjával"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "— nyugállományba vonulásukra tekintettel — e tisztségük alól felmentem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
