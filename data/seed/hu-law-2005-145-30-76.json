  "description": "katonai bíró felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 48. §-ának (2) bekezdésében foglalt jogkörömben, az Országos Igazságszolgáltatási Tanács és a honvédelmi miniszter együttes előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Habony Jánost"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2005. szeptember 30-i hatállyal – bírói tisztségének megtartása mellett – katonai bírói tisztségéből felmentem."
    },
    {
      "provision_ref": "s4",
