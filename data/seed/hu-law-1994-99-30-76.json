{
  "id": "hu-law-1994-99-30-76",
  "type": "statute",
  "title": "99/1994. (VII. 18.) KE határozat miniszterek kinevezéséről",
  "status": "amended",
  "in_force_date": "1994-07-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-99-30-76",
  "description": "miniszterek kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Baja Ferencet környezetvédelmi és területfejlesztési miniszterré,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Békesi Lászlót pénzügyminiszterré,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Fodor Gábort művelődési és közoktatási miniszterré,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Katona Bélát tárca nélküli miniszterré,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Keleti Györgyöt honvédelmi miniszterré,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Kovács Lászlót külügyminiszterré,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Kovács Pált népjóléti miniszterré,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Kósáné dr. Kovács Magdát munkaügyi miniszterré,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Kuncze Gábort belügyminiszterré,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "dr. Lakos Lászlót földművelésügyi miniszterré,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "dr. Lotz Károlyt közlekedési, hírközlési és vízügyi miniszterré,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Pál Lászlót ipari és kereskedelmi miniszterré,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "dr. Vastagh Pált igazságügy-miniszterré"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "— 1994. július 15-i hatállyal — kinevezem."
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
