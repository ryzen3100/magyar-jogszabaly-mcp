{
  "id": "hu-law-2019-51-30-63",
  "type": "statute",
  "title": "51/2019. (V. 7.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2019-05-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/2019-51-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az emberi erőforrások miniszterének előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Szilágyiné dr. Szinger Ibolyát az Eötvös József Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2019. május 10-étől 2024. május 9-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
