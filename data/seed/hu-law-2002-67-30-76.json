  "description": "politikai államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 19. §-a alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Pál Tibort a Belügyminisztérium,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Göncz Kingát és Kökény Mihályt az Egészségügyi, Szociális és Családügyi Minisztérium,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Csizmár Gábort a Foglalkoztatáspolitikai és Munkaügyi Minisztérium,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Szanyi Tibort a Földművelésügyi és Vidékfejlesztési Minisztérium,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Szalay Gábort a Gazdasági és Közlekedési Minisztérium,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Mesterházi Attilát a Gyermek-, Ifjúsági és Sportminisztérium,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Iváncsik Imrét a Honvédelmi Minisztérium,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Hankó Faragó Miklóst az Igazságügyi Minisztérium,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Kis Zoltánt a Környezetvédelmi és Vízügyi Minisztérium,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Bársony Andrást a Külügyminisztérium,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Kocsi Lászlót a Nemzeti Kulturális Örökség Minisztériuma,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Hiller Istvánt az Oktatási Minisztérium,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Burány Sándort a Pénzügyminisztérium,"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "Szabó Vilmost a Miniszterelnöki Hivatal"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "politikai államtitkárává"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "– 2002. május 27-i hatállyal –"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "kinevezem."
