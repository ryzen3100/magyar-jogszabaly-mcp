{
  "id": "hu-law-2022-85-30-63",
  "type": "statute",
  "title": "85/2022. (X. 24.) ME határozat főispán kinevezéséről",
  "status": "in_force",
  "in_force_date": "2022-10-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/2022-85-30-63",
  "description": "főispán kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 207. § (1) bekezdésében foglalt jogkörömben eljárva"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– a Miniszterelnökséget vezető miniszter javaslatára –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Róth Mártont a Csongrád-Csanád Megyei Kormányhivatalt vezető főispánná"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2022. november 1-jei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    }
  ]
}
