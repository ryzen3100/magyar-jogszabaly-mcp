  "title": "6/2022. (III. 10.) OGY határozat köztársasági elnök megválasztásáról",
  "status": "in_force",
  "in_force_date": "2022-03-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2022-6-30-41",
  "description": "köztársasági elnök megválasztásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "1. Az Országgyűlés az Alaptörvény 10. cikk (1) bekezdése alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Novák Katalint"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "köztársasági elnökké megválasztja."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Az Alaptörvény 11. cikk (6) bekezdése alapján a megválasztott köztársasági elnök 2022. év május hó 10. napján lép hivatalba."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2. Ez a határozat az elfogadásakor lép hatályba. 1 A határozatot az Országgyűlés a 2022. március 10-i ülésnapján fogadta el."
    }
  ]
}
