{
  "id": "hu-law-2016-95-30-63",
  "type": "statute",
  "title": "95/2016. (IX. 15.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2016-09-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2016-95-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az oktatásért felelős miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Pápai Református Teológiai Akadémián"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Németh Tamás egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2016. szeptember 1-jétől 2021. augusztus 31-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
