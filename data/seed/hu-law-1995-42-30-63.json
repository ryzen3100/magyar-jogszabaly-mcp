{
  "id": "hu-law-1995-42-30-63",
  "type": "statute",
  "title": "42/1995. (XI. 22.) ME határozat főiskolai főigazgató megbízásáról",
  "status": "amended",
  "in_force_date": "1995-11-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-42-30-63",
  "description": "főiskolai főigazgató megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 56. §-ának (2) és (5) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Sámsondi Kiss György főiskolai tanárt az Ybl Miklós Műszaki Főiskolán a főigazgatói teendők ellátásával"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— 1996. január 1-jei hatállyal, háromévi időtartamra —"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megbízom."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
