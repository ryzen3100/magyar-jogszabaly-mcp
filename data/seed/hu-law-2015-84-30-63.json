{
  "id": "hu-law-2015-84-30-63",
  "type": "statute",
  "title": "84/2015. (X. 6.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2015-10-06",
  "url": "https://njt.jog.gov.hu/jogszabaly/2015-84-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 221. § (2) bekezdésének c) pontja alapján – az emberi erőforrások miniszterének javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Kiss Norbertet, az Emberi Erőforrások Minisztériuma helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2015. szeptember 30-ai hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
