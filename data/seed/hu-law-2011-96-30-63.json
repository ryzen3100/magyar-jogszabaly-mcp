  "title": "96/2011. (XI. 8.) ME határozat főiskolai tanár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2011-11-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-96-30-63",
  "description": "főiskolai tanár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés b) pontjában foglalt jogkörömben – a nemzeti erőforrás miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kovács Edith Alice-t"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2011. november 15-ei hatállyal – és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Suhányi Erzsébetet"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2011. december 1-jei hatállyal – főiskolai tanárrá kinevezem."
    }
  ]
}
