    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Pálinkásné dr. Sümegi Irént 2008. június 30-i hatállyal,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "bírói tisztségének ellátására tartósan – egészségügyi okból – alkalmatlanná válása miatt"
