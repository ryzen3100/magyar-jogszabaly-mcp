{
  "id": "hu-law-2006-195-30-76",
  "type": "statute",
  "title": "195/2006. (XI. 3.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2006-11-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-195-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján az egészségügyi miniszter előterjesztésére, eredményes munkája elismeréseként"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Gritz Arnoldnénak, a Budapest XVII. ker. Önkormányzat Egészségügyi Szolgálat tanácsosának, egészségnevelőnek a"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(polgári tagozata);"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Kende Józsefnek, a tatabányai Szent Borbála Kórház ny. bányaorvosának, üzemorvosnak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Sztojcsev Stefánnak, a Veszprém Megyei Csolnoky Ferenc Kórház-Rendelőintézet főorvosának a"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "(polgári tagozata)"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "KEH ügyszám: VII-2/4337/2006."
    }
  ]
}
