  "in_force_date": "1993-07-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/1993-77-30-76",
  "description": "rektori megbízásokról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A földművelésügyi miniszter előterjesztésére 1993. július 1. napjával kezdődően a rektori teendők ellátásával"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kocsis Károly egyetemi tanárt, a Gödöllői Agrártudományi Egyetemre újabb 3 éves,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Sáringer Gyula akadémikust, a Pannon Agrártudományi Egyetemre 3 éves"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "időtartamra megbízom."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Dr. Szabó János s. k., földművelésügyi miniszter"
    }
  ]
}
