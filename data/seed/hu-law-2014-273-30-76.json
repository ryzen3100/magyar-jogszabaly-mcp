{
  "id": "hu-law-2014-273-30-76",
  "type": "statute",
  "title": "273/2014. (VII. 25.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2014-07-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/2014-273-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés f) pontja, illetve a Magyarország címerének és zászlajának használatáról, valamint állami kitüntetéseiről szóló 2011. évi CCII. törvény 18. § (1) bekezdése alapján – a miniszterelnök előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a magyar–szaúdi gazdasági kapcsolatok fejlesztése terén kifejtett tevékenységéért"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Alwaleed bin Talal bin Abdulaziz Al-Saud, a Szaúd-arábiai Királyság uralkodócsaládjának tagja, üzletember, nagybefektető részére a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR ÉRDEMREND KÖZÉPKERESZTJE"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "polgári tagozata"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "KEH ügyszám: VIII-1/03440-1/2014."
    }
  ]
}
