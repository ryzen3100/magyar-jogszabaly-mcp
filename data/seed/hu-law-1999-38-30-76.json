{
  "id": "hu-law-1999-38-30-76",
  "type": "statute",
  "title": "38/1999. (II. 24.) KE határozat az ülnökök választásáról",
  "status": "amended",
  "in_force_date": "1999-02-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/1999-38-30-76",
  "description": "az ülnökök választásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Országos Igazságszolgáltatási Tanács elnökének előterjesztésére:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. A bírák jogállásáról és javadalmazásáról szóló 1997. évi LXVII. törvény 124. § (1) bekezdése alapján a Fővárosi Bíróság, a megyei bíróságok, a helyi (városi, kerületi) bíróságok és a munkaügyi bíróságok ülnökeit 1999. március 15. és április 22. napja között kell megválasztani."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2. Ez a határozat a kihirdetése napján lép hatályba."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Budapest, 1999. február 4."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
