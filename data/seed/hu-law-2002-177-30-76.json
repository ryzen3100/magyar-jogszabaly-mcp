{
  "id": "hu-law-2002-177-30-76",
  "type": "statute",
  "title": "177/2002. (XI. 18.) KE határozat egyetemi tanári kinevezésről",
  "status": "in_force",
  "in_force_date": "2002-11-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/2002-177-30-76",
  "description": "egyetemi tanári kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére, a felsőoktatásról szóló 1993. évi LXXX. törvény 71. §-ának (1) bekezdésében foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Színház és Filmművészeti Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Karsai Györgyöt, a Pécsi Tudományegyetem egyetemi tanárát, a Színház és Filmművészeti Egyetem további jogviszonyban alkalmazott oktatóját"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2002. november hó 15. napjával"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "egyetemi tanárrá kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-2/3813/2002."
    }
  ]
}
