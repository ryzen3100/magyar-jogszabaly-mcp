{
  "id": "hu-law-1994-135-30-76",
  "type": "statute",
  "title": "135/1994. (VIII. 19.) KE határozat dandártábornoki kinevezésekről",
  "status": "amended",
  "in_force_date": "1994-08-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-135-30-76",
  "description": "dandártábornoki kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A honvédelmi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "állami ünnepünk, augusztus 20-a alkalmából"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Bátor Ferenc ezredest, a 2. Katonai Kerület parancsnokhelyettesét,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Havril András ezredest, a 3. Katonai Kerület törzsfőnökét (parancsnok első helyettes),"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Kálmán Ferenc ezredest, a Szárazföldi Csapatok tüzérfőnökét,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Tánczos László ezredest, az 1. Katonai Kerület parancsnokát"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dandártábornokká"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Keleti György s. k., honvédelmi miniszter"
    }
  ]
}
