  "title": "203/2006. (XI. 3.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2006-11-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-203-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a pénzügyminiszter előterjesztésére, eredményes munkája elismeréseként"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Klambauer György alezredesnek, a Vám- és Pénzügyőrség Országos Parancsnoksága Jövedéki Igazgatóság osztályvezetőjének,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Molnár Dénes alezredesnek, a Fővámhivatal Miskolc–Sátoraljaújhelyi Kirendeltsége vezetőjének a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "(katonai tagozata)"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "KEH ügyszám: VII-2/4345/2006."
    }
  ]
}
