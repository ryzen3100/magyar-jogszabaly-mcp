{
  "id": "hu-law-1999-11-40-00",
  "type": "statute",
  "title": "1999. MK 11. szám helyesbítés Helyesbítés",
  "status": "in_force",
  "in_force_date": "1999-02-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/1999-11-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1998. évi 121. számában kihirdetett, a mezőgazdasági termelők agrártámogatás igénybevételével összefüggő adatszolgáltatásáról és nyilvántartásba vételéről szóló 236/1998. (XII. 30.) Korm. rendelet 5., 6., 7., 8., 9., 10. §-ai helyesen: 4., 5., 6., 7., 8., 9. §."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "A Magyar Közlöny 1998. évi 122. számában kihirdetett, az állatkísérletek végzéséről szóló 243/1998. (XII. 31.) Korm. rendelet"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 3. §-a helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "[f) igazságügyi orvostani vizsgálatok:]"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": ",,g) speciális kísérleti állatok tenyésztése.''"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– 2. számú melléklete 5. pontjának tizenhatodik sora helyesen:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": ",,igazságügyi orvostani vizsgálatok''"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– 3. számú mellékletének első táblázata új sorral egészül ki:"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "[egér (Mus musculus)]"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": ",,patkány (Rattus norvegiqus)''"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "– 4. számú melléklete 4. pontjának tizenhatodik sora helyesen:"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": ",,igazságügyi orvostani vizsgálatok''"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "A Magyar Közlöny 1999. évi 2. számában kihirdetett, minőségi vágóbaromfi termelés támogatásáról szóló 3/1999. (I. 14.) FVM rendelet"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "– 2. §-a (1) bekezdésének második mondata helyesen:"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "»A háromszázharmincezer tonna vágóbaromfin belül legfeljebb egyszázhatvanezer tonna lehet a,,0105 92 00 99, valamint a 0105 93 00 99 vámtarifaszám alá tartozó Gallus domesticus fajba tartozó 8 hétnél nem idősebb szárnyasok'' (a továbbiakban: vágócsirke) mennyisége.«"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "– mellékletének 1. sora helyébe az alábbiak kerülnek:"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "----------------------"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "Vámtarifa termékszám Árumegnevezés"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "S: MSZ szakasza"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "M: Vágóbaromfi megnevezése MSZ 6918/1997. szerint"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "----------------------"
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": ",,"
    },
    {
      "provision_ref": "s25",
      "section": "25",
      "title": "25",
      "content": "ex 0105 92 00 99 vágócsirke"
    },
    {
      "provision_ref": "s26",
      "section": "26",
      "title": "26",
      "content": "S: 1.2. M: Pecsenyecsirke (brojler)"
    },
    {
      "provision_ref": "s27",
      "section": "27",
      "title": "27",
      "content": "ex 0105 93 00 99 vágócsirke"
    },
    {
      "provision_ref": "s28",
      "section": "28",
      "title": "28",
      "content": "S: 1.2. M: Pecsenyecsirke (brojler)"
    },
    {
      "provision_ref": "s29",
