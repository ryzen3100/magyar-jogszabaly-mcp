      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2004. évi 83. számában kihirdetett, a közúti közlekedési igazgatási hatósági eljárások díjairól szóló 29/2004. (VI. 16.) BM rendelet 3. számú mellékletének 4.2. alpontja helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "„4.2. Megengedett legnagyobb össztömeg 7,5 t-tól 18 600”"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(Kézirathiba)"
    }
  ]
}
