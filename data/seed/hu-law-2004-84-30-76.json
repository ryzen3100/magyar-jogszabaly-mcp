{
  "id": "hu-law-2004-84-30-76",
  "type": "statute",
  "title": "84/2004. (IX. 3.) KE határozat szolgálati viszony megszüntetéséről",
  "status": "in_force",
  "in_force_date": "2004-09-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-84-30-76",
  "description": "szolgálati viszony megszüntetéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Magyar Köztársaság Alkotmányáról szóló 1949. évi XX. törvény 30/A. § (1) bekezdés i) pontja, a honvédelemről szóló 1993. évi CX. törvény 7. § (2) bekezdés a) pontja, valamint a Magyar Honvédség hivatásos és szerződéses állományú katonáinak jogállásáról szóló 2001. évi XCV. törvény 62. § (1) bekezdés a) pontja alapján, figyelembe véve, hogy a hivatásos szolgálat felső korhatárát elérte,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "hivatásos szolgálati viszonyát 2004. szeptember 14-i hatállyal"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "megszüntetem"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Szekeres István dandártábornoknak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a HM Közigazgatási Államtitkár főtanácsadójának (főosztályvezető)."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-5/3280/2004."
    }
  ]
}
