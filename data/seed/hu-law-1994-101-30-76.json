{
  "id": "hu-law-1994-101-30-76",
  "type": "statute",
  "title": "101/1994. (VII. 18.) KE határozat címzetes államtitkárok kinevezéséről",
  "status": "amended",
  "in_force_date": "1994-07-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-101-30-76",
  "description": "címzetes államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Apró Piroskát a Miniszterelnöki Kabinetiroda vezetői teendőinek ellátására,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Pick Róbert ezredest, főhadsegédet a Honvédelmi Minisztériummal, valamint a Magyar Honvédség Parancsnokságával való közvetlen kapcsolattartás ellátására,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Szunyogh Károlyt a Köztársasági Elnöki Hivatal vezetői feladatai, valamint a Miniszterelnöki Hivatal közigazgatási államtitkárával való közvetlen kapcsolattartás ellátására"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "címzetes államtitkárrá — 1994. július 15-i hatállyal — kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
