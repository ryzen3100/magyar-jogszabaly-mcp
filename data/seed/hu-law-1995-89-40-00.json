{
  "id": "hu-law-1995-89-40-00",
  "type": "statute",
  "title": "1995. MK 89. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1995-10-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-89-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1995. évi 41. számában közzétett, a közbeszerzésekről szóló 1995. évi XL. törvény 93. §-a helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,A 89. § (3) bekezdése szerinti ügyben eljáró bíróság másodfokú határozata ellen nincs helye a Pp. XIV. fejezete szerinti felülvizsgálatnak.''"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "A Magyar Közlöny 1995. évi 43. számában kihirdetett, a területfejlesztés kedvezményezett területeinek jegyzékéről szóló 61/1995. (V. 30.) Korm. rendeletben, a 2003. oldalon két tétel hibásan jelent meg."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Helyesen a következő:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "[Nógrád megye]"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": ",,Bér 1 0 0"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Cered 0 0 1''"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Nyomdahiba)"
    }
  ]
}
