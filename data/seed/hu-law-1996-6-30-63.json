{
  "id": "hu-law-1996-6-30-63",
  "type": "statute",
  "title": "6/1996. (I. 26.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1996-01-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-6-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Fábián Zoltánt, a Jászberényi Tanítóképző Főiskola főiskolai tanárát, 1996. május 31-i hatállyal"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– nyugállományba vonulására tekintettel –;"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Nagy Jánost, a Pénzügyi és Számviteli Főiskola főiskolai tanárát, 1996. január 31-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– közalkalmazotti jogviszonyának megszűnésére tekintettel –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
