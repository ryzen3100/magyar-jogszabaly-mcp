  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 29. §-ának (1) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Szilvásy Györgyöt, a Környezetvédelmi és Területfejlesztési Minisztérium közigazgatási államtitkárát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Gilyán György és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Honti Mária közigazgatási államtitkárokat"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "e tisztségükből 1998. július 14-i hatállyal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "felmentem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Budapest, 1998. július 14."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
