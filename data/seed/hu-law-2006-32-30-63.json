{
  "id": "hu-law-2006-32-30-63",
  "type": "statute",
  "title": "32/2006. (VI. 26.) ME határozat főiskolai rektorok megbízásáról",
  "status": "in_force",
  "in_force_date": "2006-06-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-32-30-63",
  "description": "főiskolai rektorok megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) pontjában foglalt jogkörömben – az oktatási miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Modern Üzleti Tudományok Főiskoláján"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kandikó József főiskolai tanárt – 2006. augusztus 1-jétől 2010. július 31-ig terjedő időtartamra –,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Sola Scriptura Teológiai Főiskolán"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Vankó Zsuzsanna főiskolai tanárt – 2006. augusztus 1-jétől 2010. július 31-ig terjedő időtartamra –,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Pápai Református Teológiai Akadémián"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Vladár Gábor főiskolai tanárt – 2006. július 1-jétől 2011. június 30-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
