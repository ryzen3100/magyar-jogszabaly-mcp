    },
    {
      "provision_ref": "s29",
      "section": "29",
      "title": "29",
      "content": "— a Szabályzat 12. Melléklete 2. a) pontjának szövege helyesen a következő:"
    },
    {
      "provision_ref": "s30",
      "section": "30",
      "title": "30",
      "content": "a) a rendező szervezet/személy nevét és címét, telefon-, telefax- és/vagy telexszámát,"
    },
    {
