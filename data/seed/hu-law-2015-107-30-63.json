{
  "id": "hu-law-2015-107-30-63",
  "type": "statute",
  "title": "107/2015. (XI. 26.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2015-11-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2015-107-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az oktatásért felelős miniszter előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Tenk Miklósné dr. Zsebe Andrea főiskolai tanárt a Pető András Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2015. november 25-étől 2018. november 24-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
