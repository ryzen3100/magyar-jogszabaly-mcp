  "type": "statute",
  "title": "28/2003. (III. 4.) KE határozat miniszteri megbízatás megszűnésének megállapításáról",
  "status": "in_force",
  "in_force_date": "2003-03-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-28-30-76",
  "description": "miniszteri megbízatás megszűnésének megállapításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 13. §-a alapján megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kiss Elemér Miniszterelnöki Hivatalt vezető miniszternek e megbízatása"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "lemondására tekintettel"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2003. február 21-i hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megszűnt."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-1/0753/2003."
    }
  ]
