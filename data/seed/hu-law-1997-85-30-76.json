{
  "id": "hu-law-1997-85-30-76",
  "type": "statute",
  "title": "85/1997. (VI. 5.) KE határozat városi cím adományozásáról",
  "status": "in_force",
  "in_force_date": "1997-07-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-85-30-76",
  "description": "városi cím adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére az alábbi nagyközségeknek városi címet adományozok:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. a Baranya megyében lévő:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Bóly,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Sellye;"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2. a Bács-Kiskun megyében lévő:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Izsák,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Solt;"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "3. a Borsod-Abaúj-Zemplén megyében lévő:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Felsőzsolca;"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "4. a Fejér megyében lévő:"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Polgárdi;"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "5. a Jász-Nagykun-Szolnok megyében lévő:"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Újszász"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "6. a Pest megyében lévő:"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "Gyál,"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "Pilisvörösvár;"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "7. a Szabolcs-Szatmár-Bereg megyében lévő:"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "Nagyecsed;"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "8. a Veszprém megyében lévő:"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "Devecser;"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "9. a Zala megyében lévő:"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "Zalakaros."
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "Ez a határozat 1997. július 1. napján lép hatályba."
    }
  ]
}
