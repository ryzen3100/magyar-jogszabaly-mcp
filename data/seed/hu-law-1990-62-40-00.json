{
  "id": "hu-law-1990-62-40-00",
  "type": "statute",
  "title": "1990. MK 62. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1990-06-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-62-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1990. évi 27. számában megjelent a 64/1990. (III. 27.) MT rendelet A települési körről, ahol az adóalanyt vállalkozási nyereségadó- és általános forgalmi adó kedvezmény illeti meg. A rendelet mellékletében felsorolt egyes települések neve tévesen jelent meg. Helyes megnevezésük a következő:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,– Borsod-Abaúj-Zemplén megye"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Alsótelkes helyesen Alsótelekes"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Látszacséke helyesen Lácacséke"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– Csongrád megye"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Zsákányszék helyesen Zákányszék"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– Nógrád megye"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Kisecsed helyesen Kisecset''"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": ",,– Vas megye"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Egyházasdaróc helyesen Egyházasrádóc.''"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "(Kézirathiba)"
    }
  ]
}
