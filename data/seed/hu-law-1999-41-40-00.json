    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "A Magyar Közlöny 1999. évi 12. számában kihirdetett, a gyógyszerek rendeléséről és kiadásáról szóló 3/1995. (II. 8.) NM rendelet módosításáról rendelkező 4/1999. (II. 15.) EüM rendelet"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "– 1. számú mellékletének I. Csoportja"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "Vény nélkül is kiadható gyógyszerek"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "= Törzskönyvezett gyógyszerkészítmények"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": ",,Maalox 2DC rágótabl. 40x'' szövegrész törlésre kerül;"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "= Gyógytápszerek"
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": ",,Gain 450 g'' szövegrész törlésre kerül;"
    },
    {
      "provision_ref": "s25",
      "section": "25",
      "title": "25",
      "content": "– 1. számú mellékletének II. Csoportja"
    },
    {
      "provision_ref": "s26",
