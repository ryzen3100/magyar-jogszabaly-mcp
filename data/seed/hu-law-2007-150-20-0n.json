{
  "id": "hu-law-2007-150-20-0n",
  "type": "statute",
  "title": "150/2007. (XII. 27.) KvVM rendelet a Kelet-cserháti Tájvédelmi Körzet védettségének fenntartásáról",
  "status": "in_force",
  "in_force_date": "2008-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-150-20-0N",
  "description": "a Kelet-cserháti Tájvédelmi Körzet védettségének fenntartásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § A tájvédelmi körzetek létesítéséről szóló 9/1989. (VIII. 24.) KVM rendelet 1. § (1) bekezdése által védetté nyilvánított Kelet-cserháti Tájvédelmi Körzet védettségét fenntartom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § A Kelet-cserháti Tájvédelmi Körzet kiterjedése 7425 ha, ingatlan-nyilvántartási helyrajzi számait az 1. számú melléklet, fokozottan védett területének helyrajzi számait a 2. számú melléklet tartalmazza."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A védettség indoka és célja a terület természeti és tájképi adottságainak, a vulkáni tevékenység következtében kialakult felszínformáknak, valamint az erdők és gyepek természetes növény- és állatvilágának megőrzése, a területen található kultúrtörténeti értékek megóvása."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § A terület természetvédelmi kezeléséért felelős szerv a Bükki Nemzeti Park Igazgatóság."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5. §",
      "content": "5. § Ez a rendelet 2008. január 1-jén lép hatályba."
    },
