{
  "id": "hu-law-1993-161-40-00",
  "type": "statute",
  "title": "1993. MK 161. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1993-11-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/1993-161-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1993. évi 147. számában helytelenül jelent meg a mérésügyi igazgatási szolgáltatások igénybevételéért fizetendő díjak megállapításáról szóló 1/1991. (II. 28.) TNM rendelet módosítása tárgyában kiadott 7/1993. (X. 13.) TNM rendelet."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "— 8783. oldalon az R. 2. § b) pontjában a zárójeles utolsó mondat helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(…végellenőrzéssel egyidejűleg történő hitelesítést);"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "— 8784. oldalon a második 02.24.1 díj számjele helyesen:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "02.24.2 mintavételes hitelesítés a tétel minden darabja után db 015"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "— 8785. oldalon a 04.11.0 díj számjele helyesen:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "04.11.1 aerométerek hitelesítése db 1"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "— 8787. oldalon a 07.22.1 díj számjele helyesen:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "07.21.1 telepített kivitel db 1,2"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "— 8787. oldalon a 07.22.2 díj számjele helyesen:"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "07.21.2 hordozható kivitel db 0,3"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "— 8788. oldalon a 09.10.0 díj számjelű Egyszerű vízmérők (hidegvízre) megnevezés helyesen:"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "Egyszerű vízmérők (hidegvízre és melegvízre)"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "— 8788. oldalon a 09.14.0 számjelű Melegvíz- és forróvíz-mérők megnevezés helyesen:"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "Melegvíz- és forróvíz-mérők hőmennyiség mérőkhöz"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "(Kézirathiba)"
    }
  ]
}
