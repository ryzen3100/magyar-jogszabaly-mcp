{
  "id": "hu-law-2005-8-40-00",
  "type": "statute",
  "title": "2005. MK 8. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2005-01-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-8-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2004. évi 198. számának II. kötetében kihirdetett, a frekvenciasávok nemzeti felosztásának megállapításáról szóló 346/2004. (XII. 22.) Korm. rendelet 4. mellékletében"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– az 5.389C nemzetközi lábjegyzet szövegének vége helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "„...Határozat* rendelkezései szerint lehetséges. (WRC-97)”"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– az 5.556A nemzetközi lábjegyzet szövegének vége helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "„...sem haladhatja meg a –147dB(W/(m2*100 MHz)) értéket. (WCR-97)”"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(Nyomdahiba)"
    }
  ]
}
