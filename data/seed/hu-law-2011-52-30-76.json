{
  "id": "hu-law-2011-52-30-76",
  "type": "statute",
  "title": "52/2011. (III. 4.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2011-03-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-52-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Köztársaság Elnökének Érdemérme és a Köztársaság Elnökének Díszoklevele Éremmel kitüntetések alapításáról szóló 223/2010. (IX. 2.) KE. határozat 3. pontjában foglaltak alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a felsőoktatásban végzett tevékenysége elismeréseként, a szénhidrogén-ipari eljárások kutatásában elért eredményeiért"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Deák Gyulának,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Tapolca város fejlődéséért végzett áldozatos munkája elismeréseként"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Fehér Károlynénak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "helytörténeti kutató- és dokumentáló tevékenysége elismeréseként, Várpalota város kulturális életében való aktív szerepvállalásáért"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Leitner Ferencnek,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "történeti kutatásaiért, valamint az erdőtörténet és az erdőrendezés terén végzett kiemelkedő munkájáért"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Mészáros Gyulának,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "az élelmiszeriparban végzett szakmai munkássága elismeréséül, Pápa város közösségének szolgálatáért"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Politzer József Jenőnek,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "a magyar és a világ drámairodalma legjelesebb szerepeinek emlékezetes megformálásáért, művészi életútja elismeréseként"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Szoboszlay Sándornak a"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "KÖZTÁRSASÁG ELNÖKÉNEK DÍSZOKLEVELE ÉREMMEL"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "KEH ügyszám: VIII-5/00953/2011."
    }
  ]
}
