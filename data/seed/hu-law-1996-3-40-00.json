  "title": "1996. MK 3. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1996-01-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-3-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1995. évi 101. számában kihirdetett, a biztosítóintézetekről és a biztosítási tevékenységről szóló 1995. évi XCVI. törvény"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "— 169. §-ának bevezető szövege helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,169. § A Polgári Perrendtartásról szóló 1952. évi III. törvény 7. §-a (2) bekezdésének második mondata helyébe a következő rendelkezés lép:''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— 175. §-ának d) pontjában említett 27/1992. (XII. 3.) PM rendelet helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,…27/1992. (XII. 2.) PM rendelet…''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "A Magyar Közlöny 1996. évi 1. számában megjelent, a vámjog részletes szabályainak megállapításáról és a vámeljárás szabályozásáról szóló 39/1976. (XI. 10.) PM—KkM együttes rendelet módosításáról szóló 2/1996. (I. 9.) PM—IKM együttes rendelet 5. §-ának (1) bekezdésében megfogalmazott r) pont A részének 7. alpontja a következő:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": ",,7. az ukrán határszakaszon"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "közúti forgalomban a záhonyi,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "vasúti forgalomban a záhonyi''"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Az eredeti 7. alpont száma helyesen: 8."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "(Kézirathiba)"
    }
  ]
}
