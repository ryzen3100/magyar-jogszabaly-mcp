{
  "id": "hu-law-1999-50-40-00",
  "type": "statute",
  "title": "1999. MK 50. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1999-06-09",
  "url": "https://njt.jog.gov.hu/jogszabaly/1999-50-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1999. évi 43. számában kihirdetett, egyes állategészségügyi igazgatási szolgáltatások díjáról szóló 46/1999. (V. 19.) FVM rendelet"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "— 2. §-ának b) pontjában a prémes állat definíciója külön ponttal való megjelölése elmaradt. Helyesen: c) prémes állat:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Az ezt követő pontok c)—o) pontról d)—p) pontra változnak."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— 1. számú melléklete 7. pontjának h) naposbaromfi alpontjában az első sor kimaradt. A kimaradt első sor a következő:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– minden megkezdett 1000 állat után 280 | 560 | 560 | 840 | 560 | 1 120 | 1 400 | 1 120"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "— 1. számú melléklete 7. pontja md) és me) alpontjának második sorában az 5. oszlopban szereplő díjtételek helyesen a következők:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "[md) hüllő..."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "= rakományonként lagalább] 4 800"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "[md) védett állat..."
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "= rakományonként lagalább] 4 800"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "(Kézirathiba)"
    }
  ]
}
