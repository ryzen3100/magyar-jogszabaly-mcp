  "title": "78/2014. (VII. 2.) ME határozat helyettes államtitkárok felmentéséről",
  "status": "in_force",
  "in_force_date": "2014-07-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/2014-78-30-63",
  "description": "helyettes államtitkárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 221. § (2) bekezdés c) pontja alapján, az igazságügyi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kiszely Katalint,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kovács Miklósnét és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Szegedi Piroskát"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "az Igazságügyi Minisztérium helyettes államtitkárait e tisztségükből"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– 2014. június 30-ai hatállyal –"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "felmentem."
    }
  ]
}
