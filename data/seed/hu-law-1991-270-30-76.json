{
  "id": "hu-law-1991-270-30-76",
  "type": "statute",
  "title": "270/1991. (XII. 21.) KE határozat városi cím adományozásáról",
  "status": "in_force",
  "in_force_date": "1992-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/1991-270-30-76",
  "description": "városi cím adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére az alábbi községeknek a városi címet adományozom:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. a Hajdú-Bihar megyében lévő"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Nyíradony,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2. a Heves megyében lévő"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Lőrinci,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "3. a Fejér megyében lévő"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Enying,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "4. a Szabolcs-Szatmár-Bereg megyében lévő"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Tiszalök,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Újfehértó."
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Ez a határozat 1992. január 1. napján lép hatályba."
    }
  ]
}
