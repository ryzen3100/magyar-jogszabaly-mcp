{
  "id": "hu-law-2000-45-30-76",
  "type": "statute",
  "title": "45/2000. (IV. 19.) KE határozat egyetemi tanári tisztség alóli felmentésekről",
  "status": "amended",
  "in_force_date": "2000-04-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-45-30-76",
  "description": "egyetemi tanári tisztség alóli felmentésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Semmelweis Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Bagdy Emőke egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– közalkalmazotti jogviszony közös megegyezéssel történő megszüntetésére tekintettel – és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Gachályi Béla egyetemi tanárt"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– közalkalmazotti jogviszony saját kérésre történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2000. április 30. napjával e tisztségük alól"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "felmentem."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Budapest, 2000. április 17."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Pokorni Zoltán s. k., oktatási miniszter"
    }
  ]
}
