{
  "id": "hu-law-1997-76-40-00",
  "type": "statute",
  "title": "1997. MK 76. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1997-09-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-76-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1997. évi 54. számának II. kötetében kihirdetett, az Országos Atomenergia Hivatal eljárásáról a nukleáris biztonsággal összefüggő hatósági ügyekben című 108/1997. (VI. 25.) Korm. rendelet"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. számú mellékletében"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– A 3.002. pont szövege helyesen"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": ",,3.002 … a létesítményszintű üzembe helyezési engedéllyel (2.3. fejezet) történik.''"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– a 7.025. pont második mondatának szövege helyesen:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": ",,A besorolást az Engedélyes készíti el és a jelentésköteles eseménynél a Hatósággal …''"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "3. számú mellékletében"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "– a,,TARTALOMJEGYZÉK'' szövegében helyesen:"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": ",,3.10. Szilárdsági elemzés''"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "– az 5.030. pont szövege helyesen:"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": ",,5.030. … a teljes rendszer üzemelését (beleértve a biztonsági rendszer, rendszerelem kapcsolódó részeit, a normál és üzemzavari villamos betáplálás közötti átkapcsolást és a kapcsolódó segédrendszerek üzemképességét is) a tervezésihez lehető legközelebb álló feltételek között, a rendszer működését kiváltó teljes eseménysor figyelembevételével.''"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "– a 8.031. pont második mondatának szövege helyesen:"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": ",,8.031. A befúvó szellőzőrendszerekbe szűrőket is telepíteni kell …''"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "4. számú mellékletében"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "– az,,ELŐSZÓ'' szövege harmadik bekezdésének második mondata helyesen:"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": ",,E rendelet mellékleteiként kerültek kiadásra a Hatósági engedélyek fajtáit, az engedélyezés …"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "– az 1.001. pont szövege helyesen:"
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": ",,1.001. … felülvizsgálatának végrehajtására vonatkozó nukleáris biztonsági alapkövetelmények rögzítése.''"
    },
    {
      "provision_ref": "s25",
      "section": "25",
      "title": "25",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s26",
      "section": "26",
      "title": "26",
      "content": "– a,,MEGHATÁROZÁSOK'' rész szövegében a,,Hatóság'' definíció második mondata helyesen:"
    },
    {
      "provision_ref": "s27",
      "section": "27",
      "title": "27",
      "content": ",,… Biztonsági Igazgatóságát kell érteni, míg a,,hatóság'' megnevezés általános értelemben használt.''"
    },
    {
      "provision_ref": "s28",
      "section": "28",
      "title": "28",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s29",
      "section": "29",
      "title": "29",
      "content": "5. számú mellékletében"
    },
    {
      "provision_ref": "s30",
      "section": "30",
      "title": "30",
      "content": "– a 2.098. pont szövege helyesen:"
    },
    {
      "provision_ref": "s31",
      "section": "31",
      "title": "31",
      "content": ",,2.098. … tartalmára a 2.097. pont a) és b) pont alpontjaiban…''"
    },
    {
      "provision_ref": "s32",
      "section": "32",
      "title": "32",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s33",
      "section": "33",
      "title": "33",
      "content": "– a 4.2.9.,,Építmények'' című részben:"
    },
    {
      "provision_ref": "s34",
      "section": "34",
      "title": "34",
      "content": "A 4.083. és 4.084. számozású alpontok szövege egységesen 4.084. számozást kap."
    },
    {
      "provision_ref": "s35",
      "section": "35",
      "title": "35",
      "content": "(Kézirathiba)"
    }
  ]
}
