  "title": "37/2022. (VI. 11.) ME határozat helyettes államtitkár felmentéséről és helyettes államtitkárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2022-06-11",
  "url": "https://njt.jog.gov.hu/jogszabaly/2022-37-30-63",
  "description": "helyettes államtitkár felmentéséről és helyettes államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja és 234. § (1) bekezdése alapján – a belügyminiszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Simon Attila Istvánt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Belügyminisztérium helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2022. június 11-ei hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem, egyidejűleg"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Csizi Pétert,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Kivés Zoltánt,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Sölch Gellért Boldizsárt és"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Tóth Juditot"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "a Belügyminisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "2022. június 12-ei hatállyal"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "kinevezem. 1 A 109/2023. (XII. 22.) ME határozat alapján Kivés Zoltán tekintetében akként módosul, hogy a „Belügyminisztérium” szövegrész helyébe a „Közigazgatási és Területfejlesztési Minisztérium” szöveg lép."
    }
  ]
