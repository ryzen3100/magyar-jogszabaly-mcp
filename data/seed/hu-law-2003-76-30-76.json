  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Magyar Köztársaság Alkotmányáról szóló 1949. évi XX. törvény 33. §-ának (4) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Görgey Gábort,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a nemzeti kulturális örökség miniszterét,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Jánosi György"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "gyermek-, ifjúsági és sportminisztert és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Kóródi Mária"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "környezetvédelmi és vízügyi minisztert"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "e tisztségéből"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– 2003. május 18-i hatállyal –"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "felmentem."
    },
    {
      "provision_ref": "s11",
      "section": "11",
