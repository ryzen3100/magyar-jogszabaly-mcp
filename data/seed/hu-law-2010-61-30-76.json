{
  "id": "hu-law-2010-61-30-76",
  "type": "statute",
  "title": "61/2010. (III. 26.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2010-03-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-61-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "életműve elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Halász Péter írónak, újságírónak, a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND középkeresztje, polgári tagozata;"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a magyar–olasz gazdasági kapcsolatok erősítése, a magyarországi földgázpiac gyors és zökkenőmentes átalakítása érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Dott. Cesare Cuniberto-nak, a Tigáz Zrt. elnökének, a"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND lovagkeresztje, polgári tagozata"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "KEH ügyszám: VIII-1/00927/2010."
    }
  ]
}
