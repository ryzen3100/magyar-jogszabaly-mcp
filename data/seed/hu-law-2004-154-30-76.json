{
  "id": "hu-law-2004-154-30-76",
  "type": "statute",
  "title": "154/2004. (XI. 2.) KE határozat a Gazdasági Versenyhivatal elnökének kinevezéséről",
  "status": "in_force",
  "in_force_date": "2004-11-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-154-30-76",
  "description": "a Gazdasági Versenyhivatal elnökének kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A tisztességtelen piaci magatartás és a versenykorlátozás tilalmáról szóló 1996. évi LVII. törvény 35. §-ának (2) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Nagy Zoltánt a Gazdasági Versenyhivatal elnökévé"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2004. november 1-jei hatállyal, hat évi időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: V-3/4143/2004."
    }
  ]
}
