{
  "id": "hu-law-2004-75-30-63",
  "type": "statute",
  "title": "75/2004. (XI. 9.) ME határozat kormányzati főtisztviselő áthelyezéséről",
  "status": "in_force",
  "in_force_date": "2004-11-09",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-75-30-63",
  "description": "kormányzati főtisztviselő áthelyezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 31/C. §-ának (6) bekezdésében foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Szitáné dr. Kazai Ágnes kormányzati főtisztviselőt a Gazdasági és Közlekedési Minisztérium Miniszteri Titkárság állományába, főosztályvezetői teendők ellátására"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2004. november 1-jei hatállyal – határozatlan időre – áthelyezem."
    }
  ]
}
