  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1993. évi 155. számában közzétett, egyes hírközlést érintő jogszabályok módosításáról szóló 29/1993. (X. 26.) KHVM rendelet"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "— 1. §-a (3) bekezdésének e) pontjában a 4. pont c) alpontja 5. fordulatának utolsó sora helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,tervezett építése, megszüntetése esetében''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— 1. §-a (4) bekezdése b) pontjának 3. sora helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,bekezdésében, 8. §-ában, 9. §-ában a »Magyar Posta« szövegrész helyébe a''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(Kézirathiba)"
    }
  ]
}
