{
  "id": "hu-law-1996-179-30-76",
  "type": "statute",
  "title": "179/1996. (XII. 21.) KE határozat vezérőrnagy szolgálati viszonyának megszüntetéséről",
  "status": "amended",
  "in_force_date": "1996-12-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-179-30-76",
  "description": "vezérőrnagy szolgálati viszonyának megszüntetéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A polgári nemzetbiztonsági szolgálatokat irányító tárca nélküli miniszter javaslatára 1996. december 30-i hatállyal"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– érdemei elismerése mellett –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Láng Péter vezérőrnagy,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "az Információs Hivatal főigazgatójának általános helyettese"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "szolgálati viszonyát megszüntetem, és nyugállományba helyezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Nikolits István s. k., tárca nélküli miniszter"
    }
  ]
}
