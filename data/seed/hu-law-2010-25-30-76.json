  "description": "Kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján az egészségügyi miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Csorba Évának, a Magyarországi Református Egyház Bethesda Gyermekkórháza Égéssérült Gyermekeket Gyógyító Országos Központ vezető főorvosának,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Magda Tamás tüdőgyógyász főorvosnak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Rejtő Mártának, a tiszaújvárosi Városi Rendelőintézet szemész szakorvosának, főorvosnak a"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(polgári tagozat)"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Csizmás Istvánné dr. Bruck Lujzának, a tószegi Fogorvosi Szolgálat főorvosának,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Haryné dr. Riedl Erika Krisztinának, az Állami Egészségügyi Központ Radiológiai Osztály osztályvezető főorvos helyettesének,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Molnár Zoltánnénak, a mezőfalvai Nádor Gyógyszertár gyógyszerészének a"
    },
