  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján az egészségügyi miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Rendek Vilmának, a Fővárosi és Pest Megyei Egészségbiztosítási Pénztár igazgatójának,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Vass Lászlónak, az orvostudomány kandidátusának, a Semmelweis Egyetem címzetes egyetemi docensének, a Pest Megyei Flór Ferenc Kórház Kórbonctani Osztálya osztályvezető főorvosának a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Csentey Szabolcsnak, a Siófok-Balatonkiliti házi gyermekorvosának,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Kiss Zsoltnak, az Országos Egészségbiztosítási Pénztár főosztályvezetőjének,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Kristofori Györgynek, Sirok Község háziorvosának,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Záray Gyulánénak, a budapesti Szent Imre Kórház főigazgató-helyettesének a"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Varga Józsefnének, az Állami Egészségügyi Központ vezető ápolójának a"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "MAGYAR KÖZTÁRSASÁGI BRONZ ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "kitüntetést adományozom."
    },
    {
