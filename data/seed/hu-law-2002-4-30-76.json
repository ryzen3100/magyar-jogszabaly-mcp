{
  "id": "hu-law-2002-4-30-76",
  "type": "statute",
  "title": "4/2002. (I. 31.) KE határozat egyetemi tanári tisztség alóli felmentésekről",
  "status": "in_force",
  "in_force_date": "2002-01-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2002-4-30-76",
  "description": "egyetemi tanári tisztség alóli felmentésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány 315/2001. (XII. 28.) Korm. rendelete értelmében, az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Semmelweis Egyetem"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Egészségtudományi Karán"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a fenti döntés értelmében –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Berentey Ernő egyetemi tanárt és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Tomcsányi István egyetemi tanárt (az oktatói tevékenységük megszűnésével a közalkalmazotti jogviszonyuk a jogutódnál, az Országos Gyógyintézeti Központnál folyamatos),"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– továbbá, saját kérésére –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Hatvani István egyetemi tanárt,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Jákó János egyetemi tanárt,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "dr. Magyar Éva egyetemi tanárt és"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "dr. Ritter László egyetemi tanárt (közalkalmazotti jogviszonyuk a jogutódnál, az Országos Gyógyintézeti Központnál folyamatos),"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "– továbbá, saját kérésére –"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "dr. Z. Szabó László egyetemi tanárt (közalkalmazotti jogviszonya a Semmelweis Egyetemen folytatódik),"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "– továbbá, saját kérésére, közalkalmazotti jogviszony közös megegyezéssel történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "dr. Petrányi Győző egyetemi tanárt,"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "dr. Renner Antal egyetemi tanárt,"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "dr. Rózsa Imre egyetemi tanárt és"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "dr. Udvarhelyi Iván egyetemi tanárt,"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "– továbbá, közalkalmazotti jogviszony felmentéssel történő megszűnésére tekintettel –"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "dr. Sas Géza egyetemi tanárt"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "2001. december hó 31. napjával,"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "e tisztsége alól felmentem."
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "KEH ügyszám: V–2/0350/2002. 1 A rendelkezést a 20/2002. (III. 28.) KE határozat 2002. március 28. napjával hatálytalanította."
    }
  ]
}
