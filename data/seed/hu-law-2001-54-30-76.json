{
  "id": "hu-law-2001-54-30-76",
  "type": "statute",
  "title": "54/2001. (VI. 6.) KE határozat egyetemi tanári tisztség alóli felmentésről",
  "status": "in_force",
  "in_force_date": "2001-06-06",
  "url": "https://njt.jog.gov.hu/jogszabaly/2001-54-30-76",
  "description": "egyetemi tanári tisztség alóli felmentésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Pécsi Tudományegyetem Természettudományi Karán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Vuics Tibor egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– tekintettel arra, hogy a tudományos etika normáit megsértette és ez által méltatlanná vált az egyetemi tanári tisztség viselésére, amelyet fegyelmi eljárás keretében megállapítottak –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2001. május 31. napjával"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "e tisztsége alól felmentem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Budapest, 2001. május 31."
    }
  ]
}
