  "title": "6/2013. (I. 22.) ME határozat főiskolai tanárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2013-01-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2013-6-30-63",
  "description": "főiskolai tanárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 27. § (3) bekezdésében foglalt jogkörömben – az emberi erőforrások miniszterének a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Fórizs Lászlót és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Schreiner Dénes Tituszt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2013. február 15-ei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "főiskolai tanárrá kinevezem."
    }
  ]
}
