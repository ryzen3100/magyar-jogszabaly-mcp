{
  "id": "hu-law-2012-1054-30-22",
  "type": "statute",
  "title": "1054/2012. (III. 7.) Korm. határozat „Életmentő Emlékérem” adományozásáról",
  "status": "repealed",
  "in_force_date": "2012-03-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-1054-30-22",
  "description": "„Életmentő Emlékérem” adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány az „Életmentő Emlékérem” adományozásáról szóló 243/2009. (X. 29.) Korm. rendelet alapján, életmentés közben tanúsított hősies magatartása elismeréseként – a belügyminiszter mint helyi önkormányzatokért felelős miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "BÁNYAI GÁBOR ELEMÉR jánoshalmai,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "DÁNIEL ISTVÁN szendrői,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "FARKAS DÁNIEL GERGELY budapesti,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "FORGÁCS GYÖRGY ráckevei,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KOHL ZOLTÁN JÁNOS érsekcsanádi,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "KÓTI RICHÁRD komádi,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "MOLNÁR PÁL szendrői,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "MÜLLER MÁTYÁS vaskúti és"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "SOMLAI KRISZTINA kecskeméti lakosnak"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "„Életmentő Emlékérmet” adományoz. 1 A határozatot az 1046/2015. (II. 11.) Korm. határozat 1. pontja visszavonta 2015. február 12. napjával. Alkalmazására lásd e visszavonó határozat 3. pontját."
    }
  ]
}
