{
  "id": "hu-law-2024-1238-30-22",
  "type": "statute",
  "title": "1238/2024. (VIII. 8.) Korm. határozat „Életmentő Emlékérem” adományozásáról",
  "status": "in_force",
  "in_force_date": "2024-08-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/2024-1238-30-22",
  "description": "„Életmentő Emlékérem” adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány az „Életmentő Emlékérem” adományozásáról szóló 243/2009. (X. 29.) Korm. rendelet alapján, életmentés közben tanúsított hősies magatartása elismeréseként – a közigazgatási és területfejlesztési miniszter mint helyi önkormányzatokért felelős miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Illés Gergő budapesti lakosnak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Bíró Imre debreceni lakosnak és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Pózvai Krisztián keszthelyi lakosnak"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "„Életmentő Emlékérmet” adományoz."
    }
  ]
}
