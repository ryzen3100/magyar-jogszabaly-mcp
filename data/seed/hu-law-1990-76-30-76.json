{
  "id": "hu-law-1990-76-30-76",
  "type": "statute",
  "title": "76/1990. (VI. 4.) KE határozat államtitkárok felmentéséről",
  "status": "in_force",
  "in_force_date": "1990-06-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-76-30-76",
  "description": "államtitkárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. §-ának (1) bekezdése alapján a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Szabó Imre ipari minisztériumi államtitkárt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Varga Miklós környezetvédelmi és vízgazdálkodási minisztériumi államtitkárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– érdemeik elismerésével – 1990. május 31-ei hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "tisztségükből felmentem."
    }
  ]
}
