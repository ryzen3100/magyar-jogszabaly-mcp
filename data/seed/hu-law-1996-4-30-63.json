{
  "id": "hu-law-1996-4-30-63",
  "type": "statute",
  "title": "4/1996. (I. 24.) ME határozat főiskolai tanár felmentéséről",
  "status": "amended",
  "in_force_date": "1996-01-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-4-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Lappints Árpádot, az Apáczai Csere János Tanítóképző Főiskola főiskolai tanárát 1995. december 28-i hatállyal"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– nyugállományba vonulására tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
