{
  "id": "hu-law-2008-75-30-63",
  "type": "statute",
  "title": "75/2008. (XI. 28.) ME határozat szakállamtitkár megbízatásának megszűnéséről",
  "status": "in_force",
  "in_force_date": "2008-11-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-75-30-63",
  "description": "szakállamtitkár megbízatásának megszűnéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 60. § (1) bekezdése alapján, a külügyminiszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Gilyán Györgyöt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Külügyminisztérium szakállamtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2008. november 30-ai hatállyal, más fontos megbízatása miatt –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
