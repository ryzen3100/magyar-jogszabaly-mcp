{
  "id": "hu-law-2021-41-30-63",
  "type": "statute",
  "title": "41/2021. (VII. 30.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2021-07-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2021-41-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján – a Miniszterelnöki Kormányiroda közigazgatási államtitkára javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Bordás Gábort, a Miniszterelnöki Kormányiroda helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– közigazgatási államtitkárrá történt kinevezésére tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2021. július 31-ei hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
