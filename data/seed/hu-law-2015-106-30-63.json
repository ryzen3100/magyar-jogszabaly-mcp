{
  "id": "hu-law-2015-106-30-63",
  "type": "statute",
  "title": "106/2015. (XI. 26.) ME határozat állami felsőoktatási intézmény kancellárja megbízásáról",
  "status": "in_force",
  "in_force_date": "2015-11-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2015-106-30-63",
  "description": "állami felsőoktatási intézmény kancellárja megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (4a) bekezdésében foglalt jogkörömben eljárva – az oktatásért felelős miniszter előterjesztése alapján –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Károly Róbert Főiskolán dr. Csomós Tamást"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2015. november 10-étől 2016. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a kancellári teendők ellátásával megbízom."
    }
  ]
}
