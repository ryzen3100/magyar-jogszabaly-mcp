    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2006. évi 160. (2006. december 22.) számában kihirdetett, a Magyar Köztársaság 2007. évi költségvetéséről szóló 2006. évi CXXVII. törvény"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 3. számú mellékletének 15.1.2.3. pontjának címe helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "„15.1.2.3. Iskolai oktatás a 9–13. évfolyamon”"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 9. számú mellékletének fejlécében az utolsó oszlop helyesen: Egyenleg"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "(Nyomdahiba)"
    }
  ]
}
