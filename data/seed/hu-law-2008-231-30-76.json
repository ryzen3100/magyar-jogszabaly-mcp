{
  "id": "hu-law-2008-231-30-76",
  "type": "statute",
  "title": "231/2008. (XI. 3.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2008-11-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-231-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a külügyminiszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Harai Pálnak, a Medgyesi Római katolikus Plébánia nyugalmazott plébánosának, esperesnek, tb. kanonoknak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Orbán Péternek, a Volt Politikai Foglyok Országos Szövetsége alelnökének, az 56-os Bajtársi Társaság alelnökének,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Stanca Toadernek, volt parlamenti képviselőnek,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Maier Alexandrunak, nyugalmazott orvosnak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Szilágyi Árpádnak,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Török Józsefnek,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Páll Lászlónak, a Volt Politikai Foglyok Országos Szövetsége alapító tagjának, a szervezet Hargita Megyei alelnökének, az Erdélyi 56-os Társaság alelnökének,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Sándor Balázsnak, a Volt Politikai Foglyok Országos Szövetsége alapító tagjának,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Puskás Attila biológusnak, a Volt Politikai Foglyok Országos Szövetsége Kovászna Megyei alelnökének,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Kelemen Csongornak, a Volt Politikai Foglyok Országos Szövetsége városi elnökének, megyei alelnöknek,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Orbán Etelkának, nyugalmazott könyvelőnek,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Czimbalmos Károlynak,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Vorzsák Jánosnak,"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "Biczó Jánosnak, a Hargita megyei Volt Politikai Foglyok Országos Szövetsége vezetőségi tagjának,"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "Kovács Gyulának, nyugalmazott könyvelőnek a"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT polgári tagozata"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "KEH ügyszám: VIII-1/04576/2008."
    }
  ]
}
