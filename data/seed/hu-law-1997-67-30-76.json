  "title": "67/1997. (III. 28.) KE határozat dandártábornoki kinevezésről",
  "status": "amended",
  "in_force_date": "1997-03-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-67-30-76",
  "description": "dandártábornoki kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A polgári nemzetbiztonsági szolgálatokat irányító tárca nélküli miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1997. április 1-jei hatállyal"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Komjáthy László ezredest, az Információs Hivatal főigazgató helyettesét dandártábornokká kinevezem."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
