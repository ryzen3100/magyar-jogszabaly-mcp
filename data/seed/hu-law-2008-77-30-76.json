{
  "id": "hu-law-2008-77-30-76",
  "type": "statute",
  "title": "77/2008. (III. 15.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2008-03-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-77-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a gazdasági és közlekedési miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Martonosi Istvánnak, a Csongrád Megyei Kereskedők Egyesülete ügyvezető igazgatójának a"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Gláser Tamásnak, a Kem-Univerzál Kereskedelmi és Szolgáltató Kft. ügyvezető igazgatójának,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Gyovai Jánosnak, a Pest Megyei Kereskedők és Vendéglátók Szövetsége elnökének,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Nagy Ferencnek, a Kereskedők és Vendéglátók Jász-Nagykun-Szolnok Megyei Szervezete elnökének a"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "KEH ügyszám: VIII-1/01429/2008."
    }
  ]
}
