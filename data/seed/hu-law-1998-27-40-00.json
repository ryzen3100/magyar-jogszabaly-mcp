  "title": "1998. MK 27. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1998-03-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/1998-27-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1998. évi 10. számában kihirdetett, a tankönyvvé nyilvánítás, a tankönyvtámogatás, valamint az iskolai tankönyvellátás rendjéről szóló 5/1998. (II. 18.) MKM rendelet melléklete helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Melléklet az 5/1998. (II. 18.) MKM rendelethez"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "JEGYZÉK"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Magyar Államkincstárnál vezetett bankszámlákról, amelyekre az eljárási díjat be kell fizetni"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "1. Belügyminisztérium 10023002-01009349-50000000 pénzforgalmi jelzőszámú bankszámla."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "2. Földművelésügyi Minisztérium 10032000-01494549 pénzforgalmi jelzőszámú bankszámla."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "3. Honvédelmi Minisztérium 10023002-01780499 pénzforgalmi jelzőszámú bankszámla."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "4. Környezetvédelmi és Területfejlesztési Minisztérium 10032000-01468216-00000000 pénzforgalmi jelzőszámú bankszámla."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "5. Munkaügyi Minisztérium (NSZI) 10032000-01744260-00000000 pénzforgalmi jelzőszámú bankszámla."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "6. Művelődési és Közoktatási Minisztérium 10032000-01425190-00000000 pénzforgalmi jelzőszámú bankszámla."
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "7. Népjóléti Minisztérium 10032000-01491838 pénzforgalmi jelzőszámú bankszámla."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "(Kézirathiba)"
    }
  ]
}
