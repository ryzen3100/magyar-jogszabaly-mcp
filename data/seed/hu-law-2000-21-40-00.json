{
  "id": "hu-law-2000-21-40-00",
  "type": "statute",
  "title": "2000. MK 21. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2000-03-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-21-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1999. évi 110. számában a 7144. oldalon a Fogyasztóvédelmi Főfelügyelőség második közleményében szereplő,,…FAMATLI gyártmányú…'' kifejezés helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,…FAMATEL gyártmányú…''"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "A Magyar Közlöny 1999. évi 122. számában kihirdetett, a természetes gyógytényezőkről szóló 74/1999. (XII. 25.) EüM rendelet 2. számú melléklete 1. pontjának"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– ea) alpontja második sora helyesen:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": ",,Szulfid-ion vagy titrálható kén legalább 1 mg/l'';"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– eb) alpontja első sora helyesen:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": ",,Nátrium-ion kevesebb 200 mg/l-nél''"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "A Magyar Közlöny 2000. évi 12. számában kihirdetett, az érettségi vizsga vizsgaszabályzatának kiadásáról szóló 100/1997. (VI. 13.) Korm. rendelet módosításáról szóló 16/2000. (II. 11.) Korm. rendelet"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "– 20. §-ának (3) bekezdése a) pontjában a 61. § rendelkezésére történő utalás helyesen:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": ",,… az R. 61. §-a (4) bekezdésének záró részében…''"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "– 20. §-ának (4) bekezdésében a gimnáziumi érettségi vizsgaszabályzatról szóló utasítás megjelölése helyesen:"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": ",,… 129/1981. (MK 17.) MM utasítással…''"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "(Kézirathiba)"
    }
  ]
}
