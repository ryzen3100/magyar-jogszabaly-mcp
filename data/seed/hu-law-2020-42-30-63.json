{
  "id": "hu-law-2020-42-30-63",
  "type": "statute",
  "title": "42/2020. (VI. 18.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2020-06-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/2020-42-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az innovációért és technológiáért felelős miniszternek a fenntartó kezdeményezésére tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Fehérváry Örs Jákót a Sapientia Szerzetesi Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2020. július 1-jétől 2024. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
