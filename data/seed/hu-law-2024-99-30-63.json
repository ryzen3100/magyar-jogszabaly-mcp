{
  "id": "hu-law-2024-99-30-63",
  "type": "statute",
  "title": "99/2024. (IX. 10.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2024-09-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2024-99-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján – az energiaügyi miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Borsos-Papp Natáliát, az Energiaügyi Minisztérium helyettes államtitkárát e tisztségéből – közigazgatási államtitkárrá történő kinevezésére tekintettel –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2024. szeptember 14-ei hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
