  "title": "62/2004. (X. 4.) ME határozat kormányzati főtisztviselő áthelyezéséről",
  "status": "in_force",
  "in_force_date": "2004-10-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-62-30-63",
  "description": "kormányzati főtisztviselő áthelyezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló – többször módosított – 1992. évi XXIII. törvény 31/C. § (6) bekezdésében foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Forgács Imre kormányzati főtisztviselőt a Budapest Főváros Közigazgatási Hivatalába"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2004. szeptember 29-i hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "áthelyezem."
    }
  ]
}
