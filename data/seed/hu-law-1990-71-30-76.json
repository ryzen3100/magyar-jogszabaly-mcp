{
  "id": "hu-law-1990-71-30-76",
  "type": "statute",
  "title": "71/1990. (V. 24.) KE határozat miniszterek kinevezéséről",
  "status": "in_force",
  "in_force_date": "1990-05-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-71-30-76",
  "description": "miniszterek kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 33. §-ának (4) bekezdése alapján, a miniszterelnök javaslatára;"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Andrásfalvy Bertalant, művelődési és közoktatási miniszterré,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Balsai Istvánt, igazságügyminiszterré,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Bod Péter Ákost, ipari és kereskedelmi miniszterré,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Für Lajost, honvédelmi miniszterré,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Gerbovits Jenőt, tárca nélküli miniszterré,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Győriványi Sándort, munkaügyi miniszterré,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Horváth Balázst, belügyminiszterré,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Jeszenszky Gézát, külügyminiszterré,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "dr. Kádár Bélát, nemzetközi gazdasági kapcsolatok miniszterévé,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Keresztes K. Sándort, környezetvédelmi miniszterré,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "dr. Kiss Gyulát tárca nélküli miniszterré,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "dr. Mádl Ferencet, tárca nélküli miniszterré,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Nagy Ferenc Józsefet, földművelésügyi miniszterré,"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "dr. Rabár Ferencet, pénzügyminiszterré,"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "Siklós Csabát, közlekedési és hírközlési miniszterré,"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "dr. Surján Lászlót, népjóléti miniszterré"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "kinevezem."
    }
  ]
}
