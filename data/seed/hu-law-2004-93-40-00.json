{
  "id": "hu-law-2004-93-40-00",
  "type": "statute",
  "title": "2004. MK 93. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2004-06-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-93-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2004. évi 70. számában megjelent, a bűnmegelőzés hatékonyságának növelése érdekében szükséges egyes kormányzati feladatokról szóló 1002/2003. (I. 8.) Korm. határozat módosításáról szóló 1051/2004. (V. 25.) Korm. határozat 2. pontja helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "[2. A H. 6.1. pontja helyébe a következő rendelkezés lép:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "„6.1. A Kormány az OBmB állandó tagjának felkéri"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "…]"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– az Idősügyi Tanács,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– a Magyar Gyermek- és Ifjúságvédelmi Szövetség,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– a Gyermek és Ifjúsági Konferencia,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– a MOBILITAS Kutatási és Képzési Igazgatósága,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– a Biztonságos Szórakozóhelyek Egyesület"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "képviselőjét.”"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "(Nyomdahiba)"
    }
  ]
}
