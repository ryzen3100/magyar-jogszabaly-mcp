{
  "id": "hu-law-2000-98-40-00",
  "type": "statute",
  "title": "2000. MK 98. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2000-09-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-98-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2000. évi 95. számában közzétett Fogyasztóvédelmi Főfelügyelőség közleménye helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,...a DANUBILUX Kft. (1201 Budapest, Helsinki út 81.) által forgalmazott E14 és E27 fejméretű DALUX típusú beépített előtétes lámpák (energiatakarékos fénycsövek) közül a"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "HY–11 W (E14),"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a HY–13 W (E27)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "és a HY–18W (E27)"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "típusú kompakt fénycsövek"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "nem felelnek meg az élet- és vagyonbiztonsági előírásoknak.''"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "A közlemény további része változatlan."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Kézirathiba)"
    }
  ]
}
