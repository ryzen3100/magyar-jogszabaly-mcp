{
  "id": "hu-law-2010-23-30-76",
  "type": "statute",
  "title": "23/2010. (III. 15.) KE határozat kitüntetés adományozásáról",
  "status": "amended",
  "in_force_date": "2010-03-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-23-30-76",
  "description": "Kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Európai Unió Moldáviai EUBAMM misszió vezetőjeként végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Bánfi Ferenc rendőr vezérőrnagynak, a Collége Européen de Police"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "igazgatójának,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a rendőri vezetői életpályája, valamint a Rendvédelmi Szervek Védelmi Szolgálata vezetőjeként végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Frankberger Ferenc rendőr vezérőrnagynak, a Rendvédelmi Szervek Védelmi"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Szolgálata szolgálatvezetőjének, az Európai Partnerek a Korrupció Ellen (EPAC) Szervezet alelnökének a"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "tisztikeresztje, katonai tagozata"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Budapest, 2010. március 3."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "KEH ügyszám: VIII-1/00698/2010."
    }
  ]
}
