  "title": "42/2005. (VI. 23.) ME határozat az Egyenlő Bánásmód Tanácsadó Testület tagjainak felkéréséről",
  "status": "in_force",
  "in_force_date": "2005-06-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-42-30-63",
  "description": "az Egyenlő Bánásmód Tanácsadó Testület tagjainak felkéréséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Egyenlő Bánásmód Hatóságról és eljárásának részletes szabályairól szóló 362/2004. (XII. 26.) Korm. rendelet 18. §-ának (1) bekezdése alapján,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az ifjúsági, családügyi, szociális és esélyegyenlőségi miniszter javaslatára"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Farkas Lillát,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Kárpáti Józsefet és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Szigeti Györgyöt;"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "az igazságügy-miniszter javaslatára"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Gyulavári Tamást,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Herczog Máriát és"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Majtényi Lászlót"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "az Egyenlő Bánásmód Tanácsadó Testület tagsági teendőinek ellátására"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "– 2005. június 20-i hatállyal, hatéves időtartamra –"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "felkérem."
    }
  ]
