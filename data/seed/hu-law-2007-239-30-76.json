{
  "id": "hu-law-2007-239-30-76",
  "type": "statute",
  "title": "239/2007. (XI. 21.) KE határozat dr. Fodor György rektori megbízásáról",
  "status": "in_force",
  "in_force_date": "2007-11-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-239-30-76",
  "description": "dr. Fodor György rektori megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának a) pontja alapján, az oktatási és kulturális miniszternek – a fenntartóval egyetértésben tett – javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Pázmány Péter Katolikus Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Fodor György egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2007. november 1-jétől 2011. augusztus 29-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-2/4586/2007."
    }
  ]
}
