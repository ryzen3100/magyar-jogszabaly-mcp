    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Pócs Tamást az Eszterházy Károly Tanárképző Főiskola főiskolai tanárát 1996. augusztus 31-i hatállyal – nyugállományba vonulására tekintettel – e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "felmentem."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
