{
  "id": "hu-law-1996-9-40-00",
  "type": "statute",
  "title": "1996. MK 9. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1996-02-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-9-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1995. évi 117. számában kihirdetett, az egyes agrárgazdasági célok 1996. évi költségvetési támogatásáról szóló 177/1995. (XII. 29.) Korm. rendelet helyesbítése a következő:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "A rendelet bevezetőjében a törvényi hivatkozás helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,A Magyar Köztársaság 1996. évi költségvetéséről szóló 1995. évi CXXI. törvény (a továbbiakban: Tv.) 113. §-ában…''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Az 1. § (1) bekezdésének utolsó mondata helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,… 1996. évben a központi költségvetésből az e rendelet II—VIII. fejezetében…''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Az 5. § (1) bekezdése, illetve (2) bekezdése helyesen:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": ",,(1) A Tv. XV. Földművelésügyi Minisztérium fejezet…''"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": ",,(2) A Tv. XV. Földművelésügyi Minisztérium…''"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "A 45. § (1) bekezdésének a) pontjában a,,… 20,01—44,00…'' helyesen:"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": ",,…20,01—40,00…''"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "A 49. § (2) bekezdése helyesen:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": ",,(2) A megyei növényegészségügyi és talajvédelmi állomás…''"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "A VI. Fejezet címe helyesen:"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": ",,Az erdőkárok elhárításához nyújtott támogatás''"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "A rendelet 9. számú mellékletének 2. b) pontja helyesen:"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": ",,b) talajjavítás (legalább 8 éves tartamhatással, meszezés, talajcsere stb.)…''"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "(Kézirathiba)"
    }
  ]
}
