  "title": "126/2024. (XII. 23.) ME határozat helyettes államtitkári kinevezések módosulásának megállapításáról",
  "status": "in_force",
  "in_force_date": "2024-12-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/2024-126-30-63",
  "description": "helyettes államtitkári kinevezések módosulásának megállapításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 234. § (7) bekezdésében foglalt jogkörömben eljárva, a nemzetgazdasági miniszter javaslatára megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Adorján Richárd,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Berczik Ábel és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Besesek Botond"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2025. január 1-jei hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Nemzetgazdasági Minisztérium helyettes államtitkárai."
    }
  ]
}
