  "title": "92/2006. (IV. 28.) KE határozat posztumusz kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2006-04-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-92-30-76",
  "description": "posztumusz kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a MAGYAR KÖZTÁRSASÁGI ÉRDEMREND KÖZÉPKERESZTJE (polgári tagozata)"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "posztumusz kitüntetést adományozom"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a sport területén végzett sokoldalú munkássága, példamutató életútja elismeréseként"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Gyulai István újságírónak."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VII-2/1668/2006."
    }
  ]
}
