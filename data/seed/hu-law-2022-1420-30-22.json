{
  "id": "hu-law-2022-1420-30-22",
  "type": "statute",
  "title": "1420/2022. (IX. 1.) Korm. határozat a Népművészet Mestere díj 2022. évi adományozásáról",
  "status": "in_force",
  "in_force_date": "2022-09-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2022-1420-30-22",
  "description": "a Népművészet Mestere díj 2022. évi adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Magyarország Kormánya 2022-ben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. Birtalan József szilágybagosi énekes-furulyásnak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2. Bozsik Margit borsodi citerásnak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "3. Kádár Ferenc körösladányi furulyás-tárogatósnak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "4. Kun Gáborné uszódi táncosnak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "5. Lázár Éva mezőfelei gyékényfonónak,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "6. Lőrincz Etel bukovinai székely szövőnek,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "7. Nagy Béla zalai fafaragónak,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "8. Nagy Imréné kazári viseletkészítőnek,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "9. Pap Julianna Bernadett mezőkövesdi hímzőnek,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "10. Szabó István széki táncosnak a Népművészet Mestere díjat adományozza."
    }
  ]
}
