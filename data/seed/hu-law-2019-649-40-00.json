    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "A Hivatalos Értesítő 2019. szeptember 5-én megjelent 48. számának 4657. oldalán közzétett 9/2019. (IX. 5.) BVOP utasítás 4. pontjának szövege helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "„4. Az Utasítás"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a) 15. pontjában a „Főosztályon” szövegrész helyébe a „Hivatalon” szöveg,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "b) 19. pontjában a „Főosztály” szövegrész helyébe a „Hivatal” szöveg"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "lép.”"
    }
  ]
}
