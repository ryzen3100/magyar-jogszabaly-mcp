{
  "id": "hu-law-2011-279-30-76",
  "type": "statute",
  "title": "279/2011. (XI. 10.) KE határozat kitüntetések adományozásáról",
  "status": "in_force",
  "in_force_date": "2011-11-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-279-30-76",
  "description": "kitüntetések adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Magyarország demokratikus átalakulása érdekében végzett sokoldalú, fáradhatatlan tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Eberhard Diepgen ügyvédnek, Berlin volt kormányzó polgármesterének a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND középkeresztje"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "polgári tagozata,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a magyar–német gazdasági kapcsolatok fejlesztése érdekében végzett befektetői és vállalkozói munkája, valamint támogató-munkahelyteremtő tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Antal L. Szalay üzletembernek, a Provertha Electronic Components tulajdonosának a"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND lovagkeresztje"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "polgári tagozata"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "KEH ügyszám: VIII-1/05433/2011."
    }
  ]
}
