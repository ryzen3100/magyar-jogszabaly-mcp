    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1997. március 1-jei hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– hetvenedik életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
