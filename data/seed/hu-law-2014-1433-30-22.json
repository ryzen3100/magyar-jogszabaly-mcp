  "title": "1433/2014. (VII. 31.) Korm. határozat „Életmentő Emlékérem” adományozásáról",
  "status": "in_force",
  "in_force_date": "2014-07-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2014-1433-30-22",
  "description": "„Életmentő Emlékérem” adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány az „Életmentő Emlékérem” adományozásáról szóló 243/2009. (X. 29.) Korm. rendelet alapján, életmentés közben tanúsított hősies magatartása elismeréseként – a belügyminiszter mint helyi önkormányzatokért felelős miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Mészáros Barnabás boldvai és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Luif Ákos csepregi lakosnak"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "„Életmentő Emlékérmet”"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "adományoz."
    }
  ]
}
