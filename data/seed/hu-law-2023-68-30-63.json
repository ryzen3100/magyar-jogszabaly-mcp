{
  "id": "hu-law-2023-68-30-63",
  "type": "statute",
  "title": "68/2023. (VIII. 8.) ME határozat helyettes államtitkárok felmentéséről",
  "status": "in_force",
  "in_force_date": "2023-08-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/2023-68-30-63",
  "description": "helyettes államtitkárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– az európai uniós ügyekért felelős miniszter javaslatára –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Pátkai Nándort, az Európai Uniós Ügyek Minisztériuma helyettes államtitkárát"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2023. augusztus 8-ai hatállyal, továbbá"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– az igazságügyi miniszter javaslatára –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Bíró Attilát, a Miniszterelnöki Kabinetiroda helyettes államtitkárát"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2023. augusztus 9-ei hatállyal,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "e tisztségükből – közigazgatási államtitkári kinevezésük miatt – felmentem."
    }
  ]
}
