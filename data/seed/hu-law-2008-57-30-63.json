{
  "id": "hu-law-2008-57-30-63",
  "type": "statute",
  "title": "57/2008. (VIII. 29.) ME határozat szakállamtitkár megbízatásának megszűnéséről",
  "status": "in_force",
  "in_force_date": "2008-08-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-57-30-63",
  "description": "szakállamtitkár megbízatásának megszűnéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 59. § (1)–(2) bekezdése alapján megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Elbert Gábornak, az Önkormányzati Minisztérium szakállamtitkárának e megbízatása"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2008. szeptember 1-jei hatállyal – lemondásával –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megszűnik."
    }
  ]
}
