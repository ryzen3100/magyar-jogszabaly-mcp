  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Magyar Közlöny 1990. évi 138. számában közzétett 7/1990. (XII. 30.) NGKM—PM együttes rendelet 1. sz. mellékletében az egyes vámtarifaszámok helyesen a következők:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "2921.41—018, 2921.41—997, 7210.12—991, 8528.10—021, 8540.20—012, 8540.20—997, 8708.50—990, 8711.30—017, 8711.30—992, 8711.40—018, 8711.40—993, 8711.50—019, 8711.50—994, 8802.11—013, 8802.11—998, 8802.12—016, 8802.12—991"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "A rendelet 2. sz. mellékletében a +-al jelzett vámtarifaszámokhoz tartozó vámkontingens nagysága mindösszesen 600 M Ft."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(Kézirathiba)"
    }
  ]
}
