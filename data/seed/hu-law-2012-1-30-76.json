  "title": "1/2012. (I. 6.) KE határozat rektori megbízásról",
  "status": "in_force",
  "in_force_date": "2012-01-06",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-1-30-76",
  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának a) pontja alapján, a nemzeti erőforrás miniszter és a Fenntartói Testület javaslatára, a Nemzeti Közszolgálati Egyetemen"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Patyi András egyetemi tanárt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2012. január 1-től 2016. december 31-éig terjedő időtartamra"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: IV-3/06278/2011."
    }
  ]
}
