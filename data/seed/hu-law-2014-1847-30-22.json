    },
    {
      "provision_ref": "s48",
      "section": "48",
      "title": "48",
      "content": "2.8. A különleges bánásmódot igénylő gyermekek esélyteremtésének elősegítése érdekében támogatni kell a befogadó nevelést."
    },
    {
      "provision_ref": "s49",
      "section": "49",
      "title": "49",
      "content": "Felelős: oktatásért felelős miniszter"
