    },
    {
      "provision_ref": "s65",
      "section": "65",
      "title": "65",
      "content": "3.4. Elő kell segíteni a Kárpát-medence és diaszpóra hétvégi iskoláiban folyó magyar nyelvi oktatást."
    },
