      "section": "3",
      "title": "3",
      "content": "dr. Gyulai József egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2003. augusztus hó 31. napjával,"
    },
    {
