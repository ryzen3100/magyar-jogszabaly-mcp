{
  "id": "hu-law-2011-86-30-76",
  "type": "statute",
  "title": "86/2011. (IV. 7.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2011-04-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-86-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Köztársaság Elnökének Érdemérme és a Köztársaság Elnökének Díszoklevele Éremmel kitüntetések alapításáról szóló 223/2010. (IX. 2.) KE. határozat 3. pontjában foglaltak alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a köz érdekében végzett példaértékű, eredményes munkájáért"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Andrási Imrének,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a nemzeti értékek és a demokratikus Magyarország iránti elkötelezettségéért"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Cs. Kovács Károlynak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a közintézmények gazdálkodásáért végzett több évtizedes példamutató munkájáért, a köztisztviselői hivatás társadalmi elismertségének erősítéséért"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Hajdúné Gácsi Máriának,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a jászsági középfokú oktatásért, a szakoktatás fejlesztéséért végzett kimagasló tevékenységéért, a megyei közgyűlés alelnökeként végzett magas színvonalú munkájáért"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Kiss Jánosnak,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "a közösségért végzett példamutató tevékenységéért, a magyarság történelmi értékeinek képviseletéért, terjesztéséért"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Tokaji Gyulának,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "a lakosság egészségnevelése elismeréseként, a köztisztviselői hivatás társadalmi megbecsülésének erősítéséért"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "dr. Versitz Évának a"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "KÖZTÁRSASÁG ELNÖKÉNEK DÍSZOKLEVELE ÉREMMEL"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "KEH ügyszám: VIII-5/01495/2011."
    }
  ]
}
