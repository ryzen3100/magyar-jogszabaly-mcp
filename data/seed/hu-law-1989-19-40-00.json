{
  "id": "hu-law-1989-19-40-00",
  "type": "statute",
  "title": "1989. MK 19. szám helyesbítés",
  "status": "amended",
  "in_force_date": "1989-03-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/1989-19-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 11., 1989. február 22-i számában megjelent 1989. évi 4. törvényerejű rendelet melléklete helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 1. § (1) lábjegyzete: alkalmaznia helyett: tartalmaznia"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 8. § 2. sor: határára helyett: határa"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– 39. § (1) a): a szöveg végére pont helyett pontosvessző kell"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 78. § (1) 5. sor: együttes megléte esetén áll be"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "– 78. § (3) utolsó sor: védelmezni helyett: vélelmezni"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "– 82. § (4) 6. sor: általános helyett: általánosan"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "– 118. § 2. sor: sem a jelen Általános Szállítási Feltételekben"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "(Kézirathiba)"
    }
  ]
}
