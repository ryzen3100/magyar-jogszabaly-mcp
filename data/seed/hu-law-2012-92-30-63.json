{
  "id": "hu-law-2012-92-30-63",
  "type": "statute",
  "title": "92/2012. (VII. 19.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2012-07-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-92-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 220. § (2) bekezdése alapján, az emberi erőforrások minisztere javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Bathó Ferencet az Emberi Erőforrások Minisztériuma helyettes államtitkárává"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2012. július 16-ai hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    }
  ]
}
