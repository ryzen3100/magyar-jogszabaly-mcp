{
  "id": "hu-law-1995-18-30-63",
  "type": "statute",
  "title": "18/1995. (VI. 30.) ME határozat főiskolai főigazgatói megbízásokról",
  "status": "amended",
  "in_force_date": "1995-06-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-18-30-63",
  "description": "főiskolai főigazgatói megbízásokról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 56. §-ának (2) és (5) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Békési Imre főiskolai tanárt, a Juhász Gyula Tanárképző Főiskolán,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Horváth Béla főiskolai tanárt, az Illyés Gyula Pedagógiai Főiskolán,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Cseh Sándor főiskolai tanárt, az Apáczai Csere János Tanítóképző Főiskolán — ismételten —,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Gál Jenő főiskolai tanárt, a Magyar Táncművészeti Főiskolán — ismételten —"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a főigazgatói teendők ellátásával"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "1995. július 1-jei hatállyal — háromévi időtartamra —"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "megbízom."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
