{
  "id": "hu-law-2000-21-30-76",
  "type": "statute",
  "title": "21/2000. (II. 2.) KE határozat közigazgatási államtitkár felmentéséről",
  "status": "amended",
  "in_force_date": "2000-02-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-21-30-76",
  "description": "közigazgatási államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 29. § (1) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Pröhle Gergelyt, a Nemzeti Kulturális Örökség Minisztériuma közigazgatási államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– más fontos megbízatása miatt, 2000. január 31-i hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Budapest, 2000. január 31."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
