    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 2003. július 16-i hatállyal –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "kinevezem dandártábornokká"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Újfalusi Csaba ezredest,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a HM HVK Vezérkari Iroda, vezérkari irodavezetőjét."
