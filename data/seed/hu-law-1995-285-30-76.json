      "section": "3",
      "title": "3",
      "content": "dr. Galántai József egyetemi tanárt,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Simon Tibor egyetemi tanárt és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Takács Imre egyetemi tanárt"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– nyugállományba vonulásukra tekintettel – 1996. augusztus hó 31. napjával e tisztségük alól felmentem."
    },
    {
      "provision_ref": "s7",
