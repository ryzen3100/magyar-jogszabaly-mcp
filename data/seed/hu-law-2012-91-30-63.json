  "title": "91/2012. (VII. 19.) ME határozat miniszterelnöki biztos felmentéséről",
  "status": "in_force",
  "in_force_date": "2012-07-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-91-30-63",
