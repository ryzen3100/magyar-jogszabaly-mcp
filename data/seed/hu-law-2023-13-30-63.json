{
  "id": "hu-law-2023-13-30-63",
  "type": "statute",
  "title": "13/2023. (II. 16.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2023-02-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/2023-13-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – a felsőoktatásért felelős miniszternek a fenntartó kezdeményezésére tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Karsai Gábor Zsoltot az A Tan Kapuja Buddhista Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2023. február 15-étől 2027. február 14-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
