{
  "id": "hu-law-2020-91-30-63",
  "type": "statute",
  "title": "91/2020. (X. 5.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2020-10-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2020-91-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az innovációért és technológiáért felelős miniszternek a fenntartó kezdeményezésére tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Enghy Sándort a Sárospataki Református Teológiai Akadémián"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2020. október 1-jétől 2023. szeptember 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
