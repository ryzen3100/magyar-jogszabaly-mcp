{
  "id": "hu-law-1990-118-40-00",
  "type": "statute",
  "title": "1990. MK 118. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1990-11-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-118-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1990. évi 103. számában megjelent 70/1990. (X. 17.) Korm. rendelettel módosított 84/1988. (XII. 15.) Korm. rendelet melléklete 6/c) pontjának bevezető szövege helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,c) a tárgyévi mérleg szerinti bérköltség bázisának a 20%-a;''"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "melléklete 6/d) pontjában a zárójeles rész szövege helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,(a továbbiakban együtt: kedvezményezett tevékenység)''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "melléklete utolsó előtti bekezdésének harmadik sora helyesen:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": ",,… tartalmazó ellenértékének pénzben kifejezett összege, növelve…''"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Kézirathiba)"
    }
  ]
}
