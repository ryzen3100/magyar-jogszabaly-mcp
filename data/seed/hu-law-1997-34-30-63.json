{
  "id": "hu-law-1997-34-30-63",
  "type": "statute",
  "title": "34/1997. (X. 17.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "amended",
  "in_force_date": "1997-10-17",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-34-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 33. §-ának (1) bekezdése, valamint a 39. §-ának (2) bekezdése alapján, a Miniszterelnöki Hivatal közigazgatási államtitkára javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Náthon Istvánt a Miniszterelnöki Hivatalba helyettes államtitkárrá"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 1997. október 16-ai hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
