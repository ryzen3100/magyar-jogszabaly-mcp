{
  "id": "hu-law-2005-61-30-63",
  "type": "statute",
  "title": "61/2005. (IX. 2.) ME határozat kormányzati főtisztviselő áthelyezéséről",
  "status": "in_force",
  "in_force_date": "2005-09-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-61-30-63",
  "description": "kormányzati főtisztviselő áthelyezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 31/C. § (6) bekezdésében foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Szitáné dr. Kazai Ágnes kormányzati főtisztviselőt az Európai Ügyekért Felelős Tárca Nélküli Miniszter Hivatala állományába, kormányfőtanácsadói feladatok ellátására"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2005. szeptember 1-jei hatállyal – határozatlan időre – áthelyezem."
    }
  ]
}
