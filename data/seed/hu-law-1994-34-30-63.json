{
  "id": "hu-law-1994-34-30-63",
  "type": "statute",
  "title": "34/1994. (IX. 20.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1994-09-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-34-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (3) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Medvetzky Antalné dr.-t, a Pollack Mihály Műszaki Főiskola főiskolai tanárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1994. december 15-i hatállyal,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Sohajda Imrét, a Kertészeti és Élelmiszeripari Egyetem kecskeméti Kertészeti Főiskolai Kar főiskolai tanárát"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "1994. augusztus 31-i hatállyal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "— közös megegyezéssel —,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Kovács Imrét, a Liszt Ferenc Zeneművészeti Főiskola főiskolai tanárát"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "1994. szeptember 1-jei hatállyal"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "— 70. életéve betöltésére tekintettel —,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Timár Imrét, a Budapesti Tanítóképző Főiskola főiskolai tanárát"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "1995. április 30-i hatállyal"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "— nyugállományba vonulására tekintettel —"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
