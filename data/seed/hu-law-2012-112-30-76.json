{
  "id": "hu-law-2012-112-30-76",
  "type": "statute",
  "title": "112/2012. (V. 2.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2012-05-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-112-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés f) pontja, valamint a Magyarország címerének és zászlajának használatáról, valamint állami kitüntetéseiről szóló 2011. évi CCII. törvény 18. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a magyar–lengyel önkormányzati kapcsolatok ápolása és a két ország közös történelmi emlékeinek megörökítése terén végzett kiemelkedő tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Jacek Kaznowski, Varsó Biařořęka kerületének polgármestere részére a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR ÉRDEMREND"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "LOVAGKERESZTJE"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "polgári tagozata,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "az 1956-os magyar menekültek életének megmentése érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Jan Wiercioch és Krystyna Papie≤ részére,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "egy 1956-os magyar menekült szabadságharcos életének megmentése érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Stanislaw Kolodziejski nyugalmazott jogászprofesszor részére a"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "MAGYAR ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "polgári tagozata,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "a magyar–lengyel kapcsolatok ápolása és továbbfejlesztése terén végzett kiemelkedő munkája elismeréseként"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Latala-Zięba Lucyna, a Piwnicznai Lengyel–Magyar Társaság elnöke részére a"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "MAGYAR EZÜST ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "polgári tagozata"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "KEH ügyszám: VIII-1/01375/2012."
    }
  ]
}
