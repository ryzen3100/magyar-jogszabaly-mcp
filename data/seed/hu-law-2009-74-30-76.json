{
  "id": "hu-law-2009-74-30-76",
  "type": "statute",
  "title": "74/2009. (VI. 22.) KE határozat rektori megbízásról",
  "status": "in_force",
  "in_force_date": "2009-06-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2009-74-30-76",
  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának a) pontja alapján, az oktatási és kulturális miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Magyar Képzőművészeti Egyetemen,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Kőnig Frigyes egyetemi tanárt – további –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2009. július 1-jétől 2013. június 30-áig terjedő időtartamra és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Semmelweis Egyetemen,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Tulassay Tivadar egyetemi tanárt – további –"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2009. július 1-jétől 2012. június 30-áig terjedő időtartamra"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "KEH ügyszám: IV-3/02499/2009."
    }
  ]
}
