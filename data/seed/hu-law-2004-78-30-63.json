{
  "id": "hu-law-2004-78-30-63",
  "type": "statute",
  "title": "78/2004. (XI. 19.) ME határozat kormányzati főtisztviselő áthelyezéséről",
  "status": "in_force",
  "in_force_date": "2004-11-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-78-30-63",
  "description": "kormányzati főtisztviselő áthelyezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 31/C. §-ának (6) bekezdésében foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Rusznákné dr. Demeter Judit kormányzati főtisztviselőt az Ifjúsági, Családügyi, Szociális és Esélyegyenlőségi Minisztérium állományába, koordinációs főosztályvezetői-főcsoportfőnöki feladatok ellátására"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2004. november 15-i hatállyal – határozatlan időre –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "áthelyezem."
    }
  ]
}
