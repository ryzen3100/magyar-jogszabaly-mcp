{
  "id": "hu-law-2007-165-20-0n",
  "type": "statute",
  "title": "165/2007. (XII. 27.) KvVM rendelet a Tokaj–Bodrogzug Tájvédelmi Körzet védettségének fenntartásáról",
  "status": "in_force",
  "in_force_date": "2008-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-165-20-0N",
  "description": "a Tokaj–Bodrogzug Tájvédelmi Körzet védettségének fenntartásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § Az Országos Környezet- és Természetvédelmi Hivatal elnökének 7/1986. (VIII. 21.) OKTH számú rendelkezésével létesített Tokaj–Bodrogzug Tájvédelmi Körzet védettségét fenntartom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § A Tokaj–Bodrogzug Tájvédelmi Körzet kiterjedése 5318,5 ha, ingatlan-nyilvántartási helyrajzi számait az I. számú melléklet, fokozottan védett területének ingatlan-nyilvántartási helyrajzi számait a 2. számú melléklet tartalmazza."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A védettség indoka és célja a Nagy-Kopasz vulkanikus szigethegy és a Bodrogzug jellegzetes tájszerkezetének és tájképi adottságainak, az itt található élőhelyek természetes növény- és állatvilágának megőrzése, valamint a védett madarak háborítatlan fészkelő- és táplálkozóhelyének, vonulásának biztosítása."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § A terület természetvédelmi kezeléséért felelős szerv az Aggteleki Nemzeti Park Igazgatóság."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5. §",
      "content": "5. § (1) Ez a rendelet 2008. január 1-jén lép hatályba. (2)"
    },
