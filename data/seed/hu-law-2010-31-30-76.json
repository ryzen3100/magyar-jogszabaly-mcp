{
  "id": "hu-law-2010-31-30-76",
  "type": "statute",
  "title": "31/2010. (III. 15.) KE határozat kitüntetés adományozásáról",
  "status": "amended",
  "in_force_date": "2010-03-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-31-30-76",
  "description": "Kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a közlekedési, hírközlési és energiaügyi miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Hamvas Istvánnak, a Paksi Atomerőmű Zrt. műszaki vezérigazgató-helyettesének,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Horn Jánosnak, a Bánya-, Energia- és Ipari Dolgozók Szakszervezete elnöki főtanácsadójának,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Izsáki Mihálynak, a Magyar Villamos Művek Zrt. jogi és igazgatási igazgatójának,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Nagy Lajosnak, az OMYA Hungaria Kft. ügyvezető igazgatójának,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Töllösy Pálnak, a GEO-FÁBER Zrt. vezérigazgatójának,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Zsirai Istvánnak, a KTI Közlekedéstudományi Intézet Nonprofit Kft. tanácsadó tudományos munkatársának a"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(polgári tagozat);"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Nagy Károlynak, a Győr-Sopron-Ébenfurti Vasút Zrt. forgalmi végrehajtási egység vezetőjének,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "dr. Takáts Attilának, a Közlekedési, Hírközlési és Energiaügyi Minisztérium szakmai főtanácsadójának a"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "(polgári tagozat)"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "Budapest, 2010. március 1."
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s17",
