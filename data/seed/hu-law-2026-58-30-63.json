  "title": "58/2026. (VI. 26.) ME határozat helyettes államtitkárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2026-06-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2026-58-30-63",
  "description": "helyettes államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 234. § (1) bekezdésében foglalt jogkörömben eljárva, a közlekedési és beruházási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Horn Gergelyt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Nyiri Szabolcsot és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Stipich Zsuzsanna Katalint"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2026. június 28-ai hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Közlekedési és Beruházási Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kinevezem."
    }
  ]
}
