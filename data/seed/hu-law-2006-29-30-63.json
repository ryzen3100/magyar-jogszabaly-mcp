{
  "id": "hu-law-2006-29-30-63",
  "type": "statute",
  "title": "29/2006. (V. 12.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2006-05-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-29-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) pontjában foglalt jogkörömben – az oktatási miniszternek a fenntartóval egyetértésben tett előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Nemzetközi Üzleti Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Tamás István főiskolai tanárt – a 2006. június 1-jétől 2012. május 31-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
