{
  "id": "hu-law-1995-228-30-76",
  "type": "statute",
  "title": "228/1995. (X. 25.) KE határozat dandártábornoki kinevezésről",
  "status": "amended",
  "in_force_date": "1995-10-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-228-30-76",
  "description": "dandártábornoki kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A polgári nemzetbiztonsági szolgálatokat felügyelő tárca nélküli miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "nemzeti ünnepünk, október 23-a alkalmából"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Mandúr Ferenc ezredest,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Nemzetbiztonsági Hivatal szakszolgálat vezetőjének műveleti helyettesét"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dandártábornokká"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Nikolits István s. k., tárca nélküli miniszter"
    }
  ]
}
