{
  "id": "hu-law-2012-3-30-63",
  "type": "statute",
  "title": "3/2012. (I. 12.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2012-01-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-3-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormánytisztviselők jogállásáról szóló 2010. évi LVIII. törvény 51. §-a alapján, a nemzetgazdasági miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Csizmadia Norbertet, a Nemzetgazdasági Minisztérium helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2012. január 9-ei hatállyal, más fontos megbízatására tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
