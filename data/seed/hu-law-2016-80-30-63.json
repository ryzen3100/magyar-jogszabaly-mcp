{
  "id": "hu-law-2016-80-30-63",
  "type": "statute",
  "title": "80/2016. (VII. 21.) ME határozat főiskolai rektorok megbízásáról",
  "status": "in_force",
  "in_force_date": "2016-07-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/2016-80-30-63",
  "description": "főiskolai rektorok megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az oktatásért felelős miniszter előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Eötvös József Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Melicz Zoltán főiskolai tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2016. június 15-étől 2019. június 14-éig terjedő időtartamra –, valamint"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Gál Ferenc Főiskolán"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Kozma Gábor főiskolai tanárt"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– a 2016. július 1-jétől 2021. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
