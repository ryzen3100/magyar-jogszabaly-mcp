{
  "id": "hu-law-1995-46-30-63",
  "type": "statute",
  "title": "46/1995. (XII. 7.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1995-12-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-46-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Hermann Ákost, a Kandó Kálmán Műszaki Főiskola főiskolai tanárát, 1995. november 30-i hatállyal"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— közalkalmazotti jogviszonyának megszűnésére tekintettel —,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Mórócz Istvánt, a Kandó Kálmán Műszaki Főiskola főiskolai tanárát, 1996. április 30-i hatállyal,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Schnöller Antalt, a Kandó Kálmán Műszaki Főiskola főiskolai tanárát, 1996. április 30-i hatállyal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "— nyugállományba vonulására tekintettel —"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
