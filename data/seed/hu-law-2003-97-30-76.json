{
  "id": "hu-law-2003-97-30-76",
  "type": "statute",
  "title": "97/2003. (VI. 20.) KE határozat közigazgatási államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2003-06-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-97-30-76",
  "description": "közigazgatási államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 29. §-ának (1) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Vass Lajost, a Nemzeti Kulturális Örökség Minisztériuma közigazgatási államtitkárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2003. június 15-i hatállyal, más fontos megbízatása miatt –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-1/2376-0/2003."
    }
  ]
}
