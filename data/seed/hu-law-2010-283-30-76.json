{
  "id": "hu-law-2010-283-30-76",
  "type": "statute",
  "title": "283/2010. (XI. 29.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2010-11-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-283-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a nemzetgazdasági miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Bődi Jánosnak, az Integrál Építő Zrt. tulajdonos elnök-vezérigazgatójának"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Fajszi Lajosnak, az F-1. GROUP Kft. ügyvezetőjének"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Tardos Jánosnak, a Reálsas Tanácsadó Kft. ügyvezető igazgatójának a"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "kitüntetést"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "adományozom."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "KEH ügyszám: VIII-1/04927/2010."
    }
  ]
}
