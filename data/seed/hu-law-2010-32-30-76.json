  "description": "Kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a külügyminiszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Anna Valentová műfordítónak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Csanády Ágnesnek, a Hollandiai Magyar Szövetség titkárának,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Hajnal Mihály festő- és grafikusművésznek"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Hofman-Gáspár Mária festőművésznek,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Lapohos Andrásnak, a Kolozs megyei Ördöngösfüzesi Általános Iskola nyugalmazott tanárának,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "László Károlynak, a Técsői Református Líceum lelkész igazgatójának, a Técsői és Felső Tisza-vidéki református egyházközösség lelkészének,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Mayer Judit műfordítónak, nyugalmazott szerkesztőnek,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Nagy Lucia nyugalmazott belgyógyásznak, a Norvég-Magyar Egyesület vezetőjének,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Petei Juditnak, a Kárpátalja Megyei Tanács képviselőjének, a Mikaland Vegyesvállalat igazgatójának,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Péntek Lászlónak, Körösfő Község alpolgármesterének,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Rohonyi Tamásnak, a FORMULA Brazil Nagydíj rendező cégének igazgatójának,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Serényi János nyugalmazott iskolaigazgatónak,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Sofia Marta Terek-nek, a Cáritas Argentina koordinátorának, a Magyar Irodalmi és Kultúrtársaság programkoordinátorának, az Argentin Magyar Hírlap könyvvizsgálójának,"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "Tápi Lajosnak, a Magyar Köztársaság szabadkai konzuljának,"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "dr. Vass Levente urológusnak, a Studium Alapítvány és a Studium Szakkönyvkiadó (Marosvásárhely) alapító tagjának a"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "(polgári tagozat);"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "Kilyén Ilka színművésznek, a Marosvásárhelyi Nemzeti Színház Tompa Miklós Társulatának tagjának a"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "(polgári tagozat);"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "Opóczki Istvánnak, a Magyar Köztársaság bécsi külképviseletének szakácsának, hivatalsegédjének a"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "MAGYAR KÖZTÁRSASÁGI BRONZ ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": "(polgári tagozat)"
    },
    {
      "provision_ref": "s25",
      "section": "25",
      "title": "25",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s26",
      "section": "26",
      "title": "26",
      "content": "Budapest, 2010. március 5."
    },
    {
