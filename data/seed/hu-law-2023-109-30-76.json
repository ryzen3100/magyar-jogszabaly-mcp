      "section": "2",
      "title": "2",
      "content": "dr. Matécsáné dr. Sergyán Barbarát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Ulrich Ágnest és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Vucskics Petrát"
    },
    {
      "provision_ref": "s5",
      "section": "5",
