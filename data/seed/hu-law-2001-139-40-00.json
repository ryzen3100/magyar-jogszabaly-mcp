{
  "id": "hu-law-2001-139-40-00",
  "type": "statute",
  "title": "2001. MK 139. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2001-12-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2001-139-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2001. évi 119. számában kihirdetett,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. a csatornabírságról szóló 204/2001. (X. 26.) Korm. rendelet 2. számú melléklete B táblázatának"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– Küszöbérték (g/m3) fejrovata helyesen:"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": ",,Küszöbérték (g/m3, ill. 10–3 m3/m3)''"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 16. sorának 2. oszlopa helyesen:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": ",,Benzol (BTEX)''"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2. az egyes vízgazdálkodással összefüggő jogszabályok módosításáról szóló 205/2001. (X. 26.) Korm. rendelet"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 4. §-ában az a) pontban szereplő hivatkozás helyesen:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,…2. § 46. pontjában…''"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "– 5. §-ához tartozó lábjegyzet helyesen:"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": ",,2 204/2001. (X. 26.) Korm. rendelet a csatornabírságról,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "72/1996. (V. 22.) Korm. rendelet a vízgazdálkodási hatósági jogkör gyakorlásáról.''"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "(Kézirathiba)"
    }
  ]
}
