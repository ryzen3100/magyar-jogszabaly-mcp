{
  "id": "hu-law-2004-67-30-63",
  "type": "statute",
  "title": "67/2004. (X. 15.) ME határozat kormányzati főtisztviselő áthelyezéséről",
  "status": "in_force",
  "in_force_date": "2004-10-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-67-30-63",
  "description": "kormányzati főtisztviselő áthelyezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 31/C. §-ának (6) bekezdésében foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Csáky Bernadett Barbara kormányzati főtisztviselőt a Miniszterelnöki Hivatal Miniszterelnöki Titkárság állományába, főosztályvezetői teendők ellátására"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2004. október 4-i hatállyal – határozatlan időre –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "áthelyezem."
    }
  ]
}
