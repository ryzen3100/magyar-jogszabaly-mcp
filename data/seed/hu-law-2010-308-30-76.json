{
  "id": "hu-law-2010-308-30-76",
  "type": "statute",
  "title": "308/2010. (XII. 20.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2010-12-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-308-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Köztársaság Elnökének Érdemérme és a Köztársaság Elnökének Díszoklevele Éremmel kitüntetések alapításáról szóló 223/2010. (IX. 2.) KE határozat 3. pontjában foglaltak alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a gyermekek gyógyításában önkéntesként végzett tevékenységéért"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Fórizs Etelka fogszakorvosnak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Szekeres Márta nyugalmazott vezető főorvosnak, gyermekszemész szakorvosnak"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "lovasterapeutaként és önkéntesként végzett tevékenységéért"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Topár Zsoltnak, a Magyar Fogyatékosok Lovas Sportszövetsége elnökének, a"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "KÖZTÁRSASÁG ELNÖKÉNEK DÍSZOKLEVELE ÉREMMEL"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "KEH ügyszám: VIII-5/05578/2010."
    }
  ]
}
