{
  "id": "hu-law-2008-46-30-63",
  "type": "statute",
  "title": "46/2008. (VI. 20.) ME határozat főiskolai tanár kinevezéséről, főiskolai rektor felmentéséről és megbízásáról",
  "status": "in_force",
  "in_force_date": "2008-06-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-46-30-63",
  "description": "főiskolai tanár kinevezéséről, főiskolai rektor felmentéséről és megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) és b) pontjában foglalt jogkörömben – az oktatási és kulturális miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Apor Vilmos Katolikus Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kocsis Imre főiskolai tanárt, a rektori megbízatása alól – a 2008. június 14-i hatállyal – lemondása miatt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem;"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Balázs Pált – 2008. június 15-i hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "főiskolai tanárrá kinevezem, és"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "az Apor Vilmos Katolikus Főiskolán"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 2008. június 15-től 2011. június 14-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
