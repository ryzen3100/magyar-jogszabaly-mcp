{
  "id": "hu-law-2002-86-30-76",
  "type": "statute",
  "title": "86/2002. (V. 31.) KE határozat közigazgatási államtitkárok megbízatásának megszűnéséről",
  "status": "in_force",
  "in_force_date": "2002-05-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2002-86-30-76",
  "description": "közigazgatási államtitkárok megbízatásának megszűnéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 29. § (3) bekezdése alapján megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Nagy Rózának,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a volt Gazdasági Minisztérium közigazgatási államtitkárának és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Tombor Sándornak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a volt Közlekedési és Vízügyi Minisztérium közigazgatási államtitkárának"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "e megbízatása"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– 2002. május 29-i hatállyal –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "áthelyezésük miatt"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "megszűnt."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "KEH ügyszám: V-1/2084/2002."
    }
  ]
}
