  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A művelődési és közoktatási miniszter előterjesztésére a rektori teendők ellátásával a Miskolci Egyetemen 1997. november 15-től 2001. június 30-ig terjedő időtartamra"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Besenyei Lajos egyetemi tanárt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "megbízom."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Egyidejűleg a Miskolci Egyetemen"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Farkas Ottó egyetemi tanárnak"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "rektori megbízása 1997. november 14. napján történő lejártával eredményes munkájáért elismerésemet, köszönetemet fejezem ki."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Dr. Magyar Bálint s. k., művelődési és közoktatási miniszter"
    }
  ]
}
