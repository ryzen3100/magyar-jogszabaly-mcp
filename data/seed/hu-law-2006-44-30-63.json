{
  "id": "hu-law-2006-44-30-63",
  "type": "statute",
  "title": "44/2006. (VII. 13.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2006-07-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-44-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) pontjában foglalt jogkörömben – az oktatási miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Wesley János Lelkészképző Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Iványi Gábor főiskolai tanárt – 2006. július 1-jétől határozatlan időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom."
    }
  ]
}
