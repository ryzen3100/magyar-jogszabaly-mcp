{
  "id": "hu-law-2010-42-30-63",
  "type": "statute",
  "title": "42/2010. (VI. 10.) ME határozat helyettes államtitkárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2010-06-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-42-30-63",
  "description": "helyettes államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 58/R. § (1) bekezdése alapján, az illetékes miniszterek, valamint a Miniszterelnökséget vezető államtitkár javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Fericsán Anitát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Havasi Bertalant"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Miniszterelnökség helyettes államtitkárává,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Csonka Ernőt,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Jeney Orsolyát"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a Közigazgatási és Igazságügyi Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 2010. június 10-ei hatállyal –"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kinevezem. 1 A Magyar Közlöny 2010. évi 99. számában megjelent 41/2010. (VI. 10.) ME határozat tárgytalan. 2 A 94/2015. (XI. 11.) ME határozat alapján dr. Havasi Bertalan tekintetében akként módosul, hogy a „Miniszterelnökség” megnevezés helyett a „Miniszterelnöki Kabinetiroda” megnevezést kell érteni."
    }
  ]
}
