{
  "id": "hu-law-2003-154-30-76",
  "type": "statute",
  "title": "154/2003. (IX. 4.) KE határozat egyetemi tanári kinevezésekről",
  "status": "in_force",
  "in_force_date": "2003-09-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-154-30-76",
  "description": "egyetemi tanári kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "2003. szeptember hó 15. napjával,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Fekete Károlyt, a Debreceni Egyetem egyetemi docensét,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Géher Istvánt, az Eötvös Loránd Tudományegyetem egyetemi docensét,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Tomcsányi Teodórát, a Semmelweis Egyetem egyetemi docensét és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Nánai Lászlót, a Szegedi Tudományegyetem főiskolai tanárát"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kinevezem egyetemi tanárrá."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "KEH ügyszám: V-2/3373/2003."
    }
  ]
}
