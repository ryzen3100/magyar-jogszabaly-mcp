{
  "id": "hu-law-2003-8-30-84",
  "type": "statute",
  "title": "8/2003. (IV. 24.) MeHVM határozat helyettes államtitkári megbízatás megszűnésének megállapításáról",
  "status": "in_force",
  "in_force_date": "2003-04-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-8-30-84",
  "description": "helyettes államtitkári megbízatás megszűnésének megállapításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 35. §-a alapján megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kodela Lászlónak, a Miniszterelnöki Hivatal helyettes államtitkárának e megbízatása"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "lemondására tekintettel"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2003. április 21-i hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megszűnik."
    }
  ]
}
