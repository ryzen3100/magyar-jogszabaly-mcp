{
  "id": "hu-law-1997-104-30-76",
  "type": "statute",
  "title": "104/1997. (VIII. 14.) KE határozat kitüntetéses doktorrá avatásról",
  "status": "amended",
  "in_force_date": "1997-08-14",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-104-30-76",
  "description": "kitüntetéses doktorrá avatásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A művelődési és közoktatási miniszter előterjesztésére hozzájárulok ahhoz, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Geretovszky Zsolt okleveles kémia-fizika tanárt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a József Attila Tudományegyetemen,,Promotio sub auspiciis praesidentis Rei Publicae'' kitüntetéses doktorrá avassák."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Dr. Magyar Bálint s. k., művelődési és közoktatási miniszter"
    }
  ]
}
