    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "lemondására tekintettel"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Roschné dr. Bíró Krisztinát 2012. július 31-ei hatállyal és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Seydl Andreát 2012. október 25-ei hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "bírói tisztségéből felmentem,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Böröcz Lászlót"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2012. június 15. napjától 2015. június 14. napjáig terjedő időtartamra bíróvá kinevezem."
    },
    {
