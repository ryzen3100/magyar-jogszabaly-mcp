{
  "id": "hu-law-1994-181-30-76",
  "type": "statute",
  "title": "181/1994. (XI. 2.) KE határozat vezérkari főnök felmentéséről",
  "status": "amended",
  "in_force_date": "1994-11-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-181-30-76",
  "description": "vezérkari főnök felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "a honvédelmi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Deák János vezérezredest, a Magyar Honvédség parancsnokát, vezérkari főnökét"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Magyar Honvédség parancsnoki beosztása érintetlenül hagyásával"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "1994. november 1-jei hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "vezérkari főnöki beosztásából felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Keleti György s. k., honvédelmi miniszter"
    }
  ]
}
