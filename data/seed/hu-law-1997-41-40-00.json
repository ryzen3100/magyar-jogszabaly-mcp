{
  "id": "hu-law-1997-41-40-00",
  "type": "statute",
  "title": "1997. MK 41. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1997-05-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-41-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1997. évi 33. számában kihirdetett, a postai tevékenységről szóló 133/1993. (IX. 29.) Korm. rendelet módosításáról szóló 62/1997. (IV. 18.) Korm. rendelet"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 8. §-ával megállapított, az R. 16. §-a (1) bekezdésének felvezető szövegének második sora helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,települések belterületén a szolgáltató házhoz kézbesíti''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 17. § (3) bekezdésének második sora helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,»felszerelése« szövegrész helyébe a »…, felszerelések« szövegrész lép.''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– 1. sz. melléklet 7/a) pontjának ötödik sora helyesen:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": ",,(Ha az iratot nem a címzett veszi át, a rokoni vagy''"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "(Nyomdahiba)"
    }
  ]
}
