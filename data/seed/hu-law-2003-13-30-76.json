{
  "id": "hu-law-2003-13-30-76",
  "type": "statute",
  "title": "13/2003. (II. 20.) KE határozat egyetemi tanári kinevezés alóli felmentésekről",
  "status": "in_force",
  "in_force_date": "2003-02-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-13-30-76",
  "description": "egyetemi tanári kinevezés alóli felmentésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Budapesti Műszaki és Gazdaságtudományi Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Artinger István egyetemi tanárt és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Varga László egyetemi tanárt"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "2003. augusztus 31. napjával,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a Liszt Ferenc Zeneművészeti Egyetemen"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Botvay Károly egyetemi tanárt"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "2003. január 31. napjával, és"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "a Nyugat-Magyarországi Egyetemen"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "dr. Szabó Imre egyetemi tanárt"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "– nyugállományba vonulására tekintettel –"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "2003. április 30. napjával,"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "dr. Verő József további jogviszonyban alkalmazott egyetemi tanárt"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "2003. július 23. napjával,"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "– 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "kinevezése alól felmentem."
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "KEH ügyszám: V-2/0502/2003."
    }
  ]
