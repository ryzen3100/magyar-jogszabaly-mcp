{
  "id": "hu-law-2023-105-30-63",
  "type": "statute",
  "title": "105/2023. (XII. 22.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2023-12-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2023-105-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján – a Miniszterelnökséget vezető miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Horvát Szilárdot, a Miniszterelnökség helyettes államtitkárát e tisztségéből – más fontos megbízatására tekintettel –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2023. december 31-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
