  "title": "2003. MK 127. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2003-11-06",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-127-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2003. évi 118. számában kihirdetett, a közutak igazgatásáról szóló 19/1994. (V. 31.) KHVM rendelet módosításáról rendelkező 63/2003. (X. 16.) GKM rendelet melléklete helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "[4. számú melléklet a 19/1994. (V. 31.) KHVM rendelethez]"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Országos közutak nem közlekedési célú igénybevétele esetén fizetendő díjak"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(Kézirathiba)"
    }
  ]
}
