    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1990. évi 81. számában közzétett, a helyi (távolsági) menetrendszerinti autóbuszközlekedés támogatásáról szóló 2/1990. (VIII. 17.) KHM rendelet mellékletei az alábbiak szerint egészülnek ki:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. számú melléklet"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Baranya megye | Mogyoród | 2,5 km"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "| Meződ | 1,4 km"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "| Tengeri | 2,1 km"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Bács-Kiskun megye | Pereghalom | 5,0 km"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Csongrád megye | Templom malom | 7,0 km"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Somogy megye | Galambos puszta | 1,9 km"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "2. számú melléklet"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Baranya megye | Villánykövesd | 3,8 km"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Komárom-Esztergom megye | Pilismarót Basaharc | 3,6 km"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Nógrád megye | Ősagárd | 3,0 km"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Pest megye | Biatorbágy Iharos | 1,0 km"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "A Magyar Közlöny 1990. évi 95. számában közzétett 1990: LXXIV. törvény 2. § (4) bek. első mondat vége: egységek."
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "Helyesen: egységesek."
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "A 7. § (1) bek. 3 mondat: Az üzemeltetési (bérleti) díjat a vállalat..."
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "Helyesen:...vállalt..."
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "A Magyar Közlöny 1990. évi 98. számában közzétett, az Útalapról szóló 61/1989. (VI. 27.) MT rendelet módosításáról intézkedő 62/1990. (X. 4.) Korm. rendelet 1. § (2) bekezdésében szereplő összeg helyesen 300 M Ft."
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "(Nyomdahiba)"
    }
  ]
}
