{
  "id": "hu-law-1991-62-30-76",
  "type": "statute",
  "title": "A Köztársaság Elnökének 62/1991. (III. 18.) KE határozata ,,posztumusz'' tábornoki kinevezésekről",
  "status": "amended",
  "in_force_date": "1991-03-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/1991-62-30-76",
  "description": ",,posztumusz'' tábornoki kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. §-ának (1) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az 1848-as forradalom és szabadságharc 143. évfordulója alkalmából"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Kádár Gyula ezredest,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Koszorús Ferenc ezredest"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,posztumusz'' vezérezredessé;"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Bangha Ernő ezredest,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Csuthy Gyula ezredest"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": ",,posztumusz'' vezérőrnaggyá kinevezem."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Göncz Árpád s. k.,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "a Köztársaság elnöke"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Dr. Antall József s. k.,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "miniszterelnök"
    }
  ]
}
