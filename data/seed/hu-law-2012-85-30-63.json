{
  "id": "hu-law-2012-85-30-63",
  "type": "statute",
  "title": "85/2012. (VII. 13.) ME határozat helyettes államtitkár felmentéséről és kinevezéséről",
  "status": "in_force",
  "in_force_date": "2012-07-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-85-30-63",
  "description": "helyettes államtitkár felmentéséről és kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 221. § (2) bekezdése c) pontja, illetve 220. § (2) bekezdése alapján, a belügyminiszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Papp Károlyt, a Belügyminisztérium helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2012. július 15-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem, és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Hoffmann Imrét a Belügyminisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– 2012. július 16-ai hatállyal –"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kinevezem."
    }
  ]
}
