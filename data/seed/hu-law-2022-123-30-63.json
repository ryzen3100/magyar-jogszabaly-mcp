{
  "id": "hu-law-2022-123-30-63",
  "type": "statute",
  "title": "123/2022. (XII. 29.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2022-12-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2022-123-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 234. § (1) bekezdésében foglalt jogkörömben eljárva, a gazdaságfejlesztési miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Andor Krisztinát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2023. január 1-jei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Gazdaságfejlesztési Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem. 1 A 110/2023. (XII. 22.) ME határozat alapján dr. Andor Krisztina tekintetében akként módosul, hogy a „Gazdaságfejlesztési Minisztérium” megnevezés helyett a „Nemzetgazdasági Minisztérium” megnevezést kell érteni."
    }
  ]
}
