  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Magyarországnak a NATO-hoz való csatlakozása, beilleszkedésének segítése, hazánk támogatása érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Alessandro Minuto-Rizzo-nak, a NATO helyettes főtitkárának a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KÖZÉPKERESZTJE A CSILLAGGAL"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "polgári tagozata;"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a magyar–brit tudományos és kulturális kétoldalú kapcsolatok fejlesztése érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Péter Lászlónak, az University College Szlavisztikai és Délkelet-európai Tanszék nyugalmazott egyetemi tanárának a"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "KÖZÉPKERESZTJE"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "polgári tagozata;"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "a magyar kultúra – különösen a magyar nyelv és irodalom – nagy-britanniai terjesztése, népszerűsítése érdekében végzett sokoldalú tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Peter Sherwood-nak, az University College School of Slavonic and East European Studies egyetemi tanárának a"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "TISZTIKERESZTJE"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "polgári tagozata"
    },
    {
      "provision_ref": "s17",
      "section": "17",
