{
  "id": "hu-law-2004-6-30-63",
  "type": "statute",
  "title": "6/2004. (I. 22.) ME határozat kormányzati főtisztviselő áthelyezéséről",
  "status": "in_force",
  "in_force_date": "2004-01-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-6-30-63",
  "description": "kormányzati főtisztviselő áthelyezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 31/C. § (4) bekezdésében foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Simon Sándor kormányzati főtisztviselőt a Nemzeti Kulturális Örökség Minisztériuma Államtitkári Hivatal állományába főosztályvezetői teendők ellátására"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2004. január 1-jei hatállyal – határozatlan időre – áthelyezem."
    }
  ]
}
