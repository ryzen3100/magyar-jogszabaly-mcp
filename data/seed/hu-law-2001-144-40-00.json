      "title": "24",
      "content": "X. Fejezet Miniszterelnökség"
    },
    {
      "provision_ref": "s25",
      "section": "25",
      "title": "25",
      "content": "23. cím Kormányzati rendkívüli kiadások"
    },
    {
      "provision_ref": "s26",
      "section": "26",
      "title": "26",
      "content": "Á: 239134 3. alcím MTV Rt. sajáttőke egyes elemeinek emelése –12 500,0"
    },
    {
      "provision_ref": "s27",
      "section": "27",
