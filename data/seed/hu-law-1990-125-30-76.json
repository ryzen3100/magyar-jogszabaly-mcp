    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Alkotmány 30/A. § (1) bekezdés d) pontja alapján a tanácsi választásokat"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1990. szeptember 30-ára (vasárnap)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "tűzöm ki."
    }
  ]
