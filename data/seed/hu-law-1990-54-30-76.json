{
  "id": "hu-law-1990-54-30-76",
  "type": "statute",
  "title": "54/1990. (V. 1.) KE határozat államtitkári felmentésekről",
  "status": "in_force",
  "in_force_date": "1990-05-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-54-30-76",
  "description": "államtitkári felmentésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az illetékes miniszternek a Minisztertanács elnöke útján tett előterjesztésre – saját kérésükre, érdemeik elismerésével, országgyűlési képviselővé történt megválasztásuk miatt –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Kovács László külügyminisztériumi államtitkárt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Pál László ipari minisztériumi államtitkárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e tisztségükből az Országgyűlés alakuló ülésének napjával felmentem."
    }
  ]
}
