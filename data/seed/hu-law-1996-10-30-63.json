{
  "id": "hu-law-1996-10-30-63",
  "type": "statute",
  "title": "10/1996. (III. 13.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1996-03-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-10-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Körtvélyes Gézát, a Magyar Táncművészeti Főiskola főiskolai tanárát 1996. október 31-i hatállyal,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Somogyi Lászlóné Éhn Évát, a Magyar Táncművészeti Főiskola főiskolai tanárát 1996. október 31-i hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– nyugállományba vonulására tekintettel –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
