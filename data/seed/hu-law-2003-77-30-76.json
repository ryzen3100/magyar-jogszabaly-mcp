  "description": "politikai államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 23. §-a alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Hiller Istvánt, az Oktatási Minisztérium politikai államtitkárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– más fontos megbízatása miatt –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2003. május 18-i hatállyal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "felmentem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "KEH ügyszám: V-1/1834/2003."
    }
  ]
