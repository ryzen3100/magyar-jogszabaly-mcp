{
  "id": "hu-law-2010-112-30-63",
  "type": "statute",
  "title": "112/2010. (XII. 20.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2010-12-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-112-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormánytisztviselők jogállásáról szóló 2010. évi LVIII. törvény 47. § (1) bekezdése alapján, a közigazgatási és igazságügyi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Fekete Gábort a Közigazgatási és Igazságügyi Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2010. december 15-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    }
  ]
}
