{
  "id": "hu-law-2005-144-30-76",
  "type": "statute",
  "title": "144/2005. (IX. 27.) KE határozat szolgálati nyugállományba helyezésről",
  "status": "in_force",
  "in_force_date": "2005-09-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-144-30-76",
  "description": "szolgálati nyugállományba helyezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A polgári nemzetbiztonsági szolgálatokat irányító miniszter előterjesztésére, a fegyveres szervek hivatásos állományú tagjainak szolgálati viszonyáról szóló 1996. évi XLIII. törvény 59. § (1) bekezdés a) pontja alapján,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kocsis Kálmán vezérőrnagyot,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "figyelembe véve, hogy szolgálati viszonyának meghosszabbítása lejárt és ezért szolgálati jogviszonya 2005. október 31-i hatállyal megszűnik,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "érdemei elismerése mellett"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2005. november 1-jei hatállyal szolgálati nyugállományba helyezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-5/4166/2005."
    }
  ]
}
