  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszternek – a fenntartóval egyetértésben tett – előterjesztésére, a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Pázmány Péter Katolikus Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Fodor György egyetemi tanárt,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2007. június hó 30-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-2/3873/2003."
    }
  ]
}
