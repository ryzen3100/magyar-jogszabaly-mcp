{
  "id": "hu-law-2025-9-30-63",
  "type": "statute",
  "title": "9/2025. (I. 31.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2025-01-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2025-9-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján – az igazságügyi miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Pilz Tamást, az Igazságügyi Minisztérium helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– közigazgatási államtitkárrá történő kinevezésére tekintettel –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2025. január 31-ei hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
