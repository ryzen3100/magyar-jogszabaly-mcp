{
  "id": "hu-law-2007-113-20-0n",
  "type": "statute",
  "title": "113/2007. (XII. 27.) KvVM rendelet a Sághegyi Tájvédelmi Körzet védettségének fenntartásáról",
  "status": "in_force",
  "in_force_date": "2008-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-113-20-0N",
  "description": "a Sághegyi Tájvédelmi Körzet védettségének fenntartásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § Az Országos Természetvédelmi Hivatal elnökének 1/1975. számú határozatával védetté nyilvánított Sághegyi Tájvédelmi Körzet védettségét fenntartom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § A Sághegyi Tájvédelmi Körzet kiterjedése 238,1 ha, ingatlan-nyilvántartási helyrajzi számait az 1. számú melléklet, fokozottan védett területének ingatlan-nyilvántartási helyrajzi számait a 2. számú melléklet tartalmazza."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A védettség indoka és célja a terület természeti és kulturális értékeinek, így különösen a földtani képződményeknek, a xerotherm növényzetnek, a védett állatfajoknak, a hagyományos szőlőművelési kultúrának, a bányászat és a geofizikai kutatások emlékeinek megőrzése."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § A terület természetvédelmi kezeléséért felelős szerv a Fertő-Hanság és Őrségi Nemzeti Park Igazgatóság."
    },
