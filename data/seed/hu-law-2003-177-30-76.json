  "title": "177/2003. (IX. 19.) KE határozat kitüntetéses doktorrá avatásról",
  "status": "in_force",
  "in_force_date": "2003-09-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-177-30-76",
  "description": "kitüntetéses doktorrá avatásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére hozzájárulok ahhoz, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Zseni Anikó okleveles földrajz-kémia szakos tanárt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Szegedi Tudományegyetemen,,Promotio sub auspiciis praesidentis Rei Publicae'' kitüntetéses doktorává avassák."
    },
    {
      "provision_ref": "s4",
