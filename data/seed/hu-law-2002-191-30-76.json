      "section": "2",
      "title": "2",
      "content": "a Budapesti Műszaki és Gazdaságtudományi Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Farkas János egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
