{
  "id": "hu-law-1993-136-30-76",
  "type": "statute",
  "title": "136/1993. (X. 30.) KE határozat városi cím adományozásáról",
  "status": "in_force",
  "in_force_date": "1993-12-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/1993-136-30-76",
  "description": "városi cím adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére a Szabolcs-Szatmár-Bereg megyében lévő Máriapócs, Nagyhalász községeknek városi címet adományozok."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Ez a határozat 1993. december 1. napján lép hatályba."
    }
  ]
}
