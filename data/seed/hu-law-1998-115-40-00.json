{
  "id": "hu-law-1998-115-40-00",
  "type": "statute",
  "title": "1998. MK 115. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1998-12-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/1998-115-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1998. évi 102. számában, a 6544. oldalon helyesbítésként közzétett Jegyzőkönyv"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 1. pontjának tizedik sora helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,a Kazah Köztársaság Közlekedési és Hírközlési Minisztériuma''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 5. pontjának első mondata helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,5. A Felek az engedélyek egymás részére történő rendelkezésre bocsátásáért nem szednek díjat.''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(Nyomdahiba)"
    }
  ]
}
