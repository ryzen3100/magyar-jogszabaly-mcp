{
  "id": "hu-law-1990-204-30-76",
  "type": "statute",
  "title": "204/1990. (IX. 20.) KE határozat vezérőrnagyi kinevezésekről",
  "status": "in_force",
  "in_force_date": "1990-09-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-204-30-76",
  "description": "vezérőrnagyi kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. §-ának (1) bekezdése alapján a miniszterelnök javaslatára, a Fegyveres Erők Napja alkalmából"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Keczer Imre ezredest,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Makai Sándor Tibor ezredest,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Szegedi Tibor ezredest"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "vezérőrnaggyá kinevezem."
    }
  ]
}
