{
  "id": "hu-law-2006-127-30-76",
  "type": "statute",
  "title": "127/2006. (VI. 19.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2006-06-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-127-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a belügyminiszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(katonai tagozata)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kitüntetést adományozom"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Csomós Mátyás polgári védelmi ezredesnek, a Jász-Nagykun-Szolnok Megyei Katasztrófavédelmi Igazgatóság igazgatójának,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Szőllősi Sándor tűzoltó ezredesnek, a Csongrád Megyei Katasztrófavédelmi Igazgatóság igazgatójának;"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a MAGYAR KÖZTÁRSASÁGI BRONZ ÉRDEMKERESZT"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "(polgári tagozata)"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kitüntetést adományozom"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Fialka Györgynek, Csépa község polgármesterének,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Hölgye Attilának, a Vizek Őre Vízimentő Egyesület elnökének,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Laskai Istvánnak, Tiszasas község polgármesterének,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Pánczél Ferencnek, Szelevény község polgármesterének,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Radványi Leventének, Szentendre város alpolgármesterének,"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "dr. Szilágyi Mihálynak, a Fővárosi Csatornázási Művek Rt. Árvízvédelmi Főosztály főosztályvezetőjének."
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "KEH ügyszám: VII-2/2314/2006."
    }
  ]
}
