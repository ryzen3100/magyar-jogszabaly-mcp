{
  "id": "hu-law-2021-44-30-63",
  "type": "statute",
  "title": "44/2021. (VIII. 2.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2021-08-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/2021-44-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az innovációért és technológiáért felelős miniszternek a fenntartó kezdeményezésére tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Paul Graczát a Pünkösdi Teológiai Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2021. augusztus 1-jétől 2025. július 31-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
