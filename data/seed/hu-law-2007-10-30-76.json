{
  "id": "hu-law-2007-10-30-76",
  "type": "statute",
  "title": "10/2007. (I. 10.) KE határozat egyetemi tanár rektori megbízásáról",
  "status": "in_force",
  "in_force_date": "2007-01-10",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-10-30-76",
  "description": "egyetemi tanár rektori megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási és kulturális miniszter előterjesztésére, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának a) pontjában foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Kaposvári Egyetemen,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Babinszky László egyetemi tanárt,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2007. január 1-jétől 2010. június 30-ig terjedő időtartamra"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-2/5883/2006."
    }
  ]
}
