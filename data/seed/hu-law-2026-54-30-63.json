  "title": "54/2026. (VI. 26.) ME határozat helyettes államtitkárok felmentéséről és helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2026-06-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2026-54-30-63",
  "description": "helyettes államtitkárok felmentéséről és helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján és 234. § (1) bekezdésében foglalt jogkörömben eljárva – az igazságügyi miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Jakubovich Nóra Tamarát és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Szegedi Krisztiánt,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "az Igazságügyi Minisztérium helyettes államtitkárait e tisztségükből"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2026. június 27-ei hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "felmentem, egyidejűleg"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Orbán Endrét"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "az Igazságügyi Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– 2026. június 28-ai hatállyal –"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "kinevezem."
    }
  ]
}
