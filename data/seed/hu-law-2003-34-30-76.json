{
  "id": "hu-law-2003-34-30-76",
  "type": "statute",
  "title": "34/2003. (III. 4.) KE határozat egyetemi tanári kinevezés alóli felmentésekről",
  "status": "in_force",
  "in_force_date": "2003-03-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-34-30-76",
  "description": "egyetemi tanári kinevezés alóli felmentésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Semmelweis Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Korányi Lajos egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– nyugállományba vonulására tekintettel –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2003. március 31. napjával és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Vimláti László egyetemi tanárt,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– közalkalmazotti jogviszony közös megegyezéssel történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "2003. február 28. napjával"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kinevezése alól felmentem."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "KEH ügyszám: V-2/0731/2003. 1 A határozat Korányi Lajos egyetemi tanárra vonatkozó rendelkezése az 56/2003. (III. 21.) KE határozat szerint módosított szöveg."
    }
  ]
}
