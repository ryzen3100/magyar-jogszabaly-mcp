{
  "id": "hu-law-2007-33-30-63",
  "type": "statute",
  "title": "33/2007. (V. 23.) ME határozat a Nemzetbiztonsági Hivatal főigazgatójának felmentéséről",
  "status": "in_force",
  "in_force_date": "2007-05-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-33-30-63",
  "description": "a Nemzetbiztonsági Hivatal főigazgatójának felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzetbiztonsági szolgálatokról szóló 1995. évi CXXV. törvény 12. § (1) bekezdése alapján, a Miniszterelnöki Hivatalt vezető miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Galambos Lajost,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Nemzetbiztonsági Hivatal főigazgatóját e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2007. május 31-ei hatállyal,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "érdemei elismerése mellett, felmentem."
    }
  ]
}
