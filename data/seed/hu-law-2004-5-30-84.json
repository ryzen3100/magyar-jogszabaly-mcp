{
  "id": "hu-law-2004-5-30-84",
  "type": "statute",
  "title": "5/2004. (VII. 22.) MeHVM határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2004-07-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-5-30-84",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 33. § (1) bekezdése alapján, a Miniszterelnöki Hivatal közigazgatási államtitkára javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Varga Pétert a Miniszterelnöki Hivatal helyettes államtitkárává"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2004. július 13-i hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    }
  ]
}
