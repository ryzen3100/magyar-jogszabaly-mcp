  "title": "74/1992. (IV. 7.) KE határozat egyetemi tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1992-04-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/1992-74-30-76",
  "description": "egyetemi tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A művelődési és közoktatási miniszter előterjesztésére — nyugállományba vonulására tekintettel —"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Eötvös Loránd Tudományegyetemről"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Rácz Endre egyetemi tanárt 1992. június 30.,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a József Attila Tudományegyetemről"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Maróti Egon egyetemi tanárt 1992. december 30.,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Keserű Bálint egyetemi tanárt és"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Benedeczky István egyetemi tanárt 1992. december 31."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "napjának hatályával e tisztsége alól felmentem."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Göncz Árpád s. k. a Köztársaság elnöke"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Dr. Andrásfalvy Bertalan s. k. művelődési és közoktatási miniszter"
    }
  ]
}
