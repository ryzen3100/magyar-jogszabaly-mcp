{
  "id": "hu-law-2018-484607-c0-6h",
  "type": "statute",
  "title": "A Nemzeti Választási Bizottság közleménye országos népszavazási kérdések hitelesítésének megtagadásáról",
  "status": "amended",
  "in_force_date": "2018-08-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/2018-484607-C0-6H",
  "description": "Országos népszavazási kérdések hitelesítésének megtagadásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Nemzeti Választási Bizottság a népszavazás kezdeményezéséről, az európai polgári kezdeményezésről, valamint a népszavazási eljárásról szóló 2013. évi CCXXXVIII. törvény 13. § (2) bekezdése alapján az alábbi közleményt teszi közzé:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "A Nemzeti Választási Bizottság 2018. augusztus 14-én tartott ülésén az 1002/2018., 1003/2018., 1004/2018., 1005/2018., 1006/2018., 1007/2018., 1008/2018., 1009/2018., 1010/2018., 1011/2018., 1012/2018., 1013/2018., 1014/2018., 1015/2018., 1016/2018., 1017/2018., 1018/2018., 1019/2018., 1020/2018., 1021/2018., 1022/2018. és 1023/2018. számú határozataival országos népszavazásra feltenni kívánt kérdések hitelesítését megtagadta."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "A határozatok megtekinthetők a választások hivatalos honlapján, a ww w.vala sztas.h u oldalon."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Budapest, 2018. augusztus 14."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Dr. Rádi Péter s. k.,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Nemzeti Választási Bizottság elnöke"
    }
  ]
}
