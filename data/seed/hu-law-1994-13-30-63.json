    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— 1994. május 15-i hatállyal —"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Dr. Boross Péter s. k., miniszterelnök"
    }
  ]
