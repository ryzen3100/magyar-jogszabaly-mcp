  "title": "49/1998. (XI. 27.) ME határozat főiskolai főigazgatói megbízás megerősítéséről",
  "status": "amended",
  "in_force_date": "1998-11-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/1998-49-30-63",
  "description": "főiskolai főigazgatói megbízás megerősítéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 73. §-ának b) pontja alapján, az oktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
