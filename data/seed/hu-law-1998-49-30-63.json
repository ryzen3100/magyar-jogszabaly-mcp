    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2001. június 30-ig terjedő időtartamra"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megerősítem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
