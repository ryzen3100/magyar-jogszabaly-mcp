{
  "id": "hu-law-2000-119-40-00",
  "type": "statute",
  "title": "2000. MK 119. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2000-12-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-119-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2000. évi 112. számában kihirdetett, az utak építésének, forgalomba helyezésének és megszüntetésének engedélyezéséről szóló 15/2000. (XI. 16.) KöViM rendelet"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– 13. §-ának c) pontja helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",, … jogosultsággal; a szakági tervek…''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 22. §-ának e) pontja helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,… veszti; ebben…''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– 27. §-a (3) bekezdésének b) pontja helyesen:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": ",,… folytatja le; ebben…''"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 1. számú melléklet VIII. részének 1. pontjában megjelölt II. fokú szakhatóság megnevezés helyesen: Közlekedési és Vízügyi Minisztérium."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Nyomdahiba)"
    }
  ]
}
