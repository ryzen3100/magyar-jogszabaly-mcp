    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,…a helyi önkormányzatokról szóló 1990. évi LXV. törvény módosításáról szóló 1994. évi LXIII. törvény…''"
    },
    {
      "provision_ref": "s3",
