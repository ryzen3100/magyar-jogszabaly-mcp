  "title": "5/1997. (II. 13.) ME határozat főiskolai tanár felmentéséről",
  "status": "in_force",
  "in_force_date": "1997-02-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-5-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Krasznayné dr. Mankó Máriát, a Bessenyei György Tanárképző Főiskola főiskolai tanárát 1997. január 31-i hatállyal"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– saját kérésére – e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
