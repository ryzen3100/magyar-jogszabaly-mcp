  "title": "1996. MK 22. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1996-02-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-22-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1996. évi 16. számában kihirdetett, a hajózási képesítésekről szóló 2/1995. (II. 24.) KHVM rendelet módosításáról rendelkező 10/1996. (III. 1.) KHVM rendelet melléklete 1. pontjának d), e) és f) pontjai helyesen a következők:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "(1. A belvízi hajón fedélzeti munkakör betöltésére jogosító vizsgák díjai, forintban)"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,d) kishajóvezető 5000"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e) úszó munkagépvezető 3000"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "f) géphajókormányos 2500''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "(Kézirathiba)"
    }
  ]
}
