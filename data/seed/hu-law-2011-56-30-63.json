  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormánytisztviselők jogállásáról szóló 2010. évi LVIII. törvény 51. §-a alapján, a vidékfejlesztési miniszter javaslatára"
