{
  "id": "hu-law-1994-15-30-63",
  "type": "statute",
  "title": "15/1994. (V. 31.) ME határozat főiskolai főigazgató megbízásáról",
  "status": "amended",
  "in_force_date": "1994-05-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-15-30-63",
  "description": "főiskolai főigazgató megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 56. §-ának (2) és (5) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Molnár István főiskolai tanárt, a Kereskedelmi és Gazdasági Főiskolán, a főigazgatói teendők ellátásával"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— 1994. június 1-jei hatállyal, háromévi időtartamra —"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megbízom."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Dr. Boross Péter s. k., miniszterelnök"
    }
  ]
}
