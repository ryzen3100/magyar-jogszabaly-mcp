    {
      "provision_ref": "s72",
      "section": "72",
      "title": "72",
      "content": "A Magyar Közlöny 1995. évi 111. számában kihirdetett a GATT kedvezményes vámkontingensekről szóló 68/1995. (XII. 20.) IKM—PM együttes rendeletben"
    },
