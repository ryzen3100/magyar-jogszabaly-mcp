    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A népjóléti miniszter előterjesztésére dr. Réthelyi Miklós egyetemi tanárt a Semmelweis Orvostudományi Egyetemen, dr. Kelényi Gábor egyetemi tanárt a Pécsi Orvostudományi Egyetemen 1991. május 15. napjától — két évre — megbízom a rektori teendők ellátásával."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Göncz Árpád s. k.,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Köztársaság elnöke"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Dr. Surján László s. k.,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "népjóléti miniszter"
    }
  ]
}
