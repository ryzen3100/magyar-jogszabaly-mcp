{
  "id": "hu-law-2006-161-40-00",
  "type": "statute",
  "title": "2006. MK 161. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2006-12-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-161-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2006. évi 150. számában kihirdetett, az érettségi vizsga vizsgaszabályzatának kiadásáról szóló 100/1997. (VI. 13.) Korm. rendelet és a felsőoktatási intézmények felvételi eljárásairól szóló 237/2006. (XI. 27.) Korm. rendelet módosításáról szóló 253/2006. (XII. 7.) Korm. rendelet 26. §-ának (2) bekezdése helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "„(2) E rendelet"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a) 12. §-ával megállapított R. 31. § (5) bekezdése 2007. január 1-jén,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "b) 16. § (1) bekezdésével megállapított R. 41. § (1) bekezdése 2009. szeptember 1-jén,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "c) 24. §-ával megállapított FR. 15. § (7) bekezdése 2007. január 1-jén,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "d) melléklete 2008. január 1-jén"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "lép hatályba.”"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "(Kézirathiba)"
    }
  ]
}
