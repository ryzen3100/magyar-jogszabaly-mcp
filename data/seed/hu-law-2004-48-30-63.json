{
  "id": "hu-law-2004-48-30-63",
  "type": "statute",
  "title": "48/2004. (VIII. 5.) ME határozat a Nemzetbiztonsági Hivatal főigazgatójának felmentéséről",
  "status": "in_force",
  "in_force_date": "2004-08-05",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-48-30-63",
  "description": "a Nemzetbiztonsági Hivatal főigazgatójának felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzetbiztonsági szolgálatokról szóló 1995. évi CXXV. törvény 12. § (1) bekezdése alapján, a Miniszterelnöki Hivatalt vezető miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Zsohár Istvánt, a Nemzetbiztonsági Hivatal főigazgatóját e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– más fontos megbízatása miatt –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2004. július 26-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
