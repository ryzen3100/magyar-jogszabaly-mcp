  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 57. §-ában foglalt jogkörömben, a pénzügyminiszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Végh Szabolcsot és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Detrekői Lászlót"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Pénzügyminisztérium szakállamtitkárává"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2009. május 11-ei hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "kinevezem."
    }
  ]
}
