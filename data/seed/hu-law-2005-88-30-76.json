{
  "id": "hu-law-2005-88-30-76",
  "type": "statute",
  "title": "88/2005. (VI. 29.) KE határozat Monorierdő községgé nyilvánításáról",
  "status": "in_force",
  "in_force_date": "2006-10-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-88-30-76",
  "description": "Monorierdő községgé nyilvánításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Monor város Monorierdő elnevezésű településrészét Monorierdő néven községgé nyilvánítom. Monorierdő községgé nyilvánítása nem érinti Monor város városi címét."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Ez a határozat a kihirdetését követő önkormányzati általános választás napján lép hatályba."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "KEH ügyszám: VI-1/2450/2005."
    }
  ]
}
