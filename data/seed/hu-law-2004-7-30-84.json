{
  "id": "hu-law-2004-7-30-84",
  "type": "statute",
  "title": "7/2004. (VII. 26.) MeHVM határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2004-07-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-7-30-84",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 33. § (1) bekezdése alapján, a Miniszterelnöki Hivatal közigazgatási államtitkára javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Szigetvári Viktort"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Miniszterelnöki Hivatal helyettes államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2004. június 1-jei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    }
  ]
}
