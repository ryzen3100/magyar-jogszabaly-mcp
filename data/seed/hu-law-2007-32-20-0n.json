{
  "id": "hu-law-2007-32-20-0n",
  "type": "statute",
  "title": "32/2007. (X. 18.) KvVM rendelet az Aggteleki Nemzeti Park védettségének fenntartásáról",
  "status": "in_force",
  "in_force_date": "2008-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-32-20-0N",
  "description": "az Aggteleki Nemzeti Park védettségének fenntartásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § Az Országos Környezet- és Természetvédelmi Hivatal elnökének 7/1984. (XII. 29.) OKTH számú rendelkezésével létesített Aggteleki Nemzeti Park védettségét fenntartom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § Az Aggteleki Nemzeti Park kiterjedése 20188,2 ha, ingatlan-nyilvántartási helyrajzi számait az 1. számú melléklet, fokozottan védett területének ingatlan-nyilvántartási helyrajzi számait a 2. számú melléklet tartalmazza."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A védettség indoka és célja, hogy védje és őrizze meg a táj jellegzetes arculatát és természeti értékeit, különösen a jellegzetes karsztos formakincset (töbröket, víznyelőket, sziklaalakzatokat, szurdokvölgyeket, barlangrendszereket), a forrásokat, tavakat és természetes felszíni vízfolyásokat, a jellegzetes karsztvegetációt (a karsztbokorerdőket, a magashegységi fajoknak is otthont adó erdőket), a hegyi kaszálókat és a mocsárréteket, valamint ezen élőhelyek természetes növény- és állatvilágát."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § A terület természetvédelmi kezeléséért felelős szerv az Aggteleki Nemzeti Park Igazgatóság."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5. §",
      "content": "5. § (1) Ez a rendelet 2008. január 1-jén lép hatályba. (2)"
    },
