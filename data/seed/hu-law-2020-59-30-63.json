{
  "id": "hu-law-2020-59-30-63",
  "type": "statute",
  "title": "59/2020. (VII. 31.) ME határozat főiskolai rektor felmentéséről",
  "status": "in_force",
  "in_force_date": "2020-07-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2020-59-30-63",
  "description": "főiskolai rektor felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az innovációért és technológiáért felelős miniszternek a fenntartó javaslata alapján tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Apor Vilmos Katolikus Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Libor Józsefné dr. főiskolai tanárt a rektori megbízatása alól"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2020. július 31-ei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
