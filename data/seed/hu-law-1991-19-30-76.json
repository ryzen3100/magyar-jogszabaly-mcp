{
  "id": "hu-law-1991-19-30-76",
  "type": "statute",
  "title": "A Köztársaság Elnökének 19/1991. (I. 21.) KE határozata dr. Pataki István nagyköveti kinevezéséről",
  "status": "amended",
  "in_force_date": "1991-01-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/1991-19-30-76",
  "description": "dr. Pataki István nagyköveti kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A külügyminiszter előterjesztésére dr. Pataki Istvánt kinevezem rendkívüli és meghatalmazott nagykövetté és megbízom a Magyar Köztársaság dublini nagykövetségének vezetésével."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Részére a megbízólevelet aláírással és pecséttel ellátva kiadom."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Göncz Árpád s. k.,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Köztársaság elnöke"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Dr. Jeszenszky Géza s. k.,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "külügyminiszter"
    }
  ]
}
