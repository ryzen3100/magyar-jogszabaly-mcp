      "title": "12",
      "content": "A Tanács 91/496/EGK irányelve"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "a Közösségbe harmadik országokból beszállított állatok állategészségügyi ellenőrzésének megszervezését irányító elvekről, valamint a 89/662, a 90/425 és a 90/675 irányelvek módosításáról"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "FM | II. szakasz"
    },
    {
      "provision_ref": "s15",
