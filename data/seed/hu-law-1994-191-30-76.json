      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A külügyminiszter előterjesztésére dr. Sieber Edit főkonzult — érdemei elismerése mellett — felmentem e rangja, valamint a Magyar Köztársaság bécsi nagykövetsége konzuli osztálya vezetésére kapott megbízása alól."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Kovács László s. k., külügyminiszter"
    }
  ]
}
