{
  "id": "hu-law-2005-61-30-76",
  "type": "statute",
  "title": "61/2005. (IV. 29.) KE határozat közigazgatási államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2005-04-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-61-30-76",
  "description": "közigazgatási államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 26. §-a alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Dudás Ferencet"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Belügyminisztérium közigazgatási államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2005. április 27-i hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-1/1646/2005. 1 A 129/2006. (VI. 21.) KE határozat alapján a Belügyminisztérium elnevezés alatt Önkormányzati és Területfejlesztési Minisztériumot kell érteni."
    }
  ]
}
