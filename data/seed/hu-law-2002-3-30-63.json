{
  "id": "hu-law-2002-3-30-63",
  "type": "statute",
  "title": "3/2002. (I. 29.) ME határozat főiskolai tanár felmentéséről",
  "status": "in_force",
  "in_force_date": "2002-01-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2002-3-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló – többször módosított – 1993. évi LXXX. törvény 73. §-ának a) pontja alapján, az oktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Lajos Pétert, a Kecskeméti Főiskola főiskolai tanárát e tisztségéből – közalkalmazotti jogviszony közös megegyezéssel történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2001. december 31-i hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
