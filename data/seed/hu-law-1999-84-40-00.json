{
  "id": "hu-law-1999-84-40-00",
  "type": "statute",
  "title": "1999. MK 84. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1999-09-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/1999-84-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1999. évi 77/I. számában közzétett, az FVM Zala Megyei Földművelésügyi Hivatalának hirdetményében, az 5084. oldalon a sorsolás helyeként feltüntetett községnév téves. Helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,A sorsolás helye: Cserszegtomaj, Kultúrház''"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "A hirdetmény többi része változatlan."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(Kézirathiba)"
    }
  ]
}
