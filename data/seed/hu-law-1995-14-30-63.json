{
  "id": "hu-law-1995-14-30-63",
  "type": "statute",
  "title": "14/1995. (VI. 17.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1995-06-17",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-14-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Tamás Károlyt, a Pannon Agrártudományi Egyetem főiskolai tanárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1995. december 27-i hatállyal;"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Nagy Józsefet, a Jászberényi Tanítóképző Főiskola főiskolai tanárát,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Párkai Istvánné dr. Szabó Helgát, az Eötvös Loránd Tudományegyetem Tanárképző Főiskolai Kar főiskolai tanárát,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Wolf Gyulát, a Pannon Agrártudományi Egyetem főiskolai tanárát"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "1995. december 30-i hatállyal;"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Földi Pált, a Bárczi Gusztáv Gyógypedagógiai Tanárképző Főiskola főiskolai tanárát"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "1996. május 31-i hatállyal"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "— nyugállományba vonulására tekintettel —"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "e tisztségéből"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "felmentem."
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
