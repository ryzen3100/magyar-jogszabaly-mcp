  "title": "22/2003. (II. 28.) KE határozat altábornagyi előléptetésről",
  "status": "in_force",
  "in_force_date": "2003-02-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-22-30-76",
  "description": "altábornagyi előléptetésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A honvédelmi miniszter előterjesztésére a Magyar Köztársaság alkotmányáról szóló 1949. évi XX. törvény 30/A. §-a (1) bekezdésének i) pontja és a Magyar Honvédség hivatásos és szerződéses állományú katonáinak jogállásáról szóló 2001. évi XCV. törvény 4. §-ának (3) bekezdése alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "2003. március 1-jei hatállyal"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "előléptetem altábornaggyá"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Szenes Zoltán vezérőrnagyot,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Honvédelmi Minisztérium, Honvéd Vezérkar, törzsigazgatóját."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-5/0729/2003."
    }
  ]
}
