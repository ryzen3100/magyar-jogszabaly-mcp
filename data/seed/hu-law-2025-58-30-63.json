{
  "id": "hu-law-2025-58-30-63",
  "type": "statute",
  "title": "58/2025. (VII. 24.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2025-07-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/2025-58-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– a kultúráért és innovációért felelős miniszternek a fenntartó kezdeményezésére tett javaslatára –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kovács Gusztávot a Pécsi Püspöki Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2025. július 1-jétől 2026. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
