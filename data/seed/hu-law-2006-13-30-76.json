{
  "id": "hu-law-2006-13-30-76",
  "type": "statute",
  "title": "13/2006. (II. 2.) KE határozat egyetemi tanárok felmentéséről",
  "status": "in_force",
  "in_force_date": "2006-02-02",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-13-30-76",
  "description": "egyetemi tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére, az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, tekintettel a felsőoktatásról szóló 1993. évi LXXX. törvény 17. § (6)–(7) bekezdéseire,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Semmelweis Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Birkás János egyetemi tanárt 2006. május hó 13. napjával,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Istvánfi Csaba egyetemi tanárt 2006. május hó 3. napjával,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Kerényi Tibor egyetemi tanárt 2006. szeptember hó 11. napjával,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Szende Béla egyetemi tanárt 2006. július hó 29. napjával és"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Stenger Vilmosné dr. Staub Mária egyetemi tanárt 2006. január hó 9. napjával"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "felmentem."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "KEH ügyszám: V-2/6181/2005."
    }
  ]
