  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a magyarországi kerámiaipar és Hódmezővásárhely fejlődésének elősegítése, valamint a munkahely-teremtés érdekében végzett több éves tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Wendelin Franz Egon Luitwinus Maria von Boch-Galhau-nak, a Villeroy and Boch AG elnökének a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "középkereszt a csillaggal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "polgári tagozata"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Budapest, 2010. október 15."
    },
    {
