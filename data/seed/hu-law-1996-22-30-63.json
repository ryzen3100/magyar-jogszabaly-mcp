{
  "id": "hu-law-1996-22-30-63",
  "type": "statute",
  "title": "22/1996. (VI. 28.) ME határozat főiskolai tanárok kinevezéséről",
  "status": "amended",
  "in_force_date": "1996-06-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-22-30-63",
  "description": "főiskolai tanárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1)–(2) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Blaskó Béla rendőr alezredest,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Dettné dr. Légrády Ilona pénzügyőr ezredest,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Erdős Istvánt,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Kozáry Andreát és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Lőrincz József büntetés-végrehajtási ezredest"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a Rendőrtiszti Főiskolára főiskolai tanárrá"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– 1996. július 1-jei hatállyal –"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
