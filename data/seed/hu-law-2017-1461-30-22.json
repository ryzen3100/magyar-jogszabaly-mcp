{
  "id": "hu-law-2017-1461-30-22",
  "type": "statute",
  "title": "1461/2017. (VII. 25.) Korm. határozat „Életmentő Emlékérem” adományozásáról",
  "status": "in_force",
  "in_force_date": "2017-07-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/2017-1461-30-22",
  "description": "„Életmentő Emlékérem” adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány az „Életmentő Emlékérem” adományozásáról szóló 243/2009. (X. 29.) Korm. rendelet alapján, életmentés közben tanúsított hősies magatartása elismeréseként – a belügyminiszter mint helyi önkormányzatokért felelős miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Földi Zoltán rácalmási lakosnak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Kómár László öcsödi lakosnak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Kövesi Balázs paloznaki lakosnak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Látos Jenő csopaki lakosnak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Németh Balázs csopaki lakosnak,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Slemmer Ábel Sebestyén paloznaki lakosnak,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Somogyi Károly jászberényi lakosnak,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Székely Balázs balatonalmádi lakosnak,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Tógyer Gergő jászberényi lakosnak"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "„Életmentő Emlékérmet” adományoz."
    }
  ]
}
