{
  "id": "hu-law-2012-146-30-63",
  "type": "statute",
  "title": "146/2012. (XII. 13.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2012-12-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-146-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben – az emberi erőforrások miniszterének a szenátus határozata alapján előterjesztett –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Károly Róbert Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Helgertné dr. Szabó Ilona Eszter egyetemi docenst – a 2013. január 1-jétől 2016. december 31-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
