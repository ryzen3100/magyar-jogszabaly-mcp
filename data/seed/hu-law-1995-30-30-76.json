      "content": "az Eötvös Loránd Tudományegyetemről:"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Gergely János egyetemi tanárt és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Sárfalvi Béla egyetemi tanárt,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "illetve — hetvenedik életévük betöltésére tekintettel —"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Kubovics Imre egyetemi tanárt,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Pál Lénárd egyetemi tanárt és"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Maróthy János egyetemi tanárt"
    },
    {
      "provision_ref": "s10",
      "section": "10",
