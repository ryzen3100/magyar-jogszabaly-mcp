{
  "id": "hu-law-2005-54-30-76",
  "type": "statute",
  "title": "54/2005. (IV. 25.) KE határozat rendőr dandártábornok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2005-04-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-54-30-76",
  "description": "rendőr dandártábornok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére dr. Dobozi József r. ezredest a Rendészeti Biztonsági Szolgálat parancsnokát, az 1949. évi XX. törvény 30/A. § (1) bekezdés i) pontja alapján, a rendőri munka végzésében, irányításában és felügyeletében kifejtett kimagasló tevékenysége elismeréseként,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Rendőrség Napja alkalmából,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2005. április 24-i hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "rendőr dandártábornokká"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-5/1571/2005."
    }
  ]
}
