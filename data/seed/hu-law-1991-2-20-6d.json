  "id": "hu-law-1991-2-20-6d",
  "type": "statute",
  "title": "2/1991. (II. 9.) KTM rendelet a Fertő-tó Tájvédelmi Körzet nemzeti parkká nyilvánításáról",
  "status": "in_force",
  "in_force_date": "1991-02-09",
  "url": "https://njt.jog.gov.hu/jogszabaly/1991-2-20-6D",
  "description": "a Fertő-tó Tájvédelmi Körzet nemzeti parkká nyilvánításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § Fertő-Hanság Nemzeti Park néven nemzeti parkká nyilvánítom a Fertő-tó Tájvédelmi Körzetet."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § (1) A Fertő-Hanság Nemzeti Park területének ingatlannyilvántartási helyrajzi számait a rendelet 1. számú melléklete tartalmazza. (2) Az 1. számú mellékletből fokozottan védettek a 2. számú mellékletben felsorolt területek."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A Fertő-Hanság Nemzeti Park természetvédelmi kezelési feladatainak ellátására létrehozom a Fertő-Hanság Nemzeti Park Igazgatóságot."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § Ez a rendelet kihirdetése napján lép hatályba."
    },
