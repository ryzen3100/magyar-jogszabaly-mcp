{
  "id": "hu-law-2001-31-30-63",
  "type": "statute",
  "title": "31/2001. (XI. 15.) ME határozat főiskolai tanárok felmentéséről",
  "status": "in_force",
  "in_force_date": "2001-11-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2001-31-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 73. §-ának a) pontja alapján, az oktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Nyíregyházi Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Balogh Tibor főiskolai tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– közalkalmazotti jogviszonya közös megegyezéssel történő megszüntetésére tekintettel – 2001. november 15-i hatállyal,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Szent István Egyetemen"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Ágostházy László főiskolai tanárt"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– nyugállományba vonulására tekintettel – 2002. január 3-i hatállyal,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "az Eötvös Loránd Tudományegyetemen"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Gyóni Lajosné dr. főiskolai tanárt"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "– nyugállományba vonulására tekintettel – 2002. január 31-i hatállyal"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "e tisztségükből felmentem."
    }
  ]
}
