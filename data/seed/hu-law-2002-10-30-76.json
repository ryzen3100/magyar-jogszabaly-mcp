{
  "id": "hu-law-2002-10-30-76",
  "type": "statute",
  "title": "10/2002. (III. 4.) KE határozat egyetemi tanári tisztség alóli felmentésről",
  "status": "in_force",
  "in_force_date": "2002-03-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/2002-10-30-76",
  "description": "egyetemi tanári tisztség alóli felmentésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Eötvös Loránd Tudományegyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Szilárd Mihályné egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– közalkalmazotti jogviszony közös megegyezéssel, felmentéssel történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2002. február 28. napjával"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "e tisztsége alól"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "felmentem."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "KEH ügyszám: V–2/0691/2002."
    }
  ]
}
