{
  "id": "hu-law-2019-86-30-63",
  "type": "statute",
  "title": "86/2019. (VIII. 1.) ME határozat állami felsőoktatási intézmény kancellárjának megbízásáról",
  "status": "in_force",
  "in_force_date": "2019-08-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2019-86-30-63",
  "description": "állami felsőoktatási intézmény kancellárjának megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (4a) bekezdésében foglalt jogkörömben eljárva – az emberi erőforrások minisztere előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Szegedi Tudományegyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Fendler Juditot"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2019. augusztus 1-jétől 2022. július 31-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a kancellári teendők ellátásával megbízom."
    }
  ]
}
