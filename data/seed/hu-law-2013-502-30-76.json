{
  "id": "hu-law-2013-502-30-76",
  "type": "statute",
  "title": "502/2013. (XII. 12.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2013-12-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/2013-502-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés f) pontja, illetve a Magyarország címerének és zászlajának használatáról, valamint állami kitüntetéseiről szóló 2011. évi CCII. törvény 18. § (1) bekezdése alapján – a miniszterelnök előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "vállalkozásfejlesztői és szakmai-közéleti tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Lits József, az AUDITOR SZOLNOK Könyvvizsgáló, Adótanácsadó és Vagyonértékelő Kft. tulajdonos-ügyvezetője részére,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Pordán Zsigmond, a P-Metál Kft. tulajdonos-ügyvezetője részére,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Sztanó Tamás, a Leroy Co. Kereskedelmi, Szolgáltató és Vendéglátó Kft. tulajdonos-ügyvezetője részére a"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "MAGYAR ÉRDEMREND LOVAGKERESZTJE polgári tagozata;"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "vállalkozásfejlesztői és szakmai-közéleti tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Ádám Imre György, a Közép-európai Kölcsönös Biztosító Egyesület elnöke részére,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Szabó László, a TEVA Magyarország Zrt. vezérigazgatója részére,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "több évtizedes szervezői, titkárságvezetői tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Szabóné Tóth Teréz, a Vállalkozók és Munkáltatók Országos Szövetségének titkárságvezetője részére a"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "MAGYAR ARANY ÉRDEMKERESZT polgári tagozata"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "KEH ügyszám: VIII-1/06277/2013."
    }
  ]
}
