  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "1. A Debrecen megyei jogú város külterületén található földrészletek beruházási célterületté nyilvánításáról szóló 1147/2018. (III. 26.) Korm. határozatban (a továbbiakban: Korm. határozat) az „1. melléklet szerinti” szövegrész helyébe az „1. és 2. melléklet szerinti” szöveg lép."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "2. A Korm. határozat az 1. melléklet szerinti 2. melléklettel egészül ki."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "„2. melléklet az 1147/2018. (III. 26.) Korm. határozathoz"
    },
