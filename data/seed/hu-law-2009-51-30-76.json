{
  "id": "hu-law-2009-51-30-76",
  "type": "statute",
  "title": "51/2009. (IV. 16.) KE határozat miniszterek kinevezéséről",
  "status": "in_force",
  "in_force_date": "2009-04-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/2009-51-30-76",
  "description": "miniszterek kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 33. § (4) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Balázs Pétert külügyminiszterré,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Draskovics Tibort igazságügyi és rendészeti miniszterré,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Ficsor Ádámot a polgári nemzetbiztonsági szolgálatokat irányító tárca nélküli miniszterré,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Gráf Józsefet földművelésügyi és vidékfejlesztési miniszterré,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Herczog Lászlót szociális és munkaügyi miniszterré,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Hiller Istvánt oktatási és kulturális miniszterré,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Hónig Pétert közlekedési, hírközlési és energiaügyi miniszterré,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Kiss Pétert a társadalompolitika összehangolásáért felelős tárca nélküli miniszterré,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Molnár Csabát a Miniszterelnöki Hivatalt vezető miniszterré,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Oszkó Pétert pénzügyminiszterré,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Szabó Imrét környezetvédelmi és vízügyi miniszterré,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Székely Tamást egészségügyi miniszterré,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Szekeres Imrét honvédelmi miniszterré, valamint"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "Varga Zoltánt önkormányzati miniszterré"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "KEH ügyszám: IV-2/01701/2009."
    }
  ]
}
