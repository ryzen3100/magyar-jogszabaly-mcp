{
  "id": "hu-law-2008-9-30-63",
  "type": "statute",
  "title": "9/2008. (II. 22.) ME határozat főiskolai tanár kinevezéséről és főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2008-02-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-9-30-63",
  "description": "főiskolai tanár kinevezéséről és főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) és b) pontjában foglalt jogkörömben, az oktatási és kulturális miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Soltész Jánost,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2008. február 15-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "főiskolai tanárrá kinevezem, és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Szent Atanáz Görög Katolikus Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– a 2008. február 15-étől 2012. január 3-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
