{
  "id": "hu-law-2011-1193-30-22",
  "type": "statute",
  "title": "1193/2011. (VI. 15.) Korm. határozat az Államreform Operatív Program 2011–2013. időszakra szóló akciótervének elfogadásáról és a 2009–2010. évi akcióterv módosításáról",
  "status": "repealed",
  "in_force_date": "2011-06-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-1193-30-22",
  "description": "az Államreform Operatív Program 2011–2013. időszakra szóló akciótervének elfogadásáról és a 2009–2010. évi akcióterv módosításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány úgy dönt, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. az Államreform Operatív Program 2009–2010. évi akciótervéből törli az 1. melléklet szerinti konstrukciókat;"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2. jóváhagyja az Államreform Operatív Program 2011–2013. időszakra szóló akciótervét a 2. melléklet szerint;"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "3. a 2. melléklet szerinti akcióterv végrehajtása során az egyes prioritási tengelyekben kizárólag a rendelkezésre álló szabad forrás mértékéig hirdethetők meg új konstrukciók."
    },
    {
      "provision_ref": "s5",
      "section": "5",
