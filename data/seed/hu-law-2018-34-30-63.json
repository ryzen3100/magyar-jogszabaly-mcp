  "title": "34/2018. (V. 31.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2018-05-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2018-34-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 221. § (2) bekezdés c) pontja alapján – az emberi erőforrások minisztere javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Závogyán Magdolnát, az Emberi Erőforrások Minisztériuma helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2018. május 31-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
