{
  "id": "hu-law-1995-26-30-63",
  "type": "statute",
  "title": "26/1995. (VIII. 11.) ME határozat főiskolai főigazgatói megbízásról",
  "status": "amended",
  "in_force_date": "1995-08-11",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-26-30-63",
  "description": "főiskolai főigazgatói megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 56. §-ának (2) és (5) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Baka András főiskolai tanárt az Államigazgatási Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a főigazgatói teendők ellátásával"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "1995. július 17-ei hatállyal — 1998. június 30-ig terjedő időszakra ismételten —"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "A miniszterelnök helyett:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Dr. Bokros Lajos s. k., pénzügyminiszter"
    }
  ]
}
