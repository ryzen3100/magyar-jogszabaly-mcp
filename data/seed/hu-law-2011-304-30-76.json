  "description": "kitüntetések adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a magyar–török politikai, gazdasági és kulturális kapcsolatok fejlesztése és erősítése érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Abdullah Gül, a Török Köztársaság elnöke részére a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "nagykereszt a lánccal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "polgári tagozata,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a magyar–török gazdasági és kulturális kapcsolatok erősítése érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Ismet Güral, a Güral Porselen Rt. elnöke részére,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "a törökországi Thököly-emigráció emlékhelyeinek megőrzése és a magyar-török gazdasági és kulturális kapcsolatok erősítése érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Ibrahim Karaosmanoğlu, Kocaeli város polgármestere részére a"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s12",
      "section": "12",
