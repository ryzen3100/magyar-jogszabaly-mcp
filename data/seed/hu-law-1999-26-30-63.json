    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1999. augusztus 1-jétől 2001. július 31-ig terjedő időtartamra"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megerősítem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
