{
  "id": "hu-law-2017-75-30-63",
  "type": "statute",
  "title": "75/2017. (VI. 30.) ME határozat főiskolai rektor felmentéséről",
  "status": "in_force",
  "in_force_date": "2017-06-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2017-75-30-63",
  "description": "főiskolai rektor felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az emberi erőforrások miniszterének a fenntartó javaslatára tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Edutus Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Jandala Csilla főiskolai tanárt a rektori megbízatása alól"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– lemondására tekintettel –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2017. június 30-ai hatállyal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "felmentem."
    }
  ]
}
