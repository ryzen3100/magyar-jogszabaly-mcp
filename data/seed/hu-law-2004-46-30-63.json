  "title": "46/2004. (VII. 22.) ME határozat az Információs Hivatal főigazgatójának felmentéséről",
  "status": "in_force",
  "in_force_date": "2004-07-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-46-30-63",
  "description": "az Információs Hivatal főigazgatójának felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzetbiztonsági szolgálatokról szóló 1995. évi CXXV. törvény 12. § (1) bekezdése alapján, a Miniszterelnöki Hivatalt vezető miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Czukor Józsefet, az Információs Hivatal főigazgatóját e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– más fontos megbízatása miatt –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2004. július 16-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
