  "title": "70/2019. (VII. 17.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2019-07-17",
  "url": "https://njt.jog.gov.hu/jogszabaly/2019-70-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján – az emberi erőforrások miniszterének javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Fábián Károlyt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "az Emberi Erőforrások Minisztériuma helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2019. július 17-ei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
