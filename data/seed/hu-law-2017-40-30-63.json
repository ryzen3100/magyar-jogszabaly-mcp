{
  "id": "hu-law-2017-40-30-63",
  "type": "statute",
  "title": "40/2017. (IV. 28.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2017-04-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2017-40-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 220. § (2) bekezdésében foglalt jogkörömben eljárva, az emberi erőforrások minisztere javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kissné dr. Sápi Kingát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "az Emberi Erőforrások Minisztériuma helyettes államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2017. április 10-ei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    }
  ]
}
