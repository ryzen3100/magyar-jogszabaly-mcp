{
  "id": "hu-law-2007-143-20-0n",
  "type": "statute",
  "title": "143/2007. (XII. 27.) KvVM rendelet a Szigetközi Tájvédelmi Körzet védettségének fenntartásáról",
  "status": "in_force",
  "in_force_date": "2008-01-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-143-20-0N",
  "description": "a Szigetközi Tájvédelmi Körzet védettségének fenntartásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1. §",
      "content": "1. § Az Országos Környezet- és Természetvédelmi Hivatal elnökének 1/1987. (III. 19.) OKTH rendelkezésével védetté nyilvánított Szigetközi Tájvédelmi Körzet védettségét fenntartom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2. §",
      "content": "2. § A Szigetközi Tájvédelmi Körzet kiterjedése 9681,7 ha, ingatlan-nyilvántartási helyrajzi számait az 1. számú melléklet, fokozottan védett területének ingatlan-nyilvántartási helyrajzi számait a 2. számú melléklet tartalmazza."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3. §",
      "content": "3. § A védettség indoka és célja a Szigetközben a Duna folyóhoz és árteréhez kapcsolódó élővízi, mocsári és ártéri élőhelyek (holtágak, mellékágak, ártéri ligeterdők, nedves rétek) kiemelkedő természeti értékeinek, egyedi életközösségeinek védelme és fenntartása, valamint a jellegzetes tájképi adottságok megőrzése."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4. §",
      "content": "4. § A terület természetvédelmi kezeléséért felelős szerv a Fertő–Hanság és Őrségi Nemzeti Park Igazgatóság."
    },
