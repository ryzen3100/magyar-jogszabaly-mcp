  "title": "1481/2013. (VII. 26.) Korm. határozat „Életmentő Emlékérem” adományozásáról",
  "status": "repealed",
  "in_force_date": "2013-07-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2013-1481-30-22",
  "description": "„Életmentő Emlékérem” adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány az „Életmentő Emlékérem” adományozásáról szóló 243/2009. (X. 29.) Korm. rendelet alapján, életmentés közben tanúsított hősies magatartása elismeréseként – a belügyminiszter mint helyi önkormányzatokért felelős miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Zsilli Szilárd pécsi és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Nagy-Pál Zoltán tápiógyörgyei"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "lakosnak"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "„Életmentő Emlékérmet”"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "adományoz. 1 A határozatot az 1046/2015. (II. 11.) Korm. határozat 1. pontja visszavonta 2015. február 12. napjával. Alkalmazására lásd e visszavonó határozat 3. pontját."
    }
  ]
}
