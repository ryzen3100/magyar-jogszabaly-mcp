{
  "id": "hu-law-2018-130-30-63",
  "type": "statute",
  "title": "130/2018. (X. 12.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2018-10-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/2018-130-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az emberi erőforrások miniszterének a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Kissné Budai Rita Anna főiskolai tanárt a Tomori Pál Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2018. október 15-étől 2021. október 14-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
