      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1994. évi 71. számában megjelent, az egyes építésügyi jogszabályok módosításáról és hatályon kívül helyezéséről szóló 21/1994. (VI. 29.) KTM rendelet"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "— 8. §-ának 2. pontja helyesen:,,…önálló rendeltetési egységek…''"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— 8. §-ának 4. pontja helyesen:,,4. 200 légköbméternél nagyobb…''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— 9. §-ával módosított 12. § (1) bekezdés c) pontja helyesen:,,c) az építési munka műszaki terveit három példányban,''"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "(Kézirathiba)"
    }
  ]
}
