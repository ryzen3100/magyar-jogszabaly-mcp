      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére, a fenntartó javaslatára – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "megbízom a rektori teendők ellátásával"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "az Országos Rabbiképző – Zsidó Egyetemen"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Schőner Alfréd egyetemi tanárt – további –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2002. június hó 1-jétől 2006. május hó 31-ig terjedő időtartamra és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Károli Gáspár Református Egyetemen"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Kovács Eszter egyetemi tanárt"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "2002. június hó 1-jétől 2006. május hó 31-ig terjedő időtartamra."
    },
    {
