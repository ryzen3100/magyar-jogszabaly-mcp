      "section": "1",
      "title": "1",
      "content": "71/1992. (III. 25.) KE határozat"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "városi cím adományozásáról"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "A belügyminiszter előterjesztésére az alábbi községeknek a városi címet adományozom:"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "1. a Somogy megyében lévő"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Balatonföldvár,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Lengyeltóti;"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2. a Zala megyében lévő"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Hévíz."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Ez a határozat 1992. május 1. napján lép hatályba."
    }
  ]
}
