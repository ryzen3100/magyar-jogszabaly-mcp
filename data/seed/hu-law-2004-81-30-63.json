{
  "id": "hu-law-2004-81-30-63",
  "type": "statute",
  "title": "81/2004. (XI. 27.) ME határozat központi tiszt cím megszűnésének megállapításáról",
  "status": "in_force",
  "in_force_date": "2004-11-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-81-30-63",
  "description": "központi tiszt cím megszűnésének megállapításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A fegyveres szervek hivatásos állományú tagjainak szolgálati viszonyáról szóló 1996. évi XLIII. törvény 245/J. §-ának (4) bekezdése alapján – a köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 31/D. §-a (1) bekezdésének a) pontjára tekintettel – megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Gémesi István,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Horváth József,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Kopasz Árpád,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Krőzsel Károly,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Németh László és"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Tergalecz Ferenc központi tiszt címe – hivatásos szolgálati jogviszonyának megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "2004. december 30-i hatállyal"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "megszűnik."
    }
  ]
}
