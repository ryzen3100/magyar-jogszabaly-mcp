{
  "id": "hu-law-2015-12-30-63",
  "type": "statute",
  "title": "12/2015. (I. 30.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2015-01-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2015-12-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az oktatásért felelős miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Tan Kapuja Buddhista Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Jelen János Lajos tudományos főmunkatársat"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2015. február 15-étől 2019. február 14-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
