      "section": "2",
      "title": "2",
      "content": "lemondására tekintettel"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Bacsó Kincső Juditot 2026. január 31-ei hatállyal és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Huszár Eszter Etelkát 2026. március 3-ai hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
