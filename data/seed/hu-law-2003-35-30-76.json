{
  "id": "hu-law-2003-35-30-76",
  "type": "statute",
  "title": "35/2003. (III. 4.) KE határozat egyetemi tanári kinevezésről",
  "status": "in_force",
  "in_force_date": "2003-03-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-35-30-76",
  "description": "egyetemi tanári kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére, a felsőoktatásról szóló 1993. évi LXXX. törvény 71. §-a (1) bekezdésének a) pontjában foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Kodolányi János Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Lukács Lászlót, a Szent István Király Múzeum Néprajzi Osztály osztályvezetőjét, a Kodolányi János Főiskola további jogviszonyban alkalmazott tudományos tanácsadóját – meghívással, határozott időre –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2003. március 1-jétől öt évig terjedő időtartamra"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "egyetemi tanárrá kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-2/0503/2003."
    }
  ]
}
