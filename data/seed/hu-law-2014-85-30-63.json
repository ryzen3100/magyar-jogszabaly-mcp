{
  "id": "hu-law-2014-85-30-63",
  "type": "statute",
  "title": "85/2014. (VII. 8.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2014-07-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/2014-85-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben – az emberi erőforrások miniszterének a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Zsigmond Király Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Bayer József egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2014. augusztus 1-jétől 2016. február 29-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
