{
  "id": "hu-law-1996-23-40-00",
  "type": "statute",
  "title": "1996. MK 23. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1996-03-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-23-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1996. évi 17. számában kihirdetett, a közúti közlekedésről szóló 1988. évi I. törvény módosításáról rendelkező 1996. évi X. törvény"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "— 2. §-ának második sora helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,…rendelkezés lép, a § az alábbi (4) és (5) bekezdéssel…'';"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— 5. §-ának első sora helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,5. § A Kkt. 29. §-ának (4) bekezdése helyébe a következő'';"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "— 7. §-sal módosított 33. § (1) bekezdése d) pontjának harmadik sora helyesen:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": ",,…levő ingatlanon fekvő magánút esetében tulajdonosnak…''."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "(Nyomdahiba)"
    }
  ]
}
