    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Papp János egyetemi tanárt,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "1999. július 1-jétől 1999. december 31-ig terjedő időtartamra."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Pokorni Zoltán s. k., oktatási miniszter"
    }
  ]
