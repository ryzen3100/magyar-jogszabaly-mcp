  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére, megbízom a rektori teendők ellátásával"
    },
    {
      "provision_ref": "s2",
      "section": "2",
