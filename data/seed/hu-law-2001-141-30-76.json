  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére dr. Kurucz Ferenc r. ezredest, a Békés Megyei Rendőr-főkapitányság vezetőjét, a rendőri munka irányításában, a közbiztonság javítása érdekében kifejtett kimagasló tevékenysége elismeréseként 2001. október 23-i hatállyal"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "rendőr dandártábornokká"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Budapest, 2001. október 15."
    }
  ]
}
