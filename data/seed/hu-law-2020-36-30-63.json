    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Gellén Mártont és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Szecskó Józsefet,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "az Igazságügyi Minisztérium helyettes államtitkárait e tisztségükből"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2020. május 14-ei hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "felmentem, egyidejűleg"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Mázi Andrást – 2020. május 15-ei hatállyal – és"
