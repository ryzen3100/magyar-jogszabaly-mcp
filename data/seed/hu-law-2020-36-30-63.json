    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "az Igazságügyi Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "kinevezem."
    }
