{
  "id": "hu-law-2014-214-30-76",
  "type": "statute",
  "title": "214/2014. (VI. 6.) KE határozat miniszterek kinevezéséről",
  "status": "in_force",
  "in_force_date": "2014-06-06",
  "url": "https://njt.jog.gov.hu/jogszabaly/2014-214-30-76",
  "description": "miniszterek kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés c) pontja és a 16. cikk (7) bekezdése alapján – a miniszterelnök javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Semjén Zsoltot tárca nélküli miniszterré,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Pintér Sándort belügyminiszterré,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Balog Zoltánt az emberi erőforrások miniszterévé,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Fazekas Sándort földművelésügyi miniszterré,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Hende Csabát honvédelmi miniszterré,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Trócsányi Lászlót igazságügyi miniszterré,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Navracsics Tibort külgazdasági és külügyminiszterré,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Varga Mihályt nemzetgazdasági miniszterré,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "dr. Seszták Miklóst nemzeti fejlesztési miniszterré,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Lázár Jánost a Miniszterelnökséget vezető miniszterré"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "2014. június 6-ai hatállyal kinevezem."
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "KEH ügyszám: IV-2/03001-1/2014."
    }
  ]
}
