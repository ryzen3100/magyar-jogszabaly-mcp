{
  "id": "hu-law-2016-64-30-63",
  "type": "statute",
  "title": "64/2016. (VI. 7.) ME határozat főiskolai rektorok megbízásáról",
  "status": "in_force",
  "in_force_date": "2016-06-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/2016-64-30-63",
  "description": "főiskolai rektorok megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az oktatásért felelős miniszternek a fenntartók javaslata alapján tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Bhaktivedanta Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Banyár Magdolna főiskolai tanárt és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Sapientia Szerzetesi Hittudományi Főiskolán"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Várnai Sándor Jakab egyetemi tanárt"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– a 2016. július 1-jétől 2020. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
