{
  "id": "hu-law-1995-14-40-00",
  "type": "statute",
  "title": "1995. MK 14. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1995-02-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-14-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1994. évi 126. számában közzétett, a fogyasztási adóról és a fogyasztói árkiegészítésről szóló 1994. évi LXXXVIII. törvény 2. számú melléklete helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,10. Hatósági áras különjárati autóbusz forgalom (SZJ: 09 123-ból) 20%"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "A Magyar Közlöny 1994. évi 126. számában közzétett, az általános forgalmi adóról szóló 1992. évi LXXIV. törvény módosításáról szóló 1994. évi LXXXIX. törvény helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "A 6. §-ban:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": ",,26. § (1) Ha az adó alapjának megállapításához szükséges értéket külföldi fizetőeszközben fejezték ki, akkor az adó alapjának…''"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "A 15. §-ban:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,47. § (1) Az adót a havi adóbevallásra kötelezett adóalany a tárgyhónap első napjától…''"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "A 16. §-ban:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": ",,48. § (4)"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "b) …a tárgyi eszköz beszerzésére jutó előzetesen felszámított adót — a 32. § (1) bekezdésének a) pontja szerinti esetben — …''"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "A 25. §-ban:"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": ",,72. § (1)"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "b) az importáló e tekintetben nem rendelkezik adólevonási jogosultsággal."
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "(2) …A Magyar Közlönyben közzétett nemzetközi szerződés a külföldről származó pénzbeni segély felhasználását…"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "(3) …ha a külföldi illetőségű adománytevő a külföldről származó pénzbeni segély felhasználását ahhoz a feltételhez köti…"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "(5) …amilyen hányadban a kiadásokból a pénzbeni segély, adomány részesedik.''"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "A 28. §-ban:"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": ",,(5)…az 1994. év december 31. napját követően…"
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": "(6) …az adóalanynak legkésőbb 1995. év január hónap 31. napjáig kell nyilatkoznia választásáról.''"
    },
    {
      "provision_ref": "s25",
      "section": "25",
      "title": "25",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s26",
      "section": "26",
      "title": "26",
      "content": "A 29. §-ban:"
    },
    {
      "provision_ref": "s27",
      "section": "27",
      "title": "27",
      "content": ",,(3) Az az adóalany, aki (amely) 1994. év december hónap 31. napján az áfa tv. 37. §-ának hatálya alá tartozott…''"
    },
    {
      "provision_ref": "s28",
      "section": "28",
      "title": "28",
      "content": "(Nyomdahiba)"
    }
  ]
}
