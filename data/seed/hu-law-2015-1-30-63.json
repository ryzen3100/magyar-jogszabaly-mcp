{
  "id": "hu-law-2015-1-30-63",
  "type": "statute",
  "title": "1/2015. (I. 15.) ME határozat állami felsőoktatási intézmények kancellárjainak megbízásáról",
  "status": "in_force",
  "in_force_date": "2015-01-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2015-1-30-63",
  "description": "állami felsőoktatási intézmények kancellárjainak megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (4a) bekezdésében foglalt jogkörömben eljárva – az oktatásért felelős miniszter előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az Eötvös Loránd Tudományegyetemen dr. Scheuer Gyulát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Liszt Ferenc Zeneművészeti Egyetemen dr. Kupper Andrást,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Pannon Egyetemen dr. Kovács Gyulát,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Szegedi Tudományegyetemen Devecz Miklóst,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Színház- és Filmművészeti Egyetemen dr. Vonderviszt Lajost és"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "az Eötvös József Főiskolán dr. Bohátka Gergelyt"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– a 2015. január 1-jétől 2017. december 31-éig terjedő időtartamra –, valamint"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "a Pécsi Tudományegyetemen Jenei Zoltánt"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "– a 2015. január 10-étől 2017. december 31-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "a kancellári teendők ellátásával megbízom."
    }
  ]
}
