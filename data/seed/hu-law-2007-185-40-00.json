      "provision_ref": "s112",
      "section": "112",
      "title": "112",
      "content": "A divattal kapcsolatos alapfogalmak."
    },
    {
      "provision_ref": "s113",
      "section": "113",
      "title": "113",
      "content": "Szakmai információk, divattrendek beszerzési forrásai."
    },
    {
      "provision_ref": "s114",
      "section": "114",
      "title": "114",
      "content": "A divattervezés fogalma, feladatai."
    },
    {
      "provision_ref": "s115",
      "section": "115",
      "title": "115",
      "content": "Az öltözet kialakulási folyamata."
    },
    {
      "provision_ref": "s116",
      "section": "116",
      "title": "116",
      "content": "Az öltözködéstörténet főbb szakaszai."
    },
    {
      "provision_ref": "s117",
      "section": "117",
      "title": "117",
      "content": "A természeti népek, az őskor öltözete."
    },
    {
      "provision_ref": "s118",
      "section": "118",
      "title": "118",
      "content": "Az ókori egyiptomi, görög, római öltözetek."
    },
    {
      "provision_ref": "s119",
      "section": "119",
      "title": "119",
      "content": "A románkori viseletek."
    },
    {
      "provision_ref": "s120",
      "section": "120",
      "title": "120",
      "content": "A gótika korának öltözetei."
    },
