  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 60. § (1) bekezdése alapján, a gazdasági és közlekedési miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Bóna Ákost,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Egyed Gézát,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Garamhegyi Ábelt"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Gazdasági és Közlekedési Minisztérium szakállamtitkárait e tisztségükből"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– 2008. május 14-i hatállyal –"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "felmentem."
    }
  ]
