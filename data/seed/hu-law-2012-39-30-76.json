  "title": "39/2012. (II. 27.) KE határozat egyetemi tanári kinevezésről",
  "status": "in_force",
  "in_force_date": "2012-02-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-39-30-76",
  "description": "egyetemi tanári kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés c) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának b) pontja alapján, a nemzeti erőforrás miniszternek a fenntartóval egyetértésben tett javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Viga Gyulát, a Miskolci Egyetem egyetemi docensét,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Füzesi Zsuzsannát, a Pécsi Tudományegyetem egyetemi docensét és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Hörcher Ferencet, a Pázmány Péter Katolikus Egyetem egyetemi docensét"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2012. február 15. napjával kinevezem egyetemi tanárrá."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Budapest, 2012. január 11."
    },
    {
      "provision_ref": "s7",
