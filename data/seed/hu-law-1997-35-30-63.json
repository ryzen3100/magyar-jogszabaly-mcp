{
  "id": "hu-law-1997-35-30-63",
  "type": "statute",
  "title": "35/1997. (XI. 19.) ME határozat főiskolai főigazgatói megbízásról",
  "status": "amended",
  "in_force_date": "1997-11-19",
  "url": "https://njt.jog.gov.hu/jogszabaly/1997-35-30-63",
  "description": "főiskolai főigazgatói megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 73. §-ának b) pontja alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Benedek Elek Pedagógiai Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Alpárné dr. Szála Erzsébet egyetemi docenst"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "1997. november 15-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2001. június 30-ig terjedő időtartamra, a főiskola integrációja esetén az önálló intézmény megszűnéséig –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a főigazgatói teendők ellátásával megbízom."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
