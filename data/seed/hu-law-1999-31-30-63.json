{
  "id": "hu-law-1999-31-30-63",
  "type": "statute",
  "title": "31/1999. (X. 22.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1999-10-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/1999-31-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, az oktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Varsányi Györgyöt, az Eötvös József Főiskola főiskolai tanárát 2000. január 1-jei hatállyal,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Szegedi Józsefet, a Miskolci Egyetem Dunaújvárosi Főiskolai Kar főiskolai tanárát 2000. április 30-i hatállyal,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– nyugállományba vonulásukra tekintettel –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "e tisztségükből felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
