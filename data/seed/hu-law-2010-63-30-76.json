  "title": "63/2010. (III. 26.) KE határozat rektori megbízásról",
  "status": "in_force",
  "in_force_date": "2010-03-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-63-30-76",
  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény (Fot.) 100. §-ának a) pontja alapján, – tekintettel a Fot. 138/B. § (1) bekezdésére – az oktatási és kulturális miniszternek – a fenntartóval egyetértésben tett – javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Közép-európai Egyetemen,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. John Shattuck megbízott rektort"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2010. április 1-jétől 2014. július 31-éig terjedő időtartamra"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: IV-3/00956/2010."
    }
  ]
}
