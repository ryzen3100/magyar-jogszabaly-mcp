{
  "id": "hu-law-1991-9-30-76",
  "type": "statute",
  "title": "A Köztársaság Elnökének 9/1991. (I. 21.) KE határozata miniszterek felmentéséről, valamint miniszterek kinevezéséről",
  "status": "amended",
  "in_force_date": "1991-01-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/1991-9-30-76",
  "description": "miniszterek felmentéséről, valamint miniszterek kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 33. §-ának (4) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Győriványi Sándor munkaügyi minisztert — kérésére —,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Gerbovits Jenő tárca nélküli minisztert,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Kiss Gyula tárca nélküli minisztert,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Nagy Ferenc József földművelésügyi minisztert"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "e tisztségükből 1991. január 16-ai hatállyal — érdemeik elismerése mellett — felmentem, egyidejűleg"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Gergátz Elemért földművelésügyi miniszterré,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Kiss Gyulát munkaügyi miniszterré,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Nagy Ferenc Józsefet tárca nélküli miniszterré"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Göncz Árpád s. k.,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "a Köztársaság elnöke"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Dr. Antall József s. k.,"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "miniszterelnök"
    }
  ]
}
