{
  "id": "hu-law-2012-12-30-63",
  "type": "statute",
  "title": "12/2012. (I. 23.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2012-01-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/2012-12-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormánytisztviselők jogállásáról szóló 2010. évi LVIII. törvény 47. § (1) bekezdése alapján, a vidékfejlesztési miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "ifj. Zlinszky Jánost"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Vidékfejlesztési Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2012. január 16-ai hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    }
  ]
}
