{
  "id": "hu-law-2007-184-30-76",
  "type": "statute",
  "title": "184/2007. (IX. 21.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2007-09-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-184-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a pénzügyminiszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Csillag Dezsőné dr.-nak, az APEH Központi Hivatala főosztályvezetőjének,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Dankó Ádámnak, a Magyar Távirati Iroda gazdasági főszerkesztőség vezetőjének,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Kanta Tündének, a Vám- és Pénzügyőrség Országos Parancsnoksága Bűnügyi Igazgatóság igazgatójának,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Sóti Pálnénak, az APEH Közép-magyarországi Regionális Igazgatósága szakigazgatójának a"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Bodnár Teréziának, a Kincstári Vagyoni Igazgatóság vezérigazgató-helyettesének,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Burgmann Györgynek, az APEH Dél-dunántúli Regionális Igazgatósága főosztályvezetőjének,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Somodi Sándornak, az APEH Központi Hivatala osztályvezetőjének,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Szántayné Turzán Máriának, a Vám- és Pénzügyőrség Országos Parancsnoksága Gazdasági Főosztálya főosztályvezetőjének a"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "MAGYAR KÖZTÁRSASÁGI EZÜST ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "kitüntetést;"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Belkó Zoltánnénak, az APEH Észak-magyarországi Regionális Igazgatósága főosztályvezetőjének,"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "dr. Szűcs Editnek, az APEH Dél-alföldi Regionális Igazgatósága osztályvezetőjének a"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "MAGYAR KÖZTÁRSASÁGI BRONZ ÉRDEMKERESZT (polgári tagozat)"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "kitüntetést"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "adományozom."
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "KEH ügyszám: VII-2/3222-11/2007."
    }
  ]
}
