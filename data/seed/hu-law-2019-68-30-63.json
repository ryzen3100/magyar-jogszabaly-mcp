{
  "id": "hu-law-2019-68-30-63",
  "type": "statute",
  "title": "68/2019. (VII. 16.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2019-07-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/2019-68-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az emberi erőforrások miniszterének a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Gábor Dénes Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Keszthelyi-Szabó Gábor egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2019. július 15-étől 2023. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
