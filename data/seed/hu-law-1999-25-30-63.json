{
  "id": "hu-law-1999-25-30-63",
  "type": "statute",
  "title": "25/1999. (VIII. 26.) ME határozat főiskolai tanár felmentéséről",
  "status": "amended",
  "in_force_date": "1999-08-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/1999-25-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, az oktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Pethő Lászlót, a Jászberényi Tanítóképző Főiskola főiskolai tanárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1999. augusztus 1-jei hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– közalkalmazotti jogviszony közös megegyezéssel történő megszűnésére tekintettel –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
