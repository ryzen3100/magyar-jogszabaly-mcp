  "title": "103/1999. (VI. 11.) KE határozat politikai államtitkárok megbízatása megszűnésének megállapításáról",
  "status": "amended",
  "in_force_date": "1999-06-11",
  "url": "https://njt.jog.gov.hu/jogszabaly/1999-103-30-76",
  "description": "politikai államtitkárok megbízatása megszűnésének megállapításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról szóló 1997. évi LXXIX. törvény (a továbbiakban: Tv.) 24. §-ában foglalt jogkörömben megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Balsay Istvánnak és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Selmeczi Gabriellának, a Miniszterelnöki Hivatal politikai államtitkárainak megbízatása – a Tv. 21. §-a (2) bekezdésének a) pontja szerinti lemondással –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "1999. június 20-i hatállyal megszűnik."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Budapest, 1999. május 28."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
