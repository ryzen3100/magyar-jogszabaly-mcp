{
  "id": "hu-law-1995-40-30-63",
  "type": "statute",
  "title": "40/1995. (XI. 22.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1995-11-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-40-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Sárosi Herbertet, a Kertészeti és Élelmiszeripari Egyetem Élelmiszeripari Főiskolai Kara főiskolai tanárát 1995. december 29-i hatállyal,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Kisfaludy Antalt, a Bánki Donát Műszaki Főiskola főiskolai tanárát 1995. december 28-i hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— nyugállományba vonulására tekintettel —"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "e tisztségéből felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
