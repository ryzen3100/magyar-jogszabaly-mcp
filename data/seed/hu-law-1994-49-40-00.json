{
  "id": "hu-law-1994-49-40-00",
  "type": "statute",
  "title": "1994. MK 49. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1994-05-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-49-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1994. évi 26. számában kihirdetett 8/1994. (III. 10.) FM rendelet szövege három helyen hibás. A helyes szöveg a következő:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "— a 814. oldalon a 13/B. § (2) bekezdésének b) pontjánál:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,b) a borkősav hozzáadásával a must savtartalma legfeljebb 1,5 g/l-rel…''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "— a 816. oldalon a 11. § első mondatánál:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": ",,Az R. a következő 28/A. §-sal egészül ki:''"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "— a 816. oldalon a 14. § első mondatánál:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,Az R. 31. §-a a következő (6) bekezdéssel egészül ki:''"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "A Magyar Közlöny 1994. évi 31. számában kihirdetett 11/1994. (III. 22.) FM rendelet 2. § n) pontjának második mondata helyesen:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": ",,hatóságilag fogyasztásra feltétel nélkül alkalmasnak minősített hús más helységbe vagy feldolgozó üzembe való …''"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "— Az 1. számú melléklet 1. pontjában szereplő Húsvizsgálati díjak SZJ száma helyesen:"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": ",,(SZJ 142311)''"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "— A 2. számú melléklet fejléce helyesen:"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "SZÁMLA az állategészségügyi és élelmiszer-ellenőrzési igazgatási szolgáltatásokról (SZJ 171 200)"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "— Ugyanezen mellékleten a Húsvizsgálat SZJ száma helyesen:,,142311''"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "(Kézirathiba)"
    }
  ]
}
