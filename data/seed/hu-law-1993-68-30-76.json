  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A művelődési és közoktatási miniszter előterjesztésére — nyugállományba vonulásukra tekintettel — az Eötvös Loránd Tudományegyetemről"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Ribinszki Károlyné dr. Mezei Márta egyetemi tanárt 1993. december 30. napjával,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Gregor Ferenc egyetemi tanárt 1994. április 30. napjával,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Kossuth Lajos Tudományegyetemről"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Iglói Endre egyetemi tanárt és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Petrikás Árpád egyetemi tanárt"
    },
    {
