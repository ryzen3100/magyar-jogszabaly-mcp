      "content": "a Janus Pannonius Tudományegyetemről"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Herczeg Gyula egyetemi tanárt"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "1993. december 31. napjával"
    },
    {
