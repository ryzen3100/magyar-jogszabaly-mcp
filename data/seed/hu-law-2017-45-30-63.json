{
  "id": "hu-law-2017-45-30-63",
  "type": "statute",
  "title": "45/2017. (VI. 7.) ME határozat főiskolai rektorok megbízásáról",
  "status": "in_force",
  "in_force_date": "2017-06-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/2017-45-30-63",
  "description": "főiskolai rektorok megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – az oktatásért felelős miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Baptista Teológiai Akadémián"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Almási Tibor egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2017. július 1-jétől 2022. június 30-áig terjedő időtartamra – és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Sárospataki Református Teológiai Akadémián"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Füsti-Molnár Szilveszter főiskolai tanárt"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– a 2017. július 1-jétől 2020. június 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a rektori teendők ellátásával ismételten megbízom."
    }
  ]
}
