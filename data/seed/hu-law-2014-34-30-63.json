{
  "id": "hu-law-2014-34-30-63",
  "type": "statute",
  "title": "34/2014. (IV. 8.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2014-04-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/2014-34-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 221. § (2) bekezdés c) pontja alapján, a közigazgatási és igazságügyi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Fekete Gábort, a Közigazgatási és Igazságügyi Minisztérium helyettes államtitkárát e tisztségéből más fontos megbízatására tekintettel"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2014. április 8-ai hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
