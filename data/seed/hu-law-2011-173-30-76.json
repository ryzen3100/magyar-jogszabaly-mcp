  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának a) pontja alapján, a nemzeti erőforrás miniszter és a fenntartó javaslatára, a Debreceni Református Hittudományi Egyetemen"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Fekete Károly egyetemi tanárt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2011. augusztus 1-jétől 2014. július 31-éig terjedő időtartamra"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: IV-3/03806/2011."
    }
  ]
}
