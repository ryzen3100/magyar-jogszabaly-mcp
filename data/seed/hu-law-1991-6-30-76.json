  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A művelődési és közoktatási miniszter előterjesztésére dr. Lipták András akadémikus, tanszékvezető egyetemi tanárt a Kossuth Lajos Tudományegyetem rektori teendőinek ellátásával 1991. január 1-jétől 1993. június 30-áig terjedő időtartamra megbízom."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Göncz Árpád s. k.,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Köztársaság elnöke"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Dr. Andrásfalvy Bertalan s. k.,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "művelődési és közoktatási miniszter"
    }
  ]
}
