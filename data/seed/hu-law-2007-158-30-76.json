{
  "id": "hu-law-2007-158-30-76",
  "type": "statute",
  "title": "158/2007. (VIII. 31.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2007-08-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-158-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a határainkon túl is elismert, a közgazdaságtudomány terén végzett sokoldalú munkásságáért"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Kornai János Széchenyi-díjas közgazdásznak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "az európai és gazdasági jogi képzés korszerűsítésében, a társasági és cégtörvények kidolgozásában végzett munkássága, a gazdaságirányítási jog terén végzett kutatói, valamint széles körű szakmai-közéleti tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Sárközy Tamásnak, az állam- és jogtudomány doktorának, Állami-díjasnak, a Budapesti Corvinus Egyetem Gazdasági Jogi Intézete egyetemi tanárának a"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "KÖZÉPKERESZTJE A CSILLAGGAL"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "(polgári tagozata);"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "nemzetközileg is nagyra becsült irodalmi munkássága elismeréseként"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Esterházy Péter Kossuth-díjas írónak,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "nemzetközileg is nagyra becsült művészi és oktatói tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Jovánovics György Kossuth-díjas szobrászművésznek,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "a magyar és a nemzetközi filmművészetben elért eredményeiért"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "Kende János Kossuth-díjas filmoperatőrnek, a Színház- és Filmművészeti Egyetem rektori megbízottjának, a Magyar Operatőrök Társasága elnökének a"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "KÖZÉPKERESZTJE"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "(polgári tagozata);"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "világszerte elismert sportpályafutásáért, a magyar sport nemzetközi hírnevének öregbítéséért"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "Erdei Zsolt ökölvívónak,"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "nemzetközileg is nagyra becsült filmrendezői tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "Forgács Péter Balázs Béla-díjas filmrendezőnek,"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "kiemelkedő tudományos kutatói és oktatói tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "dr. Tamás Pálnak, a szociológiai tudomány kandidátusának, az MTA Szociológiai Kutatóintézet igazgatójának a"
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s25",
      "section": "25",
      "title": "25",
      "content": "TISZTIKERESZTJE"
    },
    {
      "provision_ref": "s26",
      "section": "26",
      "title": "26",
      "content": "(polgári tagozata);"
    },
    {
      "provision_ref": "s27",
      "section": "27",
      "title": "27",
      "content": "több évtizedes, sokoldalú irodalmi munkássága, újságírói tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s28",
      "section": "28",
      "title": "28",
      "content": "Csáki Judit újságírónak, kritikusnak,"
    },
    {
      "provision_ref": "s29",
      "section": "29",
      "title": "29",
      "content": "két évtizedes kritikusi munkássága elismeréseként"
    },
    {
      "provision_ref": "s30",
      "section": "30",
      "title": "30",
      "content": "Fáy Miklós újságírónak,"
    },
    {
      "provision_ref": "s31",
      "section": "31",
      "title": "31",
      "content": "a hazai borászati és borkultúra fejlesztéséért, a magyar borok nemzetközi elismertetésében betöltött szerepéért"
    },
    {
      "provision_ref": "s32",
      "section": "32",
      "title": "32",
      "content": "Györgykovács Imre somlóvásárhelyi borásznak,"
    },
    {
      "provision_ref": "s33",
      "section": "33",
      "title": "33",
      "content": "Lőrincz György a St. Andrea Pincészet (Egerszalók) borászának,"
    },
    {
      "provision_ref": "s34",
      "section": "34",
      "title": "34",
      "content": "Weninger Franz a Weninger Pincészet (Balf) borászának,"
    },
    {
      "provision_ref": "s35",
      "section": "35",
      "title": "35",
      "content": "a magyar gasztronómia megismertetéséért, a Gundel Étterem újbóli világhírnévre emeléséért"
    },
    {
      "provision_ref": "s36",
      "section": "36",
      "title": "36",
      "content": "Kalla Kálmánnak, a Gundel Étterem konyhaigazgatójának,"
    },
    {
      "provision_ref": "s37",
      "section": "37",
      "title": "37",
      "content": "az Ulpius-ház Könyvkiadó létrehozásáért, a nívós szépirodalmi művek és irodalmi alkotások kiadásáért"
    },
    {
      "provision_ref": "s38",
      "section": "38",
      "title": "38",
      "content": "Kepets Andrásnak, az Ulpius-ház Könyvkiadó könyvkiadó vezetőjének,"
    },
    {
      "provision_ref": "s39",
      "section": "39",
      "title": "39",
      "content": "több évtizedes színikritikusi és lapszerkesztői tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s40",
      "section": "40",
      "title": "40",
      "content": "Koltai Tamás Jászai Mari-díjas színikritikusnak, a Színház c. folyóirat főszerkesztőjének,"
    },
    {
      "provision_ref": "s41",
      "section": "41",
      "title": "41",
      "content": "a magyar divattervezés nemzetközi elismertetése érdekében végzett tevékenységéért"
    },
    {
      "provision_ref": "s42",
      "section": "42",
      "title": "42",
      "content": "Náray Tamás divattervezőnek,"
    },
    {
      "provision_ref": "s43",
      "section": "43",
      "title": "43",
      "content": "sokoldalú művészi és oktatói tevékenységéért"
    },
    {
      "provision_ref": "s44",
      "section": "44",
      "title": "44",
      "content": "Péter Vladimír Munkácsy Mihály-díjas szobrászművésznek, ötvösművésznek, Érdemes Művésznek, a Moholy Nagy László Iparművészeti Egyetem egyetemi tanárának,"
    },
    {
      "provision_ref": "s45",
      "section": "45",
      "title": "45",
      "content": "színházvezetői, rendezői és színművészi tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s46",
      "section": "46",
      "title": "46",
      "content": "Pintér Béla színművésznek, rendezőnek,"
    },
    {
      "provision_ref": "s47",
      "section": "47",
      "title": "47",
      "content": "egyedi, a Luan by Lucia márkanevet viselő ruhaterveiért és nagy sikerrel rendezett szakmai divatbemutatói elismeréseként"
    },
    {
      "provision_ref": "s48",
      "section": "48",
      "title": "48",
      "content": "S. Hegyi Lucia divattervezőnek, iparművésznek,"
    },
    {
      "provision_ref": "s49",
      "section": "49",
      "title": "49",
      "content": "sokoldalú művészeti tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s50",
      "section": "50",
      "title": "50",
      "content": "Wahorn András Munkácsy Mihály-díjas képzőművésznek a"
    },
    {
      "provision_ref": "s51",
      "section": "51",
      "title": "51",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s52",
      "section": "52",
      "title": "52",
      "content": "LOVAGKERESZTJE"
    },
    {
      "provision_ref": "s53",
      "section": "53",
      "title": "53",
      "content": "(polgári tagozata)"
    },
    {
      "provision_ref": "s54",
      "section": "54",
      "title": "54",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s55",
      "section": "55",
      "title": "55",
      "content": "KEH ügyszám: VII-2/3220/2007."
    }
  ]
}
