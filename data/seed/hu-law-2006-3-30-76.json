{
  "id": "hu-law-2006-3-30-76",
  "type": "statute",
  "title": "3/2006. (I. 18.) KE határozat közigazgatási államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2006-01-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-3-30-76",
  "description": "közigazgatási államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 29. §-ának (1) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Héthy Lajost, a Foglalkoztatáspolitikai és Munkaügyi Minisztérium közigazgatási államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– nyugállományba vonulása miatt, 2006. január 15-i hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: V-1/0250-0/2006."
    }
  ]
}
