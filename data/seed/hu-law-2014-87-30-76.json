{
  "id": "hu-law-2014-87-30-76",
  "type": "statute",
  "title": "87/2014. (III. 3.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2014-03-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/2014-87-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés f) pontja, illetve a Magyarország címerének és zászlajának használatáról, valamint állami kitüntetéseiről szóló 2011. évi CCII. törvény 18. § (1) bekezdése alapján – a miniszterelnök előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a magyar–török kulturális és gazdasági kapcsolatok fejlesztése érdekében tett erőfeszítései elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Mehmet Özhaseki Kayseri nagyváros főpolgármestere részére a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR ÉRDEMREND LOVAGKERESZTJE polgári tagozata"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VIII-1/00876-1/2014."
    }
  ]
}
