  "description": "a Népművészet Mestere díj 2026. évi adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Magyarország Kormánya 2026-ban"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Bálint Tibor türei, kalotaszegi bujkakészítőnek,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Balogh István ongai fafaragónak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Csoltói József ágfalvai német nemzetiségi hagyományőrzőnek,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Erdélyiné Horváth Gabriella győri népi hímző és szövőnek,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Gâtu Clara magyarfalusi, moldvai hagyományőrző néptáncosnak és népdalénekesnek,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Gregor Balázs nagykörűi szakajtókötőnek,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Hotyek Attila erdőbényei kádármesternek,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Terényi Gyöngyi átai bőrművesnek,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Vincze István melegföldvári, mezőségi néptáncosnak,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Vizoli Demeter gyergyóalfalusi hagyományőrző néptáncosnak és énekesnek"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "a Népművészet Mestere díjat adományozza."
    }
  ]
}
