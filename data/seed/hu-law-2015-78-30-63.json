{
  "id": "hu-law-2015-78-30-63",
  "type": "statute",
  "title": "78/2015. (IX. 16.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2015-09-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/2015-78-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben – az oktatásért felelős miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Jandala Csilla főiskolai tanárt az Edutus Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2015. szeptember 1-jétől 2018. augusztus 31-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
