{
  "id": "hu-law-2009-59-30-63",
  "type": "statute",
  "title": "59/2009. (VIII. 7.) ME határozat szakállamtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2009-08-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/2009-59-30-63",
  "description": "szakállamtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 58. § c) pontja alapján – más fontos megbízatására tekintettel –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Banai Károlyt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Miniszterelnöki Hivatal szakállamtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2009. augusztus 16-ai hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
