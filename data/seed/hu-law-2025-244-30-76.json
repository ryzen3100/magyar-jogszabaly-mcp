  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (3) bekezdés k) pontja és 26. cikk (2) bekezdése, valamint a bírák jogállásáról és javadalmazásáról szóló 2011. évi CLXII. törvény 3. § (2) bekezdése és 23. § (1) bekezdése alapján – az Országos Bírósági Hivatal elnökének javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Berecz Zsuzsannát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Némethné dr. Dancs Tímeát,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Pataki Bettinát és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Törökné dr. Vincze Csillát"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a 2025. október 1. napjától 2028. szeptember 30. napjáig terjedő időtartamra bíróvá kinevezem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
