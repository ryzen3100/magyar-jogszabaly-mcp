{
  "id": "hu-law-1995-135-30-76",
  "type": "statute",
  "title": "135/1995. (VIII. 24.) KE határozat dandártábornoki kinevezésről",
  "status": "amended",
  "in_force_date": "1995-08-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-135-30-76",
  "description": "dandártábornoki kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A polgári titkosszolgálatokat felügyelő tárca nélküli miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "állami ünnepünk, augusztus 20-a alkalmából"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Szikora Antal ezredest, a Magyar Köztársaság Információs Hivatala információs igazgatóját"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dandártábornokká kinevezem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Nikolits István s. k., tárca nélküli miniszter"
    }
  ]
}
