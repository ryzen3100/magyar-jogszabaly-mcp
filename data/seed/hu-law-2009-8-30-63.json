{
  "id": "hu-law-2009-8-30-63",
  "type": "statute",
  "title": "8/2009. (II. 20.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2009-02-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2009-8-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) pontjában foglalt jogkörömben – az oktatási és kulturális miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Budapesti Kommunikációs és Üzleti Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Vass László főiskolai tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– a 2009. február 1-jétől 2013. február 1-jéig terjedő időtartamra –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
