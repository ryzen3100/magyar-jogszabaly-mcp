{
  "id": "hu-law-1995-2-30-63",
  "type": "statute",
  "title": "2/1995. (I. 23.) ME határozat főiskolai tanár felmentéséről",
  "status": "amended",
  "in_force_date": "1995-01-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-2-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (3) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Walkó Györgyöt, a Magyar Táncművészeti Főiskola főiskolai tanárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— nyugállományba vonulására tekintettel, 1995. július 31-i hatállyal —"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
