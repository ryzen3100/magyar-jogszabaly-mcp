{
  "id": "hu-law-2004-165-30-76",
  "type": "statute",
  "title": "165/2004. (XII. 8.) KE határozat közigazgatási államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2004-12-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-165-30-76",
  "description": "közigazgatási államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 26. §-a alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kondorosi Ferencet"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "az Igazságügyi Minisztérium közigazgatási államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2004. december 2-i hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-1/4653/2004. 1 A 129/2006. (VI. 21.) KE határozat alapján az Igazságügyi Minisztérium elnevezés alatt az Igazságügyi és Rendészeti Minisztériumot kell érteni."
    }
  ]
}
