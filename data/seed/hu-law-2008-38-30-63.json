  "description": "szakállamtitkár megbízatásának megszűnéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 60. § (1) bekezdése alapján, a nemzeti fejlesztési és gazdasági miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Mészárosné Peredy Gabriellát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Nemzeti Fejlesztési és Gazdasági Minisztérium szakállamtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2008. május 31-i hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
