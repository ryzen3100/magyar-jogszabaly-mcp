{
  "id": "hu-law-2018-1366-30-22",
  "type": "statute",
  "title": "1366/2018. (VIII. 7.) Korm. határozat „Életmentő Emlékérem” adományozásáról",
  "status": "in_force",
  "in_force_date": "2018-08-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/2018-1366-30-22",
  "description": "„Életmentő Emlékérem” adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány az „Életmentő Emlékérem” adományozásáról szóló 243/2009. (X. 29.) Korm. rendelet alapján, életmentés közben tanúsított hősies magatartása elismeréseként – a belügyminiszter mint helyi önkormányzatokért felelős miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "BANDICS LÁSZLÓ sonkádi lakosnak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "GÁL KRISZTIÁN biharnagybajomi lakosnak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "LOVÁSZ IMRE kőteleki lakosnak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "RÉZMŰVES RÓBERT püspökladányi lakosnak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "TAMÁS LÁSZLÓ hartai lakosnak"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "„Életmentő Emlékérmet” adományoz."
    }
  ]
}
