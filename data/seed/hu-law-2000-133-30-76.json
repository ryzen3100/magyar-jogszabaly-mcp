{
  "id": "hu-law-2000-133-30-76",
  "type": "statute",
  "title": "133/2000. (IX. 27.) KE határozat közigazgatási államtitkár felmentéséről és kinevezéséről",
  "status": "amended",
  "in_force_date": "2000-09-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-133-30-76",
  "description": "közigazgatási államtitkár felmentéséről és kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 26. §-a és 29. §-ának (1) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Herman Jánost, a Külügyminisztérium közigazgatási államtitkárát, e tisztségéből – közszolgálati jogviszonya érintetlenül hagyása mellett –"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2000. augusztus 31-i hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem, egyidejűleg"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Bába Ivánt a Külügyminisztérium közigazgatási államtitkárává"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "2000. szeptember 1-jei hatállyal"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Budapest, 2000. szeptember 26."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Mádl Ferenc s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
