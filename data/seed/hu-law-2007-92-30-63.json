{
  "id": "hu-law-2007-92-30-63",
  "type": "statute",
  "title": "92/2007. (XII. 28.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2007-12-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2007-92-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) pontjában foglalt jogkörömben – az oktatási és kulturális miniszternek a fenntartóval egyetértésben tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Budapesti Gazdasági Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Sándorné dr. Kriszt Éva főiskolai tanárt – a 2008. január 1-jétől 2011. június 30-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Károly Róbert Főiskolán"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Magda Sándor egyetemi tanárt – további, a 2008. január 1-jétől 2012. december 31-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
