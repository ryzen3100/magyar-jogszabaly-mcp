  "title": "20/2008. (IV. 23.) ME határozat szakállamtitkár megbízatásának megszűnéséről",
  "status": "in_force",
  "in_force_date": "2008-04-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-20-30-63",
  "description": "szakállamtitkár megbízatásának megszűnéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 60. § (1) bekezdése alapján, a honvédelmi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Wapplerné dr. Balogh Ágnest,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Honvédelmi Minisztérium szakállamtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2008. április 30-ai hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
