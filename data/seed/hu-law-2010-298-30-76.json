{
  "id": "hu-law-2010-298-30-76",
  "type": "statute",
  "title": "298/2010. (XII. 11.) KE határozat egyetemi tanári kinevezésről",
  "status": "in_force",
  "in_force_date": "2010-12-11",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-298-30-76",
  "description": "egyetemi tanári kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának b) pontja alapján, a nemzeti erőforrás miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Fülöp Mihályt, a Debreceni Egyetem egyetemi docensét,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Paulovics Anitát, a Miskolci Egyetem egyetemi docensét és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Tóthné dr. Szita Klárát, a Miskolci Egyetem egyetemi docensét"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2010. december 15. napjával kinevezem egyetemi tanárrá."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: IV-3/05000/2010."
    }
  ]
}
