{
  "id": "hu-law-1999-22-30-63",
  "type": "statute",
  "title": "22/1999. (VII. 15.) ME határozat főiskolai főigazgató megbízásáról",
  "status": "in_force",
  "in_force_date": "1999-07-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/1999-22-30-63",
  "description": "főiskolai főigazgató megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 73. § b) pontja alapján, az oktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Roóz József főiskolai tanárt, a Pénzügyi és Számviteli Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a főigazgatói teendők ellátásával"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "az 1999. július 1-jétől 1999. december 31-ig terjedő időtartamra"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "A miniszterelnök helyett:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Pokorni Zoltán s. k., oktatási miniszter"
    }
  ]
}
