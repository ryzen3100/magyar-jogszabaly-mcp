{
  "id": "hu-law-2014-92-30-63",
  "type": "statute",
  "title": "92/2014. (VII. 22.) ME határozat helyettes államtitkárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2014-07-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2014-92-30-63",
  "description": "helyettes államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 220. § (2) bekezdésében foglalt jogkörömben eljárva, az illetékes miniszterek javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Cseri Miklóst"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "az Emberi Erőforrások Minisztériuma helyettes államtitkárává,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Czombos Tamást és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Márkusfalvi-Tóth Ádámot"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "az Igazságügyi Minisztérium helyettes államtitkárává, valamint"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Hevesi Zoltán Ajtonyt"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a Nemzeti Fejlesztési Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "– 2014. július 15-ei hatállyal –"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "kinevezem. 1 A 65/2023. (VII. 31.) ME határozat alapján dr. Czombos Tamás tekintetében akként módosul, hogy az „Igazságügyi Minisztérium” megnevezés helyett az „Európai Uniós Ügyek Minisztériuma” megnevezést kell érteni."
    }
  ]
}
