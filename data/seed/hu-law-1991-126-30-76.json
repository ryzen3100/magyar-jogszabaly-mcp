  "title": "A Köztársaság Elnökének 126/1991. (VII. 12.) KE határozata egyetemi tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1991-07-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/1991-126-30-76",
  "description": "egyetemi tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A földművelésügyi miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Kertészeti és Élelmiszeripari Egyetemről"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Dimény Imre egyetmi tanárt — nyugállományba vonulására tekintettel — 1991. november 30.,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Székely Tamás másodállású egyetemi tanárt — oktatói munkájának lemondása miatt — 1991. június 30.,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Pannon Agrártudományi Egyetemről"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Kovács Ferenc egyetemi tanárt 1991. november 30.,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Végh György egyetemi tanárt 1991. december 31."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "napjának hatályával e tisztsége alól felmentem."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Egyidejűleg dr. Székely Tamás részére az egyetemi tanári cím viselését engedélyezem."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Dr. Gergátz Elemér s. k., földművelésügyi miniszter"
    }
  ]
