{
  "id": "hu-law-2001-133-40-00",
  "type": "statute",
  "title": "2001. MK 133. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "2001-11-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/2001-133-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 2001. évi 113. számában kihirdetett, a közgyógyellátásra jogosultak részére térítésmentesen rendelhető gyógyszerekről szóló 10/1995. (II. 24.) NM rendelet módosításáról szóló 35/2001. (X. 17.) EüM rendelet melléklete helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "..."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,Apo-Fluoxetin 20 mg kapszula 20 x (1)''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": ",,Fefluzin kapszula 14 x (1)''"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,Floxet 20 mg kapszula 28 x (1)''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": ",,Frontin 0,25 mg tabl. 100 x (1)''"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": ",,Frontin 0,5 mg tabl. 100 x (1)''"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": ",,Huma-Fluoxetin 20 mg kapszula 28 x (1)''"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,Spitomin 10 mg tabl. 60 x (1)''"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": ",,Spitomin 5 mg tabl. 60 x (1)''"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "A rendelet mellékletéből kimaradt:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": ",,Otosporin fülcsepp 10 ml''"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "(Kézirathiba)"
    }
  ]
}
