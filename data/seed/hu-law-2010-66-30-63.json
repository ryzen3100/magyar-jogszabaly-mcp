{
  "id": "hu-law-2010-66-30-63",
  "type": "statute",
  "title": "66/2010. (VIII. 4.) ME határozat helyettes államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2010-08-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-66-30-63",
  "description": "helyettes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormánytisztviselők jogállásáról szóló 2010. évi LVIII. törvény 47. § (1) bekezdése alapján, a nemzeti fejlesztési miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kovács Tamás Ivánt"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Nemzeti Fejlesztési Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2010. augusztus 1-jei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    }
  ]
}
