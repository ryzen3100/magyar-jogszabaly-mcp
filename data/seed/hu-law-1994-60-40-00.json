{
  "id": "hu-law-1994-60-40-00",
  "type": "statute",
  "title": "1994. MK 60. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1994-06-03",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-60-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1994. évi 54. számának I. kötetében az egyes kormányhatározatok hatályon kívül helyezéséről, illetve módosításáról szóló 1038/1994. (V. 19.) Korm. határozatban több határozat száma pontatlanul került megjelölésre."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "A határozatok helyes megjelölései:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— a 2. pont második bekezdésében:,,1031/1992. (V. 29.)'';"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— a 2. pont harmadik bekezdésében:,,1065/1992. (XII. 2.)'';"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "— a 2. pont negyedik bekezdésében:,,1025/1993. (IV. 2.)'';"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "— a 2. pont tizedik bekezdésében:,,2012/1993. (HT. 9.)'';"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "— a Melléklet harmadik bekezdésében:,,1026/1992. (V. 12.)'';"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "— a Melléklet ötödik bekezdésében:,,2038/1993. (IX. 29.)''."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Kézirathiba)"
    }
  ]
}
