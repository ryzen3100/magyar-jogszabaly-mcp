  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A jogalkotásról szóló 2010. évi CXXX. törvény 23. § (4) bekezdés c) pontjában, a Rendőrségről szóló 1994. évi XXXIV. törvény 6. § (1) bekezdés b) pontjában foglaltak alapján a rendőrségi épületekbe történő be- és kiléptetés szabályairól szóló ORFK utasítások módosítására kiadom a következő utasítást:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
