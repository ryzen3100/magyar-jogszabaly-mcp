{
  "id": "hu-law-2000-19-30-63",
  "type": "statute",
  "title": "19/2000. (V. 9.) ME határozat főiskolai tanári tisztség alóli felmentésről",
  "status": "amended",
  "in_force_date": "2000-05-09",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-19-30-63",
  "description": "főiskolai tanári tisztség alóli felmentésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A honvédelmi miniszter – az oktatási miniszter egyetértésével – előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Zrínyi Miklós Nemzetvédelmi Egyetem Bolyai János Katonai Műszaki Főiskolai Karán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Nagy Lajos főiskolai tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2000. május 15. napjával"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– közös megegyezéssel – e tisztség alól felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
