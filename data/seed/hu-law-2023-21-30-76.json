    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Cserepes Cintiát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Nagy-Lukácsi Juditot és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Opor-Nagy Máriát"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a 2023. február 1. napjától 2026. január 31. napjáig terjedő időtartamra bíróvá kinevezem."
    },
    {
      "provision_ref": "s6",
