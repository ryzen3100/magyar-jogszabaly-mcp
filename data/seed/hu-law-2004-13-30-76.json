{
  "id": "hu-law-2004-13-30-76",
  "type": "statute",
  "title": "13/2004. (II. 16.) KE határozat címzetes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2004-02-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-13-30-76",
  "description": "címzetes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 31/A. § (2) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Draskovics Tibort, a Miniszterelnöki Hivatal címzetes államtitkárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "e tisztségéből – más fontos megbízatása miatt –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2004. február 15-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-1/0525-0/2004."
    }
  ]
}
