{
  "id": "hu-law-1994-22-40-00",
  "type": "statute",
  "title": "1994. MK 22. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1994-02-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-22-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1993. évi 192. számában a részben vagy teljesen tartósan állami tulajdonban maradó gazdálkodó szervezetekről szóló 126/1992. (VIII. 28.) Korm. rendelet módosításáról szóló 185/1993. (XII. 31.) Korm. rendelet mellékleteiben a Magyar Közlöny 1994. évi 3. számában már közölt helyesbítésen túlmenően még a következő javítások szükségesek:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "— az 1. számú mellékletben a Termelő ipari szektorból alcím nyolcadik sorában a cég neve helyesen:,,Tiszai Vegyi Kombinát Rt.'';"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— ugyanott a tizenegyedik sorban a cég neve helyesen: Nitrokémia Vegyipari Rt.'';"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— a Gyógyszergyárak alcím alatti szöveg helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "A B C D"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": ",,Gyógyszergyárak"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "CHINOIN Rt."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "B: 25%+1 szavazat"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "RICHTER GEDEON Rt."
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "B: 50%+1 szavazat"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "BIOGAL Rt."
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "B: 25%+1 szavazat"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "EGIS Gyógyszergyár Rt."
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "B: 25%+1 szavazat"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "ALKALOIDA Vegyészeti Gyár Rt."
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "B: 25%+1 szavazat"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "ELZETT-Certa Vállalat"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "B: 5%''"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "— az Állami Gazdaságok alcím utolsó sorában szereplő Balatonfelvidéki Erdő- és Fafeldolgozó Rt. állami üzletrészének aránya (B/oszlop) helyesen:,,25%+1 szavazat'';"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "— a Kutató-fejlesztő szervezetek első sorában szereplő ERŐTERV Erőmű és Hálózattervező V. Rt. állami üzletrészének aránya (B/oszlop):,,50%+1 szavazat'';"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "— a 2. számú mellékletben a népjóléti miniszter alcím alatti szöveg helyesen:"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "A B C D"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": ",,Munkaterápiás Intézet, Pomáz"
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": "B: 100%''"
    },
    {
      "provision_ref": "s25",
      "section": "25",
      "title": "25",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s26",
      "section": "26",
      "title": "26",
      "content": "A Magyar Közlöny 1994. évi 17. számában megjelent, a hajózással kapcsolatos egyes jogszabályok módosításáról szóló 8/1994. (II. 11.) KHVM rendelet 8. §-a (1) bekezdésének harmadik francia bekezdése helyesen:"
    },
    {
      "provision_ref": "s27",
      "section": "27",
      "title": "27",
      "content": ",,(…hatályát veszti:)"
    },
    {
      "provision_ref": "s28",
      "section": "28",
      "title": "28",
      "content": "— a hajózásról szóló 1973. évi 6. tvr. végrehajtásáról rendelkező 5/1974. (V. 21.) KPM rendelet módosításáról szóló 17/1992. (VII. 10.) KHVM rendelet 1., 2., 3. és 5. §-ai,''"
    },
    {
      "provision_ref": "s29",
      "section": "29",
      "title": "29",
      "content": "(Kézirathiba)"
    }
  ]
}
