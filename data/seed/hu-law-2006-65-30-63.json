  "title": "65/2006. (X. 30.) ME határozat szakállamtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2006-10-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-65-30-63",
  "description": "szakállamtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 58. § c) pontja alapján"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Tátrai Miklóst,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Környezetvédelmi és Vízügyi Minisztérium szakállamtitkárát e tisztségéből – más fontos megbízatása miatt, 2006. október 31-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
