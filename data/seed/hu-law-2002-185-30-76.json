      "section": "2",
      "title": "2",
      "content": "Őri Istvánt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Környezetvédelmi és Vízügyi Minisztérium közigazgatási államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2002. november 23-i hatállyal –"
    },
    {
      "provision_ref": "s5",
