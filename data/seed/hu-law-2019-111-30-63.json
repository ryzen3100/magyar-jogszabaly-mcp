{
  "id": "hu-law-2019-111-30-63",
  "type": "statute",
  "title": "111/2019. (X. 1.) ME határozat állami felsőoktatási intézmény kancellárjának megbízásáról",
  "status": "in_force",
  "in_force_date": "2019-10-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/2019-111-30-63",
  "description": "állami felsőoktatási intézmény kancellárjának megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (4a) bekezdésében foglalt jogkörömben eljárva – az innovációért és technológiáért felelős miniszter előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Neumann János Egyetemen Finta Zitát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2019. október 1-jétől 2020. szeptember 30-áig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a kancellári teendők ellátásával megbízom."
    }
  ]
}
