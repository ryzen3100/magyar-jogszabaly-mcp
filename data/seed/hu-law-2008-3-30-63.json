{
  "id": "hu-law-2008-3-30-63",
  "type": "statute",
  "title": "3/2008. (I. 26.) ME határozat szakállamtitkár megbízatásának megszűnéséről",
  "status": "in_force",
  "in_force_date": "2008-01-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-3-30-63",
  "description": "szakállamtitkár megbízatásának megszűnéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 58. § c) pontja alapján, a földművelésügyi és vidékfejlesztési miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Ficsor Ádámot,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Földművelésügyi és Vidékfejlesztési Minisztérium szakállamtitkárát e tisztségéből, más fontos megbízatása miatt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2008. január 31-i hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
