{
  "id": "hu-law-2002-141-30-76",
  "type": "statute",
  "title": "141/2002. (IX. 13.) KE határozat egyetemi tanári tisztség alóli felmentésekről",
  "status": "in_force",
  "in_force_date": "2002-09-13",
  "url": "https://njt.jog.gov.hu/jogszabaly/2002-141-30-76",
  "description": "egyetemi tanári tisztség alóli felmentésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Semmelweis Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Arnold Csaba egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2002. szeptember hó 30. napjával és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Riesz Tamás egyetemi tanárt"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "2002. október 31. napjával"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– közalkalmazotti jogviszony lemondással történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "e tisztség alól felmentem."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "KEH ügyszám: V-2/3298/2002."
    }
  ]
}
