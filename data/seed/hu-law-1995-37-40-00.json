  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1995. évi 22. számában megjelent FKGP 1994. évi beszámolója helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": ",,Összes bevétel a gazdasági évben: 164 778 610''"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "A Magyar Közlöny 1995. évi 32. számában kihirdetett 11/1995. (IV. 27.) IKM rendelet 7. § (5) bekezdésében az R. 1. számú mellékletének 3. pontjában négy termék ITJ-száma hibás. Helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "52—21—11—1 Benzol"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "52—21—11—2 Toluol"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "52—21—11—4 Xilolok"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "52—21—11—9 Aromatol"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "A Magyar Közlöny 1995. évi 35. számában kihirdetett, a Kereskedelmi Vámtarifa módosításáról szóló 13/1995. (V. 5.) IKM—PM együttes rendelet mellékletének 3. sorában a vámtarifaszám helyesen: 3808.30—996."
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "(Nyomdahiba)"
    }
  ]
}
