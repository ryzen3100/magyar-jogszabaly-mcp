{
  "id": "hu-law-1991-7-30-76",
  "type": "statute",
  "title": "A Köztársaság Elnökének 7/1991. (I. 18.) KE határozata a népi ülnökök választásának kitűzéséről",
  "status": "amended",
  "in_force_date": "1991-01-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/1991-7-30-76",
  "description": "a népi ülnökök választásának kitűzéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az igazságügyminiszter előterjesztése:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. A bíróságokról szóló 1972. évi IV. törvény 75. §-ának (1) bekezdése alapján elrendelem, hogy a helyi (városi, kerületi) bíróságok, a Fővárosi Bíróság, a megyei bíróságok, a munkaügyi bíróságok és a katonai bíróságok népi ülnökeit 1991. február 26. napja és március 17. napja között kell megválasztani."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2. Ez a határozat a kihirdetése napján lép hatályba."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Göncz Árpád s. k.,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a Köztársaság elnöke"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Dr. Balsai István s. k.,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "igazságügyminiszter"
    }
  ]
}
