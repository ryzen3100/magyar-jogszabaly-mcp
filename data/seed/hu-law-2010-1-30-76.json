  "title": "1/2010. (I. 8.) KE határozat bírák felmentéséről és bírák kinevezéséről",
  "status": "in_force",
  "in_force_date": "2010-01-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-1-30-76",
  "description": "bírák felmentéséről és bírák kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 48. § (2) bekezdése, valamint a bíróságok szervezetéről és igazgatásáról szóló 1997. évi LXVI. törvény 4. § (1) bekezdése alapján, az Országos Igazságszolgáltatási Tanács előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "lemondására tekintettel"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Reiszné dr. Váradi Juditot 2010. február 28-ai hatállyal,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Balogh Krisztina Beátát 2010. március 31-ei hatállyal,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "nyugállományba helyezés iránti kérelmére"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Kovács Árpádnét 2010. június 30-ai hatállyal,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a felső korhatár elérése miatt"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Nagy Máriát 2010. október 24-ei hatállyal bírói tisztségéből felmentem;"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "dr. Ignácz Györgyöt és"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "dr. Pálmai Zsófiát a 2010. január 1. napjától 2012. december 31. napjáig terjedő időtartamra bíróvá kinevezem."
    },
    {
      "provision_ref": "s11",
      "section": "11",
