{
  "id": "hu-law-2003-88-30-76",
  "type": "statute",
  "title": "88/2003. (V. 15.) KE határozat egyetemi tanári kinevezés alóli felmentésekről",
  "status": "in_force",
  "in_force_date": "2003-05-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-88-30-76",
  "description": "egyetemi tanári kinevezés alóli felmentésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Miskolci Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Gáspárdy László egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– saját kérésére, közalkalmazotti jogviszonya közös megegyezéssel történő megszüntetésére tekintettel –,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Kilián István egyetemi tanárt és"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Mihalik István egyetemi tanárt"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "2003. június 30. napjával,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "a Veszprémi Egyetemen"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "dr. Tarnay Katalin egyetemi tanárt"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "– 70. életéve betöltésére tekintettel –"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "2003. május 8. napjával"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "kinevezése alól felmentem."
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "KEH ügyszám: V-2/1769/2003."
    }
  ]
}
