{
  "id": "hu-law-1994-62-40-00",
  "type": "statute",
  "title": "1994 MK 62. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1994-06-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/1994-62-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1994. évi 58. számában a közutak igazgatásáról szóló 19/1994. (V. 31.) KHVM rendelet"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "— 5. §-ának első sora helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,5. § Azt, aki a közutat, annak műtárgyát vagy tartozékát …''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "— 6. §-a (5) bekezdésének első mondata helyesen:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": ",,(5) Ha a közutat hozzájárulás nélkül, vagy a hozzájárulásban foglaltaktól eltérően vették igénybe, a közút kezelőjének kérelmére a közlekedési hatóság az igénybe vevőt az eredeti állapot helyreállítására és pótdíj megfizetésére kötelezheti.''"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "— a rendelet 1. sz. lábjegyzetében feltüntetett rendeletszám helyesen:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,20/1984. (XII. 21.) KM r. 6. §-ának (1) bekezdése.''"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "(Kézirathiba)"
    }
  ]
}
