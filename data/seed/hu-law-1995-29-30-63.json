{
  "id": "hu-law-1995-29-30-63",
  "type": "statute",
  "title": "29/1995. (VIII. 31.) ME határozat főiskolai főigazgatói megbízásról",
  "status": "amended",
  "in_force_date": "1995-08-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-29-30-63",
  "description": "főiskolai főigazgatói megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 56. §-ának (2) és (5) bekezdése alapján, a művelődési és közoktatási miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Szabó András főiskolai tanárt a Gépipari és Automatizálási Műszaki Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a főigazgatói teendők ellátásával"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "1995. szeptember 1-jei hatállyal — háromévi időtartamra —"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
