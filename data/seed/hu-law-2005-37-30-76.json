{
  "id": "hu-law-2005-37-30-76",
  "type": "statute",
  "title": "37/2005. (III. 22.) KE határozat egyetemi tanári kinevezésről és egyidejűleg rektori megbízásról",
  "status": "in_force",
  "in_force_date": "2005-03-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-37-30-76",
  "description": "egyetemi tanári kinevezésről és egyidejűleg rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszternek – a fenntartóval egyetértésben tett – előterjesztésére, a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Közép-európai Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Elkana Yehuda mb. elnök-rektort"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– határozott időre – 2005. március 16-tól 2007. július 31-ig terjedő időtartamra"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "egyetemi tanárrá kinevezem,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "és egyidejűleg"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "KEH ügyszám: V-2/0982/2005."
    }
  ]
}
