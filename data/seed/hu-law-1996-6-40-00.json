      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1995. évi 111. számában közzétett, a Kereskedelmi Vámtarifa 1996. évi alkalmazásáról szóló 67/1995. (XII. 20.) IKM—PM együttes rendelet helyesbítése a következő:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. számú mellékletben:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "— a 6442. oldalon:"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a 4105 90 00 01 vámtarifaszám Nyers sertésbőr kikészített bőr gyártásához helyesen:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": ",,4103 90 00 01''"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "— a 6446. oldalon:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "az ex 8538 10 10 vámtarifaszám Telefonkészülék gyártásához helyesen:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": ",,8538 10 00''"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "(Kézirathiba)"
    }
  ]
}
