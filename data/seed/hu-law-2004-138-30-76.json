  "title": "138/2004. (X. 25.) KE határozat rektori megbízásról",
  "status": "in_force",
  "in_force_date": "2004-10-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-138-30-76",
  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási miniszter előterjesztésére – a felsőoktatásról szóló 1993. évi LXXX. törvényben foglalt jogkörömben –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Liszt Ferenc Zeneművészeti Egyetemen,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Batta András egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2004. november 1. napjától 2008. október 31. napjáig terjedő időtartamra,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-2/3882/2004."
    }
  ]
}
