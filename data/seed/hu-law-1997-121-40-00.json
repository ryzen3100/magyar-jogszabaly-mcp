    {
      "provision_ref": "s84",
      "section": "84",
      "title": "84",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s85",
      "section": "85",
      "title": "85",
      "content": "A Magyar Közlöny 1997. évi 117. számában megjelent, a Magyar Nemzeti Bank éves beszámoló készítési és könyvvezetési kötelezettségének sajátosságairól szóló 18/1997. (II. 4.) Korm. rendelet módosításáról szóló 258/1997. (XII. 21.) Korm. rendelet 1. számú mellékletének,,III. BANKÜZEMI ESZKÖZÖK CÉLTARTALÉKA'' sora helyesen:"
    },
    {
      "provision_ref": "s86",
      "section": "86",
      "title": "86",
      "content": ",,III. BANKÜZEMI ESZKÖZÖK"
    },
    {
      "provision_ref": "s87",
      "section": "87",
      "title": "87",
      "content": "A) ESZKÖZÖK ÖSSZESEN"
    },
    {
      "provision_ref": "s88",
      "section": "88",
      "title": "88",
      "content": "1. Befektetett eszközök"
    },
    {
      "provision_ref": "s89",
      "section": "89",
      "title": "89",
      "content": "2. Értékhelyesbítés"
    },
    {
      "provision_ref": "s90",
      "section": "90",
      "title": "90",
      "content": "3. Pénzeszközök"
    },
    {
      "provision_ref": "s91",
      "section": "91",
      "title": "91",
      "content": "4. Egyéb eszközök"
    },
    {
      "provision_ref": "s92",
      "section": "92",
      "title": "92",
      "content": "B) BANKÜZEMI ESZKÖZÖK CÉLTARTALÉKA''"
    },
    {
      "provision_ref": "s93",
      "section": "93",
      "title": "93",
      "content": "(Kézirathiba)"
    },
    {
      "provision_ref": "s94",
      "section": "94",
      "title": "94",
      "content": "A Magyar Közlöny 1997. évi 117. számában megjelent, a befektetési vállalkozások éves beszámoló készítési és könyvvezetési kötelezettségének sajátosságairól szóló 197/1996. (XII. 22.) Korm. rendelet módosításáról szóló 259/1997. (XII. 21.) Korm. rendelet 3. §-ának (1) bekezdése helyesen a következő:"
    },
    {
      "provision_ref": "s95",
      "section": "95",
      "title": "95",
      "content": ",,3. § (1) A Rendelet 5. §-ának (1) bekezdése helyébe a következő rendelkezés lép:"
    },
    {
      "provision_ref": "s96",
      "section": "96",
      "title": "96",
      "content": ",,(1) Jegyzett tőkeként kell kimutatni a Tv. 26. §-ának (3) bekezdése szerinti tőke összegét. A jegyzett tőke a külföldi székhelyű vállalkozás magyarországi fióktelepeként működő befektetési vállalkozás esetében az Épt. 9. §-ának (6) bekezdése szerinti — kizárólag pénzben rendelkezésre bocsátott — dotációs tőkét foglalja magában. Azon befektetési vállalkozásnak, amely nem külföldi székhelyű vállalkozás fióktelepe, a jegyzett tőkén belül az analitikus könyvviteli nyilvántartásokban elkülönítetten kell kimutatni az olyan tag tulajdoni részesedését, amelynek más befektetési vállalkozásban, illetve befektetési szolgáltatóban is van részesedése.'' ''"
    },
    {
      "provision_ref": "s97",
      "section": "97",
      "title": "97",
      "content": "(Kézirathiba)"
    }
  ]
}
