{
  "id": "hu-law-2025-1033-30-22",
  "type": "statute",
  "title": "1033/2025. (II. 25.) Korm. határozat „Életmentő Emlékérem” adományozásáról",
  "status": "in_force",
  "in_force_date": "2025-02-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/2025-1033-30-22",
  "description": "„Életmentő Emlékérem” adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány az „Életmentő Emlékérem” adományozásáról szóló 243/2009. (X. 29.) Korm. rendelet alapján, életmentés közben tanúsított hősies magatartása elismeréseként – a közigazgatási és területfejlesztési miniszter mint helyi önkormányzatokért felelős miniszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Lakatos Ádám tiszasülyi lakosnak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Dandás Zoltán Zsolt tiszasülyi lakosnak,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Antal Zoltán szegedi lakosnak,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Ásós Benjámin szegedi lakosnak,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Jászai Csaba nyíregyházi lakosnak,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Kovács József nyíregyházi lakosnak,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Mátai Nóra alsónémedi lakosnak és"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Dóczy Imre dányi lakosnak"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "„Életmentő Emlékérmet” adományoz."
    }
  ]
}
