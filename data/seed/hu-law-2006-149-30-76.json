{
  "id": "hu-law-2006-149-30-76",
  "type": "statute",
  "title": "149/2006. (IX. 11.) KE határozat kitüntetések adományozásáról",
  "status": "in_force",
  "in_force_date": "2006-09-11",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-149-30-76",
  "description": "kitüntetések adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdésének j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "NAGYKERESZTJE A LÁNCCAL (polgári tagozata)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kitüntetést adományozom"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Valdas Adamkus-nak, a Litván Köztársaság elnökének, a Litván Köztársaság és a Magyar Köztársaság közötti kapcsolatok szélesítése és elmélyítése érdekében végzett fáradhatatlan tevékenysége elismeréseként;"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "KÖZÉPKERESZT A CSILLAGGAL (polgári tagozata)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "kitüntetést adományozom"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Arūnas Kundrotas környezetvédelmi miniszternek,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Egidijus Kūris-nak, az Alkotmánybíróság elnökének,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Darius Semaška-nak, a Litván Köztársaság budapesti nagykövetének,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "Petras Vaitiekūnas külügyminiszternek;"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "a MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "KÖZÉPKERESZTJE (polgári tagozata)"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "kitüntetést adományozom"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "Valteris Baliukonis-nak, a köztársasági elnök külpolitikai tanácsadójának,"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "Albinas Januška külügyminiszter-helyettesnek,"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "Justinas Karosas-nak, a Parlament Külügyi Bizottsága elnökének;"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "a MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "TISZTIKERESZTJE (polgári tagozata)"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "kitüntetést adományozom"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "Darius Gaidys-nak, a Külügyminisztérium Állami és Diplomáciai Protokoll Főosztály helyettes vezetőjének,"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "Rita Grumadaitè elnöki szóvivőnek,"
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": "Raimundas Lopata-nak, a Vilniusi Egyetem Nemzetközi Kapcsolatok Politikatudományi Intézete igazgatójának;"
    },
    {
      "provision_ref": "s25",
      "section": "25",
      "title": "25",
      "content": "a MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s26",
      "section": "26",
      "title": "26",
      "content": "LOVAGKERESZTJE (polgári tagozata)"
    },
    {
      "provision_ref": "s27",
