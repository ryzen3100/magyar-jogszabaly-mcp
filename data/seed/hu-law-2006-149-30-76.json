      "content": "Paulius Normantas fényképésznek,"
    },
    {
      "provision_ref": "s29",
      "section": "29",
      "title": "29",
      "content": "Sigitas Povilaitis-nak, a Magyarországi Litvánok Közössége volt elnökének,"
    },
    {
      "provision_ref": "s30",
      "section": "30",
      "title": "30",
      "content": "Marija Rubaževičienè-nek, a Litvániai Magyarok Báthori István Kulturális Szövetsége elnökének"
    },
    {
      "provision_ref": "s31",
      "section": "31",
