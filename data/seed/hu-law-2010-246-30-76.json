  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a magyar és a kelet-közép európai régió energiaellátásának diverzifikálásában és biztonságának fokozásában, a MOL csoport üzleti modelljének kialakításában végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Hernádi Zsoltnak, a MOL Nyrt. elnök-vezérigazgatójának a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "középkereszt a csillaggal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "polgári tagozata;"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "a jogszabályoknak a széles közvélemény számára szuggesztív, kiváló retorikai képességekkel és bölcsességgel történő megismertetése és közérthetővé tétele, valamit ügyvédi, bírói és közéleti tevékenysége, életútja elismeréseként"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "dr. Erőss Pál ügyvédnek, volt legfelsőbb bírósági bírónak a"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "középkeresztje"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "polgári tagozata;"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "példaértékű életútja elismeréseként"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Bittsánszky Gézának, a Pázmány Péter Katolikus Egyetem Jog- és Államtudományi Kar oktatási és akkreditációs ügyek koordinátorának,"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "a magyar gasztronómia nemzetközi hírnevét öregbítő, határainkon túl is nagyra becsült munkássága, gazdag publikációs és szakmai-közéleti tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "Lukács István Oscar-díjas mesterszakácsnak a"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "tisztikeresztje"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "polgári tagozata;"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "eredményes gyógyítói és kórházvezetői munkájáért, az egészségmegőrzés, az egészséges életmódra nevelés érdekében végzett sokoldalú tudományos, kutatói és szakmai-közéleti tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "dr. Bedros Jonathán Róbert egészségügyi szakközgazdásznak, a Pest Megyei Flór Ferenc Kórház főigazgató főorvosának,"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "1956 eszméinek ápolásáért, a forradalom és szabadságharc eseményeit bemutató könyveiért, életútja elismeréseként"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "Fakász Tibor nyugalmazott tanárnak,"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "életútja elismeréseként"
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": "Forgó Lászlónak, a Politikai Elítéltek Közössége tagjának,"
    },
    {
      "provision_ref": "s25",
      "section": "25",
      "title": "25",
      "content": "elkötelezett és eredményes gyógyítói és vezetői munkája, az orvos és egészségügyi szakemberképzésben végzett oktató-nevelő, valamint szakmai-közéleti tevékenysége elismeréseként"
    },
    {
