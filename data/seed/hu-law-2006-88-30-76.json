{
  "id": "hu-law-2006-88-30-76",
  "type": "statute",
  "title": "88/2006. (IV. 28.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2006-04-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-88-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján az európai ügyekért felelős tárca nélküli miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a MAGYAR KÖZTÁRSASÁGI ARANY ÉRDEMKERESZT (polgári tagozata)"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "kitüntetést adományozom"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "másfél évtizedes kimagasló újságírói tevékenységéért, az európai közösségi ügyek magas színvonalú, eredményes képviseletéért"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Fóris György újságírónak."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VII-2/1439/2006."
    }
  ]
}
