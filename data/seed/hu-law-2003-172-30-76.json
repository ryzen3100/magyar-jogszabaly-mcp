  "title": "172/2003. (IX. 16.) KE határozat közigazgatási államtitkár kinevezéséről",
  "status": "in_force",
  "in_force_date": "2003-09-16",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-172-30-76",
  "description": "közigazgatási államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 26. §-a alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Pordán Endrét"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "az Egészségügyi Minisztérium közigazgatási államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2003. szeptember 15-i hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-1/3559/2003. 1 A 152/2004. (XI. 2.) KE határozattal megállapított szöveg."
    }
  ]
}
