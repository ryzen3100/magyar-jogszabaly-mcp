{
  "id": "hu-law-1995-24-30-63",
  "type": "statute",
  "title": "24/1995. (VIII. 11.) ME határozat főiskolai tanár felmentéséről",
  "status": "amended",
  "in_force_date": "1995-08-11",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-24-30-63",
  "description": "főiskolai tanár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 18. §-ának (1) bekezdése alapján, a művelődési és közoktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Földy Ferencet a Comenius Tanítóképző Főiskola főiskolai tanárát"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "1996. január 15-i hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— nyugállományba vonulására tekintettel — e tisztségéből"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "A miniszterelnök helyett:"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Dr. Bokros Lajos s. k., pénzügyminiszter"
    }
  ]
}
