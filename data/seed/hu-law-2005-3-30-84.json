{
  "id": "hu-law-2005-3-30-84",
  "type": "statute",
  "title": "3/2005. (VI. 7.) MeHVM határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2005-06-07",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-3-30-84",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 36. §-a alapján, a Miniszterelnöki Hivatal közigazgatási államtitkára javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Varga Pétert, a Miniszterelnöki Hivatal helyettes államtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– közszolgálati jogviszonya érintetlenül hagyása mellett –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2005. május 31-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
