  "title": "17/2003. (II. 12.) ME határozat kormányzati főtisztviselő áthelyezéséről",
  "status": "in_force",
  "in_force_date": "2003-02-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/2003-17-30-63",
  "description": "kormányzati főtisztviselő áthelyezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló – többször módosított – 1992. évi XXIII. törvény 31/C. §-ának (4) bekezdésében foglalt jogkörömben"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Csepregi István kormányzati főtisztviselőt a Környezetvédelmi és Vízügyi Minisztérium Jogi Főcsoportfőnökségére, főosztályvezetői teendők ellátására"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2002. november 19-i hatállyal"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– határozatlan időre –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "áthelyezem."
    }
  ]
}
