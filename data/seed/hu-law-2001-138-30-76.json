{
  "id": "hu-law-2001-138-30-76",
  "type": "statute",
  "title": "138/2001. (X. 17.) KE határozat közigazgatási államtitkári megbízatás megszűnésének megállapításáról",
  "status": "in_force",
  "in_force_date": "2001-10-17",
  "url": "https://njt.jog.gov.hu/jogszabaly/2001-138-30-76",
  "description": "közigazgatási államtitkári megbízatás megszűnésének megállapításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 27. §-ának (2) bekezdésében foglalt jogkörömben megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Skultéty Sándor,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Környezetvédelmi Minisztérium közigazgatási államtitkára megbízatása – halála miatt –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2001. szeptember 26-án"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megszűnt."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Budapest, 2001. október 8."
    }
  ]
}
