{
  "id": "hu-law-2004-53-30-63",
  "type": "statute",
  "title": "53/2004. (VIII. 27.) ME határozat az Esélyegyenlőségi Kormányhivatal elnökének felmentéséről",
  "status": "in_force",
  "in_force_date": "2004-08-27",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-53-30-63",
  "description": "az Esélyegyenlőségi Kormányhivatal elnökének felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Esélyegyenlőségi Kormányhivatalról szóló 222/2003. (XII. 12.) Korm. rendelet 4. §-ának (2) bekezdése alapján, az esélyegyenlőségi tárca nélküli miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Kiss Róbertet, az Esélyegyenlőségi Kormányhivatal elnökét e tisztségéből"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– közszolgálati jogviszonya érintetlenül hagyása mellett –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2004. augusztus 8-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
