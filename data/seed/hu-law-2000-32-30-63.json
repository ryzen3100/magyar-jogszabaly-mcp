{
  "id": "hu-law-2000-32-30-63",
  "type": "statute",
  "title": "32/2000. (XI. 29.) ME határozat főiskolai tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "2000-11-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-32-30-63",
  "description": "főiskolai tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 1993. évi LXXX. törvény 73. §-ának a) pontja alapján, az oktatási miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Nyíregyházi Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Fónai Mihály főiskolai tanárt és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Gáspári László főiskolai tanárt"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– közalkalmazotti jogviszonyuk közös megegyezéssel történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "2000. november 15-i hatállyal"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "e tisztségükből felmentem."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Budapest, 2000. november 15."
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Orbán Viktor s. k., miniszterelnök"
    }
  ]
}
