    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A külügyminiszter előterjesztésére a Magyar Köztársaság felveszi a nagyköveti szintű diplomáciai kapcsolatokat:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. Antigua és Barbudával,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2. a Bahamai Közösséggel,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "3. Belize-zel,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "4. a Dominikai Közösséggel,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "5. Haitivel,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "6. Saint Kitts és Nevis-szel,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "7. Saint Luciával és"
    },
    {
      "provision_ref": "s9",
