  "title": "74/2008. (III. 15.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2008-03-15",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-74-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "az olasz–magyar politikai, gazdasági, kereskedelmi és kulturális kapcsolatok fellendítése érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Paolo Guido Spinelli-nek, az Olasz Köztársaság budapesti nagykövetének a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND KÖZÉPKERESZTJE (polgári tagozat)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VIII-1/01318/2008."
    }
  ]
}
