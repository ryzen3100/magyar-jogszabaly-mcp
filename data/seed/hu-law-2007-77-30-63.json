      "section": "2",
      "title": "2",
      "content": "dr. Udvardi Ivánt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Külügyminisztérium szakállamtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2007. október 31-i hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
