{
  "id": "hu-law-2006-153-30-76",
  "type": "statute",
  "title": "153/2006. (IX. 14.) KE határozat egyetemi tanári kinevezésről",
  "status": "in_force",
  "in_force_date": "2006-09-14",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-153-30-76",
  "description": "egyetemi tanári kinevezésről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az oktatási és kulturális miniszter előterjesztésére, az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, tekintettel a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának b) pontjára,"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Pannon Egyetemen"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Maros Istvánt, az Imperial College London professzorát 2006. szeptember 1. napjával"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem egyetemi tanárrá."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: V-2/3476/2006."
    }
  ]
}
