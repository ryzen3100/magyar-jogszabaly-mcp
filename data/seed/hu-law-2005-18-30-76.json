    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2005. február 14-i hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s5",
