{
  "id": "hu-law-1996-32-40-00",
  "type": "statute",
  "title": "1996. MK 32. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1996-04-24",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-32-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1996. évi 26. számában kihirdetett, a területfejlesztésről és a területrendezésről szóló 1996. évi XXI. törvény 14. §-a (1) bekezdésének f) pontja helyesen:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "(A megyei területfejlesztési tanács tagjai:)"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "f) a megyei munkaügyi tanács munkaadói és munkavállalói oldalának egy-egy képviselője.''"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "(Kézirathiba)"
    }
  ]
}
