    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a) Békés megyében"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Csorvás,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "b) Borsod-Abaúj-Zemplén megyében"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Pálháza,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "c) Csongrád megyében"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Sándorfalva,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
