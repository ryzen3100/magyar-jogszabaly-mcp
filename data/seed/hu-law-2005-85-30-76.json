      "content": "Martonvásár,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "e) Heves megyében"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Kisköre,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "f) Jász-Nagykun-Szolnok megyében"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "Abádszalók,"
    },
    {
      "provision_ref": "s14",
