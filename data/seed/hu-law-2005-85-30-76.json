    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "Pilis,"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "Üllő,"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": "h) Somogy megyében"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "Kadarkút,"
    },
    {
      "provision_ref": "s21",
      "section": "21",
