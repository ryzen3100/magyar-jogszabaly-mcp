{
  "id": "hu-law-2010-213-30-76",
  "type": "statute",
  "title": "213/2010. (VIII. 4.) KE határozat rektori megbízásról",
  "status": "in_force",
  "in_force_date": "2010-08-04",
  "url": "https://njt.jog.gov.hu/jogszabaly/2010-213-30-76",
  "description": "rektori megbízásról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdés i) pontjában megállapított jogkörömben, a felsőoktatásról szóló 2005. évi CXXXIX. törvény 100. §-ának a) pontja alapján, a nemzeti erőforrás miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Kaposvári Tudományegyetemen,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Szávai Ferenc egyetemi tanárt"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2010. augusztus 1-jétől 2014. június 30-áig terjedő időtartamra"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "megbízom a rektori feladatok ellátásával."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: IV-3/02625/2010."
    }
  ]
}
