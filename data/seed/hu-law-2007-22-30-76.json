      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére, a magyar–kínai kapcsolatok fejlesztése érdekében végzett eredményes tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Zhu Zushou-nak, a Kínai Népköztársaság budapesti nagykövetének a"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND KÖZÉPKERESZTJE (polgári tagozata)"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "KEH ügyszám: VII-2/0391/2007."
    }
  ]
