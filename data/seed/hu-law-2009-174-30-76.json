  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "folyamatosan magas színvonalú sportolói pályafutása elismeréseként, második világbajnoki címe megszerzéséért"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Erdei Zsolt ökölvívónak a"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "MAGYAR KÖZTÁRSASÁGI ÉRDEMREND KÖZÉPKERESZTJE (polgári tagozat)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VIII-1/04834/2009."
    }
  ]
