{
  "id": "hu-law-2011-36-30-63",
  "type": "statute",
  "title": "36/2011. (IV. 22.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2011-04-22",
  "url": "https://njt.jog.gov.hu/jogszabaly/2011-36-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) pontjában foglalt jogkörömben, a nemzeti erőforrás miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Kecskeméti Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Danyi József főiskolai tanárt – a 2011. április 15-től 2015. április 14-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
