  "title": "74/2004. (XI. 9.) ME határozat kormányzati főtisztviselői kinevezések megszűnésének megállapításáról",
  "status": "in_force",
  "in_force_date": "2004-11-09",
  "url": "https://njt.jog.gov.hu/jogszabaly/2004-74-30-63",
  "description": "kormányzati főtisztviselői kinevezések megszűnésének megállapításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A köztisztviselők jogállásáról szóló 1992. évi XXIII. törvény 31/D. §-a (1) bekezdésének a) pontja alapján megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Sebők Attila főtisztviselői kinevezése"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "2005. március 18-i hatállyal,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Krómer István főtisztviselői kinevezése"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2005. március 19-i hatállyal,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Póda Jenő főtisztviselői kinevezése"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "2005. április 3-i hatállyal"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "– közszolgálati jogviszonyuk felmentéssel történő megszüntetésére tekintettel –"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "megszűnik."
    }
  ]
}
