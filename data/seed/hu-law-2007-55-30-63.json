      "content": "az Önkormányzati és Területfejlesztési Minisztérium szakállamtitkárát e tisztségéből"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2007. július 31-i hatállyal"
    },
    {
      "provision_ref": "s5",
