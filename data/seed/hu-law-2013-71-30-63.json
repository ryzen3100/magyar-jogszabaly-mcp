{
  "id": "hu-law-2013-71-30-63",
  "type": "statute",
  "title": "71/2013. (V. 30.) ME határozat helyettes államtitkár felmentéséről",
  "status": "in_force",
  "in_force_date": "2013-05-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2013-71-30-63",
  "description": "helyettes államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 221. § (2) bekezdés c) pontja alapján, a közigazgatási és igazságügyi miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Kátai Ildikót, a Közigazgatási és Igazságügyi Minisztérium helyettes államtitkárát e tisztségéből más fontos megbízatására tekintettel"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2013. május 31-ei hatállyal –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "felmentem."
    }
  ]
}
