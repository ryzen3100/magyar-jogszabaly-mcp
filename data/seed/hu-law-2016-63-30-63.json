      "section": "2",
      "title": "2",
      "content": "a Kecskeméti Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Ailer Piroska főiskolai tanárt,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a Szolnoki Főiskolán"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Túróczi Imre főiskolai tanárt,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "az Eszterházy Károly Főiskolán"
    },
    {
