{
  "id": "hu-law-2025-3-30-76",
  "type": "statute",
  "title": "3/2025. (I. 31.) KE határozat állami kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2025-01-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/2025-3-30-76",
  "description": "állami kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alaptörvény 9. cikk (4) bekezdés f) pontja, illetve a Magyarország címerének és zászlajának használatáról, valamint állami kitüntetéseiről szóló 2011. évi CCII. törvény 17. §-a és 18. § (1) bekezdése alapján – a miniszterelnök előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Oleg Ţulea, a Moldovai Köztársaság magyarországi rendkívüli és meghatalmazott nagykövete részére"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a magyar–moldáv kapcsolatok előmozdítása érdekében végzett tevékenysége elismeréseként"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a MAGYAR ÉRDEMREND"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "parancsnoki keresztje"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "polgári tagozat"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kitüntetést adományozom."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "SP ügyszám: SP/465-3/2025"
    }
  ]
}
