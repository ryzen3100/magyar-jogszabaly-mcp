  "title": "113/2006. (V. 30.) KE határozat kitüntetés adományozásáról",
  "status": "in_force",
  "in_force_date": "2006-05-30",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-113-30-76",
  "description": "kitüntetés adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. § (1) bekezdése j) pontja, valamint a Magyar Köztársaság kitüntetéseiről szóló 1991. évi XXXI. törvény 2. § (1) bekezdése alapján a miniszterelnök előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a MAGYAR KÖZTÁRSASÁGI ÉRDEMREND"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "középkereszt, polgári tagozat"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "kitüntetést adományozom"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "a magyar–amerikai egészségügyi kapcsolatok fejlesztése érdekében végzett tevékenységéért Tommy G. Thompson-nak, az Amerikai Egyesült Államok volt egészségügyi és humán szolgáltatások miniszterének."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: VII-2/2312/2006."
    }
  ]
}
