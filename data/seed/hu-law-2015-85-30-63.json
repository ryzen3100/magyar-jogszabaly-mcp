    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Nagy Krisztinát és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Szatmári Györgyi Katalint"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2015. október 1-jei hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
