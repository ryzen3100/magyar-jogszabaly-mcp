{
  "id": "hu-law-1995-74-40-00",
  "type": "statute",
  "title": "1995. MK 74. szám helyesbítés",
  "status": "in_force",
  "in_force_date": "1995-09-08",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-74-40-00",
  "description": "Helyesbítés",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Helyesbítés: A Magyar Közlöny 1995. évi 50. számában kihirdetett, a gazdasági stabilizációt szolgáló egyes törvénymódosításokról szóló 1995. évi XLVIII. törvény"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "— 3. §-a (10) bekezdése negyedik mondatának szövege helyesen:"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": ",,3. § (10) … Abban az esetben pedig, ha az adó fizetésére kötelezett a személygépkocsi tulajdonjogát…''"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "— 44. §-a d) alpontjának szövege helyesen:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": ",,d) az ingatlan-nyilvántartási eljárást;''"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "— 53. §-a (1) bekezdésének szövege helyesen:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": ",,53. § (1) … ezt követően kezdeményezett első fokú és jogorvoslati…''"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "— 159. §-a (2) bekezdésének szövege helyesen:"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": ",,E törvény 28—52. és 54. §-ai a kihirdetését követő…''"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "A Magyar Közlöny 1995. évi 57. számában kihirdetett, a felsőoktatási intézmények hallgatói részére nyújtható támogatásokról és az általuk fizetendő díjakról és térítésekről szóló 83/1995. (VII. 6.) Korm. rendelet"
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "— 3. § (2) bekezdés c) pontjának második sorában foglalt szövegrész helyesen a következő:"
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": ",,…szolgáltatások és természetbeni juttatások nyújtásának…''"
    },
    {
      "provision_ref": "s17",
      "section": "17",
      "title": "17",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s18",
      "section": "18",
      "title": "18",
      "content": "— 5. § (2) bekezdésének második sorában foglalt szövegrész helyesen a következő:"
    },
    {
      "provision_ref": "s19",
      "section": "19",
      "title": "19",
      "content": ",,…ítéli oda az (1) bekezdés b) és d), h) pontjai alapján…''"
    },
    {
      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "(Nyomdahiba)"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "— 8. § (3) bekezdésének negyedik sorában foglalt szövegrész helyesen a következő:"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": ",,…Szabályzatban határozza meg.''"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "(Kézirathiba)"
    }
  ]
}
