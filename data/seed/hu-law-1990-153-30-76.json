  "title": "153/1990. (VII. 25.) KE határozat egyetemi tanárok felmentéséről",
  "status": "in_force",
  "in_force_date": "1990-07-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-153-30-76",
  "description": "egyetemi tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A művelődési és közoktatási miniszter előterjesztésére – nyugállományba vonulásukra tekintettel –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Inczédy Jánost a Veszprémi Vegyipari Egyetem,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Nemecz Ernőt a Veszprémi Vegyipari Egyetem"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "egyetemi tanárait 1990. december 30-ával,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Káldor Mihályt, a Nehézipari Műszaki Egyetem egyetemi tanárát 1990. december 31-ével"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "e tisztsége alól felmentem."
    }
  ]
}
