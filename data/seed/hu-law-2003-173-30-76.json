  "description": "címzetes államtitkár kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 31/A. §-ának (2) bekezdése alapján, a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Jakab Ferencnét"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "az Egészségügyi Minisztérium címzetes államtitkárává"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2003. szeptember 15-i hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: V-1/3558-1/2003. 1 A 153/2004. (XI. 2.) KE határozattal megállapított szöveg."
    }
  ]
