{
  "id": "hu-law-2013-83-30-63",
  "type": "statute",
  "title": "83/2013. (VI. 18.) ME határozat címzetes főjegyzői cím adományozásáról",
  "status": "in_force",
  "in_force_date": "2013-06-18",
  "url": "https://njt.jog.gov.hu/jogszabaly/2013-83-30-63",
  "description": "címzetes főjegyzői cím adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A közszolgálati tisztviselőkről szóló 2011. évi CXCIX. törvény 253. § (1) bekezdése alapján, a megyei, illetve a fővárosi kormányhivatal javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Csupity Péter Zoltánnak, Kunfehértó község jegyzőjének,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Czakó Sándornak, Rohod község jegyzőjének,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Gerstnerné dr. Kiss Ildikónak, Balatonszárszó nagyközség, Kötcse és Nagycsepely községek jegyzőjének,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Hegyközi Bélának, Bükkszentkereszt-Répáshuta községek körjegyzőjének,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Kanozsainé dr. Pék Máriának, Pápa város jegyzőjének,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "dr. Nyíkos Sárának, Nagykőrös város jegyzőjének,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Rentzné dr. Bezdán Editnek, Jász-Nagykun-Szolnok megye főjegyzőjének,"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Tóth Jánosnénak, Csákvár község jegyzőjének,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Varró Gyulának, Parád község jegyzőjének"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "– 2013. július 1-jei hatállyal, határozatlan időre –"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "címzetes főjegyzői címet adományozok."
    }
  ]
}
