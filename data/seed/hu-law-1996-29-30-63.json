{
  "id": "hu-law-1996-29-30-63",
  "type": "statute",
  "title": "29/1996. (VII. 26.) ME határozat az Országos Statisztikai Tanács tagjainak felmentéséről és az új tagok megbízásáról",
  "status": "in_force",
  "in_force_date": "1996-07-26",
  "url": "https://njt.jog.gov.hu/jogszabaly/1996-29-30-63",
  "description": "az Országos Statisztikai Tanács tagjainak felmentéséről és az új tagok megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A statisztikáról szóló 1993. évi XLVI. törvény 7. §-ának (4) bekezdése alapján – a Központi Statisztikai Hivatal elnöke előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Lendvai Jánost,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Csanádi Ágnest,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Debreceni Jánost,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Andorka Rudolfot,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "dr. Cseh-Szombathy Lászlót"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "az Országos Statisztikai Tanács tagját, e megbízatása alól felmentem;"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "egyben 1996. július 10-től 1999. december 31-ig terjedő időre"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Pukli Pétert, a Központi Statisztikai Hivatal elnökhelyettesét,"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "Dietz Gusztávné dr.-t, az Állami Bankfelügyelet főosztályvezető-helyettesét,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
      "content": "Paszternák Józsefnét, a Magyar Agrárkamara főosztályvezetőjét,"
    },
    {
      "provision_ref": "s12",
      "section": "12",
      "title": "12",
      "content": "dr. Mundruczó Györgyöt, a Budapesti Közgazdaságtudományi Egyetem egyetemi tanárát,"
    },
    {
      "provision_ref": "s13",
      "section": "13",
      "title": "13",
      "content": "dr. Szilágyi Györgyöt, a Központi Statisztikai Hivatal főosztályvezető-helyettesét"
    },
    {
      "provision_ref": "s14",
      "section": "14",
      "title": "14",
      "content": "az Országos Statisztikai Tanács tagjává megbízom."
    },
    {
      "provision_ref": "s15",
      "section": "15",
      "title": "15",
      "content": "Budapest, 1996. július 10."
    },
    {
      "provision_ref": "s16",
      "section": "16",
      "title": "16",
      "content": "Horn Gyula s. k., miniszterelnök"
    }
  ]
}
