{
  "id": "hu-law-2024-127-30-63",
  "type": "statute",
  "title": "127/2024. (XII. 23.) ME határozat helyettes államtitkárok kinevezéséről",
  "status": "in_force",
  "in_force_date": "2024-12-23",
  "url": "https://njt.jog.gov.hu/jogszabaly/2024-127-30-63",
  "description": "helyettes államtitkárok kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 234. § (1) bekezdésében foglalt jogkörömben eljárva, a nemzetgazdasági miniszter javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Csákiné dr. Gyuris Krisztinát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Kisfaludy Tamást és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Lakner Zsuzsát"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2025. január 1-jei hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Nemzetgazdasági Minisztérium helyettes államtitkárává"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "kinevezem."
    }
  ]
}
