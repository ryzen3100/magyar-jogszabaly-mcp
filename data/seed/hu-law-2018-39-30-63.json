      "content": "Kiss-Hegyi Esztert"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– 2018. június 1-jei hatállyal – és"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Korom Renátát"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2018. június 11-ei hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
