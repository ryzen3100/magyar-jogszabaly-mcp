{
  "id": "hu-law-2024-36-30-63",
  "type": "statute",
  "title": "36/2024. (IV. 25.) ME határozat főiskolai rektor megbízásáról",
  "status": "in_force",
  "in_force_date": "2024-04-25",
  "url": "https://njt.jog.gov.hu/jogszabaly/2024-36-30-63",
  "description": "főiskolai rektor megbízásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A nemzeti felsőoktatásról szóló 2011. évi CCIV. törvény 37. § (8) bekezdésében foglalt jogkörömben eljárva – a kultúráért és innovációért felelős miniszternek a fenntartó kezdeményezésére tett előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Rácz Máté Mártont az IBS Nemzetközi Üzleti Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– a 2024. június 1-jétől 2027. május 31-éig terjedő időtartamra –"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "a rektori teendők ellátásával megbízom."
    }
  ]
}
