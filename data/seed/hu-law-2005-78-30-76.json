      "section": "7",
      "title": "7",
      "content": "2005. augusztus 1-jétől 2007. július 31-ig terjedő időtartamra,"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "a Magyar Képzőművészeti Egyetemen"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Kőnig Frigyes egyetemi tanárt"
    },
    {
      "provision_ref": "s10",
      "section": "10",
      "title": "10",
      "content": "2005. július 1-jétől 2009. június 30-ig terjedő időtartamra,"
    },
    {
      "provision_ref": "s11",
      "section": "11",
      "title": "11",
