{
  "id": "hu-law-2006-88-30-63",
  "type": "statute",
  "title": "88/2006. (XII. 28.) ME határozat szakállamtitkár megbízatásának megszűnéséről",
  "status": "in_force",
  "in_force_date": "2006-12-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2006-88-30-63",
  "description": "szakállamtitkár megbízatásának megszűnéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A központi államigazgatási szervekről, valamint a Kormány tagjai és az államtitkárok jogállásáról szóló 2006. évi LVII. törvény 58. §-ának b) pontja alapján megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Haraszthy Lászlónak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Környezetvédelmi és Vízügyi Minisztérium szakállamtitkárának e megbízatása"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2006. december 29-i hatállyal"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– lemondásával – megszűnik."
    }
  ]
}
