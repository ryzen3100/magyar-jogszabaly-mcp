{
  "id": "hu-law-1993-110-30-76",
  "type": "statute",
  "title": "110/1993. (IX. 2.) KE határozat városi cím adományozásáról",
  "status": "in_force",
  "in_force_date": "1993-10-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/1993-110-30-76",
  "description": "városi cím adományozásáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére az alábbi községeknek a városi címet adományozom:"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "1. a Csongrád megyében lévő"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Mindszent,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "2. a Szabolcs-Szatmár-Bereg megyében lévő"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Baktalórántháza."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Ez a határozat 1993. október 1. napján lép hatályba."
    }
  ]
}
