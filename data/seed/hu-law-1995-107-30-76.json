    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s8",
      "section": "8",
