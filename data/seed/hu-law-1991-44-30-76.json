  "title": "A Köztársaság Elnökének 44/1991. (III. 1.) KE határozata közigazgatási államtitkár felmentéséről",
  "status": "amended",
  "in_force_date": "1991-03-01",
  "url": "https://njt.jog.gov.hu/jogszabaly/1991-44-30-76",
  "description": "közigazgatási államtitkár felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 30/A. §-ának (1) bekezdése alapján a miniszterelnök javaslatára dr. Kiss Elemért, a Környezetvédelmi és Területfejlesztési Minisztérium közigazgatási államtitkárát — saját kérésére, érdemei elismerése mellett — e tisztségéből 1991. február 28-ai hatállyal felmentem."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Göncz Árpád s. k.,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Köztársaság elnöke"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Dr. Antall József s. k.,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "miniszterelnök"
    }
  ]
}
