{
  "id": "hu-law-1995-148-30-76",
  "type": "statute",
  "title": "148/1995. (VIII. 31.) KE határozat egyetemi tanárok felmentéséről",
  "status": "amended",
  "in_force_date": "1995-08-31",
  "url": "https://njt.jog.gov.hu/jogszabaly/1995-148-30-76",
  "description": "egyetemi tanárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A művelődési és közoktatási miniszter előterjesztésére a Magyar Képzőművészeti Főiskolán"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Gerzson Pál egyetemi tanárt,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Rozanits Tibor egyetemi tanárt,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Sváby Lajos egyetemi tanárt és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Szinte Gábor egyetemi tanárt"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "— nyugállományba vonulására tekintettel — 1995. augusztus 31. napjával e tisztsége alól felmentem."
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "Göncz Árpád s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s9",
      "section": "9",
      "title": "9",
      "content": "Dr. Fodor Gábor s. k., művelődési és közoktatási miniszter"
    }
  ]
}
