{
  "id": "hu-law-2009-1-30-63",
  "type": "statute",
  "title": "1/2009. (I. 9.) ME határozat főiskolai rektor felmentéséről",
  "status": "in_force",
  "in_force_date": "2009-01-09",
  "url": "https://njt.jog.gov.hu/jogszabaly/2009-1-30-63",
  "description": "főiskolai rektor felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A felsőoktatásról szóló 2005. évi CXXXIX. törvény 101. § (3) bekezdés a) pontjában foglalt jogkörömben, a 2008. évi XCIV. törvény 1. §-ában foglaltakra tekintettel – az oktatási és kulturális miniszter előterjesztésére –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "a Tessedik Sámuel Főiskolán"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Puskás János főiskolai tanárt, a rektori megbízatása alól"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– 2008. december 31-ei hatállyal –"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "felmentem."
    }
  ]
}
