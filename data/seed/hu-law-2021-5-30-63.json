{
  "id": "hu-law-2021-5-30-63",
  "type": "statute",
  "title": "5/2021. (II. 12.) ME határozat helyettes államtitkárok felmentéséről",
  "status": "in_force",
  "in_force_date": "2021-02-12",
  "url": "https://njt.jog.gov.hu/jogszabaly/2021-5-30-63",
  "description": "helyettes államtitkárok felmentéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A kormányzati igazgatásról szóló 2018. évi CXXV. törvény 228. § (2) bekezdés b) pontja alapján – az agrárminiszter javaslatára –"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Belánszky-Demkó Zsoltot – más fontos megbízatására tekintettel – és"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Gyüre Anitát,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "az Agrárminisztérium helyettes államtitkárait e tisztségükből"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2021. február 15-ei hatállyal"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "felmentem."
    }
  ]
}
