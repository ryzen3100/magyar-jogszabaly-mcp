{
  "id": "hu-law-2008-121-30-76",
  "type": "statute",
  "title": "121/2008. (V. 14.) KE határozat miniszterek kinevezéséről",
  "status": "in_force",
  "in_force_date": "2008-05-14",
  "url": "https://njt.jog.gov.hu/jogszabaly/2008-121-30-76",
  "description": "miniszterek kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "Az Alkotmány 33. § (4) bekezdése alapján a miniszterelnök javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Szabó Pált közlekedési, hírközlési és energiaügyi miniszterré,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Bajnai Gordont nemzeti fejlesztési és gazdasági miniszterré,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Gyenesei Istvánt önkormányzati miniszterré"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "2008. május 15-i hatállyal kinevezem."
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "KEH ügyszám: IV-2/02484/2008."
    }
  ]
}
