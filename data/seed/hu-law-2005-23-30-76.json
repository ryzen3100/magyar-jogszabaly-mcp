  "title": "23/2005. (II. 28.) KE határozat a Magyar Nemzeti Bank monetáris tanácsa tagjainak kinevezéséről",
  "status": "in_force",
  "in_force_date": "2005-02-28",
  "url": "https://njt.jog.gov.hu/jogszabaly/2005-23-30-76",
  "description": "a Magyar Nemzeti Bank monetáris tanácsa tagjainak kinevezéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Magyar Nemzeti Bankról szóló 2001. évi LVIII. törvény (a továbbiakban: Tv.) 49. § (4) bekezdés c) pontja alapján, a miniszterelnöknek a Tv. 49. § (11) bekezdése második mondatában foglalt jogkörében tett javaslatára"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Neményi Juditot,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "dr. Bánfi Tamást,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "dr. Bihari Pétert és"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "dr. Csáki Csabát"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "a Magyar Nemzeti Bank monetáris tanácsa tagjává"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– 2005. március 1-jei hatállyal, hatévi időtartamra –"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "kinevezem."
    },
    {
      "provision_ref": "s9",
