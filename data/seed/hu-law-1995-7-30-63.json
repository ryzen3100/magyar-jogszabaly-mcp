    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "— 1995. március 16-i hatállyal, háromévi időtartamra —"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
