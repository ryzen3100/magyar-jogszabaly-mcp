{
  "id": "hu-law-2000-121-30-76",
  "type": "statute",
  "title": "121/2000. (VIII. 17.) KE határozat Ászár községgé nyilvánításáról",
  "status": "amended",
  "in_force_date": "2002-10-20",
  "url": "https://njt.jog.gov.hu/jogszabaly/2000-121-30-76",
  "description": "Ászár községgé nyilvánításáról",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A belügyminiszter előterjesztésére Kisbér város Ászár elnevezésű településrészét – a korábbi egyesítés megszüntetésével – Ászár néven községgé nyilvánítom. Ászár községgé nyilvánítása nem érinti Kisbér városi címét."
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "Ez a határozat a kihirdetését követő önkormányzati általános választás napján lép hatályba."
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "Budapest, 2000. augusztus 14."
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "Mádl Ferenc s. k., a Köztársaság elnöke"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "Ellenjegyzem:"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "Dr. Pintér Sándor s. k., belügyminiszter"
    }
  ]
}
