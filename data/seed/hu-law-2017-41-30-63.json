      "provision_ref": "s20",
      "section": "20",
      "title": "20",
      "content": "Vályiné Koós Ibolyát"
    },
    {
      "provision_ref": "s21",
      "section": "21",
      "title": "21",
      "content": "az Országos Statisztikai Tanács tagsági teendőinek ellátása alól – 2017. április 30-ai hatállyal – felmentem, egyidejűleg"
    },
    {
      "provision_ref": "s22",
      "section": "22",
      "title": "22",
      "content": "Bognár Andreát, a Nemzeti Adó és Vámhivatal főosztályvezetőjét,"
    },
    {
      "provision_ref": "s23",
      "section": "23",
      "title": "23",
      "content": "Bolláné Sütő Hajnalkát, a Külgazdasági és Külügyminisztérium főosztályvezetőjét,"
    },
    {
      "provision_ref": "s24",
      "section": "24",
      "title": "24",
      "content": "Fadgyas-Freyler Petrát, a Nemzeti Egészségbiztosítási Alapkezelő osztályvezetőjét,"
    },
    {
      "provision_ref": "s25",
      "section": "25",
      "title": "25",
      "content": "Gonda Bencét, a Miniszterelnöki Kabinetiroda főosztályvezetőjét,"
    },
    {
      "provision_ref": "s26",
      "section": "26",
      "title": "26",
      "content": "Hodálik Pált, Szarvas város alpolgármesterét,"
    },
    {
      "provision_ref": "s27",
      "section": "27",
      "title": "27",
      "content": "Horn Dánielt, a Magyar Tudományos Akadémia tudományos főmunkatársát,"
    },
    {
      "provision_ref": "s28",
      "section": "28",
      "title": "28",
      "content": "dr. Kincses Áront, a Központi Statisztikai Hivatal elnökhelyettesét,"
    },
    {
      "provision_ref": "s29",
      "section": "29",
      "title": "29",
      "content": "Kiss Katalint, a Belügyminisztérium főosztályvezetőjét,"
    },
    {
      "provision_ref": "s30",
      "section": "30",
      "title": "30",
      "content": "Molnár Györgyöt, a Magyar Tudományos Akadémia tudományos főmunkatársát,"
    },
    {
      "provision_ref": "s31",
      "section": "31",
      "title": "31",
      "content": "dr. Papp Attilát, a Magyar Tudományos Akadémia Társadalomtudományi Kutatóközpont Kisebbségkutató Intézetének igazgatóját,"
    },
    {
      "provision_ref": "s32",
      "section": "32",
      "title": "32",
      "content": "Pósfai Józsefet, Úny község polgármesterét,"
    },
    {
      "provision_ref": "s33",
      "section": "33",
      "title": "33",
      "content": "Sulyok Jánost, a Honvédelmi Minisztérium helyettes államtitkárát,"
    },
    {
      "provision_ref": "s34",
      "section": "34",
      "title": "34",
      "content": "Szabó Andreát, a Magyar Tudományos Akadémia tudományos munkatársát,"
    },
    {
      "provision_ref": "s35",
      "section": "35",
      "title": "35",
      "content": "Szük Krisztinát, a Magyar Kereskedelmi és Iparkamara közgazdasági referensét,"
    },
    {
      "provision_ref": "s36",
      "section": "36",
      "title": "36",
      "content": "Tavaszi Zsoltot, a Magyar Államkincstár elnökhelyettesét,"
    },
    {
      "provision_ref": "s37",
      "section": "37",
      "title": "37",
      "content": "dr. Tóth Gergelyt, a Nemzeti Közszolgálati Egyetem adjunktusát és"
    },
    {
      "provision_ref": "s38",
      "section": "38",
      "title": "38",
      "content": "dr. Várpalotai Viktort, a Nemzetgazdasági Minisztérium főosztályvezető-helyettesét"
    },
    {
      "provision_ref": "s39",
      "section": "39",
      "title": "39",
      "content": "– a 2017. május 1-től 2020. április 30-ig terjedő időtartamra –"
    },
    {
      "provision_ref": "s40",
      "section": "40",
      "title": "40",
      "content": "az Országos Statisztikai Tanács tagsági teendőinek ellátásával megbízom."
    }
  ]
}
