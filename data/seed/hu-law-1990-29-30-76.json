{
  "id": "hu-law-1990-29-30-76",
  "type": "statute",
  "title": "29/1990. (III. 21.) KE határozat vezérőrnagyi kinevezésekről",
  "status": "in_force",
  "in_force_date": "1990-03-21",
  "url": "https://njt.jog.gov.hu/jogszabaly/1990-29-30-76",
  "description": "vezérőrnagyi kinevezésekről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A honvédelmi miniszter előterjesztésére"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "– dr. Birkás János ezredest, az MN Központi Katonai Kórház parancsnokát,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "– Csurgay Miklós ezredest, az 1. honi légvédelmi hadtest parancsnok első helyettesét,"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "– Preininger Ambrus ezredest, a 2. gépesített hadtest parancsnokát,"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– Scharrer János ezredest, az MN kiképzési és szárazföldi főcsoportfőnök helyettesét,"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "– Szabó János ezredest, a Kossuth Lajos Katonai Főiskola parancsnokát,"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "– dr. Szabó Miklós ezredest, a Zalka Máté Katonai Műszaki Főiskola parancsnokát"
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "vezérőrnaggyá kinevezem."
    }
  ]
}
