{
  "id": "hu-law-2002-101-30-76",
  "type": "statute",
  "title": "101/2002. (VI. 29.) KE határozat közigazgatási államtitkár megbízatásának megszűnéséről",
  "status": "in_force",
  "in_force_date": "2002-06-29",
  "url": "https://njt.jog.gov.hu/jogszabaly/2002-101-30-76",
  "description": "közigazgatási államtitkár megbízatásának megszűnéséről",
  "provisions": [
    {
      "provision_ref": "s1",
      "section": "1",
      "title": "1",
      "content": "A Kormány tagjai és az államtitkárok jogállásáról és felelősségéről szóló 1997. évi LXXIX. törvény 29. §-ának (3) bekezdése alapján megállapítom, hogy"
    },
    {
      "provision_ref": "s2",
      "section": "2",
      "title": "2",
      "content": "dr. Baán Lászlónak,"
    },
    {
      "provision_ref": "s3",
      "section": "3",
      "title": "3",
      "content": "a Nemzeti Kulturális Örökség Minisztériuma közigazgatási államtitkárának"
    },
    {
      "provision_ref": "s4",
      "section": "4",
      "title": "4",
      "content": "e megbízatása"
    },
    {
      "provision_ref": "s5",
      "section": "5",
      "title": "5",
      "content": "– 2002. június 19-i hatállyal –"
    },
    {
      "provision_ref": "s6",
      "section": "6",
      "title": "6",
      "content": "áthelyezése miatt"
    },
    {
      "provision_ref": "s7",
      "section": "7",
      "title": "7",
      "content": "megszűnt."
    },
    {
      "provision_ref": "s8",
      "section": "8",
      "title": "8",
      "content": "KEH ügyszám: V-1/2393/2002."
    }
  ]
}
