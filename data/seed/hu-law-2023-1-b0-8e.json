      "provision_ref": "s111",
      "section": "111",
      "title": "111",
      "content": "Megjegyzés:"
    },
    {
      "provision_ref": "s112",
      "section": "112",
      "title": "112",
      "content": "A gyakorló lovaglónadrág a ló körüli teendők ellátásakor viselendő."
    },
