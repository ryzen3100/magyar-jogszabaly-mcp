{
  "name": "@ansvar/hungarian-law-mcp",
  "version": "1.0.0",
  "mcpName": "eu.ansvar/hungarian-law-mcp",
  "description": "Hungarian law database covering data protection, cybersecurity, e-commerce, and criminal law provisions via Model Context Protocol",
  "author": "Ansvar Systems <hello@ansvar.eu>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ansvar-Systems/Hungarian-law-mcp.git"
  },
  "homepage": "https://ansvar.eu",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hungarian-law",
    "data-protection",
    "gdpr",
    "cybersecurity",
    "legislation",
    "legal",
    "compliance",
    "ansvar"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "hungarian-law-mcp": "dist/src/index.js"
  },
  "files": [
    "dist",
    "data/database.db",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "build:db": "node --import tsx scripts/build-db.ts",
    "dev": "node --import tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ingest": "node --import tsx scripts/ingest.ts",
    "ingest:discover": "node --import tsx scripts/ingest.ts --full --discover-only",
    "ingest:full": "node --import tsx scripts/ingest.ts --full --resume",
    "ingest:full:inforce": "node --import tsx scripts/ingest.ts --full --in-force-only --resume",
    "test:contract": "vitest run tests/contract/",
    "validate": "npm run lint && npm test && npm run test:contract",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "check-updates": "node --import tsx scripts/check-updates.ts"
  },
  "dependencies": {
    "@ansvar/mcp-sqlite": "^1.0.5",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "ajv": "^8.18.0"
  }
}
